{
  "name": "scholzmx-astro",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "bun@1.3.9",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "typecheck": "astro check",
    "build-blog": "bun run scripts/build-blog-cli.ts",
    "lint:js": "oxlint",
    "lint:js:fix": "oxlint --fix",
    "lint:css": "stylelint \"src/**/*.{css,astro}\"",
    "lint:css:fix": "stylelint \"src/**/*.{css,astro}\" --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "tokens:check": "bun run scripts/check-css-tokens.ts",
    "quality:check": "bun run typecheck && bun run tokens:check && bun run lint:js && bun run lint:css && bun run format:check",
    "quality:fix": "bun run lint:js:fix && bun run lint:css:fix && bun run format",
    "quality:full": "bun run quality:check && bun run build && bun run test:a11y",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "bunx playwright test",
    "test:e2e:ui": "bunx playwright test --ui",
    "test:e2e:dev": "bunx playwright test --headed",
    "lighthouse": "lighthouse http://localhost:4321 --output html --output-path ./lighthouse-report.html",
    "lighthouse:ci": "lhci autorun",
    "perf:local": "bun run build && bun run preview & wait-on http://localhost:4321 && bun run lighthouse; kill $!",
    "perf:budget": "bun run build && bun run lighthouse:ci",
    "a11y": "pa11y http://localhost:4321",
    "a11y:wait": "wait-on http://localhost:4321 && bun run a11y",
    "test:a11y": "bun run build && bun run preview & bun run a11y:wait; kill $!"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.8",
    "@astrojs/rss": "^4.0.18",
    "@playwright/test": "^1.58.2",
    "astro": "^6.1.1",
    "npm-check-updates": "^18.3.1",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "sharp": "^0.34.5",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@astrojs/sitemap": "^3.7.2",
    "@lhci/cli": "^0.15.1",
    "@types/bun": "^1.3.11",
    "@types/node": "^24.12.0",
    "astro-pagefind": "^1.8.6",
    "astro-purgecss": "^5.5.0",
    "lighthouse": "^12.8.2",
    "lightningcss": "^1.32.0",
    "oxlint": "^1.57.0",
    "pa11y": "^9.1.1",
    "postcss": "^8.5.8",
    "postcss-html": "^1.8.1",
    "postcss-scss": "^4.0.9",
    "prettier": "3.6.2",
    "prettier-plugin-astro": "0.14.1",
    "stylelint": "^16.26.1",
    "stylelint-config-html": "^1.1.0",
    "stylelint-config-standard": "^39.0.1",
    "tailwindcss": "^4.2.2",
    "vitest": "^4.1.2",
    "wait-on": "^9.0.4"
  }
}
