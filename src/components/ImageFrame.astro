---
// A framed picture: a post or recipe hero, a card's photo, or the homepage portrait,
// which can turn over to a second photo when clicked.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

type Fit = 'cover' | 'contain';

export interface Props {
  src: string | ImageMetadata;
  alt: string;
  width?: number;
  height?: number;
  loading?: 'lazy' | 'eager';

  // Move and zoom the picture inside its frame: percentages from the centre, and a factor.
  positionX?: number;
  positionY?: number;
  scale?: number;
  fillMode?: Fit;

  style?: 'watercolor' | 'hero' | 'simple';
  size?: 'small' | 'medium' | 'large'; // watercolor only
  aspectRatio?: string; // e.g. "8/3"

  // A second photo the frame turns over to when clicked
  alternateSrc?: string | ImageMetadata;
  alternateAlt?: string;
  alternatePositionX?: number;
  alternatePositionY?: number;
  alternateScale?: number;
}

const {
  src,
  alt,
  width,
  height,
  loading = 'lazy',
  positionX,
  positionY,
  scale,
  fillMode = 'cover',
  style = 'simple',
  size = 'medium',
  aspectRatio,
  alternateSrc,
  alternateAlt,
  alternatePositionX,
  alternatePositionY,
  alternateScale,
} = Astro.props;

const isHero = style === 'hero';
const clickable = alternateSrc !== undefined;

// Watercolor portraits have fixed sizes; heroes and simple frames take their column's width.
const portraitSizes = {
  small: { width: 120, height: 140 },
  medium: { width: 160, height: 180 },
  large: { width: 200, height: 230 },
};
const portrait = style === 'watercolor' ? portraitSizes[size] : undefined;
const frameWidth = width ?? portrait?.width;
const frameHeight = height ?? portrait?.height;

// What Astro's image service is asked for
const imageWidth = frameWidth ?? (isHero ? 800 : 100);
function parseAspectRatio(r?: string): { w: number; h: number } | undefined {
  const [w, h] = (r ?? '').split('/').map(Number);
  return w && h && w > 0 && h > 0 ? { w, h } : undefined;
}
const ar = parseAspectRatio(aspectRatio);
const imageHeight = height ?? (ar ? Math.round(imageWidth * (ar.h / ar.w)) : 400);

const responsiveWidths = isHero
  ? [393, 768, 1024, 1200]
  : portrait
    ? [160, 240, 320, 480, 640, 960]
    : [320, 480, 640, 800, 1024];
const sizes = isHero
  ? '(min-width: 90rem) 1100px, (min-width: 72rem) 72rem, 100vw'
  : portrait
    ? '(min-width: 1200px) 240px, (min-width: 768px) 200px, 160px'
    : '(min-width: 768px) 640px, 100vw';

const eager = isHero || loading === 'eager';
const frameStyle = [
  aspectRatio && `aspect-ratio: ${aspectRatio};`,
  portrait && `width: ${frameWidth}px; height: ${frameHeight}px;`,
]
  .filter(Boolean)
  .join(' ');

// The primary photo and, on a clickable frame, the one it turns over to
const layers = [
  { role: 'primary', src, alt, x: positionX, y: positionY, scale },
  ...(alternateSrc
    ? [
        {
          role: 'alternate',
          src: alternateSrc,
          alt: alternateAlt || alt,
          x: alternatePositionX,
          y: alternatePositionY,
          scale: alternateScale,
        },
      ]
    : []),
].map((layer) => ({
  ...layer,
  primary: layer.role === 'primary',
  // Without a position or zoom, the picture simply fills the frame.
  moved: layer.x !== undefined || layer.y !== undefined || layer.scale !== undefined,
  transform: `scale(${layer.scale || 1}) translate(${layer.x || 0}%, ${layer.y || 0}%);`,
}));
---

<div
  class:list={['image-frame', `image-frame-${style}`, { clickable }]}
  style={frameStyle}
  role={clickable ? 'button' : undefined}
  tabindex={clickable ? '0' : undefined}
  aria-label={
    clickable
      ? `Click to toggle between ${alt} and ${alternateAlt || 'alternate image'}`
      : undefined
  }
  aria-pressed={clickable ? 'false' : undefined}
>
  {layers.map((layer) => {
    const img = {
      alt: layer.alt,
      class: `fit-${fillMode}`,
      loading: layer.primary && eager ? ('eager' as const) : ('lazy' as const),
      fetchpriority: layer.primary && isHero ? ('high' as const) : undefined,
    };
    const picture =
      typeof layer.src === 'string' ? (
        <img
          {...img}
          src={layer.src}
          decoding={layer.primary ? (img.loading === 'eager' ? 'sync' : 'async') : undefined}
        />
      ) : (
        <Image
          {...img}
          src={layer.src}
          width={imageWidth}
          height={layer.moved ? undefined : imageHeight}
          widths={responsiveWidths}
          sizes={sizes}
          format="avif"
        />
      );
    return layer.moved ? (
      <div
        class={`image-wrapper ${layer.role}-image`}
        style={`transform: ${layer.transform}`}
        aria-hidden={layer.primary ? undefined : 'true'}
      >
        <div class="frame-image custom-positioning">{picture}</div>
      </div>
    ) : (
      <div
        class={`frame-image simple-fill ${layer.role}-image`}
        aria-hidden={layer.primary ? undefined : 'true'}
      >
        {picture}
      </div>
    );
  })}
</div>

<style>
  .image-frame {
    position: relative;
    margin: 0 auto;
    overflow: hidden;
    display: block;
  }

  .image-frame img {
    display: block;
    width: 100%;
    height: 100%;
  }

  .fit-cover {
    object-fit: cover;
  }

  .fit-contain {
    object-fit: contain;
  }

  .image-wrapper {
    width: 100%;
    height: 100%;
    overflow: hidden;
    transform-origin: center center;
    position: relative;
  }

  /* A moved picture: centred on the frame, then shifted and zoomed by its wrapper */
  .frame-image.custom-positioning {
    width: 100%;
    height: 100%;
    display: block;
    transform: translate(-50%, -50%);
    position: absolute;
    top: 50%;
    left: 50%;
    overflow: hidden;
  }

  .frame-image.simple-fill {
    width: 100%;
    /* Prevent baseline gap and reserve exactly content height */
    line-height: 0;
    height: 100%;
    display: block;
    overflow: hidden;
  }

  /* A post or recipe header; the page sets its margins and corners. */
  .image-frame-hero {
    width: 100%;
    max-width: 64rem;
    background: var(--color-background);
  }

  /* A card's photo fills the card */
  .image-frame-simple {
    width: 100%;
    border-radius: var(--border-radius);
    box-shadow: 0 4px 12px rgba(139, 90, 60, 0.15);
  }

  /* The portrait. The homepage repaints the frame as a pasted photograph. */
  .image-frame-watercolor {
    border-radius: var(--organic-md);
    padding: 8px;
    background: linear-gradient(
      135deg,
      rgba(255, 248, 240, 0.9) 0%,
      rgba(250, 245, 235, 0.7) 50%,
      rgba(240, 235, 220, 0.9) 100%
    );
    box-shadow:
      0 2px 8px rgba(139, 90, 60, 0.1),
      0 8px 24px rgba(90, 70, 50, 0.12),
      inset 0 0 20px rgba(255, 248, 240, 0.5);
  }

  .image-frame-watercolor img {
    border-radius: var(--organic-sm);
  }

  @media (max-width: 768px) {
    .image-frame-watercolor {
      max-width: 120px;
      max-height: 140px;
    }
  }

  /* A frame that turns over to a second photo */
  .image-frame.clickable {
    cursor: pointer;
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }

  .image-frame.clickable:hover {
    box-shadow: 0 8px 20px rgba(139, 90, 60, 0.25);
  }

  .image-frame.clickable:focus {
    outline: none;
  }

  /* Only show focus outline when navigating with keyboard */
  .image-frame.clickable:focus-visible {
    outline: 2px solid var(--color-moss);
    outline-offset: 2px;
  }

  .primary-image {
    transition: opacity 0.3s ease;
  }

  .alternate-image {
    opacity: 0;
    transition: opacity 0.3s ease;
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  @media (prefers-reduced-motion: reduce) {
    .primary-image,
    .alternate-image {
      transition: none;
    }
  }

  .image-frame.show-alternate .primary-image {
    opacity: 0;
  }

  .image-frame.show-alternate .alternate-image {
    opacity: 1;
  }
</style>

{clickable && <script src="/scripts/image-frame-toggle.js" is:inline />}
