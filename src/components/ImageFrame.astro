---
// A framed picture: a post or recipe hero, a card's photo, or the homepage portrait,
// which can turn over to a second photo when clicked.
//
// The frame is always filled. Which part of the picture shows is said in terms of the
// picture, not of the frame, so one setting picks the same spot in a wide hero and in a
// small print (the geometry is the `.frame-view img.local` rule below):
// - `scale` enlarges the picture from the size at which it would fit whole into the frame.
//   Where that would leave the frame partly empty, the picture is enlarged until it fills.
// - `positionX`/`positionY` shift the picture right and down, in percent of its own size:
//   the point of the picture at the frame's centre is (50 - positionX)%, (50 - positionY)%.
//   The picture stops at the frame's edges.
// scripts/browser-smoke.mjs pins the homepage portrait's framing to the pixel.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

export interface Props {
  src: string | ImageMetadata;
  alt: string;
  /** The widest the frame is shown, in px: the size the image service is asked for */
  width?: number;
  loading?: 'lazy' | 'eager';

  positionX?: number;
  positionY?: number;
  scale?: number;

  style?: 'watercolor' | 'hero' | 'simple';
  size?: 'small' | 'medium' | 'large'; // watercolor only
  /** The frame's shape, e.g. "8/3". A watercolor frame has its own. */
  aspectRatio?: string;

  // A second photo the frame turns over to when clicked
  alternateSrc?: string | ImageMetadata;
  alternateAlt?: string;
  alternatePositionX?: number;
  alternatePositionY?: number;
  alternateScale?: number;
}

const {
  src,
  alt,
  width,
  loading = 'lazy',
  positionX,
  positionY,
  scale,
  style = 'simple',
  size = 'medium',
  aspectRatio,
  alternateSrc,
  alternateAlt,
  alternatePositionX,
  alternatePositionY,
  alternateScale,
} = Astro.props;

const isHero = style === 'hero';
const clickable = alternateSrc !== undefined;

// Watercolor portraits have fixed sizes; heroes and simple frames take their column's width.
const portraitSizes = {
  small: { width: 120, height: 140 },
  medium: { width: 160, height: 180 },
  large: { width: 200, height: 230 },
};
const portrait = style === 'watercolor' ? portraitSizes[size] : undefined;

// What Astro's image service is asked for. The picture keeps its own shape; the frame
// crops it in the browser.
const imageWidth = width ?? portrait?.width ?? (isHero ? 800 : 100);
const responsiveWidths = isHero
  ? [393, 768, 1024, 1200]
  : portrait
    ? [160, 240, 320, 480, 640, 960]
    : [320, 480, 640, 800, 1024];
const sizes = isHero
  ? '(min-width: 90rem) 1100px, (min-width: 72rem) 72rem, 100vw'
  : portrait
    ? '(min-width: 1200px) 240px, (min-width: 768px) 200px, 160px'
    : '(min-width: 768px) 640px, 100vw';

const eager = isHero || loading === 'eager';
const frameStyle = [
  aspectRatio && `aspect-ratio: ${aspectRatio};`,
  portrait && `width: ${portrait.width}px; height: ${portrait.height}px;`,
]
  .filter(Boolean)
  .join(' ');

const number = (value: number) => Number(value.toFixed(4));

// The primary photo and, on a clickable frame, the one it turns over to
const layers = [
  { role: 'primary', src, alt, x: positionX, y: positionY, scale },
  ...(alternateSrc
    ? [
        {
          role: 'alternate',
          src: alternateSrc,
          alt: alternateAlt || alt,
          x: alternatePositionX,
          y: alternatePositionY,
          scale: alternateScale,
        },
      ]
    : []),
].map((layer) => ({
  ...layer,
  primary: layer.role === 'primary',
  view: [
    `--zoom: ${number(layer.scale || 1)}`,
    `--focus-x: ${number(0.5 - (layer.x || 0) / 100)}`,
    `--focus-y: ${number(0.5 - (layer.y || 0) / 100)}`,
  ].join('; '),
}));
---

<div
  class:list={['image-frame', `image-frame-${style}`, { clickable }]}
  style={frameStyle}
  role={clickable ? 'button' : undefined}
  tabindex={clickable ? '0' : undefined}
  aria-label={
    clickable
      ? `Click to toggle between ${alt} and ${alternateAlt || 'alternate image'}`
      : undefined
  }
  aria-pressed={clickable ? 'false' : undefined}
>
  {layers.map((layer) => {
    const img = {
      alt: layer.alt,
      loading: layer.primary && eager ? ('eager' as const) : ('lazy' as const),
      fetchpriority: layer.primary && isHero ? ('high' as const) : undefined,
    };
    // A local picture's proportions are known at build time. Those of a picture from a
    // URL are not: see `img.remote`.
    const picture =
      typeof layer.src === 'string' ? (
        <img
          {...img}
          class="remote"
          src={layer.src}
          decoding={layer.primary ? (img.loading === 'eager' ? 'sync' : 'async') : undefined}
        />
      ) : (
        <Image
          {...img}
          class="local"
          style={`--aspect: ${number(layer.src.width / layer.src.height)}`}
          src={layer.src}
          width={imageWidth}
          widths={responsiveWidths}
          sizes={sizes}
          format="avif"
        />
      );
    return <div
      class={`frame-view ${layer.role}-image`}
      style={layer.view}
      aria-hidden={layer.primary ? undefined : 'true'}
    >
      {picture}
    </div>;
  })}
</div>

<style>
  .image-frame {
    position: relative;
    margin: 0 auto;
    overflow: hidden;
    display: block;
  }

  /* The window onto the picture: cq units inside it are the frame's own width and height */
  .frame-view {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    container-type: size;
  }

  .frame-view img {
    position: absolute;
    display: block;
    max-width: none;
  }

  /* --fit is the picture's width when it fits whole into the frame. It is shown --zoom
     times that, and never smaller than the frame. Its focus point goes to the frame's
     centre, as far as the picture's edges allow. */
  .frame-view img.local {
    --fit: min(100cqw, 100cqh * var(--aspect));
    --w: max(var(--fit) * var(--zoom), 100cqw, 100cqh * var(--aspect));
    --h: calc(var(--w) / var(--aspect));

    width: var(--w);
    height: var(--h);
    left: clamp(100cqw - var(--w), 50cqw - var(--focus-x) * var(--w), 0px);
    top: clamp(100cqh - var(--h), 50cqh - var(--focus-y) * var(--h), 0px);
  }

  /* A picture from a URL: its proportions are not known, so it fills the frame around
     its focus point, and --zoom enlarges it from there. */
  .frame-view img.remote {
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: calc(var(--focus-x) * 100%) calc(var(--focus-y) * 100%);
    transform-origin: calc(var(--focus-x) * 100%) calc(var(--focus-y) * 100%);
    transform: scale(max(1, var(--zoom)));
  }

  /* A post or recipe header; the page sets its margins and corners. */
  .image-frame-hero {
    width: 100%;
    max-width: 64rem;
    background: var(--color-background);
  }

  /* A card's photo fills the card */
  .image-frame-simple {
    width: 100%;
    border-radius: var(--border-radius);
    box-shadow: 0 4px 12px rgba(139, 90, 60, 0.15);
  }

  /* The portrait. The homepage repaints the frame as a pasted photograph. */
  /* The mat is 8px wide, and the picture is measured inside it. A picture larger than
     that runs out over the mat, to the frame's edge. */
  .image-frame-watercolor {
    border-radius: var(--organic-md);
    padding: 8px;
    background: linear-gradient(
      135deg,
      rgba(255, 248, 240, 0.9) 0%,
      rgba(250, 245, 235, 0.7) 50%,
      rgba(240, 235, 220, 0.9) 100%
    );
    box-shadow:
      0 2px 8px rgba(139, 90, 60, 0.1),
      0 8px 24px rgba(90, 70, 50, 0.12),
      inset 0 0 20px rgba(255, 248, 240, 0.5);
  }

  .image-frame-watercolor .frame-view {
    overflow: visible;
  }

  .image-frame-watercolor img {
    border-radius: var(--organic-sm);
  }

  @media (max-width: 768px) {
    .image-frame-watercolor {
      max-width: 120px;
      max-height: 140px;
    }
  }

  /* A frame that turns over to a second photo */
  .image-frame.clickable {
    cursor: pointer;
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }

  .image-frame.clickable:hover {
    box-shadow: 0 8px 20px rgba(139, 90, 60, 0.25);
  }

  .image-frame-watercolor.clickable:hover {
    box-shadow:
      0 4px 12px rgba(139, 90, 60, 0.15),
      0 12px 30px rgba(90, 70, 50, 0.15),
      inset 0 0 25px rgba(255, 248, 240, 0.6);
  }

  .image-frame.clickable:focus {
    outline: none;
  }

  /* Only show focus outline when navigating with keyboard */
  .image-frame.clickable:focus-visible {
    outline: 2px solid var(--color-moss);
    outline-offset: 2px;
  }

  .primary-image {
    transition: opacity 0.3s ease;
  }

  .alternate-image {
    opacity: 0;
    transition: opacity 0.3s ease;
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  @media (prefers-reduced-motion: reduce) {
    .primary-image,
    .alternate-image {
      transition: none;
    }
  }

  .image-frame.show-alternate .primary-image {
    opacity: 0;
  }

  .image-frame.show-alternate .alternate-image {
    opacity: 1;
  }
</style>

{clickable && <script src="/scripts/image-frame-toggle.js" is:inline />}
