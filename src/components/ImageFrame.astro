---
/**
 * ImageFrame - Unified image component with positioning and framing
 * Uses external CSS for better caching and ImageRenderer for consistent rendering
 */
import ImageRenderer from './ImageRenderer.astro';
import '../styles/image-frame.css';
import type { ImageMetadata } from 'astro';

type FrameStyle = 'botanical' | 'polaroid' | 'gentle-oval' | 'watercolor' | 'hero' | 'simple';
type FrameSize = 'small' | 'medium' | 'large' | 'custom';

export interface Props {
  src: string | ImageMetadata;
  alt: string;
  width?: number;
  height?: number;
  loading?: 'lazy' | 'eager';
  positionX?: number;
  positionY?: number;
  scale?: number;
  fillMode?: 'cover' | 'contain' | 'fill';
  focalX?: number;
  focalY?: number;
  style?: FrameStyle;
  size?: FrameSize;
  aspectRatio?: string;
  className?: string;
  containerClass?: string;
  caption?: string;
  alternateSrc?: string | ImageMetadata;
  alternateAlt?: string;
  alternatePositionX?: number;
  alternatePositionY?: number;
  alternateScale?: number;
  alternateFillMode?: 'cover' | 'contain' | 'fill';
  clickable?: boolean;
}

const {
  src,
  alt,
  width,
  height,
  loading = 'lazy',
  positionX,
  positionY,
  scale,
  fillMode = 'contain',
  style: frameStyle = 'simple',
  size = 'medium',
  aspectRatio,
  className = '',
  containerClass = '',
  focalX,
  focalY,
  caption,
  alternateSrc,
  alternateAlt,
  alternatePositionX,
  alternatePositionY,
  alternateScale,
  alternateFillMode,
  clickable,
} = Astro.props;

const useCustomPositioning =
  positionX !== undefined || positionY !== undefined || scale !== undefined;
const finalPositionX = positionX || 0;
const finalPositionY = positionY || 0;
const finalScale = scale || 1;

const isClickable = clickable || alternateSrc !== undefined;
const useAlternateCustomPositioning =
  alternatePositionX !== undefined ||
  alternatePositionY !== undefined ||
  alternateScale !== undefined;
const finalAlternatePositionX = alternatePositionX || 0;
const finalAlternatePositionY = alternatePositionY || 0;
const finalAlternateScale = alternateScale || 1;
const finalAlternateFillMode = alternateFillMode || fillMode;

const objectFitClass =
  fillMode === 'cover'
    ? 'tw-object-cover'
    : fillMode === 'contain'
      ? 'tw-object-contain'
      : 'tw-object-fill';
const alternateObjectFitClass =
  finalAlternateFillMode === 'cover'
    ? 'tw-object-cover'
    : finalAlternateFillMode === 'contain'
      ? 'tw-object-contain'
      : 'tw-object-fill';
const customObjectFitClass = 'tw-object-contain';

function clamp(val: number, min: number, max: number) {
  return Math.min(max, Math.max(min, val));
}
const hasFocal = focalX !== undefined || focalY !== undefined;
const focalXPct = `${clamp((focalX ?? 0) + 50, 0, 100)}%`;
const focalYPct = `${clamp((focalY ?? 0) + 50, 0, 100)}%`;
const objectPositionStyle = hasFocal ? `object-position: ${focalXPct} ${focalYPct};` : '';

const containerHeightClass = frameStyle === 'simple' ? '' : 'tw-h-full';
const imageHeightClass =
  frameStyle === 'simple' ? (aspectRatio ? 'tw-h-full' : 'tw-h-auto') : 'tw-h-full';

const portraitSizeMap: Record<FrameSize, Record<FrameStyle, { width: string; height: string }>> = {
  small: {
    botanical: { width: '120px', height: '120px' },
    polaroid: { width: '120px', height: '120px' },
    'gentle-oval': { width: '110px', height: '130px' },
    watercolor: { width: '120px', height: '140px' },
    hero: { width: '100%', height: 'auto' },
    simple: { width: '100%', height: 'auto' },
  },
  medium: {
    botanical: { width: '160px', height: '160px' },
    polaroid: { width: '160px', height: '160px' },
    'gentle-oval': { width: '150px', height: '170px' },
    watercolor: { width: '160px', height: '180px' },
    hero: { width: '100%', height: 'auto' },
    simple: { width: '100%', height: 'auto' },
  },
  large: {
    botanical: { width: '200px', height: '200px' },
    polaroid: { width: '200px', height: '200px' },
    'gentle-oval': { width: '180px', height: '210px' },
    watercolor: { width: '200px', height: '230px' },
    hero: { width: '100%', height: 'auto' },
    simple: { width: '100%', height: 'auto' },
  },
  custom: {
    botanical: { width: '160px', height: '160px' },
    polaroid: { width: '160px', height: '160px' },
    'gentle-oval': { width: '150px', height: '170px' },
    watercolor: { width: '160px', height: '180px' },
    hero: { width: '100%', height: 'auto' },
    simple: { width: '100%', height: 'auto' },
  },
};

let finalWidth: string | number;
let finalHeight: string | number;

if (frameStyle === 'hero') {
  finalWidth = width || 'calc(min(75vw, 1100px) + 4rem)';
  finalHeight = height || 'auto';
} else if (frameStyle === 'simple') {
  finalWidth = width || '100%';
  finalHeight = height || 'auto';
} else {
  if (size === 'custom') {
    finalWidth = width || portraitSizeMap.medium[frameStyle].width;
    finalHeight = height || portraitSizeMap.medium[frameStyle].height;
  } else {
    const frameSize = portraitSizeMap[size][frameStyle];
    finalWidth = width || frameSize.width;
    finalHeight = height || frameSize.height;
  }
}

const imageWidth = typeof finalWidth === 'string' ? parseInt(finalWidth, 10) || 800 : finalWidth;
function parseAspectRatio(r?: string): { w: number; h: number } | undefined {
  if (!r) return undefined;
  const parts = r.split('/');
  if (parts.length !== 2) return undefined;
  const w = Number(parts[0]);
  const h = Number(parts[1]);
  if (!Number.isFinite(w) || !Number.isFinite(h) || w <= 0 || h <= 0) return undefined;
  return { w, h };
}
const ar = parseAspectRatio(aspectRatio);
let imageHeight =
  typeof finalHeight === 'string' ? parseInt(finalHeight, 10) : (finalHeight as number);
if (!Number.isFinite(imageHeight)) {
  imageHeight = ar ? Math.round((imageWidth as number) * (ar.h / ar.w)) : 400;
}

const responsiveWidths = (() => {
  switch (frameStyle) {
    case 'hero':
      return [393, 768, 1024, 1200];
    case 'botanical':
    case 'polaroid':
    case 'gentle-oval':
    case 'watercolor':
      return [160, 240, 320, 480, 640, 960];
    default:
      return [320, 480, 640, 800, 1024];
  }
})();

const defaultSizes = (() => {
  switch (frameStyle) {
    case 'hero':
      return '(min-width: 90rem) 1100px, (min-width: 72rem) 72rem, 100vw';
    case 'botanical':
    case 'polaroid':
    case 'gentle-oval':
    case 'watercolor':
      return '(min-width: 1200px) 240px, (min-width: 768px) 200px, 160px';
    default:
      return '(min-width: 768px) 640px, 100vw';
  }
})();

const effectiveLoading = frameStyle === 'hero' ? 'eager' : loading;
const effectiveFetchPriority = frameStyle === 'hero' ? 'high' : undefined;
const heroSizes = '(min-width: 90rem) 1100px, (min-width: 72rem) 72rem, 100vw';
const decodingAttr = effectiveLoading === 'eager' ? 'sync' : 'async';

const hasCaption = Astro.slots?.has?.('caption') || caption;
function simpleHash(str: string): string {
  let hash = 0;
  for (let i = 0; i < str.length; i++) {
    const char = str.charCodeAt(i);
    hash = (hash << 5) - hash + char;
    hash = hash & hash;
  }
  return Math.abs(hash).toString(36);
}
const captionId = hasCaption
  ? `imgcap-${simpleHash(typeof src === 'string' ? src : src.src)}-${simpleHash(alt)}`
  : undefined;

const baseContainerClass = `image-frame image-frame-${frameStyle} tw-relative tw-overflow-hidden tw-block ${className} ${
  isClickable
    ? 'clickable tw-cursor-pointer tw-transition-transform tw-duration-200 tw-ease-in-out'
    : ''
} ${containerClass} ${
  frameStyle === 'hero'
    ? 'tw-w-full tw-max-w-5xl -tw-mt-lg tw-mb-lg tw-aspect-[3/2] md:tw-aspect-[3/2] sm:tw-aspect-[4/3]'
    : ''
}`;

const widthStyle =
  frameStyle === 'hero' || (frameStyle === 'simple' && width === undefined) ? 'width: 100%;' : '';

const baseContainerStyle = `${widthStyle} ${aspectRatio ? `aspect-ratio: ${aspectRatio};` : ''} ${
  frameStyle !== 'hero' && frameStyle !== 'simple'
    ? `width: ${finalWidth}; height: ${finalHeight};`
    : ''
}`;
---

{
  hasCaption ? (
    <figure class="image-figure tw-mx-auto">
      <div
        class={baseContainerClass}
        style={baseContainerStyle}
        role={isClickable ? 'button' : undefined}
        tabindex={isClickable ? '0' : undefined}
        aria-label={
          isClickable
            ? `Click to toggle between ${alt} and ${alternateAlt || 'alternate image'}`
            : undefined
        }
        aria-pressed={isClickable ? 'false' : undefined}
        aria-describedby={hasCaption ? captionId : undefined}
      >
        {useCustomPositioning ? (
          <div
            class="image-wrapper primary-image tw-w-full tw-h-full tw-overflow-hidden tw-origin-center tw-relative"
            style={`transform: scale(${finalScale}) translate(${finalPositionX}%, ${finalPositionY}%);`}
          >
            <div class="frame-image custom-positioning tw-w-full tw-h-full tw-block tw-absolute tw-top-1/2 tw-left-1/2 tw--translate-x-1/2 tw--translate-y-1/2 tw-overflow-hidden">
              <ImageRenderer
                src={src}
                alt={alt}
                width={imageWidth}
                height={imageHeight}
                widths={responsiveWidths}
                sizes={frameStyle === 'hero' ? heroSizes : defaultSizes}
                loading={effectiveLoading}
                fetchpriority={effectiveFetchPriority}
                decoding={decodingAttr}
                class="tw-w-full tw-h-full"
                objectFitClass={customObjectFitClass}
              />
            </div>
          </div>
        ) : (
          <div
            class={`frame-image simple-fill fill-${fillMode} primary-image tw-w-full ${containerHeightClass} tw-block tw-overflow-hidden`}
            style={aspectRatio ? `aspect-ratio: ${aspectRatio};` : undefined}
          >
            <ImageRenderer
              src={src}
              alt={alt}
              width={imageWidth}
              height={imageHeight}
              widths={responsiveWidths}
              sizes={frameStyle === 'hero' ? heroSizes : defaultSizes}
              loading={effectiveLoading}
              fetchpriority={effectiveFetchPriority}
              decoding={decodingAttr}
              class={`tw-w-full ${imageHeightClass} tw-block ${objectFitClass}`}
              style={objectPositionStyle}
            />
          </div>
        )}

        {alternateSrc &&
          (useAlternateCustomPositioning ? (
            <div
              class="image-wrapper alternate-image tw-opacity-0 tw-transition-opacity tw-duration-300 tw-ease-in-out tw-absolute tw-inset-0 tw-w-full tw-h-full tw-overflow-hidden tw-origin-center"
              style={`transform: scale(${finalAlternateScale}) translate(${finalAlternatePositionX}%, ${finalAlternatePositionY}%);`}
              aria-hidden="true"
            >
              <div class="frame-image custom-positioning tw-w-full tw-h-full tw-block tw-absolute tw-top-1/2 tw-left-1/2 tw--translate-x-1/2 tw--translate-y-1/2 tw-overflow-hidden">
                <ImageRenderer
                  src={alternateSrc}
                  alt={alternateAlt || alt}
                  width={imageWidth}
                  height={imageHeight}
                  widths={responsiveWidths}
                  sizes={frameStyle === 'hero' ? heroSizes : defaultSizes}
                  loading="lazy"
                  class="tw-w-full tw-h-full"
                  objectFitClass={customObjectFitClass}
                />
              </div>
            </div>
          ) : (
            <div
              class={`frame-image simple-fill fill-${finalAlternateFillMode} alternate-image tw-absolute tw-inset-0 tw-w-full ${containerHeightClass} tw-block tw-overflow-hidden tw-opacity-0 tw-transition-opacity tw-duration-300 tw-ease-in-out`}
              aria-hidden="true"
            >
              <ImageRenderer
                src={alternateSrc}
                alt={alternateAlt || alt}
                width={imageWidth}
                height={imageHeight}
                widths={responsiveWidths}
                sizes={frameStyle === 'hero' ? heroSizes : defaultSizes}
                loading="lazy"
                class={`tw-w-full tw-h-full tw-block ${alternateObjectFitClass}`}
                style={objectPositionStyle}
              />
            </div>
          ))}
      </div>
      <figcaption class="image-caption" id={captionId}>
        {caption}
        <slot name="caption" />
      </figcaption>
    </figure>
  ) : (
    <div
      class={baseContainerClass}
      style={baseContainerStyle}
      role={isClickable ? 'button' : undefined}
      tabindex={isClickable ? '0' : undefined}
      aria-label={
        isClickable
          ? `Click to toggle between ${alt} and ${alternateAlt || 'alternate image'}`
          : undefined
      }
      aria-pressed={isClickable ? 'false' : undefined}
    >
      {useCustomPositioning ? (
        <div
          class="image-wrapper primary-image tw-w-full tw-h-full tw-overflow-hidden tw-origin-center tw-relative"
          style={`transform: scale(${finalScale}) translate(${finalPositionX}%, ${finalPositionY}%);`}
        >
          <div class="frame-image custom-positioning tw-w-full tw-h-full tw-block tw-absolute tw-top-1/2 tw-left-1/2 tw--translate-x-1/2 tw--translate-y-1/2 tw-overflow-hidden">
            <ImageRenderer
              src={src}
              alt={alt}
              width={imageWidth}
              height={imageHeight}
              widths={responsiveWidths}
              sizes={frameStyle === 'hero' ? heroSizes : defaultSizes}
              loading={effectiveLoading}
              fetchpriority={effectiveFetchPriority}
              decoding={decodingAttr}
              class="tw-w-full tw-h-full"
              objectFitClass={customObjectFitClass}
            />
          </div>
        </div>
      ) : (
        <div
          class={`frame-image simple-fill fill-${fillMode} primary-image tw-w-full ${containerHeightClass} tw-block tw-overflow-hidden`}
        >
          <ImageRenderer
            src={src}
            alt={alt}
            width={imageWidth}
            height={imageHeight}
            widths={responsiveWidths}
            sizes={frameStyle === 'hero' ? heroSizes : defaultSizes}
            loading={effectiveLoading}
            fetchpriority={effectiveFetchPriority}
            decoding={decodingAttr}
            class={`tw-w-full ${imageHeightClass} tw-block ${objectFitClass}`}
            style={objectPositionStyle}
          />
        </div>
      )}

      {alternateSrc &&
        (useAlternateCustomPositioning ? (
          <div
            class="image-wrapper alternate-image tw-opacity-0 tw-transition-opacity tw-duration-300 tw-ease-in-out tw-absolute tw-inset-0 tw-w-full tw-h-full tw-overflow-hidden tw-origin-center"
            style={`transform: scale(${finalAlternateScale}) translate(${finalAlternatePositionX}%, ${finalAlternatePositionY}%);`}
            aria-hidden="true"
          >
            <div class="frame-image custom-positioning tw-w-full tw-h-full tw-block tw-absolute tw-top-1/2 tw-left-1/2 tw--translate-x-1/2 tw--translate-y-1/2 tw-overflow-hidden">
              <ImageRenderer
                src={alternateSrc}
                alt={alternateAlt || alt}
                width={imageWidth}
                height={imageHeight}
                widths={responsiveWidths}
                sizes={frameStyle === 'hero' ? heroSizes : defaultSizes}
                loading="lazy"
                class="tw-w-full tw-h-full"
                objectFitClass={customObjectFitClass}
              />
            </div>
          </div>
        ) : (
          <div
            class={`frame-image simple-fill fill-${finalAlternateFillMode} alternate-image tw-absolute tw-inset-0 tw-w-full ${containerHeightClass} tw-block tw-overflow-hidden tw-opacity-0 tw-transition-opacity tw-duration-300 tw-ease-in-out`}
            aria-hidden="true"
          >
            <ImageRenderer
              src={alternateSrc}
              alt={alternateAlt || alt}
              width={imageWidth}
              height={imageHeight}
              widths={responsiveWidths}
              sizes={frameStyle === 'hero' ? heroSizes : defaultSizes}
              loading="lazy"
              class={`tw-w-full tw-h-full tw-block ${alternateObjectFitClass}`}
              style={objectPositionStyle}
            />
          </div>
        ))}
    </div>
  )
}

{isClickable && <script is:inline src="/scripts/image-frame-toggle.js" />}
