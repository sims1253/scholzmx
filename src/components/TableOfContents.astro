---
export interface Props {
  maxDepth?: number;
  className?: string;
}

const { maxDepth = 3, className = '' } = Astro.props;
---

<div class={`toc-container ${className}`} data-max-depth={maxDepth}>
  <button
    class="toc-toggle"
    aria-expanded="false"
    aria-controls="toc-content"
    aria-label="Toggle table of contents"
    type="button"
  >
    <svg class="toc-icon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
      <path
        d="M3 5h18M3 12h18M3 19h18"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"></path>
    </svg>
    <span class="toc-label">Contents</span>
    <svg class="toc-chevron" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
      <path
        d="M6 9l6 6 6-6"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
    </svg>
  </button>

  <div id="toc-content" class="toc-content">
    <nav aria-label="Table of contents">
      <ol class="toc-list"></ol>
    </nav>
  </div>
</div>
<style>
  .toc-container {
    position: sticky;
    top: 2rem;
  }

  .toc-toggle {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    padding: var(--space-xs) var(--space-sm);
    background: color-mix(in oklab, var(--color-surface) 60%, transparent);
    border: 1px solid var(--color-lichen);
    border-radius: var(--organic-sm);
    color: var(--color-walnut);
    font-family: var(--font-heading);
    font-size: var(--text-sm);
    font-weight: 500;
    cursor: pointer;
    transition: all var(--transition-fast);
    width: 100%;
    justify-content: space-between;
    min-height: 44px;
  }

  .toc-toggle:hover {
    background: color-mix(in oklab, var(--color-walnut) 8%, transparent);
    border-color: var(--color-sage);
  }

  .toc-toggle:focus-visible {
    outline: 2px solid var(--color-tansy);
    outline-offset: 2px;
  }

  .toc-icon {
    flex-shrink: 0;
  }

  .toc-chevron {
    flex-shrink: 0;
    transition: transform var(--transition-fast);
  }

  .toc-toggle[aria-expanded='true'] .toc-chevron {
    transform: rotate(180deg);
  }

  .toc-label {
    flex: 1;
    text-align: center;
  }

  .toc-content {
    background: var(--color-surface);
    border: 1px solid var(--color-lichen);
    border-radius: var(--organic-sm);
    margin-top: var(--space-sm);
    max-height: 0;
    overflow: hidden;
    transition:
      max-height var(--transition-medium),
      opacity var(--transition-medium),
      padding var(--transition-medium);
    opacity: 0;
    box-shadow: 0 4px 12px color-mix(in oklab, var(--color-walnut) 6%, transparent);
  }

  .toc-content[aria-expanded='true'] {
    max-height: 60vh;
    overflow-y: auto;
    opacity: 1;
    padding: var(--space-md);
  }

  .toc-list {
    list-style: none;
    padding: 0 0 0 var(--space-xs);
    margin: 0;
    position: relative;
  }

  .toc-item {
    margin-bottom: 0;
  }

  .toc-item + .toc-item {
    margin-top: var(--space-xs);
    padding-top: var(--space-xs);
    border-top: 1px dashed color-mix(in oklab, var(--color-lichen) 55%, transparent);
  }

  .toc-link {
    display: block;
    position: relative;
    color: var(--color-walnut);
    text-decoration: none;
    padding: var(--space-xs) var(--space-sm) var(--space-xs) calc(var(--space-sm) + 0.65rem);
    border-radius: 4px;
    font-size: var(--text-sm);
    line-height: 1.4;
    transition:
      background-color var(--transition-fast),
      color var(--transition-fast),
      transform var(--transition-fast);
    border-left: 2px solid transparent;
  }

  .toc-link::before {
    content: '•';
    position: absolute;
    left: var(--space-xs);
    top: calc(var(--space-xs) + 0.45em);
    font-size: 0.7em;
    color: color-mix(in oklab, var(--color-sage) 70%, var(--color-walnut));
    opacity: 0.75;
  }

  .toc-link:hover {
    background: color-mix(in oklab, var(--color-sage) 15%, transparent);
    border-left-color: var(--color-sage);
    transform: translateX(2px);
  }

  .toc-link.active {
    background: color-mix(in oklab, var(--color-moss) 20%, transparent);
    border-left-color: var(--color-moss);
    font-weight: 500;
  }

  .toc-link:focus-visible {
    outline: 2px solid var(--color-tansy);
    outline-offset: 2px;
    background: color-mix(in oklab, var(--color-tansy) 10%, transparent);
  }

  .toc-h3 {
    margin-left: var(--space-lg);
    font-size: var(--text-xs);
  }

  .toc-h4 {
    margin-left: var(--space-lg);
    margin-top: var(--space-xxs);
    font-size: var(--text-xs);
  }

  /* Hand-drawn vine decoration */
  .toc-list::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 1px;
    background: linear-gradient(
      to bottom,
      transparent 0%,
      color-mix(in oklab, var(--color-sage) 40%, transparent) 10%,
      color-mix(in oklab, var(--color-sage) 40%, transparent) 90%,
      transparent 100%
    );
  }

  /* Mobile: Static positioning for stacking */
  @media (max-width: 1199px) {
    .toc-container {
      position: static;
      margin-bottom: 0;
    }
  }

  /* Desktop sidebar refinement: Auto-expand TOC on large screens */
  @media (min-width: 1200px) {
    .toc-container {
      width: fit-content;
      max-width: var(--sidebar-width);
    }

    .toc-toggle {
      display: none;
    }

    .toc-content {
      width: max-content;
      max-width: var(--sidebar-width);
      max-height: none;
      opacity: 1;
      padding: var(--space-md);
      margin-top: 0;
      overflow: hidden;
      box-shadow: 0 4px 12px color-mix(in oklab, var(--color-walnut) 6%, transparent);
    }

    .toc-content[aria-expanded='true'],
    .toc-content[aria-expanded='false'] {
      /* Override aria-expanded styles for desktop */
      width: max-content;
      max-width: var(--sidebar-width);
      max-height: none;
      opacity: 1;
      padding: var(--space-md);
    }

    .toc-link {
      white-space: nowrap;
      max-width: 100%;
      overflow: hidden;
      text-overflow: ellipsis;
    }
  }

  /* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .toc-content {
      transition: none;
    }

    .toc-chevron {
      transition: none;
    }
  }
</style>

<script>
  import '../scripts/table-of-contents';
</script>
