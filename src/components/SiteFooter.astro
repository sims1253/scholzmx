---
import FooterLedge from './FooterLedge.astro';
---

<footer class="site-footer">
  <FooterLedge />

  <div class="colophon">
    <ul class="footer-links">
      <li>
        <a href="https://github.com/sims1253" rel="noopener me" class="no-external-indicator">
          GitHub
        </a>
      </li>
      <li>
        <a
          href="https://bsky.app/profile/scholzmx.bsky.social"
          rel="noopener me"
          class="no-external-indicator"
        >
          Bluesky
        </a>
      </li>
      <li><a href="/rss.xml">RSS feed</a></li>
    </ul>
    <p>
      Writing and pictures are shared under
      <a
        href="https://creativecommons.org/licenses/by-sa/4.0/"
        rel="license"
        class="no-external-indicator"
        >CC BY-SA 4.0</a
      >, the code under the MIT license.
    </p>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    z-index: 1;
    margin-top: 0.6rem;
    padding: 0 var(--space-md) 0.5rem;
  }

  /* Small print under the ledge's rule: the links, then the licence, on one line where
     they fit. */
  .colophon {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: baseline;
    gap: 0 1.5rem;
    max-width: 46rem;
    margin: 0 auto;
    padding-top: 0.2rem;
    font-family: var(--font-ui);
    font-size: var(--text-xs);
    line-height: 1.5;
    color: var(--color-text-muted);
    text-align: center;
  }

  .colophon a {
    white-space: nowrap;
  }

  .colophon p {
    margin: 0;
    text-wrap: balance;
    hyphens: manual;
  }

  .footer-links {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0 1.1rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--text-xs);
  }

  .footer-links li {
    margin: 0;
  }

  /* The links stay easy to hit though the type is small. */
  .footer-links a {
    display: inline-block;
    padding-block: 0.15rem;
  }
</style>
