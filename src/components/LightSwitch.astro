---
/**
 * The light switch at the end of the navigation: a candle stub in a jam jar, hung by its
 * wire from a bent nail, drawn in the footer ledge's doodle hand. A spider lives on a
 * thread beside it. By day the candle is out and the spider dozes up in the vines; by
 * torchlight the candle burns, the jar glows, and the spider has let itself down to warm
 * its legs.
 *
 * The state comes from the theme alone (the head script in BaseLayout sets it before first
 * paint), so the drawing is right on the first frame and nothing moves on load. Changing the
 * light is a small event: src/scripts/theme-toggle.ts sets data-turn on a click, and the CSS
 * plays it. The wick catches, the flame grows and the spider comes down; or the flame is
 * blown flat, soot puffs out of the jar and the spider shoots back up its thread. Under
 * reduced motion (base.css stops all animation) the states change without any of that.
 */
---

<button
  id="nav-theme-toggle"
  class="light-switch"
  aria-label="Candlelight"
  aria-pressed="false"
  title="Light the candle"
  type="button"
>
  <span class="switch-stage" aria-hidden="true">
    <span class="switch-layer glow">
      <svg class="glow-flicker" viewBox="0 0 28 44">
        <defs>
          <radialGradient id="light-switch-glow">
            <stop class="glow-core" offset="0"></stop>
            <stop class="glow-edge" offset="1"></stop>
          </radialGradient>
        </defs>
        <circle cx="13" cy="28" r="16" fill="url(#light-switch-glow)"></circle>
      </svg>
    </span>

    <svg class="switch-base" viewBox="0 0 28 44">
      <defs>
        <clipPath id="light-switch-silk">
          <rect x="18" y="-5" width="14" height="52"></rect>
        </clipPath>
      </defs>

      <!-- The nail, bent up at its tip, with a little rust shadow under it -->
      <path class="ink" d="M7.6 2.2v4"></path>
      <path class="ink" d="M7.8 4.2h7c1 0 1.5-.7 1.7-2"></path>
      <path class="hatch" d="M9 7l1.4-1.2M11.4 7l1.4-1.2"></path>

      <g class="jar">
        <!-- The wire bail, hooked over the nail and twisted round the jar's neck -->
        <path class="ink-thin wire" d="M13 4.6c-.9.5-1.2 1.3-.8 2"></path>
        <path
          class="ink wire"
          d="M12.4 6.4C9.2 9 6.8 12.4 6 17.6M12.6 6.4c3.2 2.6 6 6 7.4 11.2"
        ></path>

        <!-- The glass: paper by day, amber by torchlight -->
        <path
          class="glass"
          d="M6.6 19.6c-1.5 1-2.2 2.6-2.2 5v11.4c0 2.4 1.4 3.8 3.6 3.8h10c2.2 0 3.6-1.4 3.6-3.8V24.6c0-2.4-.7-4-2.2-5Z"
        ></path>
        <path
          class="glass-warm"
          d="M6.6 19.6c-1.5 1-2.2 2.6-2.2 5v11.4c0 2.4 1.4 3.8 3.6 3.8h10c2.2 0 3.6-1.4 3.6-3.8V24.6c0-2.4-.7-4-2.2-5Z"
        ></path>

        <!-- The candle stub, a drip down its side, and its wick -->
        <path class="wax" d="M10.4 39.6v-6.9c0-.9 5.2-.9 5.2 0v6.9Z"></path>
        <path class="ink" d="M10.4 39.6v-6.9c0-.9 5.2-.9 5.2 0v6.9"></path>
        <path class="ink-thin" d="M10.4 32.7c0 .9 5.2.9 5.2 0M15.6 33.4c.5 1 .4 2.1 0 2.8"></path>
        <path class="ink wick" d="M13 32.8c0-.9.4-1.4.1-2.4"></path>

        <path
          class="ink-thin spark"
          d="M11 29l-1.4-.9M15 29l1.4-.9M13 28v-1.6M11.5 31.4l-1.3.4"
        ></path>

        <!-- The jar: lip, screw thread, body, the wire round its neck, a highlight, shade -->
        <path class="ink" d="M5.4 17.4h15.2"></path>
        <path class="ink-thin" d="M6 18.8h14"></path>
        <path
          class="ink"
          d="M6.6 19.6c-1.5 1-2.2 2.6-2.2 5v11.4c0 2.4 1.4 3.8 3.6 3.8h10c2.2 0 3.6-1.4 3.6-3.8V24.6c0-2.4-.7-4-2.2-5"
        ></path>
        <path class="ink-thin wire" d="M5.2 18.2c5 1.5 10.6 1.5 15.6 0"></path>
        <path class="ink-thin shine" d="M18.6 23.4c.6 2.6.6 6 .2 9"></path>
        <path class="hatch" d="M5.4 35.6l1.6-1.6M5.6 38.4l2.6-2.6M8 39.4l1.6-1.6"></path>

        <!-- Soot when it is blown out -->
        <g class="soot">
          <path class="ink-thin wisp" d="M13 29.6c-1.2-1.6.8-2.6-.2-4.4s1-2.8 0-4.6"></path>
          <circle class="puff puff-1" cx="13" cy="20" r="2"></circle>
          <circle class="puff puff-2" cx="11.2" cy="16.4" r="2.6"></circle>
          <circle class="puff puff-3" cx="14" cy="12.8" r="3"></circle>
        </g>
      </g>

      <!-- The spider on its thread from the vines above -->
      <g clip-path="url(#light-switch-silk)">
        <g class="spider">
          <path class="ink-thin silk" d="M0 -1.6V-60"></path>
          <g class="legs">
            <path
              class="ink-thin leg"
              d="M-1.2-.8c-1.2-1.1-2.3-1.1-3.1-.2M-1.5.3c-1.4-.4-2.5-.1-3.3.9M-1.4 1.3c-1.2.5-2 1.2-2.4 2.3M-.9 2.2c-.6.8-.9 1.7-.8 2.7M1.2-.8c1.2-1.1 2.3-1.1 3.1-.2M1.5.3c1.4-.4 2.5-.1 3.3.9M1.4 1.3c1.2.5 2 1.2 2.4 2.3M.9 2.2c.6.8.9 1.7.8 2.7"
            ></path>
          </g>
          <circle class="ink-fill" cx="0" cy=".8" r="1.9"></circle>
          <circle class="ink-fill" cx="0" cy="-1.4" r="1.1"></circle>
          <circle class="eye" cx="-.4" cy="-1.6" r=".32"></circle>
          <circle class="eye" cx=".4" cy="-1.6" r=".32"></circle>
          <path class="ink-thin startle" d="M-3.4-3.4l-1.1-1.1M0-4.2v-1.6M3.4-3.4l1.1-1.1"></path>
        </g>
      </g>
    </svg>

    <!-- The flame sits in its own stacked svg layer so flame-dance runs on the compositor. -->
    <span class="switch-layer jar-flame-swing">
      <span class="switch-layer flame">
        <svg class="flame-dance" viewBox="0 0 28 44">
          <path
            class="flame-outer"
            d="M13 30.6c-2-.5-2.8-2.4-1.9-4.4.5-1.2 1.4-2.3 1.9-4.4.6 1.7 2 3.1 2.2 4.8.2 2-1 3.6-2.2 4Z"
          ></path>
          <path
            class="flame-core"
            d="M13 30c-.8-.4-1-1.3-.5-2.3.3-.6.5-1.1.5-1.9.4.9.9 1.6.9 2.4 0 .9-.4 1.6-.9 1.8Z"
          ></path>
        </svg>
      </span>
    </span>
  </span>
</button>

<style>
  /* --lit is 1 by torchlight, whether chosen, from the clock or from the system; the
     flame dances and its glow flickers only then. tokens.colors.css owns the rule for
     when the torch is lit, through its --by-day and --by-torch switches. */
  .light-switch {
    --lit: var(--by-day, 0) var(--by-torch, 1);
    --dance: var(--by-day, none) var(--by-torch, flame-dance 1.7s ease-in-out infinite);
    --flicker: var(--by-day, none) var(--by-torch, torch-flicker 5.3s linear infinite);

    display: inline-flex;
    align-items: center;
    justify-content: center;
    /* 44px to press, while the drawing takes only its own 1.4em in the row, so its gap
       matches the links'. */
    width: 44px;
    height: 44px;
    margin-inline: calc((1.4em - 44px) / 2);
    padding: 0;
    border: 0;
    border-radius: 6px;
    background: transparent;
    color: var(--color-ink-medium);
    font: inherit;
    cursor: pointer;
  }

  .light-switch:hover {
    color: var(--color-ink-dark);
  }

  .light-switch:focus-visible {
    outline: 2px solid var(--color-walnut);
    outline-offset: 2px;
  }

  /* The nail sits above the words' cap height and the jar hangs level with them. */
  .switch-stage {
    position: relative;
    display: block;
    width: 1.4em;
    height: 2.2em;
    margin-top: -0.3em;
    /* Kept out of the page's cross-fade, so the flame and the spider play crisply. */
    view-transition-name: light-switch;
  }

  .switch-stage svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .switch-layer {
    position: absolute;
    inset: 0;
    display: block;
    pointer-events: none;
  }

  .switch-base {
    position: relative;
    z-index: 1;
  }

  .glow {
    z-index: 0;
  }

  .jar-flame-swing {
    z-index: 2;
    transform-origin: 46.43% 10.45%;
  }

  /* One hand with the footer ledge */
  .ink {
    fill: none;
    stroke: currentcolor;
    stroke-width: 1.15;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .ink-thin {
    fill: none;
    stroke: currentcolor;
    stroke-width: 0.75;
    stroke-linecap: round;
    stroke-linejoin: round;
    opacity: 0.6;
  }

  .ink-fill {
    fill: currentcolor;
  }

  .hatch {
    fill: none;
    stroke: currentcolor;
    stroke-width: 0.7;
    stroke-linecap: round;
    opacity: 0.45;
  }

  .glass {
    fill: color-mix(in srgb, var(--color-parchment-light) 70%, transparent);
  }

  .glass-warm {
    fill: color-mix(in srgb, var(--color-ochre) 30%, transparent);
    opacity: var(--lit);
  }

  /* Tallow, a little yellow, and pale enough to read on either paper */
  .wax {
    fill: color-mix(in srgb, var(--color-tansy) 22%, var(--print-sheet));
  }

  .wire {
    stroke: color-mix(in srgb, var(--color-iron) 65%, currentcolor);
    opacity: 0.9;
  }

  .shine {
    stroke: var(--paper-sheet);
    opacity: 0.9;
  }

  /* The flame and its glow sit in their own stacked svg boxes so continuous dark-mode
     flicker runs strictly on the compositor with zero main-thread layout or paint. */
  .flame {
    transform-origin: 46.43% 69.55%;
    transform: scale(var(--lit));
  }

  .flame-dance {
    transform-origin: 46.43% 69.55%;
    will-change: transform;
    animation: var(--dance);
  }

  .glow-flicker {
    will-change: opacity;
    animation: var(--flicker);
  }

  .flame-outer {
    fill: var(--color-ochre);
  }

  .flame-core {
    fill: var(--color-tansy);
  }

  .glow {
    opacity: calc(var(--lit) * 0.85);
  }

  .glow-core {
    stop-color: var(--color-ochre);
  }

  .glow-edge {
    stop-color: var(--color-ochre);
    stop-opacity: 0;
  }

  .spark,
  .soot,
  .startle {
    opacity: 0;
  }

  .spark,
  .puff {
    transform-box: fill-box;
    transform-origin: center;
  }

  /* Soot: grey smoke rings in the same ink */
  .puff {
    fill: currentcolor;
    fill-opacity: 0.3;
    stroke: currentcolor;
    stroke-width: 0.6;
    stroke-opacity: 0.6;
  }

  /* The spider dozes up in the vines by day and warms itself beside the jar by night. */
  .spider {
    transform-box: view-box;
    transform: translate(25px, calc(7px + var(--lit) * 18px));
  }

  .legs {
    transform-box: view-box;
    transform-origin: 0 0;
    transform: scale(calc(0.6 + var(--lit) * 0.4));
  }

  .eye {
    fill: var(--color-parchment);
    opacity: var(--lit);
  }

  .silk {
    opacity: 0.4;
  }

  /* A nudge sets the jar swinging on its nail. */
  .jar {
    transform-box: view-box;
    transform-origin: 13px 4.6px;
  }

  .light-switch:hover .jar,
  .light-switch:hover .jar-flame-swing {
    animation: swing 1.1s ease-in-out;
  }

  /* Lighting: the wick sparks, the flame catches and grows, the glass warms, and the
     spider lets itself down to the warmth, bouncing on its thread. */
  .light-switch[data-turn='light'] .spark {
    animation: spark 0.4s ease-out;
  }

  .light-switch[data-turn='light'] .flame {
    animation: catch 0.75s cubic-bezier(0.3, 0.7, 0.4, 1) 0.15s backwards;
  }

  .light-switch[data-turn='light'] .glow,
  .light-switch[data-turn='light'] .glass-warm {
    animation: warm 0.9s ease-out 0.2s backwards;
  }

  .light-switch[data-turn='light'] .spider {
    animation: let-down 1.2s ease-in-out 0.5s backwards;
  }

  .light-switch[data-turn='light'] .legs {
    animation: stretch 0.6s ease-out 1.1s backwards;
  }

  /* Blowing out: the flame is pushed flat, soot puffs out of the jar, and the spider, who
     was not told, jumps and shoots back up its thread. */
  .light-switch[data-turn='out'] .flame {
    animation: blow-out 0.3s ease-in backwards;
  }

  .light-switch[data-turn='out'] .glow,
  .light-switch[data-turn='out'] .glass-warm {
    animation: cool 0.45s ease-in backwards;
  }

  .light-switch[data-turn='out'] .soot {
    animation: show 1.4s linear backwards;
  }

  .light-switch[data-turn='out'] .wisp {
    animation: wisp 1.2s ease-out 0.15s backwards;
  }

  .light-switch[data-turn='out'] .puff-1 {
    animation: puff 1s ease-out 0.2s backwards;
  }

  .light-switch[data-turn='out'] .puff-2 {
    animation: puff 1s ease-out 0.35s backwards;
  }

  .light-switch[data-turn='out'] .puff-3 {
    animation: puff 1s ease-out 0.5s backwards;
  }

  .light-switch[data-turn='out'] .spider {
    animation: startle 0.9s ease-out 0.1s backwards;
  }

  .light-switch[data-turn='out'] .startle {
    animation: show 0.5s steps(1) 0.1s backwards;
  }

  @keyframes flame-dance {
    0%,
    100% {
      transform: scale(1, 1) skewX(0deg);
    }
    30% {
      transform: scale(0.94, 1.06) skewX(-4deg);
    }
    60% {
      transform: scale(1.04, 0.95) skewX(3deg);
    }
  }

  @keyframes swing {
    0%,
    100% {
      transform: rotate(0);
    }
    20% {
      transform: rotate(5deg);
    }
    45% {
      transform: rotate(-3.5deg);
    }
    70% {
      transform: rotate(1.5deg);
    }
  }

  @keyframes spark {
    0% {
      opacity: 0;
      transform: scale(0.4);
    }
    30% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      transform: scale(1.4);
    }
  }

  @keyframes catch {
    0% {
      transform: scale(0.1, 0.15);
    }
    35% {
      transform: scale(0.5, 0.7);
    }
    70% {
      transform: scale(1.1, 1.25);
    }
    100% {
      transform: scale(1);
    }
  }

  @keyframes warm {
    from {
      opacity: 0;
    }
  }

  @keyframes let-down {
    0% {
      transform: translate(25px, 7px);
    }
    55% {
      transform: translate(25px, 28px);
    }
    75% {
      transform: translate(25px, 23.5px);
    }
    90% {
      transform: translate(25px, 25.8px);
    }
    100% {
      transform: translate(25px, 25px);
    }
  }

  @keyframes stretch {
    from {
      transform: scale(0.6);
    }
  }

  @keyframes blow-out {
    0% {
      transform: scale(1) skewX(0deg);
    }
    45% {
      transform: scale(0.8, 0.5) skewX(-35deg);
    }
    100% {
      transform: scale(0.2, 0) skewX(-45deg);
    }
  }

  @keyframes cool {
    from {
      opacity: 0.85;
    }
  }

  @keyframes show {
    from,
    to {
      opacity: 1;
    }
  }

  @keyframes wisp {
    0% {
      opacity: 0.8;
      transform: translate(0, 0);
    }
    100% {
      opacity: 0;
      transform: translate(-1px, -10px);
    }
  }

  @keyframes puff {
    0% {
      opacity: 0;
      transform: translate(0, 6px) scale(0.4);
    }
    25% {
      opacity: 0.9;
    }
    100% {
      opacity: 0;
      transform: translate(-3px, -8px) scale(1.5);
    }
  }

  @keyframes startle {
    0% {
      transform: translate(25px, 25px);
    }
    12% {
      transform: translate(25px, 22px);
    }
    22% {
      transform: translate(25px, 25px);
    }
    55% {
      transform: translate(25px, 5px);
    }
    75% {
      transform: translate(25px, 8px);
    }
    100% {
      transform: translate(25px, 7px);
    }
  }

  /* The smallest phones (320px): the closer gaps leave no room for a 44px-wide target
     beside "Research"; 24px (the WCAG minimum) keeps it clear of the link. */
  @media (max-width: 24rem) {
    .light-switch {
      width: 24px;
      margin-inline: calc((1.4em - 24px) / 2);
    }
  }
</style>

<style is:global>
  /* The page cross-fades into the new light; the switch shows its own change instead. */
  ::view-transition-old(light-switch) {
    display: none;
  }

  ::view-transition-new(light-switch) {
    animation: none;
  }
</style>
