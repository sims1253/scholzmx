---
/**
 * One mark on a card, drawn in the footer ledge's doodle hand: iron-gall strokes,
 * a little moss and tansy. Every mark is decoration and hidden from assistive tech.
 * StackedCard places it; src/lib/cardDressing.ts decides which one a card gets.
 *
 * The critters are drawn as a naturalist would note them down: a fine pen line, a wash
 * of colour beneath it, and a stipple where the fur or the wing is. At the size they sit
 * on a card the stipple reads as texture. What moves in each (a leg, a wing, the whole
 * body) is its own group, so the stylesheet can set it going (src/styles/stacked-card.css).
 */
import type { Mark } from '../lib/cardDressing';

interface Props {
  mark: Mark;
}

const { kind, home, turn, along, variant } = Astro.props.mark;
const style = `--mark-turn: ${turn}deg; --mark-along: ${along}%`;

// A tansy leaf, from the stalk (0, 0) along +x for `length`: a midrib with narrow lobes
// down both sides that sweep forward toward the tip, as on a fern. The leaf is longest a
// third of the way up, and narrows to its point.
function lobedLeaf(length: number, lobes: number) {
  const step = length / (lobes + 0.5);
  const top: string[] = [];
  for (let i = 0; i < lobes; i++) {
    const x = step * (i + 0.75);
    const reach = length * 0.3 * Math.sin(((i + 0.9) / (lobes + 0.6)) * Math.PI);
    // The sinus between two lobes is shallow, so the leaf holds together under its teeth.
    top.push(`L${x.toFixed(1)},${(-reach * 0.2).toFixed(1)}`);
    top.push(`L${(x + reach * 0.95).toFixed(1)},${(-reach).toFixed(1)}`);
  }
  top.push(`L${length.toFixed(1)},0`);
  const bottom = top
    .map((command) =>
      command.replace(/,(|-)([\d.]+)$/, (_, sign, y) => `,${sign === '-' ? '' : '-'}${y}`)
    )
    .reverse();
  return `M0,0${top.join('')}${bottom.join('')}Z`;
}
