---
/**
 * One mark on a card, drawn in the footer ledge's doodle hand: iron-gall strokes,
 * a little moss and tansy. Every mark is decoration and hidden from assistive tech.
 * StackedCard places it; src/lib/cardDressing.ts decides which one a card gets.
 */
import type { Mark } from '../lib/cardDressing';

interface Props {
  mark: Mark;
}

const { kind, home, turn, along, variant } = Astro.props.mark;
const style = `--mark-turn: ${turn}deg; --mark-along: ${along}%`;
---

<span
  class={`sc-mark sc-mark-${kind} sc-mark-${home}`}
  data-variant={variant}
  style={style}
  aria-hidden="true"
>
  {kind === 'ring' && <i class="ring-stain" />}
  {kind === 'blot' && <svg viewBox="0 0 40 40">
    <path
      class="fill"
      d="M17 9c4-4 10-1 10 4 4-2 9 2 7 7 4 2 2 8-2 8 0 5-6 7-9 3-3 4-10 2-9-3-5 0-7-6-3-8-4-3 0-9 4-7 0-2 1-4 2-4Z"
    />
    <path class="fill" d="M24 30c1 3 1 5 0 7-1-2-2-4 0-7Z" />
    <circle class="fill" cx="36" cy="8" r="1.6" />
    <circle class="fill" cx="6" cy="34" r="1.1" />
    <circle class="fill" cx="35" cy="35" r="0.9" />
    <circle class="fill" cx="8" cy="8" r="0.7" />
  </svg>}
  {kind === 'thumb' && <svg viewBox="0 0 30 38">
    {[3, 5.5, 8, 10.5, 13].map((rx, i) => (
      <ellipse
        class="thin"
        cx="15"
        cy="20"
        rx={rx}
        ry={rx * 1.3 + 1}
        stroke-dasharray={`${7 + i * 3} ${1.5 + (i % 2)}`}
        transform={`rotate(${i * 9 - 18} 15 20)`}
      />
    ))}
    <path class="thin" d="M13 19c1-2 3-2 4 0" />
  </svg>}
  {kind === 'stamp' && <svg viewBox="0 0 76 38">
    <circle class="ink" cx="56" cy="19" r="16" />
    <circle class="thin" cx="56" cy="19" r="12" />
    <circle class="thin" cx="56" cy="19" r="14" stroke-dasharray="1.6 2.4" />
    <path class="ink" d="M45 17h22M45 21h22" />
    <path class="thin" d="M48 13h4M54 13h6M50 26h5M57 26h5" />
    <path
      class="ink"
      d="M2 12c4-3 8 3 12 0s8 3 12 0 8 3 12 0M2 19c4-3 8 3 12 0s8 3 12 0 8 3 12 0M2 26c4-3 8 3 12 0s8 3 12 0 8 3 12 0"
    />
  </svg>}
  {kind === 'tansy' && <svg viewBox="0 0 44 52">
    <path class="moss" d="M8 50C14 38 20 28 24 16" />
    <path
      class="moss"
      d="M14 40c-4-1-8-4-9-8M17 33c-4 0-8-2-10-6M14 40c3-3 5-6 5-10M19 30c3-2 5-5 5-9"
    />
    <path class="moss thin" d="M7 34l2-1M8 29l2 0M17 37l1-2M21 27l1-2" />
    {[
      [24, 13],
      [30, 10],
      [28, 17],
      [34, 15],
      [21, 8],
      [27, 4],
    ].map(([cx, cy]) => <g>
      <circle class="flower" cx={cx} cy={cy} r="3.4" />
      <circle class="flower-eye" cx={cx} cy={cy} r="1.1" />
    </g>)}
    <rect class="tape" x="3" y="36" width="20" height="7" transform="rotate(-28 13 40)" />
  </svg>}
  {kind === 'pencil' && <svg viewBox="0 0 44 30">
    <path class="pencil" d="M10 16c0-3 3-4 5-2s0 6-4 6-7-4-6-8 6-7 10-5 6 7 3 11" />
    <path class="pencil" d="M24 17l4 6c3-8 7-14 13-19" />
    <path class="pencil thin" d="M25 18l3 4" />
  </svg>}
  {kind === 'mouse' && <svg viewBox="0 0 48 36">
    <path class="tail" d="M37 29c6 1 9-2 8-6-1-3-4-3-5-1" />
    <path class="fur" d="M15 24c0-7 6-12 13-12 6 0 10 5 10 11 0 5-4 8-9 8H19c-3 0-4-3-4-7Z" />
    <path class="fur" d="M17 21c-2-4-7-5-11-2l-4 4 5 2c4 1 8 0 10-4Z" />
    <circle class="ear" cx="16" cy="15" r="3.6" />
    <circle class="fill" cx="8.5" cy="20" r="0.9" />
    <circle class="fill" cx="2.3" cy="23" r="0.9" />
    <path class="thin" d="M3 22l-3-2M3 23.5l-3 1" />
    <path class="ink" d="M21 31l-1 3M30 31l1 3" />
    <path class="scrap" d="M7 27l5-2 2 4-5 1Z" />
    <path class="thin" d="M11 27c1 1 2 1 4 0" />
  </svg>}
  {kind === 'ants' && <svg viewBox="0 0 64 12">
    {[4, 22, 41].map((x, i) => <g transform={`translate(${x} 0)`}>
      <path class="thin" d="M2 9l-1 3M4 9l0 3M6 9l1 3M2 6l-1-3M4 6l0-3M6 6l1-3" />
      <circle class="fill" cx="1.6" cy="7.5" r="1.7" />
      <circle class="fill" cx="4.4" cy="7.5" r="1.1" />
      <ellipse class="fill" cx="8" cy="7.5" rx="2.3" ry="1.6" />
      <path class="thin" d="M10 6.5l2.5-2.5M10 8.5l2.5 2" />
      {i === 2 && <path class="crumb" d="M12 2l5-1 1 4-4 2Z" />}
    </g>)}
  </svg>}
  {kind === 'inchworm' && <svg viewBox="0 0 34 20">
    <path class="worm" d="M4 18c0-9 5-14 11-14s10 5 11 13" />
    <path class="rings" d="M4 18c0-9 5-14 11-14s10 5 11 13" />
    <circle class="fill" cx="27.5" cy="16.8" r="2.5" />
    <circle cx="28.4" cy="16.2" r="0.7" fill="var(--sc-sheet)" />
    <path class="thin" d="M28 14.5l1-3M29.5 15l3-2M3 19.5l-1.5 0.5M6 19.5l1.5 0.5" />
  </svg>}
  {kind === 'ladybird' && <svg viewBox="0 0 20 20">
    <path class="thin" d="M5 7L2 5M4 11H1M5 15l-3 2M15 7l3-2M16 11h3M15 15l3 2" />
    <circle class="fill" cx="10" cy="4.5" r="2.6" />
    <path class="ink" d="M8.5 2.5L7 0M11.5 2.5L13 0" />
    <ellipse class="shell" cx="10" cy="11.5" rx="5.6" ry="6.4" />
    <path class="ink" d="M10 5.5v12.4" />
    <circle class="fill" cx="7.5" cy="10" r="1.1" />
    <circle class="fill" cx="12.6" cy="12.6" r="1.1" />
    <circle class="fill" cx="7.8" cy="14.5" r="0.9" />
  </svg>}
</span>
