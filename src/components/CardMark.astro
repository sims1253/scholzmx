---
/**
 * One mark on a card, drawn in the footer ledge's doodle hand: iron-gall strokes,
 * a little moss and tansy. Every mark is decoration and hidden from assistive tech.
 * StackedCard places it; src/lib/cardDressing.ts decides which one a card gets.
 *
 * A critter that moves is drawn as layers: each part that moves on its own (the
 * creature, its feelers, its wings) is its own svg, stacked over the others. An svg is
 * a box the compositor can move by itself, where a shape inside one would repaint the
 * drawing on every frame. stacked-card.css holds the movements.
 */
import type { Mark } from '../lib/cardDressing';

interface Props {
  mark: Mark;
}

const { kind, home, turn, along, variant, wait } = Astro.props.mark;
const style = `--mark-turn: ${turn}deg; --mark-along: ${along}%; --mark-wait: ${wait}s`;

const n = (value: number) => Number(value.toFixed(1));

/** A feathery leaf: a midrib with pairs of leaflets that shorten towards the tip */
function fern(x: number, y: number, heading: number, length: number, pairs = 5): string {
  const rad = (deg: number) => (deg * Math.PI) / 180;
  const dx = Math.cos(rad(heading));
  const dy = Math.sin(rad(heading));
  let d = `M${n(x)} ${n(y)}l${n(dx * length)} ${n(dy * length)}`;
  for (let i = 1; i <= pairs; i++) {
    const t = i / (pairs + 0.6);
    const reach = length * 0.36 * (1 - 0.6 * t);
    for (const side of [-58, 58]) {
      const a = rad(heading + side);
      d += `M${n(x + dx * length * t)} ${n(y + dy * length * t)}l${n(Math.cos(a) * reach)} ${n(Math.sin(a) * reach)}`;
    }
  }
  return d;
}

/** Tansy heads as [cx, cy, r], back row first; each variant is another sprig */
const TANSY_HEADS: Record<1 | 2 | 3, [number, number, number][]> = {
  1: [
    [15.5, 13.5, 2.8],
    [21, 9.8, 3.1],
    [27.5, 8, 3.3],
    [34, 9.2, 3.1],
    [39.5, 12.8, 2.8],
    [19.5, 17, 2.7],
    [25.5, 15, 3.1],
    [32, 15.2, 3.1],
    [37, 18.6, 2.6],
  ],
  2: [
    [18, 12, 2.9],
    [24, 8.6, 3.2],
    [30.5, 8.4, 3.2],
    [36.5, 11.6, 2.9],
    [21.5, 16.2, 2.8],
    [28, 14.6, 3.2],
    [34, 17, 2.7],
  ],
  3: [
    [14, 15, 2.6],
    [18.5, 10.6, 3],
    [24.5, 7.6, 3.2],
    [31, 7, 3.3],
    [37, 9.4, 3],
    [41.5, 14, 2.6],
    [21, 16.4, 2.8],
    [27, 14, 3.2],
    [33.5, 14.4, 3.1],
    [38, 19, 2.5],
    [27.5, 20, 2.6],
  ],
};
const tansyHeads = TANSY_HEADS[variant];
// Every head stands on its own stalk; the stalks leave the stem at one fork.
const tansyStalks = tansyHeads
  .map(([x, y]) => `M26 29Q${n(26 + (x - 26) * 0.3)} ${n(y + 7)} ${x} ${y}`)
  .join('');
const tansyLeaves =
  fern(13.5, 49, -152, 12) + fern(18, 41.5, -6, 12.5) + fern(22, 34.5, -168, 9, 4);

/** Ladybird spots as [cx, cy, r] */
const SPOTS: Record<1 | 2 | 3, [number, number, number][]> = {
  1: [
    [10, 7.6, 1.1],
    [6.6, 10.4, 1.1],
    [13.4, 10.4, 1.1],
    [7.2, 14.6, 1],
    [12.8, 14.6, 1],
  ],
  2: [
    [7.6, 7.8, 0.7],
    [12.4, 7.8, 0.7],
    [5.9, 10.6, 0.7],
    [8.4, 11, 0.7],
    [11.6, 11, 0.7],
    [14.1, 10.6, 0.7],
    [6.6, 14, 0.7],
    [8.6, 15.6, 0.7],
    [11.4, 15.6, 0.7],
    [13.4, 14, 0.7],
  ],
  3: [
    [7.1, 10.6, 1.8],
    [12.9, 10.6, 1.8],
  ],
};
---

<span
  class={`sc-mark sc-mark-${kind} sc-mark-${home}`}
  data-variant={variant}
  style={style}
  aria-hidden="true"
>
  {kind === 'ring' && <i class="ring-stain" />}
  {kind === 'blot' && <svg viewBox="0 0 40 40">
    <path
      class="fill"
      d="M17 9c4-4 10-1 10 4 4-2 9 2 7 7 4 2 2 8-2 8 0 5-6 7-9 3-3 4-10 2-9-3-5 0-7-6-3-8-4-3 0-9 4-7 0-2 1-4 2-4Z"
    />
    <path class="fill" d="M24 30c1 3 1 5 0 7-1-2-2-4 0-7Z" />
    <circle class="fill" cx="36" cy="8" r="1.6" />
    <circle class="fill" cx="6" cy="34" r="1.1" />
    <circle class="fill" cx="35" cy="35" r="0.9" />
    <circle class="fill" cx="8" cy="8" r="0.7" />
  </svg>}
  {kind === 'thumb' && <svg viewBox="0 0 30 38">
    {[3, 5.5, 8, 10.5, 13].map((rx, i) => (
      <ellipse
        class="thin"
        cx="15"
        cy="20"
        rx={rx}
        ry={rx * 1.3 + 1}
        stroke-dasharray={`${7 + i * 3} ${1.5 + (i % 2)}`}
        transform={`rotate(${i * 9 - 18} 15 20)`}
      />
    ))}
    <path class="thin" d="M13 19c1-2 3-2 4 0" />
  </svg>}
  {kind === 'stamp' && <svg viewBox="0 0 76 38">
    <circle class="ink" cx="56" cy="19" r="16" />
    <circle class="thin" cx="56" cy="19" r="12" />
    <circle class="thin" cx="56" cy="19" r="14" stroke-dasharray="1.6 2.4" />
    <path class="ink" d="M45 17h22M45 21h22" />
    <path class="thin" d="M48 13h4M54 13h6M50 26h5M57 26h5" />
    <path
      class="ink"
      d="M2 12c4-3 8 3 12 0s8 3 12 0 8 3 12 0M2 19c4-3 8 3 12 0s8 3 12 0 8 3 12 0M2 26c4-3 8 3 12 0s8 3 12 0 8 3 12 0"
    />
  </svg>}
  {kind === 'tansy' && <svg viewBox="0 0 48 58">
    <path class="leaf" d={tansyLeaves} />
    <path class="stem" d="M9 57C12 47 19 39 26 29" />
    <path class="stalk" d={tansyStalks} />
    {tansyHeads.map(([cx, cy, r]) => <g>
      <circle class="flower" cx={cx} cy={cy} r={r} />
      <circle class="flower-eye" cx={cx} cy={n(cy + 0.2)} r={n(r * 0.48)} />
      <path
        class="flower-light"
        d={`M${n(cx - r * 0.55)} ${n(cy - r * 0.25)}a${n(r * 0.62)} ${n(r * 0.62)} 0 0 1 ${n(r * 0.75)} ${n(-r * 0.42)}`}
      />
    </g>)}
    <rect class="tape" x="1" y="43" width="22" height="7.5" transform="rotate(-34 12 47)" />
  </svg>}
  {kind === 'pencil' && <svg viewBox="0 0 44 30">
    {variant === 1 && (
      <>
        <path class="pencil" d="M10 16c0-3 3-4 5-2s0 6-4 6-7-4-6-8 6-7 10-5 6 7 3 11" />
        <path class="pencil" d="M24 17l4 6c3-8 7-14 13-19" />
        <path class="pencil thin" d="M25 18l3 4" />
      </>
    )}
    {variant === 2 && (
      <>
        <path class="pencil" d="M14 4l5 15L6 9.5h16L9 19Z" />
        <path class="pencil" d="M5 26c3-3 5 2 8 0s5-3 8-1 5 2 8 0 5-2 9-1" />
        <path class="pencil thin" d="M28 8l8-3M29 13l9 0" />
      </>
    )}
    {variant === 3 && (
      <>
        <path
          class="pencil"
          d="M14 13c-1-5 3-7 4-3 2-4 6-1 3 2 4 0 4 5 0 4 2 4-3 5-4 2-2 3-6 0-4-3-4 0-3-4 1-2Z"
        />
        <circle class="pencil thin" cx="16.5" cy="12.5" r="1.6" />
        <path class="pencil" d="M17 19c1 3 0 6-2 9M16 24c2-2 5-3 8-2-2 2-5 3-8 2Z" />
        <path class="pencil" d="M30 22l4 4c2-6 5-10 9-13" />
      </>
    )}
  </svg>}
  {kind === 'mouse' && <svg viewBox="0 0 56 36">
    <path class="tail" d="M44 31c5 2.6 10.5.2 9.5-5.5-.8-4.6-5.8-4.3-5 0" />
    <circle class="ear far" cx="14.8" cy="9.6" r="3.5" />
    <path
      class="fur"
      d="M2.5 21.5C5 17 10 13.5 16 12.5c3-3 10-5 16-4 9 1.5 15 9.5 13.5 18-.5 4-3.5 6.5-7.5 6.5H20c-3.5 0-6-2.5-6.5-5.5-3.5.5-7.5-1-9.5-3-1-1-1.5-2-1.5-3Z"
    />
    <path class="belly" d="M13.5 27.5c4 2.8 9 4.2 15 4.5l-2 1H20c-3.5 0-6-2.5-6.5-5.5Z" />
    <path class="thin" d="M30 33c-3.5-5.5-.5-12.5 7-13.5" />
    <path
      class="hatch"
      d="M26 12.5l2-1.8M31 12.2l2.2-1.5M36 14.2l2.2-1.2M40 18l2-.8M42.5 23l1.8-.3"
    />
    <path class="ink" d="M33.5 33c-3 .8-6.5.8-9.5 0M16 25.5c-2 .5-4 1.5-5.5 2.5" />
    <circle class="ear" cx="19" cy="10" r="4.5" />
    <path
      class="ear-in"
      d="M16.8 9.5c0-2 1.3-3.2 2.7-2.7 1.3.5 2 2.2 1.5 4-.5 1.5-1.7 2.2-2.8 1.7-.9-.4-1.4-1.6-1.4-3Z"
    />
    <circle class="eye" cx="9.6" cy="17.8" r="1.35" />
    <circle class="glint" cx="9.2" cy="17.3" r="0.45" />
    <circle class="nose" cx="2.8" cy="21.5" r="1.15" />
    <path class="thin" d="M5 21l-5.5-3M5 22.3l-6 .4M5.5 23.5l-4.5 3" />
    <path class="scrap" d="M5 27l5.5-2.2 2.2 4.5-5.7 2.2Z" />
    <path class="thin" d="M9.5 27.3c1.2.9 2.6.9 3.8 0" />
  </svg>}
  {kind === 'inchworm' && <span class="roam">
    <svg class="arch" viewBox="0 0 34 20">
      <path class="worm" d="M4 18c0-9 5-14 11-14s10 5 11 13" />
      <path class="rings" d="M4 18c0-9 5-14 11-14s10 5 11 13" />
      <path class="thin" d="M3 19.5l-1.5.5M6 19.5l1.5.5" />
    </svg>
    <svg class="head" viewBox="0 0 34 20">
      <circle class="fill" cx="27.5" cy="16.8" r="2.5" />
      <circle class="glint" cx="28.4" cy="16.2" r="0.7" />
      <path class="thin" d="M28 14.5l1-3M29.5 15l3-2" />
    </svg>
  </span>}
  {kind === 'ladybird' && <span class="roam">
    <svg viewBox="0 0 20 20">
      <path class="thin" d="M5 8L2 6M4.3 11.5H1M5 15l-3 2M15 8l3-2M15.7 11.5H19M15 15l3 2" />
      <circle class="dark" cx="10" cy="4.6" r="2.7" />
      <circle class="glint" cx="8.3" cy="4.2" r="0.65" />
      <circle class="glint" cx="11.7" cy="4.2" r="0.65" />
      <ellipse class="shell" cx="10" cy="11.5" rx="5.7" ry="6.4" />
      <path class="seam" d="M10 5.5v12.4" />
      {SPOTS[variant].map(([cx, cy, r]) => (
        <circle class="spot" cx={cx} cy={cy} r={r} />
      ))}
      <path class="shine" d="M6.2 9c.6-1.5 1.6-2.5 2.8-3" />
    </svg>
    <svg class="feel" viewBox="0 0 20 20">
      <path class="thin" d="M8.8 2.6C8.3 1.5 7.6.7 6.6.3M11.2 2.6c.5-1.1 1.2-1.9 2.2-2.3" />
    </svg>
  </span>}
  {kind === 'snail' && <span class="roam">
    <svg class="feel" viewBox="0 0 44 24">
      <path class="ink" d="M35 17c0-3 1.5-5.5 2.8-8.6M36.5 17.5c1.8-2 3.5-3.8 5.5-5" />
      <circle class="fill" cx="38" cy="8" r="1" />
      <circle class="fill" cx="42.3" cy="12.2" r="1" />
    </svg>
    <svg viewBox="0 0 44 24">
      <path
        class="flesh"
        d="M2 22.8c3-2 8-1.8 14-1.8h14c2.5 0 3.8-1.5 4.3-4.3.3-1.3 2.7-1.3 3.1 0 .9 4-1.8 6.5-6 6.5H6c-1.8 0-3.2 0-4-.4Z"
      />
      <path
        class="shell"
        d="M22 21.2c-8 0-12.5-5-11.5-10.5 1-6 8-8.5 13.5-5.2 4.5 3 5 9.5 1.2 13.2-1 1-2 2-3.2 2.5Z"
      />
      <path class="ink" d="M23.5 16.8c-4 2-8-1-7-5 1-3 4.2-3.2 5.3-1.2 1 1.2.2 3.2-1 3.2" />
      <path class="hatch" d="M12.5 14.5l2-1.8M14 18l2.8-1.8M24.5 8.5l1.5 1.5" />
    </svg>
  </span>}
  {kind === 'bee' && <span class="roam">
    <svg class="fan" viewBox="0 0 26 20">
      <path
        d="M13 8.5C8-1 0 1 1.5 5.5 3 8.5 9 9 13 8.5ZM13.5 8.5C15-1 22-1 21 3.5c-.6 3-4 4.5-7.5 5Z"
      />
    </svg>
    <svg class="wings" viewBox="0 0 26 20">
      <path d="M12.5 8.5C9.5 2 3.5 1 4 4.5c.5 3 5.5 4 8.5 4Z" />
      <path d="M13.5 8.5c0-5-3.5-8-4.5-5.5-.5 2.5 2 4.5 4.5 5.5Z" />
    </svg>
    <svg viewBox="0 0 26 20">
      <path class="thin" d="M7.5 16.5L6 19.5M11.5 17.3l-.2 2.5M16 16.5l1.5 3" />
      <ellipse class="fuzz" cx="10.5" cy="12.5" rx="7.2" ry="5" />
      <path class="band" d="M8 8.6c-1.1 2.6-1.1 5.2 0 7.8M13.2 8.4c-1.1 2.7-1.1 5.5 0 8.2" />
      <path class="tip" d="M4.7 9.8c-1.8 1.5-1.8 4 0 5.5" />
      <circle class="dark" cx="19.3" cy="13" r="3.1" />
      <circle class="glint" cx="20.4" cy="12.3" r="0.7" />
    </svg>
    <svg class="feel" viewBox="0 0 26 20">
      <path class="thin" d="M20.5 10.5c.5-1.5 1.5-2.6 3-3.3M21.8 11.2c1-.9 2.2-1.3 3.7-1.2" />
    </svg>
  </span>}
  {kind === 'beetle' && <span class="roam">
    <svg viewBox="0 0 28 16">
      <path class="ink" d="M7 12.5l-2.5 3M12 13l-.5 2.8M17.5 12.5l2.5 3M21.5 11.5l3 2.5" />
      <path class="dark" d="M17.5 5.5c3.5-.3 6.5 1.7 7.3 4.5.4 1.6-.3 2.8-1.8 2.8h-5.5Z" />
      <path
        class="shell"
        d="M2.5 11.5c0-5.5 4.5-9 9.5-9s8 3 8 8.5c0 1.2-.6 1.8-1.8 1.8H4.5c-1.2 0-2-.6-2-1.3Z"
      />
      <path class="shine" d="M6 7.5c1.5-2 3.8-3.1 6.3-3.1M5 10c.3-.6.6-1.1 1-1.6" />
      <path class="ridge" d="M9 12.3C8.6 9 10 5.6 13 3.6M14 12.3c-.3-2.8.6-5.5 2.7-7.3" />
      <circle class="glint" cx="22.6" cy="8.6" r="0.65" />
    </svg>
    <svg class="feel" viewBox="0 0 28 16">
      <path class="thin" d="M23.5 7.5c1.5-1 2.5-2.8 2.8-5M24.3 8.5c1.5-.2 2.9-1 4-2.5" />
    </svg>
  </span>}
  {kind === 'moth' && <span class="roam">
    <svg class="wings" viewBox="0 0 28 22">
      {['', 'matrix(-1 0 0 1 28 0)'].map((flip) => <g transform={flip || undefined}>
        <path class="wing hind" d="M13.2 11.5c-4-.8-8.2.6-8.7 3.8-.4 2.9 3.7 4.5 8.7.2Z" />
        <path class="wing" d="M13.2 7.5C9.5 3.8 3 2.8 1.3 5.7c-1.3 2.8 2.2 7 11.9 6.3Z" />
        <path class="vein" d="M12 9C8.5 6.5 5 5.5 2.5 6.3M12 10.5c-3-.5-6-.3-8.5.8" />
        <circle class="eye-spot" cx="6.5" cy="7.8" r="1.1" />
      </g>)}
    </svg>
    <svg viewBox="0 0 28 22">
      <ellipse class="fill" cx="14" cy="11.8" rx="1.7" ry="5.6" />
      <circle class="fill" cx="14" cy="5.6" r="1.7" />
      <path class="hatch" d="M12.8 10h2.4M12.7 12.5h2.6M12.9 15h2.2" />
    </svg>
    <svg class="feel" viewBox="0 0 28 22">
      <path class="thin" d="M13.4 4.4C12.2 2.5 10.5 1.3 8.3 1M14.6 4.4c1.2-1.9 2.9-3.1 5.1-3.4" />
    </svg>
  </span>}
</span>
