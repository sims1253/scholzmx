---
import '../styles/stacked-card.css';
import { createSeededRng } from '../scripts/seeded';
import { doodadCategories } from '../config/doodadConfig';
import { processDoodadCategories, extractDoodadsByKind } from '../lib/doodadProcessor';
import type { DoodadResults } from '../config/doodadConfig';
/**
 * StackedCard: a sheet of paper on a small stack, taped or pinned to the page.
 *
 * - `material` picks what the sheet is, one per shelf: writing paper (blog, notes),
 *   a library catalogue card (research), a workshop tag (projects) or a recipe card.
 *   All four share the stack, the shadow and the lift; each adds one printed detail.
 * - With `href`, the whole card is one link (its title); links in the body stay
 *   separately clickable above it.
 * - The `media` slot sits above the title. The `aside` slot holds a small print taped
 *   into the bottom corner beside the footer line, so it never narrows the title or
 *   the description.
 * - Doodad configuration: see `src/config/doodadConfig.ts`
 */
interface Props {
  seed: string;
  title?: string;
  subtitle?: string;
  href?: string;
  material?: 'paper' | 'index' | 'tag' | 'recipe';
  allowBookmark?: boolean;
  allowTape?: boolean;
  // Force the number of sheets (1–4). Omit to use weighted randomness.
  layers?: 1 | 2 | 3 | 4;
  tilt?: 'light' | 'med';
  class?: string;
  ornament?: boolean;
  layout?: 'stacked' | 'side';
  // Heading level for accessibility (defaults to h2 for proper document outline)
  headingLevel?: 2 | 3 | 4;
}

const {
  seed,
  title,
  subtitle,
  href,
  material = 'paper',
  allowBookmark = false, // A random ribbon reads as "pinned"; opt in where it means something
  allowTape = material !== 'tag', // A tag hangs from its string
  layers: layersProp,
  tilt = 'light',
  class: className,
  ornament = true,
  layout = 'stacked',
  headingLevel = 2,
} = Astro.props;

const HeadingTag = `h${headingLevel}` as const;

// Split RNG streams to prevent ripple changes when extending features
const layoutRng = createSeededRng(seed, 'stackedcard-v3:layout');
const doodadRng = createSeededRng(seed, 'stackedcard-v3:doodads');

// A small sideways shift keeps the hand-placed look; rows keep one baseline,
// so the vertical draw no longer moves the card (it stays to keep the stream stable).
const offx = Math.round(layoutRng.between(-8, 8) * 0.4);
layoutRng.between(-6, 6);
// Layer count weighting (1:15%, 2:45%, 3:30%, 4:10%)
const r = layoutRng.random();
const singleSheet = material === 'index' || material === 'tag';
const layerCount = layersProp ?? (singleSheet ? 1 : r < 0.15 ? 1 : r < 0.6 ? 2 : r < 0.9 ? 3 : 4);
const isSheet = layerCount === 1;
const rotA = (
  tilt === 'light' ? layoutRng.between(-1.6, 1.2) : layoutRng.between(-2.4, 2.0)
).toFixed(2);
const rotB = (
  tilt === 'light' ? layoutRng.between(-1.2, 1.6) : layoutRng.between(-2.0, 2.2)
).toFixed(2);
const rotC = (
  tilt === 'light' ? layoutRng.between(-1.0, 1.0) : layoutRng.between(-1.6, 1.6)
).toFixed(2);

const doodads: DoodadResults = processDoodadCategories(
  doodadCategories,
  isSheet,
  allowBookmark,
  allowTape,
  ornament,
  {
    random: doodadRng.random,
    pick: doodadRng.chance,
    map: doodadRng.between,
    betweenInt: doodadRng.betweenInt,
  }
);

const svgDoodles = extractDoodadsByKind(doodads, doodadCategories, 'svg');
const ringEffect = extractDoodadsByKind(doodads, doodadCategories, 'background').find(
  (d) => d.id === 'ringEffect'
);

const hasBookmark = !!doodads.bookmarkRibbon?.active;
const hasTape = !!doodads.tapeCorners?.active;
const bookmarkSide = doodads.bookmarkRibbon?.side || 'right';
const showTab = !!doodads.tab?.active;
const showStickerTR = !!doodads.stickerTR?.active;
const showStickerBL = !!doodads.stickerBL?.active;

const styleVars = {
  '--offx': `${offx}px`,
  '--rot-a': `${rotA}deg`,
  '--rot-b': `${rotB}deg`,
  '--rot-c': `${rotC}deg`,
  ...(ringEffect && {
    '--ring-scale': `${ringEffect.props.ringScale ?? 0.9}`,
    '--ring-alpha': `${ringEffect.props.ringAlpha ?? 0}`,
    '--ring-x': `${ringEffect.props.ringX ?? 90}%`,
    '--ring-y': `${ringEffect.props.ringY ?? 90}%`,
    '--ring-turn': `${ringEffect.props.rotation ?? 0}deg`,
    '--ring-src': `url(/grotto/coffee-ring-${ringEffect.props.variant ?? 1}.svg)`,
  }),
} satisfies Record<string, string>;

const styleInline = Object.entries(styleVars)
  .map(([k, v]) => `${k}: ${v}`)
  .join('; ');
---

<article
  class:list={['sc-card', className]}
  style={styleInline}
  data-material={material}
  data-ring={ringEffect ? 'active' : 'none'}
  data-layers={String(layerCount)}
  data-linked={href ? '' : undefined}
>
  {layerCount >= 3 && <i class="sc-layer-c" aria-hidden="true" />}
  {layerCount >= 4 && <i class="sc-layer-d" aria-hidden="true" />}
  {/* Doodles are pressed between the sheets: they peek out at an edge, never over text. */}
  {svgDoodles.map((doodle) => {
    const { definition, props } = doodle;
    const position = props.position ?? definition.positions?.[0] ?? 'bottomRight';
    const turn = `rotate(${props.rotation ?? 0}deg) scale(${props.scale ?? 1})`;
    const size = definition.defaultSize ?? '2rem';
    return (
      <i
        class={`sc-doodle ${position}`}
        style={`--doodle-src: url(${definition.src}); --doodle-size: ${size}; --doodle-turn: ${turn}`}
        aria-hidden="true"
      />
    );
  })}
  {hasBookmark && (
    <i class={`sc-bookmark ${bookmarkSide === 'left' ? 'left' : 'right'}`} aria-hidden="true" />
  )}
  {hasTape && (
    <>
      <i class="sc-tape left" aria-hidden="true" />
      <i class="sc-tape right" aria-hidden="true" />
    </>
  )}
  {showStickerTR && <i class="sc-sticker tr" aria-hidden="true" />}
  {showStickerBL && <i class="sc-sticker bl" aria-hidden="true" />}
  {showTab && <i class="sc-tab" aria-hidden="true" />}
  <div class="sc-face">
    <div class="sc-content">
      {layout === 'side' ? (
        <div class="sc-row">
          <div class="sc-col content">
            {title && <HeadingTag class="sc-title">
              {href ? <a href={href} class="sc-title-link">{title}</a> : title}
            </HeadingTag>}
            {subtitle && <p class="sc-subtitle">{subtitle}</p>}
            <slot />
          </div>
          {Astro.slots.has('media') && <div class="sc-col media">
            <slot name="media" />
          </div>}
        </div>
      ) : (
        <>
          <slot name="media" />
          {title && <HeadingTag class="sc-title">
            {href ? <a href={href} class="sc-title-link">{title}</a> : title}
          </HeadingTag>}
          {subtitle && <p class="sc-subtitle">{subtitle}</p>}
          <slot />
          <slot name="aside" />
        </>
      )}
    </div>
  </div>
</article>
