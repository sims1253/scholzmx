---
import '../styles/stacked-card.css';
import CardMark from './CardMark.astro';
import { dressCard, type Material } from '../lib/cardDressing';
/**
 * StackedCard: a sheet of paper lying on a desk, on a small stack or alone, held down
 * by tape, a pin, a clip or a staple, or by nothing at all.
 *
 * - `material` picks what the sheet is, one per shelf: writing paper (blog), a library
 *   catalogue card (research), a workshop tag (projects) or a recipe card.
 * - Everything else (tilt, where it lies, tint, ruling, edge, dog-ear, fastener and the
 *   one mark on it) comes from `seed` via src/lib/cardDressing.ts, so a card always
 *   looks the same and nothing moves on load.
 * - With `href`, the whole card is one link (its title); links in the body stay
 *   separately clickable above it.
 * - Slots: `media` above the title; `aside` for a small print taped into the bottom
 *   corner beside the footer line; `tab` for a divider tab standing up behind the card.
 */
interface Props {
  seed: string;
  title?: string;
  subtitle?: string;
  href?: string;
  material?: Material;
  // Force the number of sheets (1–4). Omit to let the seed choose.
  layers?: 1 | 2 | 3 | 4;
  // False leaves the card unmarked (no stains, no critters).
  marks?: boolean;
  class?: string;
  layout?: 'stacked' | 'side';
  // Heading level for accessibility (defaults to h2 for proper document outline)
  headingLevel?: 2 | 3 | 4;
}

const {
  seed,
  title,
  subtitle,
  href,
  material = 'paper',
  layers,
  marks = true,
  class: className,
  layout = 'stacked',
  headingLevel = 2,
} = Astro.props;

const HeadingTag = `h${headingLevel}` as const;

// A slot filled by a false expression still counts as present, so look at what it holds.
const aside = Astro.slots.has('aside') ? (await Astro.slots.render('aside')).trim() : '';
const dress = dressCard(seed, { material, layers, marks, cornerTaken: aside !== '' });
const { mark, fastener } = dress;
// Stains lie in the paper; flowers and critters sit on top of it and may overhang.
const inPaper = mark && ['ring', 'blot', 'thumb', 'stamp', 'pencil'].includes(mark.kind);

const spotStyle = `--place-x: ${dress.place.x}rem; --place-y: ${dress.place.y}rem; --short: ${dress.place.short}rem; --over: ${dress.place.over}`;
const cardStyle = `--rot-c: ${dress.tilt.face}deg; --rot-a: ${dress.tilt.a}deg; --rot-b: ${dress.tilt.b}deg`;
---

<div class="sc-spot" style={spotStyle}>
  <slot name="tab" />
  <article
    class:list={['sc-card', className]}
    style={cardStyle}
    data-material={material}
    data-layers={String(dress.layers)}
    data-tint={dress.tint}
    data-ruling={dress.ruling}
    data-edge={dress.edge}
    data-fold={dress.fold ?? undefined}
    data-mark={mark?.kind}
    data-zone={mark?.home === 'corner' ? '' : undefined}
    data-linked={href ? '' : undefined}
  >
    {dress.layers >= 3 && <i class="sc-layer-c" aria-hidden="true" />}
    {dress.layers >= 4 && <i class="sc-layer-d" aria-hidden="true" />}
    <div class="sc-face">
      <div class="sc-content">
        {layout === 'side' ? (
          <div class="sc-row">
            <div class="sc-col content">
              {title && <HeadingTag class="sc-title">
                {href ? <a href={href} class="sc-title-link">{title}</a> : title}
              </HeadingTag>}
              {subtitle && <p class="sc-subtitle">{subtitle}</p>}
              <slot />
            </div>
            {Astro.slots.has('media') && <div class="sc-col media">
              <slot name="media" />
            </div>}
          </div>
        ) : (
          <>
            <slot name="media" />
            {title && <HeadingTag class="sc-title">
              {href ? <a href={href} class="sc-title-link">{title}</a> : title}
            </HeadingTag>}
            {subtitle && <p class="sc-subtitle">{subtitle}</p>}
            <slot />
            {aside && <Fragment set:html={aside} />}
          </>
        )}
      </div>
      {mark && inPaper && <CardMark mark={mark} />}
    </div>
    {dress.fold && <i class={`sc-fold ${dress.fold}`} aria-hidden="true" />}
    {fastener.kind === 'tape' &&
      fastener.strips.map((strip) => (
        <i
          class={`sc-tape ${strip.spot}`}
          data-tone={strip.tone}
          data-tear={strip.tear}
          style={`--tape-turn: ${strip.turn}deg; --tape-len: ${strip.length}rem`}
          aria-hidden="true"
        />
      ))}
    {fastener.kind === 'pin' && <i class="sc-pin" aria-hidden="true" />}
    {fastener.kind === 'staple' && <i class="sc-staple" aria-hidden="true" />}
    {fastener.kind === 'clip' && <svg class="sc-clip" viewBox="0 0 14 40" aria-hidden="true">
      <path d="M4 26V6a3 3 0 0 1 6 0v26a5 5 0 0 1-10 0V9" />
    </svg>}
    {mark && !inPaper && <CardMark mark={mark} />}
  </article>
</div>
