---
import type { ImageMetadata } from 'astro';
import StackedCard from './StackedCard.astro';
import ImageFrame from './ImageFrame.astro';

interface CardItem {
  id: string;
  title: string;
  subtitle?: string;
  href?: string;
  writtenDate?: string;
  updatedDate?: string;
  /** Short footer annotation (e.g. servings & time on recipes), set in the same hand as dates. */
  meta?: string;
  tags?: string[];
  hero?:
    | {
        kind: 'url';
        src: string;
        scale?: number;
        posX?: number; // -1..1
        posY?: number; // -1..1
      }
    | {
        kind: 'asset';
        src: ImageMetadata;
        width?: number;
        height?: number;
        scale?: number;
        posX?: number;
        posY?: number;
      };
  year?: number;
  /** A divider tab (a year, an initial) that rises above the first card it covers. */
  tab?: string;
}

interface Props {
  items: CardItem[];
  class?: string;
  layers?: 1 | 2 | 3 | 4; // Allow forcing single-layer cards
  columns?: 1 | 'auto';
  itemMinWidth?: string;
  aspectRatio?: string; // Aspect ratio for strip images (e.g., "8/3", "3/2")
  // "thumb" tapes a small photo to the card's corner; "strip" runs it across the top
  media?: 'strip' | 'thumb';
  headingLevel?: 2 | 3 | 4; // Card title level, so cards nest under a section heading
  tagBase?: string; // Index page that filters by tag, e.g. "/recipes"
  material?: 'paper' | 'recipe'; // What the sheets are: writing paper, or recipe cards
}

const {
  items,
  class: className,
  layers,
  columns = 'auto',
  itemMinWidth,
  aspectRatio = '8/3',
  media = 'strip',
  headingLevel = 2,
  tagBase = '/blog',
  material = 'paper',
} = Astro.props;

// A print keeps its picture's own proportions, between 4:3 and 16:9, so a screenshot is not
// cut to a slice. The card keeps room in its corner for a 4:3 print (stacked-card.css), so
// a taller picture is cut to that. One the post zooms into or shifts is cut to 4:3 around
// that spot; so is a picture from a URL, whose proportions are not known.
function printRatio(hero: NonNullable<CardItem['hero']>): string {
  const cut = (hero.scale ?? 1) !== 1 || Boolean(hero.posX) || Boolean(hero.posY);
  if (cut || hero.kind === 'url') return '4/3';
  const ratio = Math.min(16 / 9, Math.max(4 / 3, hero.src.width / hero.src.height));
  return `${ratio.toFixed(3)}/1`;
}

// "2025-11-23" reads as "23 November 2025", the way the posts themselves give their dates.
// A tab heads the first card of each run of cards that share it. It is the run's
// heading one level above the card titles, so year jumps and the outline still work.
const TabTag = headingLevel === 4 ? 'h3' : 'h2';
const tabStarts = (index: number) => {
  const tab = items[index]?.tab;
  return tab !== undefined && tab !== items[index - 1]?.tab;
};

const inWords = (isoDay: string) =>
  new Date(`${isoDay}T00:00:00Z`).toLocaleDateString('en-GB', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
    timeZone: 'UTC',
  });
---

<div
  class:list={['nc-grid', className]}
  style={columns === 'auto' ? `--nc-min: ${itemMinWidth ?? '22rem'}` : undefined}
>
  {items.map((it, index) => <div
    class="nc-item"
    data-year={it.year}
    data-tags={it.tags?.join(',') || ''}
  >
    <StackedCard
      seed={`stack/${it.id}`}
      title={it.title}
      subtitle={it.subtitle}
      href={it.href}
      material={material}
      layers={layers}
      headingLevel={headingLevel}
    >
      {tabStarts(index) && <TabTag class="nc-tab" id={`tab-${it.tab}`} slot="tab">{it.tab}</TabTag>}
      {it.hero && <div
        class:list={['sc-media', { 'nc-thumb': media === 'thumb' }]}
        slot={media === 'thumb' ? 'aside' : 'media'}
      >
        <ImageFrame
          src={it.hero.kind === 'url' ? it.hero.src : it.hero.src}
          alt=""
          aspectRatio={media === 'thumb' ? printRatio(it.hero) : aspectRatio}
          style="simple"
          positionX={it.hero.posX !== undefined ? it.hero.posX * 100 : undefined}
          positionY={it.hero.posY !== undefined ? it.hero.posY * 100 : undefined}
          scale={it.hero.scale}
          width={media === 'thumb' ? 480 : 1200}
        />
      </div>}
      <div class="sc-meta">
        {it.writtenDate ? (
          <p class="sc-dates">
            <time datetime={it.writtenDate}>{inWords(it.writtenDate)}</time
            >{it.updatedDate && it.updatedDate !== it.writtenDate && (
              <>, tended <time datetime={it.updatedDate}>{inWords(it.updatedDate)}</time></>
            )}
          </p>
        ) : it.meta ? (
          <p class="sc-dates">{it.meta}</p>
        ) : null}
        <div class="sc-tags">
          {it.tags?.map((tag) => <a
            class="sc-chip"
            href={`${tagBase}?tag=${encodeURIComponent(tag)}`}
          >
            #{tag}
          </a>)}
        </div>
      </div>
    </StackedCard>
  </div>)}
</div>

<style>
  /* Auto columns fill rows of equal width, so a lone card keeps its size. */
  .nc-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, var(--nc-min, 100%)), 1fr));
    align-items: start;
    gap: var(--space-xl) var(--space-lg);
  }

  .nc-item {
    width: 100%;
    max-width: var(--card-max-width);
    margin: 0 auto;
    padding-inline: var(--space-xs);
  }

  /* On index pages the cards lie on the desk side by side, a row's sheets nearly one
     length (see .sc-desk). */
  :global(.index-page) .nc-grid {
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr));
    align-items: stretch;
    gap: var(--desk-row-gap) var(--desk-col-gap);
  }

  :global(.index-page) .nc-item {
    display: flex;
    flex-direction: column;
    max-width: none;
    margin-inline: 0;
    padding-inline: 0;
  }

  /* The first card of a year (or letter) leaves room for its divider tab: one line of
     the sheets, so the card still ends on a line with the others in its row. */
  :global(.index-page) .nc-item:has(.nc-tab) {
    padding-top: var(--sc-pitch);
  }

  /* A card-box divider: its tab stands up behind the first card of the year (or
     letter), between the strips of tape, and stays put when the card is lifted. */
  .nc-tab {
    position: absolute;
    bottom: 100%;
    left: 5.25rem;
    z-index: 0;
    margin: 0 0 -0.45rem;
    padding: 0.1rem 0.8rem 0.5rem;
    border: 1px solid var(--sc-edge);
    border-bottom: 0;
    border-radius: 3px 3px 0 0;
    background:
      var(--stock-grain) 0 0 / 256px 256px repeat,
      color-mix(in srgb, var(--sc-sheet-back) 70%, var(--color-sage));
    font-family: var(--font-heading);
    font-size: var(--text-md);
    font-weight: 400;
    line-height: 1.2;
    color: var(--color-moss);
    font-variant-numeric: oldstyle-nums;
    scroll-margin-top: 3rem;
  }
</style>
