---
export interface Props {
  variant?: 'vine' | 'simple' | 'botanical' | 'ornate' | 'sketch';
  width?: 'narrow' | 'medium' | 'wide' | 'full';
  className?: string;
}

const { variant = 'vine', width = 'medium', className = '' } = Astro.props;

const uniqueId = Math.random().toString(36).substring(7);

// Semantic color tokens via CSS variables.
// Applied as inline styles (not presentation attributes) because color-mix()
// and var() are not reliably parsed inside stroke/fill attributes.
const vineColor = 'var(--color-walnut)';
const leafColor = 'var(--color-accent-secondary)';
const flowerColor = 'var(--color-sage)';
const tansyColor = 'var(--color-decorative)';
const strokeWeight = 3;

// color-mix(in srgb, <base> <pct>%, transparent)
const mix = (base: string, pct: number) => `color-mix(in srgb, ${base} ${pct}%, transparent)`;
// Build an inline style string for a paint property (e.g. stroke, fill)
const paint = (prop: 'stroke' | 'fill', base: string, pct: number) => `${prop}: ${mix(base, pct)};`;
---

<div class={`hand-drawn-divider hand-drawn-divider--${width} ${className}`}>
  {
    variant === 'vine' && (
      <svg
        class="divider-svg"
        viewBox="0 0 800 64"
        preserveAspectRatio="xMidYMid meet"
        aria-hidden="true"
      >
        <defs>
          <filter id={`dividerTexture-${uniqueId}`} x="-40%" y="-40%" width="180%" height="180%">
            <feTurbulence baseFrequency="0.03" numOctaves="2" result="noise" seed="3" />
            <feDisplacementMap in="SourceGraphic" in2="noise" scale="1" />
          </filter>

          <filter id={`dividerShadow-${uniqueId}`} x="-40%" y="-40%" width="180%" height="180%">
            <feGaussianBlur in="SourceAlpha" stdDeviation="1" />
            <feOffset dx="1" dy="1" result="offset" />
            <feFlood flood-color={mix(vineColor, 20)} />
            <feComposite in2="offset" operator="in" />
            <feMerge>
              <feMergeNode />
              <feMergeNode in="SourceGraphic" />
            </feMerge>
          </filter>
        </defs>

        {/* Main vine line */}
        <path
          d="M80,32 Q200,20 400,36 T600,24 T720,32"
          style={paint('stroke', vineColor, 60)}
          stroke-width={strokeWeight}
          fill="none"
          filter={`url(#dividerTexture-${uniqueId})`}
        />

        {/* Decorative leaves */}
        <g style={paint('fill', leafColor, 40)} filter={`url(#dividerShadow-${uniqueId})`}>
          <ellipse cx="260" cy="32" rx="8" ry="4" transform="rotate(30 260 32)" />
          <ellipse
            cx="258"
            cy="34"
            rx="5"
            ry="2.5"
            transform="rotate(30 258 34)"
            style={paint('fill', vineColor, 30)}
          />
          <ellipse cx="520" cy="32" rx="7" ry="3.5" transform="rotate(-45 520 32)" />
          <ellipse
            cx="518"
            cy="34"
            rx="4"
            ry="2"
            transform="rotate(-45 518 34)"
            style={paint('fill', vineColor, 30)}
          />
        </g>

        {/* Small decorative dots */}
        <g style={paint('fill', flowerColor, 65)}>
          <circle cx="200" cy="32" r="2" />
          <circle cx="400" cy="32" r="1.5" />
          <circle cx="600" cy="32" r="1.8" />
        </g>
      </svg>
    )
  }

  {
    variant === 'simple' && (
      <svg
        class="divider-svg"
        viewBox="0 0 400 24"
        preserveAspectRatio="xMidYMid meet"
        aria-hidden="true"
      >
        <defs>
          <filter id={`simpleTexture-${uniqueId}`} x="0%" y="0%" width="100%" height="100%">
            <feTurbulence baseFrequency="0.05" numOctaves="1" result="noise" seed="5" />
            <feDisplacementMap in="SourceGraphic" in2="noise" scale="0.8" />
          </filter>
        </defs>

        <path
          d="M50,12 Q100,8 150,12 T250,12 T350,12"
          style={paint('stroke', vineColor, 50)}
          stroke-width="2"
          fill="none"
          filter={`url(#simpleTexture-${uniqueId})`}
        />

        {/* Central botanical element */}
        <g transform="translate(200, 12)">
          <circle r="3" style={paint('fill', leafColor, 40)} />
          <ellipse rx="8" ry="2" transform="rotate(45)" style={paint('fill', vineColor, 30)} />
          <ellipse rx="8" ry="2" transform="rotate(-45)" style={paint('fill', vineColor, 30)} />
        </g>
      </svg>
    )
  }

  {
    variant === 'botanical' && (
      <svg
        class="divider-svg"
        viewBox="0 0 500 60"
        preserveAspectRatio="xMidYMid meet"
        aria-hidden="true"
      >
        <defs>
          <filter id={`botanicalBlur-${uniqueId}`} x="-40%" y="-40%" width="180%" height="180%">
            <feGaussianBlur stdDeviation="0.5" />
          </filter>
        </defs>

        {/* Central stem (reference spine) */}
        <path
          d="M100,30 Q175,25 250,35 T400,30"
          style={paint('stroke', vineColor, 50)}
          stroke-width="3"
          fill="none"
          filter={`url(#botanicalBlur-${uniqueId})`}
          stroke-linecap="round"
        />

        {/* Leaves and flowers aligned to spine tangents */}
        <g
          style={`${paint('fill', leafColor, 42)} ${paint('stroke', vineColor, 25)}`}
          stroke-width="0.6"
        >
          {/* Left leaf pair: tangent ~ -10deg at x≈150 */}
          <g transform="translate(150,30) rotate(-10)">
            <ellipse rx="10" ry="4.2" />
            <ellipse rx="8" ry="3.2" transform="rotate(16) translate(6, -1)" />
          </g>

          {/* Central rosette centered on spine apex (x≈250,y≈35) */}
          <g transform="translate(250,35)">
            <circle r="6" style={paint('fill', flowerColor, 50)} />
            <circle r="4" style={paint('fill', vineColor, 28)} />
            <circle r="2" style={paint('fill', tansyColor, 55)} />
          </g>

          {/* Right leaf pair: tangent ~ +10deg at x≈350 */}
          <g transform="translate(350,30) rotate(10)">
            <ellipse rx="10" ry="4.2" />
            <ellipse rx="8" ry="3.2" transform="rotate(-16) translate(-6, -1)" />
          </g>
        </g>

        {/* Decorative tendrils arcing from spine with mirrored curvature */}
        <g
          style={paint('stroke', leafColor, 30)}
          stroke-width="1.3"
          fill="none"
          stroke-linecap="round"
        >
          {/* Left tendril: start on spine near x≈170, gentle C matching slope */}
          <path d="M170,33 C176,36 182,35 188,33" />
          {/* Right tendril: start on spine near x≈312, mirror curve */}
          <path d="M312,33 C318,36 324,35 330,33" />
        </g>
      </svg>
    )
  }

  {
    variant === 'ornate' && (
      <svg
        class="divider-svg"
        viewBox="0 0 700 80"
        preserveAspectRatio="xMidYMid meet"
        aria-hidden="true"
      >
        <defs>
          <filter id={`ornateTexture-${uniqueId}`} x="0%" y="0%" width="100%" height="100%">
            <feTurbulence baseFrequency="0.025" numOctaves="2" result="noise" seed="9" />
            <feDisplacementMap in="SourceGraphic" in2="noise" scale="1.2" />
          </filter>
          <filter id={`ornateShadow-${uniqueId}`} x="0%" y="0%" width="120%" height="120%">
            <feGaussianBlur in="SourceAlpha" stdDeviation="2" />
            <feOffset dx="2" dy="2" result="offset" />
            <feFlood flood-color={mix(vineColor, 15)} />
            <feComposite in2="offset" operator="in" />
            <feMerge>
              <feMergeNode />
              <feMergeNode in="SourceGraphic" />
            </feMerge>
          </filter>
        </defs>

        {/* Central decorative element */}
        <g transform="translate(350, 40)" filter={`url(#ornateShadow-${uniqueId})`}>
          {/* Ornate center */}
          <circle r="12" style={paint('fill', leafColor, 30)} />
          <circle r="8" style={paint('fill', flowerColor, 40)} />
          <circle r="4" style={paint('fill', tansyColor, 60)} />

          {/* Radiating elements */}
          <g style={paint('stroke', vineColor, 50)} stroke-width="2" fill="none">
            <path d="M-20,0 Q-15,-5 -10,0 Q-5,5 0,0" />
            <path d="M20,0 Q15,-5 10,0 Q5,5 0,0" />
            <path d="M0,-20 Q-5,-15 0,-10 Q5,-5 0,0" />
            <path d="M0,20 Q-5,15 0,10 Q5,5 0,0" />
          </g>
        </g>

        {/* Extending vine patterns */}
        <path
          d="M100,40 Q200,30 300,45 Q350,40 400,45 Q500,30 600,40"
          style={paint('stroke', vineColor, 40)}
          stroke-width="2.5"
          fill="none"
          filter={`url(#ornateTexture-${uniqueId})`}
        />

        {/* Side decorations */}
        <g style={paint('fill', leafColor, 30)} filter={`url(#ornateTexture-${uniqueId})`}>
          <ellipse cx="150" cy="40" rx="8" ry="4" transform="rotate(20 150 40)" />
          <ellipse cx="550" cy="40" rx="8" ry="4" transform="rotate(-20 550 40)" />
        </g>
      </svg>
    )
  }

  {
    variant === 'sketch' && (
      <svg
        class="divider-svg"
        viewBox="0 0 400 30"
        preserveAspectRatio="xMidYMid meet"
        aria-hidden="true"
      >
        <defs>
          <filter id={`sketchTexture-${uniqueId}`} x="0%" y="0%" width="100%" height="100%">
            <feTurbulence baseFrequency="0.08" numOctaves="2" result="noise" seed="11" />
            <feDisplacementMap in="SourceGraphic" in2="noise" scale="0.5" />
          </filter>
        </defs>

        {/* Sketchy hand-drawn line */}
        <path
          d="M20,15 Q60,12 100,15 T180,14 T260,16 T340,14 T380,15"
          style={paint('stroke', vineColor, 45)}
          stroke-width="1.5"
          fill="none"
          filter={`url(#sketchTexture-${uniqueId})`}
          stroke-linecap="round"
        />

        {/* Tiny sketch elements - like pencil marks */}
        <g style={paint('fill', leafColor, 35)}>
          <circle cx="60" cy="15" r="1" />
          <circle cx="140" cy="14" r="0.8" />
          <circle cx="220" cy="15" r="1.2" />
          <circle cx="300" cy="14" r="0.9" />
        </g>

        {/* Small cross-hatch marks */}
        <g style={paint('stroke', vineColor, 25)} stroke-width="0.5">
          <line x1="80" y1="12" x2="85" y2="17" />
          <line x1="160" y1="11" x2="165" y2="16" />
          <line x1="240" y1="12" x2="245" y2="17" />
          <line x1="320" y1="13" x2="325" y2="18" />
        </g>
      </svg>
    )
  }
</div>

<style>
  .hand-drawn-divider {
    display: flex;
    justify-content: center;
    align-items: center;
    margin: var(--spacing-component) auto;
  }

  .hand-drawn-divider--narrow {
    max-width: 200px;
  }
  .hand-drawn-divider--medium {
    max-width: 300px;
  }
  .hand-drawn-divider--wide {
    max-width: 400px;
  }
  .hand-drawn-divider--full {
    max-width: 100%;
  }

  .divider-svg {
    width: 100%;
    height: auto;
    filter: drop-shadow(0 1px 2px color-mix(in srgb, var(--color-walnut) 10%, transparent));
  }

  /* Responsive sizing */
  @media (max-width: 768px) {
    .hand-drawn-divider {
      margin: var(--space-md) auto;
    }

    .hand-drawn-divider--wide,
    .hand-drawn-divider--medium {
      max-width: 200px;
    }
  }

  @media (max-width: 480px) {
    .hand-drawn-divider--narrow,
    .hand-drawn-divider--medium,
    .hand-drawn-divider--wide {
      max-width: 160px;
    }
  }
</style>
