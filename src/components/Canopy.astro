---
/**
 * The vine canopy over the top of every page.
 *
 * By day it casts leaf shadows that move in the wind; after dark the same leaves stand
 * in front of a torch. The leaves are SVG masks drawn by scripts/draw-canopy.mjs, so
 * their colour comes from --canopy-shade and the effect costs a few cached images and
 * compositor-only animation: transform, translate and rotate, nothing that repaints.
 */
---

<div class="canopy" aria-hidden="true" data-canopy>
  <div class="canopy-sun">
    <div class="canopy-leaves canopy-leaves--high"></div>
    <div class="canopy-leaves canopy-leaves--low"></div>
  </div>
</div>

<script>
  // Nothing sways while the canopy is scrolled out of view.
  const canopy = document.querySelector('[data-canopy]');
  if (canopy && 'IntersectionObserver' in window) {
    new IntersectionObserver(([entry]) => {
      canopy.toggleAttribute('data-still', !entry?.isIntersecting);
    }).observe(canopy);
  }
</script>

<style>
  /* Two masked leaf layers, each carrying the canopy's fade in its own mask. A masked
     parent around them would be composited again on every frame of the sway. */
  .canopy {
    --canopy-fade: linear-gradient(to bottom, #000 28%, transparent 96%);

    position: absolute;
    inset: 0 0 auto;
    height: min(120vh, 64rem);
    overflow: hidden;
    pointer-events: none;
    z-index: 0;
  }

  /* Torchlight sits behind the leaves and flickers on its own. */
  .canopy::before {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--canopy-glow);
    mask-image: var(--canopy-fade);
    animation: var(--canopy-flicker);
  }

  /* By day the shadows lean away from the sun and lengthen as it sinks. */
  .canopy-sun {
    position: absolute;
    inset: 0;
    transform: skewX(var(--canopy-skew)) scaleY(var(--canopy-stretch));
    transform-origin: 50% 0;
  }

  /* One slow sway per layer, eased like a branch: no stacked gusts, whose sudden
     changes of direction read as stutter on layers this large. Leaves hang from the top,
     so the rotation moves the lower ones furthest. */
  .canopy-leaves {
    position: absolute;
    inset: -3rem -7rem 0;
    background-color: var(--canopy-shade);
    mask:
      url('/grotto/canopy-high.svg') top center / cover no-repeat,
      var(--canopy-fade);
    mask-composite: intersect;
    transform-origin: 50% 0;
    will-change: transform;
  }

  /* The high canopy is far away and heavy: it moves least. */
  .canopy-leaves--high {
    animation: sway-high 19s cubic-bezier(0.37, 0, 0.63, 1) infinite alternate;
  }

  /* The crisp, near leaves are sharpest at noon and soften as the light gets low. */
  .canopy-leaves--low {
    mask:
      url('/grotto/canopy-low.svg') top center / cover no-repeat,
      var(--canopy-fade);
    mask-composite: intersect;
    opacity: var(--canopy-crisp);
    animation: sway-low 11s cubic-bezier(0.37, 0, 0.63, 1) -3s infinite alternate;
  }

  /* Out of view, the wind stops (see the script above). */
  .canopy[data-still]::before,
  .canopy[data-still] .canopy-leaves {
    animation-play-state: paused;
  }

  @keyframes sway-high {
    from {
      transform: translate3d(-0.4%, 0, 0) rotate(-0.25deg);
    }

    to {
      transform: translate3d(0.4%, 0.2%, 0) rotate(0.25deg);
    }
  }

  @keyframes sway-low {
    from {
      transform: translate3d(0.6%, 0, 0) rotate(0.6deg);
    }

    to {
      transform: translate3d(-0.6%, 0.4%, 0) rotate(-0.6deg);
    }
  }

  @media (max-width: 768px) {
    .canopy {
      height: min(95vh, 40rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .canopy::before,
    .canopy-leaves {
      animation: none;
    }
  }

  @media print {
    .canopy {
      display: none;
    }
  }
</style>
