---
/**
 * The vine canopy over the top of every page.
 *
 * By day it casts leaf shadows that move in the wind; after dark the same leaves stand
 * in front of a torch. Three parallax depth planes (far, mid and near) drift out of
 * phase on their own hinges so the light shifts organically while keeping the canopy to
 * three compositor layers.
 *
 * scripts/draw-canopy.mjs draws the three planes (with their downward fade baked in)
 * into one SVG mask and writes where each hangs to src/data/canopy.json, so the colour
 * comes from --canopy-shade and each plane runs a single pure-transform animation on the
 * compositor thread.
 */
import canopy from '../data/canopy.json';

type Plane = (typeof canopy.depths)[number];

const hinge = ({ box, hinge, period, phase }: Plane) =>
  `left:${box[0]}%;top:${box[1]}%;width:${box[2]}%;height:${box[3]}%;` +
  `transform-origin:${hinge[0]}% ${hinge[1]}%;--t:${period}s;--p:${phase}`;

// Single mask selecting the plane's strip of the packed sprite (fade is baked into the SVG).
const shade = ({ sheet }: Plane) =>
  `mask-size:${sheet[0]}% ${sheet[1]}%;mask-position:${sheet[2]}% ${sheet[3]}%`;
---

<div class="canopy" aria-hidden="true" data-canopy>
  <div class="canopy-stage" style={`aspect-ratio:${canopy.stage.ratio}`}>
    {canopy.depths.map((plane) => <div class={`canopy-depth canopy-depth--${plane.name}`}>
      <div class="canopy-hinge" style={hinge(plane)}>
        <i class="canopy-shade" style={shade(plane)} />
      </div>
    </div>)}
  </div>
</div>

<script>
  // Nothing sways while the canopy is scrolled out of view or the tab is hidden.
  // Cache the canopy height on resize so scroll checks never force a layout read.
  const canopy = document.querySelector<HTMLElement>('[data-canopy]');
  if (canopy) {
    let still = false;
    let canopyHeight = canopy.offsetHeight;
    const sync = () => {
      const gone = document.hidden || window.scrollY > canopyHeight;
      if (gone !== still) canopy.toggleAttribute('data-still', (still = gone));
    };
    const measure = () => {
      canopyHeight = canopy.offsetHeight;
      sync();
    };
    addEventListener('scroll', sync, { passive: true });
    addEventListener('resize', measure, { passive: true });
    document.addEventListener('visibilitychange', sync);
    sync();
  }
</script>

<style>
  .canopy {
    --canopy-fade: linear-gradient(to bottom, #000 28%, transparent 96%);

    position: absolute;
    inset: 0 0 auto;
    /* Never longer than the page, or a short page scrolls into empty shade. */
    height: min(120vh, 64rem, 100%);
    overflow: hidden;
    contain: strict;
    pointer-events: none;
    z-index: 0;
  }

  /* Torchlight sits behind the leaves and flickers on its own. */
  .canopy::before {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--canopy-glow);
    mask-image: var(--canopy-fade);
    animation: var(--canopy-flicker);
  }

  /* The stage is as tall as the canopy and far wider, centred on the page: the leaves
     keep their size whatever the screen's shape, and a wider screen sees more of them.
     It starts above the page so that the vines come in from out of sight. By torchlight
     the whole stage shifts a little about the torch's corner as the flame moves. */
  .canopy-stage {
    position: absolute;
    inset: -3rem auto 0 50%;
    translate: -50% 0;
    transform-origin: calc(50% + 40vw) 3rem;
    animation: var(--canopy-quiver);
  }

  .canopy-depth {
    position: absolute;
    inset: 0;
  }

  /* Each depth plane runs one pure-transform animation combining sway, lateral drift and
     a periodic gust, with its own pivot, period and phase so the three planes drift
     against one another organically on the compositor thread. */
  .canopy-hinge {
    --ease: cubic-bezier(0.37, 0, 0.63, 1);
    --time: calc(var(--t) * var(--canopy-air));

    position: absolute;
    will-change: transform;
    animation: canopy-breeze-near calc(var(--time) * 2) var(--ease)
      calc(var(--time) * var(--p) * -1.8) infinite;
  }

  .canopy-depth--far > .canopy-hinge {
    animation-name: canopy-breeze-far;
    animation-duration: calc(var(--time) * 1.15);
  }

  .canopy-depth--mid > .canopy-hinge {
    animation-name: canopy-breeze-mid;
    animation-duration: calc(var(--time) * 1.5);
  }

  .canopy-shade {
    position: absolute;
    inset: 0;
    background-color: var(--canopy-shade);
    mask-image: url('/grotto/canopy.svg');
    mask-repeat: no-repeat;
  }

  /* Out of view, the wind stops (see the script above). */
  .canopy[data-still]::before,
  .canopy[data-still] .canopy-stage,
  .canopy[data-still] .canopy-hinge {
    animation-play-state: paused;
  }

  /* One compound breeze cycle per depth plane: gentle counter-sway, drift, then a
     downwind gust with a soft rebound and return to rest. */
  @keyframes canopy-breeze-far {
    0%,
    100% {
      transform: translate3d(-0.5rem, 0, 0) rotate(0.35deg);
    }

    24% {
      transform: translate3d(0.3rem, 0.1rem, 0) rotate(-0.4deg);
    }

    48% {
      transform: translate3d(0.55rem, 0.16rem, 0) rotate(0.2deg);
    }

    68% {
      transform: translate3d(-0.25rem, 0.08rem, 0) rotate(-0.65deg);
    }

    84% {
      transform: translate3d(-0.4rem, 0.02rem, 0) rotate(-0.2deg);
    }
  }

  @keyframes canopy-breeze-mid {
    0%,
    100% {
      transform: translate3d(-0.65rem, 0, 0) rotate(0.6deg);
    }

    24% {
      transform: translate3d(0.4rem, 0.14rem, 0) rotate(-0.75deg);
    }

    46% {
      transform: translate3d(0.7rem, 0.2rem, 0) rotate(0.3deg);
    }

    66% {
      transform: translate3d(-0.3rem, 0.1rem, 0) rotate(-1.15deg);
    }

    82% {
      transform: translate3d(-0.45rem, 0.04rem, 0) rotate(-0.35deg);
    }
  }

  @keyframes canopy-breeze-near {
    0%,
    100% {
      transform: translate3d(-0.8rem, 0, 0) rotate(0.85deg);
    }

    22% {
      transform: translate3d(0.5rem, 0.18rem, 0) rotate(-1deg);
    }

    44% {
      transform: translate3d(0.85rem, 0.24rem, 0) rotate(0.45deg);
    }

    64% {
      transform: translate3d(-0.4rem, 0.12rem, 0) rotate(-1.6deg);
    }

    78% {
      transform: translate3d(-0.2rem, 0.06rem, 0) rotate(-0.45deg);
    }

    88% {
      transform: translate3d(-0.55rem, 0.03rem, 0) rotate(-0.85deg);
    }
  }

  /* The far planes fall a little behind as the page scrolls, as things further away do.
     The browser ties this to the scroll position itself; where it cannot, nothing lags. */
  @supports (animation-timeline: scroll()) {
    @media (prefers-reduced-motion: no-preference) {
      .canopy-depth--far,
      .canopy-depth--mid {
        animation: canopy-lag-far linear both;
        animation-timeline: scroll(root);
        animation-range: 0 100vh;
      }

      .canopy-depth--mid {
        animation-name: canopy-lag-mid;
      }
    }
  }

  @keyframes canopy-lag-far {
    to {
      transform: translate3d(0, 2.4rem, 0);
    }
  }

  @keyframes canopy-lag-mid {
    to {
      transform: translate3d(0, 1.1rem, 0);
    }
  }

  @media (max-width: 768px) {
    .canopy {
      height: min(95vh, 40rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .canopy::before,
    .canopy-stage,
    .canopy-hinge {
      animation: none;
    }
  }

  @media print {
    .canopy {
      display: none;
    }
  }
</style>
