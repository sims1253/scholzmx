---
import Search from './Search.astro';

interface Jump {
  href: string;
  label: string;
}

interface Props {
  /** Pagefind filter value set on the indexed pages (data-pagefind-filter="type:…"). */
  type: 'blog' | 'recipe';
  /** Plural noun for messages, e.g. "posts". */
  noun: string;
  /** How many entries the index lists; a short one is read, not searched. */
  count: number;
  tags: string[];
  jumps?: Jump[];
}

const { type, noun, count, tags, jumps } = Astro.props;

// A dozen entries fit in a glance. Beyond that the index opens with a search field and a
// tag browser; below it, one quiet line: the year jumps and a search folded away. Tag
// links on the cards filter either way.
const long = count > 12;
const showJumps = jumps && jumps.length > 1;
const indexPath = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<div class:list={['index-finder', { 'is-short': !long }]} data-index-finder data-noun={noun}>
  <details class="finder-search" open={long || undefined}>
    <summary>Search {noun}</summary>
    <div role="search">
      <Search
        id={`${type}-search`}
        className="pagefind-ui"
        uiOptions={{
          showImages: false,
          debounceTimeoutMs: 100,
          pageSize: 5,
          excerptLength: 22,
          showResultsCount: true,
          showEmptyFilters: false,
          filters: { type },
          translations: {
            placeholder: `Search ${noun}`,
            clear_search: 'Clear',
            load_more: 'Show more results',
            search_label: `Search ${noun}`,
            filters_label: 'Filters',
            zero_results: 'Nothing here mentions [SEARCH_TERM].',
            many_results: '[COUNT] matches for [SEARCH_TERM]',
            one_result: 'One match for [SEARCH_TERM]',
            alt_search: 'Nothing for [SEARCH_TERM]. Showing [DIFFERENT_TERM] instead.',
            search_suggestion: 'Try a broader word.',
          },
        }}
      />
    </div>
  </details>

  {(showJumps || (long && tags.length > 0)) && <div class="finder-row">
    {showJumps && <nav class="finder-jumps" aria-label="Jump to year">
      {jumps.map((jump) => <a href={jump.href}>{jump.label}</a>)}
    </nav>}

    {long && tags.length > 0 && <details class="finder-tags">
      <summary>Browse by tag</summary>
      <ul>
        {tags.map((tag) => <li>
          <button type="button" data-filter-tag={tag} aria-pressed="false">
            {tag}
          </button>
        </li>)}
      </ul>
    </details>}
  </div>}

  <p class="finder-filter">
    <span class="finder-status" data-filter-status aria-live="polite"></span>
    <a class="finder-clear" href={indexPath}>Show all {noun}</a>
  </p>
</div>

<script>
  import '../scripts/index-finder';
</script>
