---
// Import shared quotes data to avoid duplication between server and client
import { personalQuotes } from '../data/quotes.js';

// Get random quote for initial display
const getRandomQuote = () => personalQuotes[Math.floor(Math.random() * personalQuotes.length)];
const initialQuote = getRandomQuote();
// A long quote sets a size smaller, so it still fits under the portrait on a laptop's screen.
const LONG_QUOTE = 120;
const isLong = initialQuote!.text.length > LONG_QUOTE;
// A name stays on one line: "— Michael McGough," and "Joel Quartuccio", never a surname alone.
const NAMES = /(?<!,) /g;

// Tansy heads in the frame's two corners: [x, y, open]. Two are open; the rest open one
// per new quote, first in the upper corner, then in the lower.
const upperHeads = [
  [9, 9, true],
  [19, 5, false],
  [5, 19, false],
] as const;
const lowerHeads = [
  [51, 51, true],
  [41, 55, false],
  [55, 41, false],
  [47, 44, false],
] as const;
---

<figure class="quote-of-the-day">
  {/* The frame: a vine climbs out of each corner along the edges. The stems stretch with
      the quote; the corners, with their leaves and tansy, keep their shape. */}
  <svg class="quote-vine" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
    <path d="M7 1.5C28 3.5 47-.5 70 2.5" />
    <path d="M1.5 7C3.5 32-.5 60 2 84 2.5 95 8 98.5 16 98" />
    <path class="thin" d="M3 12C5 38 1 62 4 88" />
    <path d="M30 98.5C52 96.5 72 101 93 98.5" />
    <path d="M98.5 93C96.5 74 100.5 58 98 40" />
  </svg>
  <svg class="quote-leaf quote-leaf--top" viewBox="0 0 20 12" aria-hidden="true">
    <path class="leaf" d="M1 9C6 1 14 0 19 3 14 10 7 11 1 9Z" />
    <path class="vein" d="M1 9C7 6 12 4 17 3.5" />
  </svg>
  <svg class="quote-leaf quote-leaf--side" viewBox="0 0 20 12" aria-hidden="true">
    <path class="leaf" d="M1 9C6 1 14 0 19 3 14 10 7 11 1 9Z" />
    <path class="vein" d="M1 9C7 6 12 4 17 3.5" />
  </svg>
  <svg class="quote-corner quote-corner--upper" viewBox="0 0 60 60" aria-hidden="true">
    <path
      class="stem"
      d="M14 60C12 42 12 26 16 17 25 13 41 13 60 15M16 17 9 9M16 17 19 5M16 17 5 19"
    />
    <path class="leaf" d="M15 34C7 33 2 28 1 21 8 22 13 27 15 34Z" />
    <path class="leaf" d="M34 14C34 7 39 2 46 1 45 8 40 12 34 14Z" />
    <path class="vein" d="M15 34C10 30 6 26 2 22M34 14C37 10 41 5 45 2" />
    {upperHeads.map(([cx, cy, open]) => (
      <circle class:list={['tansy-head', { open }]} cx={cx} cy={cy} r="3.8" />
    ))}
  </svg>
  <svg class="quote-corner quote-corner--lower" viewBox="0 0 60 60" aria-hidden="true">
    <path
      class="stem"
      d="M46 0C48 18 48 34 44 43 35 47 19 47 0 45M44 43 51 51M44 43 41 55M44 43 55 41M44 43 47 44"
    />
    <path class="leaf" d="M45 26C53 27 58 32 59 39 52 38 47 33 45 26Z" />
    <path class="leaf" d="M26 46C26 53 21 58 14 59 15 52 20 48 26 46Z" />
    <path class="leaf" d="M47 12C52 8 57 9 59 12 55 16 51 15 47 12Z" />
    <path class="vein" d="M45 26C50 30 54 34 58 38M26 46C23 50 19 55 15 58" />
    {lowerHeads.map(([cx, cy, open]) => (
      <circle class:list={['tansy-head', { open }]} cx={cx} cy={cy} r="3.8" />
    ))}
  </svg>
  <!-- A bee comes to whichever flower has just opened. -->
  <svg class="quote-bee" viewBox="-12 -10 24 20" aria-hidden="true">
    <path class="bee-wing bee-wing-l" d="M-1-3c-4-6-10-5-9-1 1 3 6 3 9 1Z"></path>
    <path class="bee-wing bee-wing-r" d="M1-3c4-6 10-5 9-1-1 3-6 3-9 1Z"></path>
    <path class="bee-body" d="M-6 0c0-3 3-5 6-5s6 2 6 5-3 5-6 5-6-2-6-5Z"></path>
    <path class="bee-stripe" d="M-2-4.5v9M2-4.5v9"></path>
    <circle class="bee-head" cx="7" cy="-0.5" r="2"></circle>
    <path class="bee-line" d="M8-2c1-1 2-2 3-2M8.5-1.5c1 0 2 0 3 .5"></path>
  </svg>
  <div
    class="quote-container"
    id="quote-container"
    aria-live="polite"
    aria-label="Quote of the day"
  >
    <button
      class="quote-interactive-wrapper"
      type="button"
      aria-labelledby="quote-text quote-author"
      aria-description="Activate to display another quote."
      id="quote-wrapper-button"
    >
      <blockquote class="daily-quote">
        <p
          class:list={['quote-text', { 'is-long': isLong }]}
          id="quote-text"
          data-long={LONG_QUOTE}
        >
          {initialQuote!.text}
        </p>
        <footer class="quote-attribution">
          <cite class="quote-author" id="quote-author" data-names={NAMES.source}
            >{`— ${initialQuote!.author}`.replace(NAMES, '\u00a0')}</cite
          >
        </footer>
      </blockquote>
    </button>
  </div>
</figure>

<script>
  // Import shared quotes data to ensure consistency with server-side rendering
  import { personalQuotes } from '../data/quotes.js';

  function getRandomQuote() {
    return personalQuotes[Math.floor(Math.random() * personalQuotes.length)];
  }

  function updateQuote() {
    const newQuote = getRandomQuote();
    const quoteText = document.getElementById('quote-text');
    const quoteAuthor = document.getElementById('quote-author');
    const container = document.getElementById('quote-container');

    if (quoteText && quoteAuthor && container) {
      container.classList.add('is-turning');

      setTimeout(() => {
        quoteText.textContent = newQuote!.text;
        quoteText.classList.toggle(
          'is-long',
          newQuote!.text.length > Number(quoteText.dataset.long)
        );
        quoteAuthor.textContent = `— ${newQuote!.author}`.replace(
          new RegExp(quoteAuthor.dataset.names ?? '$^', 'g'),
          '\u00a0'
        );
        container.classList.remove('is-turning');

        // Create accessible announcement for screen readers
        const announcement = `New quote: ${newQuote!.text} by ${newQuote!.author}`;

        // Update the aria-label for immediate announcement
        container.setAttribute('aria-label', `Quote of the day: ${announcement}`);

        // Reset aria-label after announcement
        setTimeout(() => {
          container.setAttribute('aria-label', 'Quote of the day');
        }, 3000);
      }, 200);
    }
  }

  // Every quote read opens one more tansy flower in the frame.
  function bloom(): Element | null {
    const head = document.querySelector('.quote-of-the-day .tansy-head:not(.open)');
    head?.classList.add('open');
    return head;
  }

  // A bee flies in to the flower that has just opened (or any open one), sits, and leaves.
  function visit(head: Element | null) {
    const figure = document.querySelector<HTMLElement>('.quote-of-the-day');
    const bee = figure?.querySelector<HTMLElement>('.quote-bee');
    const open = figure?.querySelectorAll('.tansy-head.open') ?? [];
    const target = head ?? open[Math.floor(Math.random() * open.length)];
    if (!figure || !bee || !target) return;
    const box = figure.getBoundingClientRect();
    const flower = target.getBoundingClientRect();
    bee.style.setProperty('--bee-x', `${flower.left + flower.width / 2 - box.left}px`);
    bee.style.setProperty('--bee-y', `${flower.top + flower.height / 2 - box.top - 3}px`);
    bee.classList.remove('is-visiting');
    // Flush styles between removing and adding the class, so the flight starts over.
    void bee.getBoundingClientRect();
    bee.classList.add('is-visiting');
    // Without motion the bee just sits on the flower, so see it off by hand.
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
      setTimeout(() => bee.classList.remove('is-visiting'), 3500);
    }
  }

  document.getElementById('quote-wrapper-button')?.addEventListener('click', () => {
    updateQuote();
    visit(bloom());
  });
</script>

<style>
  /* A slip of the wall's own paper, framed by a vine that climbs out of two corners. The
     frame sits in the padding, so it adds no more height than the padding itself. */
  .quote-of-the-day {
    position: relative;
    max-width: 22rem;
    margin: 0;
    padding: 0.75rem 0.9rem 0.85rem 1rem;
  }

  .quote-vine {
    position: absolute;
    inset: 0.3rem;
    width: calc(100% - 0.6rem);
    height: calc(100% - 0.6rem);
    overflow: visible;
    pointer-events: none;
  }

  .quote-vine path {
    fill: none;
    stroke: var(--color-moss);
    stroke-width: 1.2;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
  }

  .quote-vine .thin {
    stroke-width: 0.7;
    opacity: 0.7;
  }

  .quote-corner,
  .quote-leaf {
    position: absolute;
    overflow: visible;
    pointer-events: none;
  }

  .quote-corner {
    width: 3.1rem;
    height: 3.1rem;
  }

  .quote-corner--upper {
    top: -0.45rem;
    left: -0.45rem;
  }

  .quote-corner--lower {
    right: -0.45rem;
    bottom: -0.45rem;
  }

  .quote-leaf {
    width: 1.05rem;
    height: 0.65rem;
  }

  /* At the ends of the stems: one along the top, one up the right side */
  .quote-leaf--top {
    top: 0;
    left: 70%;
    transform: rotate(-8deg);
  }

  .quote-leaf--side {
    top: calc(0.3rem + 40% - 1rem);
    right: -0.15rem;
    transform: rotate(-80deg);
  }

  .stem,
  .vein {
    fill: none;
    stroke: var(--color-moss);
    stroke-linecap: round;
  }

  .stem {
    stroke-width: 1.3;
  }

  .vein {
    stroke-width: 0.6;
    opacity: 0.8;
  }

  .leaf {
    fill: color-mix(in srgb, var(--color-moss) 50%, transparent);
    stroke: var(--color-moss);
    stroke-width: 0.6;
  }

  .quote-leaf .vein {
    stroke-width: 0.8;
  }

  /* Tansy: a closed bud is a small green button; an open head is a yellow one. */
  .tansy-head {
    fill: var(--color-moss);
    stroke: transparent;
    stroke-width: 1;
    transform: scale(0.45);
    transform-box: fill-box;
    transform-origin: center;
    transition:
      transform 0.6s cubic-bezier(0.22, 1, 0.36, 1),
      fill 0.6s ease;
  }

  .tansy-head.open {
    fill: var(--color-tansy);
    stroke: color-mix(in srgb, var(--color-ochre) 70%, var(--color-ink-dark));
    transform: scale(1);
  }

  /* A reader's hand on the quote: the open heads lift a little toward it. */
  .quote-of-the-day:has(.quote-interactive-wrapper:is(:hover, :focus-visible)) .tansy-head.open {
    transform: scale(1.15);
  }

  .quote-container {
    transition:
      opacity 0.2s ease,
      transform 0.2s ease;
  }

  .quote-container.is-turning {
    opacity: 0.4;
    transform: translateY(4px);
  }

  .quote-interactive-wrapper {
    display: block;
    width: 100%;
    background: none;
    border: none;
    padding: 0.15rem 0.2rem;
    margin: 0;
    cursor: pointer;
    text-align: start;
    font: inherit;
    color: inherit;
    border-radius: var(--border-radius);
  }

  .quote-interactive-wrapper:hover .quote-text {
    color: var(--color-text-primary);
  }

  .quote-interactive-wrapper:focus-visible {
    outline: 2px solid var(--color-walnut);
    outline-offset: 2px;
  }

  .daily-quote {
    margin: 0;
    padding: 0;
    border: none;
    background: none;
  }

  /* Override global blockquote quotation mark */
  .daily-quote::before {
    display: none;
  }

  .quote-text {
    margin: 0;
    font-family: var(--font-body-personal);
    font-size: max(16px, 0.86rem);
    font-style: italic;
    line-height: 1.4;
    color: var(--color-text-secondary);
    white-space: pre-line;
    text-wrap: balance;
    hyphens: manual;
  }

  .quote-text.is-long {
    font-size: max(15px, 0.76rem);
    line-height: 1.3;
  }

  .quote-attribution {
    margin: 0.3em 0 0;
  }

  /* A block of its own, so its lines are led by its own size and not by the quote's. */
  .quote-author {
    display: block;
    font-family: var(--font-body-personal);
    font-size: max(15px, var(--text-xs));
    font-style: normal;
    line-height: 1.35;
    color: var(--color-text-muted);
    text-wrap: balance;
    overflow-wrap: anywhere;
  }

  /* The bee: drawn in the same hand as the footer's ledge, parked off-page until a visit */
  .quote-bee {
    position: absolute;
    top: 0;
    left: 0;
    width: 24px;
    height: 20px;
    margin: -10px 0 0 -12px;
    overflow: visible;
    color: var(--color-ink-medium);
    opacity: 0;
    pointer-events: none;
    transform: translate(var(--bee-x, 0px), var(--bee-y, 0px));
  }

  .bee-body {
    fill: var(--color-tansy);
    stroke: currentcolor;
    stroke-width: 0.9;
  }

  .bee-stripe,
  .bee-line {
    fill: none;
    stroke: currentcolor;
    stroke-width: 0.9;
    stroke-linecap: round;
  }

  .bee-head {
    fill: currentcolor;
  }

  .bee-wing {
    fill: color-mix(in srgb, var(--color-parchment) 60%, transparent);
    stroke: currentcolor;
    stroke-width: 0.8;
    transform-box: fill-box;
    transform-origin: bottom center;
  }

  .bee-wing-l {
    transform-origin: bottom right;
  }

  .bee-wing-r {
    transform-origin: bottom left;
  }

  .quote-bee.is-visiting {
    animation: bee-visit 5.5s cubic-bezier(0.4, 0, 0.4, 1) both;
  }

  .quote-bee.is-visiting .bee-wing {
    animation: bee-flap 0.12s linear 28 alternate;
  }

  @keyframes bee-visit {
    0% {
      transform: translate(calc(var(--bee-x) + 140px), calc(var(--bee-y) - 70px)) rotate(-20deg);
      opacity: 0;
    }
    8% {
      opacity: 1;
    }
    30% {
      transform: translate(calc(var(--bee-x) + 40px), calc(var(--bee-y) - 36px)) rotate(12deg);
    }
    48% {
      transform: translate(calc(var(--bee-x) + 6px), calc(var(--bee-y) - 10px)) rotate(-6deg);
    }
    58%,
    82% {
      transform: translate(var(--bee-x), var(--bee-y)) rotate(0deg);
      opacity: 1;
    }
    90% {
      transform: translate(calc(var(--bee-x) + 24px), calc(var(--bee-y) - 30px)) rotate(10deg);
    }
    100% {
      transform: translate(calc(var(--bee-x) + 160px), calc(var(--bee-y) - 100px)) rotate(-15deg);
      opacity: 0;
    }
  }

  @keyframes bee-flap {
    from {
      transform: scaleY(1);
    }
    to {
      transform: scaleY(0.25);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tansy-head,
    .quote-container {
      transition: none;
    }

    /* The bee simply sits on the flower for a moment (base.css stops all animation;
       the script takes the class away again). */
    .quote-bee.is-visiting {
      opacity: 1;
    }
  }
</style>
