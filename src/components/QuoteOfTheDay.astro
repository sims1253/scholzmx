---
// Import shared quotes data to avoid duplication between server and client
import { personalQuotes } from '../data/quotes.js';

// Get random quote for initial display
const getRandomQuote = () => personalQuotes[Math.floor(Math.random() * personalQuotes.length)];
const initialQuote = getRandomQuote();

// Flower heads on the sprig; the first two are open, the rest bloom one per new quote.
const heads = [
  [30, 12, true],
  [21, 19, true],
  [39, 20, false],
  [14, 29, false],
  [45, 31, false],
  [26, 27, false],
  [35, 36, false],
] as const;
---

<figure class="quote-of-the-day">
  <svg class="quote-sprig" viewBox="0 0 60 84" aria-hidden="true">
    <path
      class="sprig-stem"
      d="M30 83C29 66 31 52 30 40M30 40 30 12M30 40 21 19M30 40 39 20M30 44 14 29M31 47 45 31M30 34 26 27M31 42 35 36"
    ></path>
    <path class="sprig-leaf" d="M30 66c-7-2-13-7-15-14 6 1 12 5 15 14Z"></path>
    <path class="sprig-leaf" d="M30 58c7-3 12-9 13-16-6 2-11 7-13 16Z"></path>
    {heads.map(([cx, cy, open]) => (
      <circle class:list={['sprig-head', { open }]} cx={cx} cy={cy} r="4.2" />
    ))}
  </svg>
  <div
    class="quote-container"
    id="quote-container"
    aria-live="polite"
    aria-label="Quote of the day"
  >
    <button
      class="quote-interactive-wrapper"
      type="button"
      aria-labelledby="quote-text quote-author"
      aria-description="Activate to display another quote."
      id="quote-wrapper-button"
    >
      <blockquote class="daily-quote">
        <p class="quote-text" id="quote-text">{initialQuote!.text}</p>
        <footer class="quote-attribution">
          <cite class="quote-author" id="quote-author">— {initialQuote!.author}</cite>
        </footer>
      </blockquote>
    </button>
  </div>
</figure>

<script>
  // Import shared quotes data to ensure consistency with server-side rendering
  import { personalQuotes } from '../data/quotes.js';

  function getRandomQuote() {
    return personalQuotes[Math.floor(Math.random() * personalQuotes.length)];
  }

  function updateQuote() {
    const newQuote = getRandomQuote();
    const quoteText = document.getElementById('quote-text');
    const quoteAuthor = document.getElementById('quote-author');
    const container = document.getElementById('quote-container');

    if (quoteText && quoteAuthor && container) {
      container.classList.add('is-turning');

      setTimeout(() => {
        quoteText.textContent = newQuote!.text;
        quoteAuthor.textContent = `— ${newQuote!.author}`;
        container.classList.remove('is-turning');

        // Create accessible announcement for screen readers
        const announcement = `New quote: ${newQuote!.text} by ${newQuote!.author}`;

        // Update the aria-label for immediate announcement
        container.setAttribute('aria-label', `Quote of the day: ${announcement}`);

        // Reset aria-label after announcement
        setTimeout(() => {
          container.setAttribute('aria-label', 'Quote of the day');
        }, 3000);
      }, 200);
    }
  }

  // Every quote read opens one more tansy flower on the sprig.
  function bloom() {
    document.querySelector('.quote-sprig .sprig-head:not(.open)')?.classList.add('open');
  }

  document.getElementById('quote-wrapper-button')?.addEventListener('click', () => {
    updateQuote();
    bloom();
  });
</script>

<style>
  .quote-of-the-day {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr);
    align-items: end;
    gap: var(--space-sm);
    max-width: 30rem;
    margin: 0 auto var(--space-xl);
  }

  .quote-sprig {
    width: 3rem;
    height: auto;
    overflow: visible;
  }

  .sprig-stem {
    fill: none;
    stroke: var(--color-moss);
    stroke-width: 1.3;
    stroke-linecap: round;
  }

  .sprig-leaf {
    fill: color-mix(in srgb, var(--color-moss) 55%, transparent);
  }

  .sprig-head {
    fill: var(--color-moss);
    stroke: transparent;
    stroke-width: 1;
    transform: scale(0.38);
    transform-box: fill-box;
    transform-origin: center;
    transition:
      transform 0.6s cubic-bezier(0.34, 1.56, 0.64, 1),
      fill 0.6s ease;
  }

  .sprig-head.open {
    fill: var(--color-tansy);
    stroke: color-mix(in srgb, var(--color-ochre) 70%, var(--color-ink-dark));
    transform: scale(1);
  }

  .quote-container {
    transition:
      opacity 0.2s ease,
      transform 0.2s ease;
  }

  .quote-container.is-turning {
    opacity: 0.4;
    transform: translateY(4px);
  }

  .quote-interactive-wrapper {
    display: block;
    width: 100%;
    background: none;
    border: none;
    padding: var(--space-xs) var(--space-sm);
    margin: 0;
    cursor: pointer;
    text-align: start;
    font: inherit;
    color: inherit;
    border-radius: var(--border-radius);
  }

  .quote-interactive-wrapper:hover .quote-text {
    color: var(--color-text-primary);
  }

  .quote-interactive-wrapper:focus-visible {
    outline: 2px solid var(--color-walnut);
    outline-offset: 2px;
  }

  .daily-quote {
    margin: 0;
    padding: 0;
    border: none;
    background: none;
  }

  /* Override global blockquote quotation mark */
  .daily-quote::before {
    display: none;
  }

  .quote-text {
    margin: 0;
    font-family: var(--font-body-personal);
    font-size: var(--text-lg);
    font-style: italic;
    line-height: 1.4;
    color: var(--color-text-secondary);
    white-space: pre-line;
    text-wrap: balance;
    hyphens: manual;
  }

  .quote-attribution {
    margin: 0.35em 0 0;
  }

  .quote-author {
    font-family: var(--font-body-personal);
    font-size: var(--text-sm);
    font-style: normal;
    color: var(--color-text-muted);
  }

  @media (prefers-reduced-motion: reduce) {
    .sprig-head,
    .quote-container {
      transition: none;
    }
  }
</style>
