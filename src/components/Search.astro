---
interface Props {
  id: string;
  className?: string;
  uiOptions: {
    showImages?: boolean;
    debounceTimeoutMs?: number;
    pageSize?: number;
    excerptLength?: number;
    showResultsCount?: boolean;
    showEmptyFilters?: boolean;
    filters?: Record<string, string>;
    translations?: Record<string, string>;
  };
}

const { id, className, uiOptions } = Astro.props;
const placeholder = uiOptions.translations?.placeholder ?? 'Search';
const searchLabel = uiOptions.translations?.search_label ?? placeholder;
---

<div id={id} class={className} data-search-options={JSON.stringify(uiOptions)}>
  <div class="pagefind-ui__form">
    <input
      class="pagefind-ui__search-input"
      type="search"
      placeholder={placeholder}
      aria-label={searchLabel}
      autocomplete="off"
      data-search-placeholder
    />
  </div>
</div>
<script>
  for (const element of document.querySelectorAll<HTMLElement>('[data-search-options]')) {
    const placeholderInput = element.querySelector<HTMLInputElement>('[data-search-placeholder]');
    const details = element.closest<HTMLDetailsElement>('details');

    let loading: Promise<void> | null = null;
    const mount = (): Promise<void> => {
      if (loading) return loading;
      loading = (async () => {
        const [{ PagefindUI }] = await Promise.all([
          import('@pagefind/default-ui'),
          import('@pagefind/default-ui/css/ui.css'),
        ]);
        const value = placeholderInput?.value ?? '';
        const selectionStart = placeholderInput?.selectionStart ?? value.length;
        const selectionEnd = placeholderInput?.selectionEnd ?? value.length;
        const wasFocused = placeholderInput !== null && document.activeElement === placeholderInput;

        // The options are serialized from this component's typed props in the build above.
        const options = JSON.parse(element.dataset.searchOptions ?? '{}');
        element.replaceChildren();
        const ui = new PagefindUI({ ...options, element, bundlePath: '/pagefind/' });
        if (options.filters) ui.triggerFilters(options.filters);

        const realInput = element.querySelector<HTMLInputElement>('.pagefind-ui__search-input');
        if (realInput) {
          if (wasFocused) realInput.focus();
          if (value) {
            realInput.value = value;
            realInput.setSelectionRange(selectionStart, selectionEnd);
            realInput.dispatchEvent(new Event('input', { bubbles: true }));
          }
        }
        element.dataset.searchReady = 'true';
      })();
      return loading;
    };

    if (details && !details.open) {
      details.addEventListener('toggle', () => {
        if (details.open) void mount();
      });
    }

    if (placeholderInput) {
      for (const eventName of ['focus', 'pointerenter', 'input'] as const) {
        placeholderInput.addEventListener(eventName, () => void mount(), { once: true });
      }
    }
  }
</script>
