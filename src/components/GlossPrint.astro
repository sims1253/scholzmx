---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
/**
 * GlossPrint: a die-cut vinyl sticker, stuck flat on whatever it is given to. The picture
 * is the object: its own outline casts the shadow and nothing lies behind it, so it must
 * come with a clear ground.
 *
 * It is glossy. At rest a still sheen lies across it (CSS alone, so it is there without
 * JavaScript and under reduced motion). Once the reader scrolls or brings the pointer
 * over the card it sits on, the script below lights it by its relief instead: a normal
 * map made from the picture by scripts/make-print-reliefs.mjs.
 *
 * Torchlight warmth is computed directly inside the WebGL fragment shader so the canvas
 * carries no CSS filter, and the sticker drop-shadow sits only on the static <img>.
 *
 * - `relief` is that map's URL (import it with `?url`, so the file is fetched only when
 *   the sticker is about to be lit).
 * - `turn` is the angle it was stuck on at; pass a seeded value.
 */
interface Props {
  image: ImageMetadata;
  relief: string;
  width?: number;
  turn?: string;
  loading?: 'eager' | 'lazy';
}

const { image, relief, width = 160, turn = '0deg', loading = 'lazy' } = Astro.props;

// The sheen is cut to the sticker by the picture's own alpha: the same two files the
// <img> chooses between. A mask is always fetched in CORS mode, so the <img> asks in
// that mode too (`crossorigin`): otherwise the browser treats the two as different
// requests and fetches every picture twice.
const [small, large] = await Promise.all([
  getImage({ src: image, width }),
  getImage({ src: image, width: width * 2 }),
]);
const mask = `image-set(url('${small.src}') 1x, url('${large.src}') 2x)`;
// A tall sticker is as tall as the others are wide, not taller.
const fit = Math.min(1, image.width / image.height);
---

<div
  class="gloss-print"
  data-relief={relief}
  style={`--gloss-turn: ${turn}; --gloss-fit: ${fit.toFixed(3)}; --gloss-mask: ${mask}`}
>
  <img
    src={small.src}
    srcset={`${small.src} 1x, ${large.src} 2x`}
    alt=""
    width={small.attributes.width}
    height={small.attributes.height}
    loading={loading}
    decoding="async"
    crossorigin="anonymous"
  />
  <i class="gloss-sheen" aria-hidden="true"></i>
</div>

<style>
  .gloss-print {
    /* Daylight from the window is white; the torch is warm and nearer. */
    --gloss-shine: var(--by-day, rgb(255 255 255 / 0.62)) var(--by-torch, rgb(255 208 140 / 0.4));
    --gloss-glow: var(--by-day, rgb(255 255 255 / 0.16)) var(--by-torch, rgb(255 208 140 / 0.1));
    /* Shadow lives only on the static <img>, never on the wrapper around the live canvas. */
    --gloss-img-filter: var(--by-day, drop-shadow(0 1.5px 2px rgb(29 35 24 / 0.36)))
      var(--by-torch, brightness(0.8) sepia(0.15) drop-shadow(0 1.5px 2.5px rgb(0 0 0 / 0.55)));

    position: relative;
    display: block;
    width: calc(100% * var(--gloss-fit, 1));
    margin-inline: auto;
    transform: perspective(26rem) rotateX(var(--gloss-tilt-x, 0deg))
      rotateY(var(--gloss-tilt-y, 0deg)) rotate(var(--gloss-turn));
  }

  .gloss-print img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 0;
    filter: var(--gloss-img-filter);
  }

  /* Both lights lie over the picture and take no clicks: the card under it is a link. */
  .gloss-sheen,
  .gloss-print :global(.gloss-light) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    transition: opacity 0.5s ease;
  }

  /* The resting sheen: the window's streak across the upper left, and a faint glow
     where the light comes from. */
  .gloss-sheen {
    background:
      linear-gradient(
        118deg,
        transparent 16%,
        var(--gloss-shine) 27%,
        var(--gloss-glow) 33%,
        transparent 34%,
        transparent 38%,
        var(--gloss-glow) 39%,
        transparent 47%
      ),
      radial-gradient(120% 90% at 20% 0%, var(--gloss-glow), transparent 60%);
    mask: var(--gloss-mask) center / 100% 100% no-repeat;
  }

  /* Torchlight warmth is baked in the shader, so the canvas carries no CSS filter. */
  .gloss-print :global(.gloss-light) {
    opacity: 0;
  }

  .gloss-print[data-lit] :global(.gloss-light) {
    opacity: 1;
  }

  .gloss-print[data-lit] .gloss-sheen {
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .gloss-print {
      transform: rotate(var(--gloss-turn));
    }
  }
</style>

<script>
  // Lights each sticker directly on its own WebGL canvas (zero GPU-to-CPU readback),
  // staggered one sticker init per animation frame so scrolling never stalls, and with
  // reads strictly batched ahead of writes so no frame triggers forced layout.
  const still = matchMedia('(prefers-reduced-motion: reduce)');
  const darkMedia = matchMedia('(prefers-color-scheme: dark)');

  const isTorchlit = () => {
    const theme = document.documentElement.dataset.theme;
    return theme === 'dark' || (theme !== 'light' && darkMedia.matches);
  };

  const VERTEX = `
    attribute vec2 corner;
    varying vec2 at;
    void main() {
      at = vec2(corner.x, -corner.y) * 0.5 + 0.5;
      gl_Position = vec4(corner, 0.0, 1.0);
    }`;

  // A tight highlight inside a wide soft one, tinted warm by torchlight right in the shader.
  const FRAGMENT = `
    precision mediump float;
    uniform sampler2D relief;
    uniform vec3 light;
    uniform vec3 tint;
    varying vec2 at;
    void main() {
      vec4 texel = texture2D(relief, at);
      vec3 normal = normalize(vec3(texel.rg * 2.0 - 1.0, texel.b));
      vec3 toLight = normalize(light - vec3(at, 0.0));
      float facing = max(dot(normal, normalize(toLight + vec3(0.0, 0.0, 1.0))), 0.0);
      float shine = pow(facing, 110.0) * 0.6 + pow(facing, 22.0) * 0.14;
      float shade = clamp(-dot(normal.xy, toLight.xy) * 0.55, 0.0, 0.3);
      gl_FragColor = vec4(tint * shine, min(shine + shade, 1.0)) * texel.a;
    }`;

  interface Print {
    sticker: HTMLElement;
    card: HTMLElement;
    seen: boolean;
    held: boolean;
    lit: boolean;
    tiltWritten: boolean;
    loading: boolean;
    at: [number, number];
    to: [number, number];
    tilt: [number, number];
    drawnAt: [number, number];
    drawnDark: boolean;
    draw?: (x: number, y: number, dark: boolean) => void;
  }

  const restFromRect = (box: DOMRect, viewHeight: number): [number, number] => {
    const passed = Math.min(1, Math.max(0, (box.top + box.height / 2) / viewHeight));
    return [0.62 - passed * 0.5, 0.5 - passed * 0.42];
  };

  const lamp = (print: Print, map: HTMLImageElement) => {
    const canvas = document.createElement('canvas');
    canvas.width = map.naturalWidth;
    canvas.height = map.naturalHeight;
    canvas.className = 'gloss-light';
    canvas.setAttribute('aria-hidden', 'true');
    const gl = canvas.getContext('webgl', { premultipliedAlpha: true, antialias: false });
    if (!gl) return;
    const program = gl.createProgram();
    for (const [kind, source] of [
      [gl.VERTEX_SHADER, VERTEX],
      [gl.FRAGMENT_SHADER, FRAGMENT],
    ] as const) {
      const shader = gl.createShader(kind);
      if (!shader) return;
      gl.shaderSource(shader, source);
      gl.compileShader(shader);
      gl.attachShader(program, shader);
    }
    gl.linkProgram(program);
    if (!gl.getProgramParameter(program, gl.LINK_STATUS)) return;
    gl.useProgram(program);

    gl.bindBuffer(gl.ARRAY_BUFFER, gl.createBuffer());
    gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 1, -1, -1, 1, 1, 1]), gl.STATIC_DRAW);
    const corner = gl.getAttribLocation(program, 'corner');
    gl.enableVertexAttribArray(corner);
    gl.vertexAttribPointer(corner, 2, gl.FLOAT, false, 0, 0);

    gl.bindTexture(gl.TEXTURE_2D, gl.createTexture());
    gl.pixelStorei(gl.UNPACK_PREMULTIPLY_ALPHA_WEBGL, false);
    gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGBA, gl.RGBA, gl.UNSIGNED_BYTE, map);
    gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.LINEAR);
    gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE);
    gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE);

    const light = gl.getUniformLocation(program, 'light');
    const tint = gl.getUniformLocation(program, 'tint');

    canvas.addEventListener('webglcontextlost', () => {
      print.draw = undefined;
      print.lit = false;
      delete print.sticker.dataset.lit;
      if (print.tiltWritten) {
        print.sticker.style.removeProperty('--gloss-tilt-x');
        print.sticker.style.removeProperty('--gloss-tilt-y');
        print.tiltWritten = false;
      }
    });

    print.sticker.append(canvas);
    return (x: number, y: number, dark: boolean) => {
      gl.uniform3f(light, x, y, 0.5);
      if (dark) gl.uniform3f(tint, 1.0, 0.8, 0.52);
      else gl.uniform3f(tint, 1.0, 1.0, 1.0);
      gl.drawArrays(gl.TRIANGLE_STRIP, 0, 4);
    };
  };

  const prints: Print[] = [...document.querySelectorAll<HTMLElement>('.gloss-print')].map(
    (sticker) => ({
      sticker,
      card: sticker.closest<HTMLElement>('article') ?? sticker,
      seen: false,
      held: false,
      lit: false,
      tiltWritten: false,
      loading: false,
      at: [0.3, 0.2],
      to: [0.3, 0.2],
      tilt: [0, 0],
      drawnAt: [NaN, NaN],
      drawnDark: false,
    })
  );

  let frame = 0;
  let woken = false;
  let scrollDirty = true;
  const initQueue: { print: Print; map: HTMLImageElement }[] = [];
  let initFrame = 0;

  // Initialize at most one sticker WebGL context per frame so first scroll stays smooth.
  const drainInits = () => {
    initFrame = 0;
    if (still.matches) return;
    const next = initQueue.shift();
    if (!next) return;
    const { print, map } = next;
    if (!print.draw) {
      print.draw = lamp(print, map);
      if (print.draw) {
        print.at = restFromRect(print.sticker.getBoundingClientRect(), window.innerHeight);
        print.to = [print.at[0], print.at[1]];
        wake();
      }
    }
    if (initQueue.length > 0) initFrame = requestAnimationFrame(drainInits);
  };

  const step = () => {
    frame = 0;
    const dark = isTorchlit();
    const viewHeight = window.innerHeight;

    // Phase 1 (READ ONLY): measure visible unheld stickers once when scroll moved.
    if (scrollDirty) {
      scrollDirty = false;
      for (const print of prints) {
        if (!print.seen || !print.draw || print.held) continue;
        print.to = restFromRect(print.sticker.getBoundingClientRect(), viewHeight);
      }
    }

    // Phase 2 (COMPUTE + WRITE ONLY): zero interleaved layout reads.
    let moving = false;
    for (const print of prints) {
      if (!print.seen || !print.draw) continue;
      const leanX = print.held ? (0.5 - print.to[1]) * 7 : 0;
      const leanY = print.held ? (print.to[0] - 0.5) * 7 : 0;
      print.at[0] += (print.to[0] - print.at[0]) * 0.16;
      print.at[1] += (print.to[1] - print.at[1]) * 0.16;
      print.tilt[0] += (leanX - print.tilt[0]) * 0.16;
      print.tilt[1] += (leanY - print.tilt[1]) * 0.16;

      const atMoving =
        Math.abs(print.to[0] - print.at[0]) > 0.002 || Math.abs(print.to[1] - print.at[1]) > 0.002;
      const tiltMoving =
        Math.abs(leanX - print.tilt[0]) > 0.02 || Math.abs(leanY - print.tilt[1]) > 0.02;
      if (atMoving || tiltMoving) moving = true;

      if (
        !print.lit ||
        dark !== print.drawnDark ||
        Math.abs(print.at[0] - print.drawnAt[0]) > 0.0008 ||
        Math.abs(print.at[1] - print.drawnAt[1]) > 0.0008
      ) {
        print.draw(print.at[0], print.at[1], dark);
        print.drawnAt[0] = print.at[0];
        print.drawnAt[1] = print.at[1];
        print.drawnDark = dark;
      }

      if (print.held || Math.abs(print.tilt[0]) > 0.02 || Math.abs(print.tilt[1]) > 0.02) {
        print.sticker.style.setProperty('--gloss-tilt-x', `${print.tilt[0].toFixed(2)}deg`);
        print.sticker.style.setProperty('--gloss-tilt-y', `${print.tilt[1].toFixed(2)}deg`);
        print.tiltWritten = true;
      } else if (print.tiltWritten) {
        print.sticker.style.removeProperty('--gloss-tilt-x');
        print.sticker.style.removeProperty('--gloss-tilt-y');
        print.tilt[0] = 0;
        print.tilt[1] = 0;
        print.tiltWritten = false;
      }

      if (!print.lit) {
        print.lit = true;
        print.sticker.dataset.lit = '';
      }
    }
    if (moving) frame = requestAnimationFrame(step);
  };

  // Fetches a sticker's relief and queues its lamp once the reader scrolls or hovers.
  const kindle = (print: Print) => {
    const relief = print.sticker.dataset.relief;
    if (!woken || !print.seen || print.draw || print.loading || still.matches || !relief) return;
    print.loading = true;
    const map = new Image();
    map.src = relief;
    delete print.sticker.dataset.relief;
    void map
      .decode()
      .then(() => {
        initQueue.push({ print, map });
        if (!still.matches) initFrame ||= requestAnimationFrame(drainInits);
      })
      .catch(() => {
        print.loading = false;
      });
  };

  const wake = () => {
    if (still.matches) return;
    if (!woken) {
      woken = true;
      prints.forEach(kindle);
    }
    frame ||= requestAnimationFrame(step);
  };

  let lookFrame = 0;
  const look = () => {
    lookFrame = 0;
    const edge = 200;
    const height = window.innerHeight;
    let relight = false;
    // Read all bounding rects in one pass before any writes.
    const rects = prints.map((print) => print.sticker.getBoundingClientRect());
    prints.forEach((print, index) => {
      const box = rects[index];
      if (!box) return;
      print.seen = box.bottom >= -edge && box.top <= height + edge;
      if (print.seen && !print.held) print.to = restFromRect(box, height);
      kindle(print);
      if (woken && print.seen && print.draw) relight = true;
    });
    scrollDirty = false;
    if (relight && !still.matches && !frame) step();
  };
  const watch = () => {
    if (still.matches) return;
    scrollDirty = true;
    lookFrame ||= requestAnimationFrame(look);
  };

  // Re-tint lit canvases when the visitor toggles daylight / torchlight.
  const retheme = () => {
    if (!still.matches && woken && prints.some((p) => p.seen && p.draw)) {
      frame ||= requestAnimationFrame(step);
    }
  };
  new MutationObserver(retheme).observe(document.documentElement, {
    attributes: true,
    attributeFilter: ['data-theme'],
  });
  darkMedia.addEventListener('change', retheme);

  still.addEventListener('change', () => {
    if (!still.matches) {
      if (initQueue.length > 0) initFrame ||= requestAnimationFrame(drainInits);
      watch();
      return;
    }
    cancelAnimationFrame(lookFrame);
    lookFrame = 0;
    cancelAnimationFrame(frame);
    frame = 0;
    cancelAnimationFrame(initFrame);
    initFrame = 0;
    for (const print of prints) {
      print.lit = false;
      delete print.sticker.dataset.lit;
      if (print.tiltWritten) {
        print.sticker.style.removeProperty('--gloss-tilt-x');
        print.sticker.style.removeProperty('--gloss-tilt-y');
        print.tiltWritten = false;
      }
    }
  });

  for (const print of prints) {
    print.card.addEventListener('pointermove', (event) => {
      if (event.pointerType === 'touch') return;
      const box = print.sticker.getBoundingClientRect();
      const reach = (distance: number) => 0.5 + (0.75 * distance) / (0.6 + Math.abs(distance));
      print.held = true;
      print.to = [
        reach((event.clientX - box.left) / box.width - 0.5),
        reach((event.clientY - box.top) / box.height - 0.5),
      ];
      wake();
    });
    print.card.addEventListener('pointerleave', () => {
      print.held = false;
      scrollDirty = true;
      wake();
    });
  }
  if (!still.matches) look();
  addEventListener(
    'scroll',
    () => {
      if (still.matches) return;
      woken = true;
      watch();
    },
    { passive: true }
  );
  addEventListener('resize', watch, { passive: true });
</script>
