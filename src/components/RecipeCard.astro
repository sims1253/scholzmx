---
/**
 * The recipe card: one recipe description rendered as Michael Chu's table (wide screens),
 * as numbered steps (phones, screen readers, anyone who wants the details), and as a
 * cooking mode that walks through the steps with timers. See src/lib/recipe.ts.
 */
import Series from './Series.astro';
import {
  formatAmount,
  formatDuration,
  formatStepTime,
  layOut,
  rowEntries,
  timing,
  type RecipeIngredient,
  type RecipeMeanwhile,
  type RecipeStep,
} from '../lib/recipe';

interface Props {
  ingredients: RecipeIngredient[];
  steps: RecipeStep[];
  meanwhile?: RecipeMeanwhile[];
  makes?: { amount: number; unit: string };
  prepMinutes?: number;
  equipment?: string[];
}

const { ingredients, steps, meanwhile = [], makes, prepMinutes = 0, equipment = [] } = Astro.props;

const grid = layOut(ingredients, steps);
const { active, total } = timing(steps, prepMinutes);
const ingredientById = new Map(ingredients.map((ingredient) => [ingredient.id, ingredient]));
const stepIndex = new Map(steps.map((step, index) => [step.id, index]));

// A "get ready" stage collects the prep that ingredient lists usually hide.
const prepWork = ingredients.filter((ingredient) => ingredient.prep);
const getReady = prepWork.length > 0 || equipment.length > 0;
const offset = getReady ? 1 : 0;

// Only say what the data supports: no "0 minutes of work" when steps aren't timed.
const sentence = (text: string) => text.charAt(0).toUpperCase() + text.slice(1);
const timeSentence =
  active > 0 && total > active
    ? `${sentence(formatDuration(active))} of work, ready in ${formatDuration(total)}.`
    : total > 0
      ? `Ready in ${formatDuration(total)}.`
      : '';

const amountOf = (ingredient: RecipeIngredient) =>
  ingredient.amount === undefined ? '' : formatAmount(ingredient.amount, ingredient.unit);
const tasksDuring = (step: RecipeStep) =>
  meanwhile.filter((task) => task.during === step.id).map((task) => task.do);
const columnTasks = Array.from({ length: grid.columns }, (_, index) =>
  grid.cells.filter((cell) => cell.col === index + 1).flatMap((cell) => tasksDuring(cell.step))
);
const longest = (step: RecipeStep) =>
  step.minutes === undefined ? 0 : Array.isArray(step.minutes) ? step.minutes[1] : step.minutes;
const when = (step: RecipeStep) =>
  [formatStepTime(step.minutes), step.heat].filter(Boolean).join(', ');
const inputsOf = (step: RecipeStep) =>
  step.uses.map((id) => {
    const ingredient = ingredientById.get(id);
    if (ingredient) return { ingredient, text: ingredient.name };
    const index = stepIndex.get(id) ?? 0;
    return { ingredient: undefined, text: steps[index]?.result ?? `step ${index + 1 + offset}` };
  });
---

<section class="recipe-card" data-recipe-card aria-labelledby="recipe-card-title">
  <div class="rc-sheet pasted">
    <header class="rc-header">
      <h2 class="rc-title" id="recipe-card-title">The recipe</h2>
      <p class="rc-summary">
        {makes && (
          <>Makes
            <span class="rc-qty" data-amount={makes.amount}>{formatAmount(makes.amount)}</span>
            {makes.unit}.
          </>
        )}{timeSentence}
        {equipment.length > 0 && (
          <>You'll need <Series items={equipment.map((text) => ({ text }))} last="and" />.</>
        )}
      </p>

      <div class="rc-controls" data-rc-controls hidden>
        <fieldset class="rc-choice">
          <legend>Amount</legend>
          <label><input type="radio" name="rc-scale" value="0.5" />Half</label>
          <label><input type="radio" name="rc-scale" value="1" checked />As written</label>
          <label><input type="radio" name="rc-scale" value="2" />Double</label>
        </fieldset>
        <fieldset class="rc-choice">
          <legend>Show</legend>
          <label><input type="radio" name="rc-view" value="table" checked />Table</label>
          <label><input type="radio" name="rc-view" value="steps" />Steps</label>
        </fieldset>
        <button type="button" class="rc-start" data-rc-start>Start cooking</button>
      </div>
    </header>

    <div class="rc-table-wrap" role="region" aria-labelledby="rc-caption" tabindex="0">
      <table class="rc-table">
        <caption id="rc-caption">
          Ingredients in the order they go in. Each step combines the rows it spans; hatched steps
          are hands-off.
        </caption>
        {meanwhile.length > 0 && <thead>
          <tr>
            <td class="rc-corner"></td>
            {columnTasks.map((tasks) =>
              tasks.length > 0 ? (
                <td class="rc-meanwhile"><span>Meanwhile</span> {tasks.join('; ')}</td>
              ) : (
                <td class="rc-blank"></td>
              )
            )}
          </tr>
        </thead>}
        <tbody>
          {grid.rows.map((ingredient, row) => <tr
            data-ingredient={ingredient.id}
            data-taken-at={(grid.takenAt.get(ingredient.id) ?? 0) + offset}
          >
            <th scope="row" class="rc-ingredient">
              <span class="rc-name">
                {ingredient.amount !== undefined && <span
                  class="rc-qty"
                  data-amount={ingredient.amount}
                  data-unit={ingredient.unit}
                  data-fixed={ingredient.scales === false ? '' : undefined}
                  >{amountOf(ingredient)}</span
                >}
                {ingredient.name}
              </span>
              {(ingredient.prep || ingredient.note) && <span class="rc-aside"
                >{[ingredient.prep, ingredient.note].filter(Boolean).join('; ')}</span
              >}
            </th>
            {rowEntries(grid, row).map((entry) =>
              entry.kind === 'empty' ? (
                <td class="rc-blank" colspan={entry.span > 1 ? entry.span : undefined}></td>
              ) : (
                <td
                  class:list={['rc-step', { 'rc-wait': entry.cell.step.wait }]}
                  rowspan={entry.cell.rowSpan > 1 ? entry.cell.rowSpan : undefined}
                  data-stage={entry.cell.index + offset}
                >
                  <span class="rc-do">{entry.cell.step.do}</span>
                  {when(entry.cell.step) && <span class="rc-when">{when(entry.cell.step)}</span>}
                </td>
              )
            )}
          </tr>)}
        </tbody>
      </table>
    </div>

    <ol class="rc-steps">
      {getReady && <li class="rc-steps-item" data-stage="0" data-minutes={prepMinutes}>
        <h3 class="rc-steps-do">Get ready</h3>
        <div class="rc-steps-detail">
          {equipment.length > 0 && <p>
            Set out <Series items={equipment.map((text) => ({ text }))} last="and" />.
          </p>}
          {prepWork.length > 0 && <ul class="rc-prep">
            {prepWork.map((ingredient) => <li>
              <span class="rc-prep-name">{ingredient.name}:</span>
              {ingredient.prep}
            </li>)}
          </ul>}
        </div>
      </li>}
      {steps.map((step, index) => <li
        class="rc-steps-item"
        data-stage={index + offset}
        data-minutes={longest(step)}
      >
        <h3 class="rc-steps-do">{step.do}</h3>
        <p class="rc-steps-uses">
          <!-- prettier-ignore -->
          {inputsOf(step).map((input, n) => <>{n > 0 ? ', ' : ''}{input.ingredient && input.ingredient.amount !== undefined && <><span class="rc-qty" data-amount={input.ingredient.amount} data-unit={input.ingredient.unit} data-fixed={input.ingredient.scales === false ? '' : undefined}>{amountOf(input.ingredient)}</span> </>}{input.text}</>)}
        </p>
        {step.detail && <p class="rc-steps-detail">{step.detail}</p>}
        {(when(step) || step.wait) && <p class="rc-steps-when">
          {[when(step), step.wait ? 'hands off' : ''].filter(Boolean).join(', ')}
        </p>}
        {tasksDuring(step).map((task) => <p class="rc-steps-meanwhile">
          <span>Meanwhile:</span>
          {task}
        </p>)}
      </li>)}
    </ol>
  </div>

  <div class="rc-cook" data-rc-cook hidden>
    <div class="rc-cook-inner">
      <p class="rc-cook-count" data-rc-count></p>
      <p class="rc-cook-do" data-rc-do></p>
      <p class="rc-cook-detail" data-rc-detail></p>
      <p class="rc-cook-meanwhile" data-rc-meanwhile hidden></p>
      <div class="rc-cook-actions">
        <button type="button" class="rc-timer" data-rc-timer hidden>Start timer</button>
        <span class="rc-timers" data-rc-timers></span>
        <span class="rc-cook-nav">
          <button type="button" data-rc-back>Back</button>
          <button type="button" class="rc-next" data-rc-next>Next</button>
          <button type="button" data-rc-stop>Stop cooking</button>
        </span>
      </div>
    </div>
    <p class="sr-only" aria-live="assertive" data-rc-announce></p>
  </div>
</section>

<script>
  import '../scripts/recipe-card';
</script>

<style>
  /* The card is wider than the reading column; it breaks out to the page. */
  .recipe-card {
    --card-width: min(72rem, 100cqi - 2 * var(--space-md));

    width: var(--card-width);
    margin: var(--space-lg) calc((100% - var(--card-width)) / 2) var(--space-xxl);
  }

  .rc-sheet {
    padding: var(--space-lg) var(--space-lg) var(--space-md);
    background: var(--paper-sheet);
    border: 1px solid color-mix(in srgb, var(--color-ink-dark) 10%, transparent);
    box-shadow:
      0 1px 2px color-mix(in srgb, var(--color-ink-dark) 12%, transparent),
      0 16px 32px -18px color-mix(in srgb, var(--color-ink-dark) 40%, transparent);
  }

  .rc-header {
    margin-bottom: var(--space-md);
  }

  .rc-title {
    margin: 0 0 0.2em;
    font-size: var(--text-2xl);
    font-style: normal;
    font-weight: 400;
  }

  .rc-summary {
    max-width: 44rem;
    margin: 0;
    font-style: italic;
    color: var(--color-text-secondary);
    font-variant-numeric: oldstyle-nums;
  }

  .rc-controls {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    gap: var(--space-sm) var(--space-lg);
    margin-top: var(--space-md);
  }

  .rc-controls[hidden] {
    display: none;
  }

  .rc-choice {
    display: flex;
    gap: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .rc-choice legend {
    padding: 0;
    margin-bottom: 0.25rem;
    font-size: var(--text-sm);
    font-style: italic;
    color: var(--color-text-muted);
  }

  .rc-choice label {
    position: relative;
    padding: 0.3rem 0.8rem;
    border: 1px solid var(--rule-ink);
    font-size: var(--text-sm);
    cursor: pointer;
  }

  .rc-choice label + label {
    border-left-width: 0;
  }

  .rc-choice label:first-of-type {
    border-radius: 999px 0 0 999px;
  }

  .rc-choice label:last-of-type {
    border-radius: 0 999px 999px 0;
  }

  .rc-choice input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .rc-choice label:has(input:checked) {
    background: color-mix(in srgb, var(--color-tansy) 30%, transparent);
    color: var(--color-text-primary);
  }

  .rc-choice label:has(input:focus-visible) {
    outline: 2px solid var(--color-walnut);
    outline-offset: 2px;
  }

  .rc-start,
  .rc-next {
    padding: 0.45rem 1.1rem;
    border: 1px solid var(--color-walnut);
    border-radius: 999px;
    background: var(--color-walnut);
    color: var(--paper-sheet);
    font: inherit;
    font-size: var(--text-md);
    cursor: pointer;
  }

  .rc-start {
    margin-left: auto;
  }

  .rc-start:hover,
  .rc-next:hover {
    background: var(--btn-walnut-hover);
  }

  /* ===== Table ===== */

  .rc-table-wrap {
    overflow-x: auto;
  }

  .rc-table-wrap:focus-visible {
    outline: 2px solid var(--color-walnut);
    outline-offset: 4px;
  }

  /* As wide as its steps need, up to the card */
  .rc-table {
    inline-size: auto;
    margin: 0;
    border-collapse: collapse;
    font-size: var(--text-sm);
    line-height: 1.35;
  }

  .rc-table caption {
    caption-side: bottom;
    padding-top: var(--space-sm);
    font-style: italic;
    color: var(--color-text-muted);
    text-align: left;
  }

  .rc-table th,
  .rc-table td {
    padding: 0.45rem 0.6rem;
    border: 1px solid var(--rule-ink);
    vertical-align: middle;
  }

  .rc-ingredient {
    position: sticky;
    left: 0;
    z-index: 1;
    min-width: 11.5rem;
    max-width: 15rem;
    background: var(--paper-sheet);
    font-weight: 400;
    text-align: left;
  }

  .rc-name {
    display: block;
  }

  .rc-qty {
    font-weight: 600;
    font-variant-numeric: oldstyle-nums;
    white-space: nowrap;
  }

  .rc-aside {
    display: block;
    font-family: var(--font-body-personal);
    font-size: var(--text-xs);
    font-style: italic;
    color: var(--color-text-muted);
  }

  .rc-step {
    min-width: 5.25rem;
    background: var(--wash-sage);
    text-align: center;
  }

  /* Hands-off time is hatched: you can walk away. */
  .rc-wait {
    background:
      repeating-linear-gradient(
        -45deg,
        transparent 0 7px,
        color-mix(in srgb, var(--color-moss) 16%, transparent) 7px 8px
      ),
      var(--wash-sage);
  }

  .rc-do {
    display: block;
    font-family: var(--font-heading);
    font-size: var(--text-md);
  }

  .rc-when {
    display: block;
    font-style: italic;
    color: var(--color-text-muted);
    font-variant-numeric: oldstyle-nums;
  }

  .rc-blank {
    background: transparent;
  }

  /* The meanwhile row is a band, not part of the grid: only its tasks are drawn. */
  .rc-table thead td {
    border-style: hidden hidden solid;
  }

  .rc-meanwhile {
    padding-block: 0.35rem;
    background: color-mix(in srgb, var(--color-tansy) 22%, var(--paper-sheet));
    font-size: var(--text-xs);
    line-height: 1.3;
    text-align: center;
    vertical-align: bottom;
  }

  .rc-meanwhile span {
    display: block;
    font-style: italic;
    color: var(--color-text-muted);
  }

  /* ===== Steps ===== */

  .rc-steps {
    max-width: 40rem;
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: rc-step;
  }

  .rc-steps-item {
    position: relative;
    margin: 0 0 var(--space-md);
    padding: 0 0 0 2.6rem;
    counter-increment: rc-step;
  }

  .rc-steps-item::before {
    content: counter(rc-step);
    position: absolute;
    left: 0;
    top: -0.1rem;
    width: 2rem;
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    color: var(--color-moss);
    text-align: right;
    font-variant-numeric: oldstyle-nums;
  }

  .rc-steps-do {
    margin: 0;
    font-size: var(--text-lg);
    font-style: normal;
  }

  .rc-steps-uses {
    margin: 0.1rem 0 0.3rem;
    color: var(--color-text-secondary);
  }

  .rc-steps-detail,
  .rc-steps-detail p {
    margin: 0 0 0.3rem;
  }

  .rc-prep {
    margin: 0;
    padding-left: 1.1rem;
  }

  .rc-prep-name {
    font-weight: 600;
  }

  .rc-steps-when,
  .rc-steps-meanwhile {
    margin: 0;
    font-size: var(--text-sm);
    font-style: italic;
    color: var(--color-text-muted);
  }

  .rc-steps-meanwhile span {
    color: var(--color-ochre);
  }

  /* One view at a time. Without JavaScript the screen size decides. */
  .recipe-card:not([data-view]) .rc-steps,
  .recipe-card[data-view='table'] .rc-steps,
  .recipe-card[data-view='steps'] .rc-table-wrap {
    display: none;
  }

  @media (max-width: 48rem) {
    .recipe-card:not([data-view]) .rc-steps {
      display: block;
    }

    .recipe-card:not([data-view]) .rc-table-wrap {
      display: none;
    }

    .rc-sheet {
      padding: var(--space-md) var(--space-sm);
    }

    .rc-start {
      margin-left: 0;
    }
  }

  /* ===== Cooking ===== */

  .rc-step.is-current,
  .rc-steps-item.is-current {
    background: color-mix(in srgb, var(--color-tansy) 38%, var(--paper-sheet));
  }

  .rc-step.is-current {
    outline: 2px solid var(--color-ochre);
    outline-offset: -2px;
  }

  .rc-steps-item.is-current {
    margin-inline: -0.6rem;
    padding-block: 0.4rem;
    padding-right: 0.6rem;
    padding-left: 3.2rem;
  }

  .rc-steps-item.is-current::before {
    left: 0.6rem;
    top: 0.3rem;
  }

  .rc-step.is-done,
  .rc-steps-item.is-done {
    opacity: 0.5;
  }

  tr.is-current .rc-ingredient {
    background: color-mix(in srgb, var(--color-tansy) 28%, var(--paper-sheet));
  }

  tr.is-used .rc-ingredient {
    color: var(--color-text-muted);
    text-decoration: line-through;
    text-decoration-color: color-mix(in srgb, var(--color-ink-dark) 45%, transparent);
  }

  .recipe-card.is-cooking .rc-step {
    cursor: pointer;
  }

  .rc-cook {
    position: fixed;
    inset: auto 0 0;
    z-index: 1100;
    padding: 0 var(--space-sm) var(--space-sm);
    pointer-events: none;
  }

  .rc-cook[hidden] {
    display: none;
  }

  .rc-cook-inner {
    max-width: 46rem;
    margin: 0 auto;
    padding: var(--space-sm) var(--space-md);
    background: var(--paper-sheet);
    border: 1px solid color-mix(in srgb, var(--color-ink-dark) 12%, transparent);
    border-top: 3px solid var(--color-tansy);
    box-shadow: 0 -12px 30px -14px color-mix(in srgb, var(--color-ink-dark) 45%, transparent);
    pointer-events: auto;
  }

  .rc-cook-count {
    margin: 0;
    font-size: var(--text-sm);
    font-style: italic;
    color: var(--color-text-muted);
  }

  .rc-cook-do {
    margin: 0;
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    line-height: 1.2;
  }

  .rc-cook-detail {
    margin: 0.2rem 0 0;
    max-width: 40rem;
  }

  /* In the step list the highlighted step already shows the instruction. */
  .recipe-card[data-view='steps'] .rc-cook-detail {
    display: none;
  }

  .rc-cook-meanwhile {
    margin: 0.3rem 0 0;
    font-style: italic;
    color: var(--color-ochre);
  }

  .rc-cook-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-top: var(--space-sm);
  }

  .rc-cook-nav {
    display: flex;
    gap: 0.5rem;
    margin-left: auto;
  }

  .rc-cook-actions button:not(.rc-next) {
    padding: 0.4rem 0.9rem;
    border: 1px solid var(--rule-ink);
    border-radius: 999px;
    background: transparent;
    color: var(--color-text-primary);
    font: inherit;
    font-size: var(--text-sm);
    cursor: pointer;
  }

  .rc-cook-actions .rc-timer {
    border-color: var(--color-ochre);
  }

  .rc-timers {
    font-size: var(--text-sm);
    font-variant-numeric: tabular-nums;
    color: var(--color-text-secondary);
  }

  :global(html.rc-cooking body) {
    padding-bottom: 16rem;
  }

  @media print {
    .rc-controls,
    .rc-cook,
    .rc-steps {
      display: none !important;
    }

    .rc-table-wrap {
      display: block !important;
      overflow: visible;
    }
  }
</style>
