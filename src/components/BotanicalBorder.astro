---
export interface Props {
  position?: 'top' | 'bottom' | 'left' | 'right' | 'corner';
  variant?: 'vine' | 'leaves' | 'flowers' | 'geometric';
  intensity?: 'light' | 'medium' | 'heavy';
  className?: string;
}

const { position = 'top', variant = 'vine', intensity = 'medium', className = '' } = Astro.props;

const opacity = intensity === 'light' ? 0.15 : intensity === 'medium' ? 0.25 : 0.35;
const strokeWidth = intensity === 'light' ? '2' : intensity === 'medium' ? '3' : '4';

/* Watercolor palette: glaze tones sit a little above the old line opacity
   so pigment actually reads once the paint filter erodes into it. */
const glaze = Math.min(0.55, opacity + 0.16); // body of the leaf
const glazeDeep = Math.min(0.62, opacity + 0.24); // second pass, overlaps read darker
const rim = Math.min(0.7, opacity + 0.3); // dried edge
const vineStroke = Math.min(0.55, opacity + 0.18);
---

<div class={`botanical-border ${position} ${variant} ${className}`}>
  {
    position === 'top' && (
      <svg class="border-svg" viewBox="0 0 820 160" preserveAspectRatio="none">
        <defs>{/* Paint filters (wc-ink / wc-paint) are shared via WatercolorDefs */}</defs>

        {/* Main border path (orange wave) - COMMENTED OUT */}
        {/* <path
        d="M0,25 Q100,8 200,30 T400,18 T600,35 T800,25 L800,0 L0,0 Z"
        fill={`rgba(180,83,9,${opacity})`}
        filter="url(#roughTexture)"
      /> */}

        {/* Watercolor vine: loaded-brush stroke via wc-ink (wobble + bleed) */}
        <path
          d="M50,50 Q150,30 250,55 T450,40 T650,60 T800,50"
          stroke={`rgba(90, 107, 71, ${vineStroke})`}
          stroke-width={strokeWidth}
          fill="none"
          stroke-linecap="round"
          filter="url(#wc-ink)"
        />
        {/* second glaze along the vine: where it overlaps the first, it
            dries deeper — the glazing cue */}
        <path
          d="M55,52 Q152,33 248,57 T452,43 T648,62 T792,52"
          stroke={`rgba(139, 90, 60, ${vineStroke * 0.55})`}
          stroke-width={Number(strokeWidth) * 0.55}
          fill="none"
          stroke-linecap="round"
          filter="url(#wc-ink)"
        />

        {/* Botanical elements: layered pigment glazes with dried edges */}
        <g filter="url(#wc-paint)">
          {/* leaf cluster 1 */}
          <g transform="translate(120,20) rotate(45)">
            <ellipse rx="9" ry="4.2" fill={`rgba(90, 107, 71, ${glaze})`} />
            <ellipse rx="7" ry="2.8" cx="0.8" cy="0.6" fill={`rgba(90, 107, 71, ${glazeDeep})`} />
            <ellipse
              rx="9"
              ry="4.2"
              fill="none"
              stroke={`rgba(64, 80, 52, ${rim})`}
              stroke-width="1.1"
            />
          </g>
          {/* leaf cluster 2 */}
          <g transform="translate(320,30) rotate(-30)">
            <ellipse rx="8" ry="3.6" fill={`rgba(90, 107, 71, ${glaze})`} />
            <ellipse rx="6" ry="2.4" cx="0.7" cy="0.5" fill={`rgba(90, 107, 71, ${glazeDeep})`} />
            <ellipse
              rx="8"
              ry="3.6"
              fill="none"
              stroke={`rgba(64, 80, 52, ${rim})`}
              stroke-width="1"
            />
          </g>
          {/* leaf cluster 3 */}
          <g transform="translate(520,23) rotate(60)">
            <ellipse rx="9" ry="4.5" fill={`rgba(90, 107, 71, ${glaze})`} />
            <ellipse rx="6.8" ry="2.9" cx="0.9" cy="0.4" fill={`rgba(90, 107, 71, ${glazeDeep})`} />
            <ellipse
              rx="9"
              ry="4.5"
              fill="none"
              stroke={`rgba(64, 80, 52, ${rim})`}
              stroke-width="1.1"
            />
          </g>

          {/* flowers: stacked translucent washes, offset so overlaps deepen */}
          <g transform="translate(180,45)">
            <circle r="3.2" fill={`rgba(168, 181, 160, ${glaze})`} />
            <circle r="2.2" cx="0.4" cy="0.3" fill={`rgba(139, 90, 60, ${glazeDeep * 0.75})`} />
            <circle r="1.1" cx="0.2" cy="0.1" fill={`rgba(176, 146, 44, ${rim * 0.8})`} />
          </g>
          <g transform="translate(380,35)">
            <circle r="2.6" fill={`rgba(168, 181, 160, ${glaze})`} />
            <circle r="1.7" cx="0.3" cy="0.3" fill={`rgba(139, 90, 60, ${glazeDeep * 0.75})`} />
            <circle r="0.9" fill={`rgba(176, 146, 44, ${rim * 0.8})`} />
          </g>
          <g transform="translate(580,50)">
            <circle r="3.4" fill={`rgba(168, 181, 160, ${glaze})`} />
            <circle r="2.3" cx="0.5" cy="0.2" fill={`rgba(139, 90, 60, ${glazeDeep * 0.75})`} />
            <circle r="1.2" fill={`rgba(176, 146, 44, ${rim * 0.8})`} />
          </g>
        </g>
      </svg>
    )
  }

  {
    position === 'left' && (
      <svg class="border-svg vertical" viewBox="0 0 180 800">
        <defs>{/* Paint filters shared via WatercolorDefs */}</defs>

        {/* Main vine with watercolor stroke */}
        <path
          d="M25,0 Q35,120 30,240 Q25,360 35,480 Q40,600 30,720 Q25,800 35,800"
          stroke={`rgba(90, 107, 71, ${vineStroke})`}
          stroke-width={strokeWidth}
          fill="none"
          stroke-linecap="round"
          filter="url(#wc-ink)"
        />
        <path
          d="M28,10 Q37,125 32,245 Q28,365 37,485 Q41,605 32,725 Q27,800 36,800"
          stroke={`rgba(139, 90, 60, ${vineStroke * 0.55})`}
          stroke-width={Number(strokeWidth) * 0.55}
          fill="none"
          stroke-linecap="round"
          filter="url(#wc-ink)"
        />

        {/* Botanical elements: layered pigment glazes with dried edges */}
        <g filter="url(#wc-paint)">
          <g transform="translate(30,108)">
            <ellipse rx="9" ry="4" fill={`rgba(90, 107, 71, ${glaze})`} />
            <ellipse rx="7" ry="2.7" cx="0.7" cy="0.5" fill={`rgba(90, 107, 71, ${glazeDeep})`} />
            <ellipse
              rx="9"
              ry="4"
              fill="none"
              stroke={`rgba(64, 80, 52, ${rim})`}
              stroke-width="1.1"
            />
          </g>
          <g transform="translate(33,226)">
            <ellipse rx="9" ry="4" fill={`rgba(90, 107, 71, ${glaze})`} />
            <ellipse rx="6.8" ry="2.6" cx="0.8" cy="0.4" fill={`rgba(90, 107, 71, ${glazeDeep})`} />
            <ellipse
              rx="9"
              ry="4"
              fill="none"
              stroke={`rgba(64, 80, 52, ${rim})`}
              stroke-width="1.1"
            />
          </g>
          <g transform="translate(29,346)">
            <ellipse rx="9" ry="4" fill={`rgba(90, 107, 71, ${glaze})`} />
            <ellipse rx="7" ry="2.6" cx="0.6" cy="0.6" fill={`rgba(90, 107, 71, ${glazeDeep})`} />
            <ellipse
              rx="9"
              ry="4"
              fill="none"
              stroke={`rgba(64, 80, 52, ${rim})`}
              stroke-width="1.1"
            />
          </g>

          {/* Flowers with glazing layers */}
          <g transform="translate(40,150)">
            <circle r="5" fill={`rgba(168, 181, 160, ${glaze})`} />
            <circle r="3.4" cx="0.5" cy="0.4" fill={`rgba(139, 90, 60, ${glazeDeep * 0.75})`} />
            <circle r="1.8" fill={`rgba(176, 146, 44, ${rim * 0.8})`} />
          </g>
          <g transform="translate(23,380)">
            <circle r="4.2" fill={`rgba(168, 181, 160, ${glaze})`} />
            <circle r="2.8" cx="0.4" cy="0.5" fill={`rgba(139, 90, 60, ${glazeDeep * 0.75})`} />
            <circle r="1.5" fill={`rgba(176, 146, 44, ${rim * 0.8})`} />
          </g>
        </g>
      </svg>
    )
  }

  {
    position === 'corner' && (
      <svg class="border-svg corner" viewBox="0 0 100 100">
        <defs>
          <filter id="cornerEmboss" x="-20%" y="-20%" width="140%" height="140%">
            <feGaussianBlur in="SourceAlpha" stdDeviation="3" />
            <feOffset dx="3" dy="3" result="offset" />
            <feFlood flood-color={`rgba(139, 90, 60, ${opacity + 0.1})`} />
            <feComposite in2="offset" operator="in" />
            <feMerge>
              <feMergeNode />
              <feMergeNode in="SourceGraphic" />
            </feMerge>
          </filter>
        </defs>

        <path
          d="M10,10 Q40,5 70,10 Q75,40 70,70 Q40,75 10,70 Q5,40 10,10"
          stroke={`rgba(139, 90, 60, ${opacity + 0.2})`}
          stroke-width={strokeWidth}
          fill="none"
          filter="url(#cornerEmboss)"
        />
        <circle
          cx="40"
          cy="40"
          r="12"
          fill={`rgba(90, 107, 71, ${opacity + 0.1})`}
          filter="url(#cornerEmboss)"
        />
      </svg>
    )
  }

  {
    position === 'bottom' && (
      <svg class="border-svg" viewBox="0 0 820 160" preserveAspectRatio="none">
        <defs>
          <filter id="roughTextureBottom" x="-20%" y="-20%" width="140%" height="140%">
            <feTurbulence baseFrequency="0.04" numOctaves="3" result="noise" seed="1" />
            <feDisplacementMap in="SourceGraphic" in2="noise" scale="2" />
          </filter>
          <filter id="shadowBottom" x="-20%" y="-20%" width="140%" height="140%">
            <feGaussianBlur in="SourceAlpha" stdDeviation="2" />
            <feOffset dx="1" dy="2" result="offset" />
            <feFlood flood-color="rgba(139, 90, 60, 0.2)" />
            <feComposite in2="offset" operator="in" />
            <feMerge>
              <feMergeNode />
              <feMergeNode in="SourceGraphic" />
            </feMerge>
          </filter>
        </defs>

        {/* Main border path (orange wave) */}
        <path
          d="M0,25 Q100,8 200,30 T400,18 T600,35 T800,25 L800,0 L0,0 Z"
          fill={`rgba(180,83,9,${opacity})`}
          filter="url(#roughTextureBottom)"
        />

        {/* Organic vine pattern - COMMENTED OUT */}
        {/*
      <path
        d="M50,50 Q150,30 250,55 T450,40 T650,60 T800,50"
        stroke={`rgba(139, 90, 60, ${opacity + 0.1})`}
        stroke-width={strokeWidth}
        fill="none"
        filter="url(#roughTextureBottom)"
      />
      */}

        {/* Scattered botanical elements */}
        <g fill={`rgba(90, 107, 71, ${opacity})`} filter="url(#shadowBottom)">
          <ellipse cx="120" cy="20" rx="10" ry="5" transform="rotate(45 120 20)" />
          <ellipse cx="320" cy="30" rx="8" ry="4" transform="rotate(-30 320 30)" />
          <ellipse cx="520" cy="23" rx="9" ry="5" transform="rotate(60 520 23)" />

          {/* Small flowers */}
          <circle cx="180" cy="45" r="3" fill={`rgba(168, 181, 160, ${opacity})`} />
          <circle cx="380" cy="35" r="2.5" fill={`rgba(168, 181, 160, ${opacity})`} />
          <circle cx="580" cy="50" r="3.5" fill={`rgba(168, 181, 160, ${opacity})`} />
        </g>
      </svg>
    )
  }

  {
    position === 'right' && (
      <svg class="border-svg vertical" viewBox="0 0 180 800">
        <defs>{/* Paint filters shared via WatercolorDefs */}</defs>

        {/* Main vine with watercolor stroke */}
        <path
          d="M25,0 Q35,120 30,240 Q25,360 35,480 Q40,600 30,720 Q25,800 35,800"
          stroke={`rgba(90, 107, 71, ${vineStroke})`}
          stroke-width={strokeWidth}
          fill="none"
          stroke-linecap="round"
          filter="url(#wc-ink)"
        />
        <path
          d="M28,10 Q37,125 32,245 Q28,365 37,485 Q41,605 32,725 Q27,800 36,800"
          stroke={`rgba(139, 90, 60, ${vineStroke * 0.55})`}
          stroke-width={Number(strokeWidth) * 0.55}
          fill="none"
          stroke-linecap="round"
          filter="url(#wc-ink)"
        />

        {/* Botanical elements: layered pigment glazes with dried edges */}
        <g filter="url(#wc-paint)">
          <g transform="translate(32,105)">
            <ellipse rx="9" ry="4" fill={`rgba(90, 107, 71, ${glaze})`} />
            <ellipse rx="7" ry="2.6" cx="0.7" cy="0.5" fill={`rgba(90, 107, 71, ${glazeDeep})`} />
            <ellipse
              rx="9"
              ry="4"
              fill="none"
              stroke={`rgba(64, 80, 52, ${rim})`}
              stroke-width="1.1"
            />
          </g>
          <g transform="translate(30,228)">
            <ellipse rx="9" ry="4" fill={`rgba(90, 107, 71, ${glaze})`} />
            <ellipse rx="6.6" ry="2.7" cx="0.8" cy="0.4" fill={`rgba(90, 107, 71, ${glazeDeep})`} />
            <ellipse
              rx="9"
              ry="4"
              fill="none"
              stroke={`rgba(64, 80, 52, ${rim})`}
              stroke-width="1.1"
            />
          </g>
          <g transform="translate(33,348)">
            <ellipse rx="9" ry="4" fill={`rgba(90, 107, 71, ${glaze})`} />
            <ellipse rx="7" ry="2.5" cx="0.6" cy="0.6" fill={`rgba(90, 107, 71, ${glazeDeep})`} />
            <ellipse
              rx="9"
              ry="4"
              fill="none"
              stroke={`rgba(64, 80, 52, ${rim})`}
              stroke-width="1.1"
            />
          </g>
          <g transform="translate(29,466)">
            <ellipse rx="8.5" ry="3.8" fill={`rgba(90, 107, 71, ${glaze})`} />
            <ellipse rx="6.5" ry="2.5" cx="0.7" cy="0.5" fill={`rgba(90, 107, 71, ${glazeDeep})`} />
            <ellipse
              rx="8.5"
              ry="3.8"
              fill="none"
              stroke={`rgba(64, 80, 52, ${rim})`}
              stroke-width="1.1"
            />
          </g>
          <g transform="translate(32,586)">
            <ellipse rx="9" ry="4" fill={`rgba(90, 107, 71, ${glaze})`} />
            <ellipse rx="6.8" ry="2.6" cx="0.8" cy="0.4" fill={`rgba(90, 107, 71, ${glazeDeep})`} />
            <ellipse
              rx="9"
              ry="4"
              fill="none"
              stroke={`rgba(64, 80, 52, ${rim})`}
              stroke-width="1.1"
            />
          </g>
          <g transform="translate(30,706)">
            <ellipse rx="9" ry="4" fill={`rgba(90, 107, 71, ${glaze})`} />
            <ellipse rx="7" ry="2.6" cx="0.6" cy="0.5" fill={`rgba(90, 107, 71, ${glazeDeep})`} />
            <ellipse
              rx="9"
              ry="4"
              fill="none"
              stroke={`rgba(64, 80, 52, ${rim})`}
              stroke-width="1.1"
            />
          </g>

          {/* Flowers with glazing layers */}
          <g transform="translate(45,150)">
            <circle r="3.6" fill={`rgba(168, 181, 160, ${glaze})`} />
            <circle r="2.4" cx="0.4" cy="0.3" fill={`rgba(139, 90, 60, ${glazeDeep * 0.75})`} />
            <circle r="1.2" fill={`rgba(176, 146, 44, ${rim * 0.8})`} />
          </g>
          <g transform="translate(40,300)">
            <circle r="3" fill={`rgba(168, 181, 160, ${glaze})`} />
            <circle r="2" cx="0.3" cy="0.3" fill={`rgba(139, 90, 60, ${glazeDeep * 0.75})`} />
            <circle r="1" fill={`rgba(176, 146, 44, ${rim * 0.8})`} />
          </g>
          <g transform="translate(48,500)">
            <circle r="4" fill={`rgba(168, 181, 160, ${glaze})`} />
            <circle r="2.6" cx="0.5" cy="0.4" fill={`rgba(139, 90, 60, ${glazeDeep * 0.75})`} />
            <circle r="1.3" fill={`rgba(176, 146, 44, ${rim * 0.8})`} />
          </g>
          <g transform="translate(42,650)">
            <circle r="3.4" fill={`rgba(168, 181, 160, ${glaze})`} />
            <circle r="2.2" cx="0.4" cy="0.3" fill={`rgba(139, 90, 60, ${glazeDeep * 0.75})`} />
            <circle r="1.1" fill={`rgba(176, 146, 44, ${rim * 0.8})`} />
          </g>
        </g>
      </svg>
    )
  }
</div>

<style>
  .botanical-border {
    pointer-events: none;
    z-index: 1;
  }

  /* Top and bottom borders span container width */
  .botanical-border.top,
  .botanical-border.bottom {
    position: absolute;
    left: 0;
    width: 100%;
  }

  /* Side borders use fixed positioning to float at sides */
  .botanical-border.left,
  .botanical-border.right {
    position: fixed;
  }

  /* Hide borders on smaller screens to avoid content interference */
  @media (max-width: 1200px) {
    .botanical-border.left,
    .botanical-border.right {
      display: none;
    }
  }

  @media (max-width: 768px) {
    /* Hide side borders completely on mobile */
    .botanical-border.left,
    .botanical-border.right,
    .botanical-border.bottom {
      display: none;
    }

    /* Show simplified top border on mobile - maintains aesthetic without clutter */
    .botanical-border.top {
      height: 48px;
      opacity: 0.5;
    }

    .botanical-border.top .border-svg {
      filter: drop-shadow(0 1px 2px rgba(139, 90, 60, 0.05));
    }
  }

  .border-svg {
    width: 100%;
    height: 100%;
    filter: drop-shadow(0 2px 4px rgba(139, 90, 60, 0.1));
  }

  .botanical-border.top {
    top: 0;
    height: 128px;
  }

  .botanical-border.bottom {
    bottom: 0;
    height: 128px;
    transform: scaleY(-1);
  }

  .botanical-border.left {
    top: 178px;
    left: 0;
    width: 160px;
    height: calc(100vh - 306px);
    opacity: 0.6;
  }

  .botanical-border.right {
    top: 178px;
    right: 0;
    width: 160px;
    height: calc(100vh - 306px);
    opacity: 0.4;
    transform: scaleX(-1);
  }

  .botanical-border.corner {
    width: 80px;
    height: 80px;
  }

  .botanical-border.corner:nth-of-type(1) {
    top: 12px;
    left: 12px;
  }

  .botanical-border.corner:nth-of-type(2) {
    top: 12px;
    right: 12px;
    transform: scaleX(-1);
  }

  .botanical-border.corner:nth-of-type(3) {
    bottom: 12px;
    left: 12px;
    transform: scaleY(-1);
  }

  .botanical-border.corner:nth-of-type(4) {
    bottom: 12px;
    right: 12px;
    transform: scale(-1);
  }
</style>
