---
/**
 * BotanicalBorder Component
 * Decorative SVG borders with botanical themes.
 * Uses shared SVG filters from SVGFilters.astro (include in layout).
 */
export interface Props {
  position?: 'top' | 'bottom' | 'left' | 'right' | 'corner';
  variant?: 'vine' | 'leaves' | 'flowers' | 'geometric';
  intensity?: 'light' | 'medium' | 'heavy';
  className?: string;
}

const { position = 'top', variant = 'vine', intensity = 'medium', className = '' } = Astro.props;

const opacity = intensity === 'light' ? 0.15 : intensity === 'medium' ? 0.25 : 0.35;
const strokeWidth = intensity === 'light' ? '2' : intensity === 'medium' ? '3' : '4';
---

<div class={`botanical-border ${position} ${variant} ${className}`}>
  {
    position === 'top' && (
      <svg class="border-svg" viewBox="0 0 820 160" preserveAspectRatio="none">
        <path
          d="M50,50 Q150,30 250,55 T450,40 T650,60 T800,50"
          stroke={`rgba(var(--border-walnut-rgb), ${opacity + 0.1})`}
          stroke-width={strokeWidth}
          fill="none"
          filter="url(#bb-gentleTexture)"
        />

        <g fill={`rgba(var(--border-moss-rgb), ${opacity})`} filter="url(#bb-softShadow)">
          <ellipse cx="120" cy="20" rx="8" ry="4" transform="rotate(45 120 20)" />
          <ellipse cx="320" cy="30" rx="7" ry="3.5" transform="rotate(-30 320 30)" />
          <ellipse cx="520" cy="23" rx="8" ry="4.5" transform="rotate(60 520 23)" />
          <circle
            cx="180"
            cy="45"
            r="2.5"
            fill={`rgba(var(--border-light-rgb), ${opacity + 0.1})`}
          />
          <circle cx="380" cy="35" r="2" fill={`rgba(var(--border-light-rgb), ${opacity + 0.1})`} />
          <circle
            cx="580"
            cy="50"
            r="2.8"
            fill={`rgba(var(--border-light-rgb), ${opacity + 0.1})`}
          />
        </g>
      </svg>
    )
  }

  {
    position === 'left' && (
      <svg class="border-svg vertical" viewBox="0 0 180 800">
        <path
          d="M25,0 Q35,120 30,240 Q25,360 35,480 Q40,600 30,720 Q25,800 35,800"
          stroke={`rgba(var(--border-walnut-rgb), ${opacity + 0.15})`}
          stroke-width={strokeWidth}
          fill="none"
          filter="url(#bb-organicTexture)"
        />

        <g fill={`rgba(var(--border-moss-rgb), ${opacity})`} filter="url(#bb-organicTexture)">
          <path d="M30,100 Q42,95 48,108 Q42,120 30,115 Q18,108 30,100" />
          <path
            d="M28,102 Q38,98 43,108 Q38,118 28,113 Q18,108 28,102"
            fill={`rgba(var(--border-brown-rgb),${opacity - 0.05})`}
          />
          <path d="M35,220 Q47,215 53,228 Q47,240 35,235 Q23,228 35,220" />
          <path
            d="M33,222 Q43,218 48,228 Q43,238 33,233 Q23,228 33,222"
            fill={`rgba(var(--border-brown-rgb),${opacity - 0.05})`}
          />
          <path d="M27,340 Q39,335 45,348 Q39,360 27,355 Q15,348 27,340" />
          <path
            d="M25,342 Q35,338 40,348 Q35,358 25,353 Q15,348 25,342"
            fill={`rgba(var(--border-brown-rgb),${opacity - 0.05})`}
          />
          <circle cx="40" cy="150" r="5" />
          <circle cx="38" cy="148" r="4" fill={`rgba(var(--border-brown-rgb),${opacity + 0.05})`} />
          <circle
            cx="37"
            cy="147"
            r="2.5"
            fill={`rgba(var(--border-light-rgb), ${opacity + 0.15})`}
          />
          <circle cx="23" cy="380" r="4" />
          <circle cx="21" cy="378" r="3" fill={`rgba(var(--border-brown-rgb),${opacity + 0.05})`} />
          <circle
            cx="20"
            cy="377"
            r="2"
            fill={`rgba(var(--border-light-rgb), ${opacity + 0.15})`}
          />
        </g>
      </svg>
    )
  }

  {
    position === 'corner' && (
      <svg class="border-svg corner" viewBox="0 0 100 100">
        <path
          d="M10,10 Q40,5 70,10 Q75,40 70,70 Q40,75 10,70 Q5,40 10,10"
          stroke={`rgba(var(--border-walnut-rgb), ${opacity + 0.2})`}
          stroke-width={strokeWidth}
          fill="none"
          filter="url(#bb-cornerEmboss)"
        />
        <circle
          cx="40"
          cy="40"
          r="12"
          fill={`rgba(var(--border-moss-rgb), ${opacity + 0.1})`}
          filter="url(#bb-cornerEmboss)"
        />
      </svg>
    )
  }

  {
    position === 'bottom' && (
      <svg class="border-svg" viewBox="0 0 820 160" preserveAspectRatio="none">
        <path
          d="M0,25 Q100,8 200,30 T400,18 T600,35 T800,25 L800,0 L0,0 Z"
          fill={`rgba(var(--border-ochre-rgb),${opacity})`}
          filter="url(#bb-roughTexture)"
        />

        <g fill={`rgba(var(--border-moss-rgb), ${opacity})`} filter="url(#bb-bottomShadow)">
          <ellipse cx="120" cy="20" rx="10" ry="5" transform="rotate(45 120 20)" />
          <ellipse cx="320" cy="30" rx="8" ry="4" transform="rotate(-30 320 30)" />
          <ellipse cx="520" cy="23" rx="9" ry="5" transform="rotate(60 520 23)" />
          <circle cx="180" cy="45" r="3" fill={`rgba(var(--border-light-rgb), ${opacity})`} />
          <circle cx="380" cy="35" r="2.5" fill={`rgba(var(--border-light-rgb), ${opacity})`} />
          <circle cx="580" cy="50" r="3.5" fill={`rgba(var(--border-light-rgb), ${opacity})`} />
        </g>
      </svg>
    )
  }

  {
    position === 'right' && (
      <svg class="border-svg vertical" viewBox="0 0 180 800">
        <path
          d="M25,0 Q35,120 30,240 Q25,360 35,480 Q40,600 30,720 Q25,800 35,800"
          stroke={`rgba(var(--border-walnut-rgb), ${opacity + 0.15})`}
          stroke-width={strokeWidth}
          fill="none"
          filter="url(#bb-organicTexture)"
        />

        <g fill={`rgba(var(--border-moss-rgb), ${opacity})`} filter="url(#bb-organicTexture)">
          <path d="M30,100 Q42,95 48,108 Q42,120 30,115 Q18,108 30,100" />
          <path d="M35,220 Q47,215 53,228 Q47,240 35,235 Q23,228 35,220" />
          <path d="M28,340 Q40,335 46,348 Q40,360 28,355 Q16,348 28,340" />
          <path d="M32,460 Q44,455 50,468 Q44,480 32,475 Q20,468 32,460" />
          <path d="M30,580 Q42,575 48,588 Q42,600 30,595 Q18,588 30,580" />
          <path d="M35,700 Q47,695 53,708 Q47,720 35,715 Q23,708 35,700" />
          <circle cx="45" cy="150" r="3" fill={`rgba(var(--border-light-rgb), ${opacity})`} />
          <circle cx="40" cy="300" r="2.5" fill={`rgba(var(--border-light-rgb), ${opacity})`} />
          <circle cx="48" cy="500" r="3.5" fill={`rgba(var(--border-light-rgb), ${opacity})`} />
          <circle cx="42" cy="650" r="3" fill={`rgba(var(--border-light-rgb), ${opacity})`} />
        </g>
      </svg>
    )
  }
</div>

<style>
  .botanical-border {
    --border-walnut-rgb: 139, 90, 60;
    --border-moss-rgb: 90, 107, 71;
    --border-light-rgb: 168, 181, 160;
    --border-ochre-rgb: 180, 83, 9;
    --border-brown-rgb: 139, 69, 19;

    pointer-events: none;
    z-index: 1;
  }

  @media (prefers-color-scheme: dark) {
    .botanical-border {
      --border-walnut-rgb: 201, 172, 143;
      --border-moss-rgb: 144, 159, 117;
      --border-light-rgb: 200, 213, 195;
      --border-ochre-rgb: 221, 149, 85;
      --border-brown-rgb: 199, 137, 87;
    }
  }

  .botanical-border.top,
  .botanical-border.bottom {
    position: absolute;
    left: 0;
    width: 100%;
  }

  .botanical-border.left,
  .botanical-border.right {
    position: fixed;
  }

  @media (max-width: 1200px) {
    .botanical-border.left,
    .botanical-border.right {
      display: none;
    }
  }

  .border-svg {
    width: 100%;
    height: 100%;
    filter: drop-shadow(0 2px 4px rgba(var(--border-walnut-rgb), 0.1));
  }

  .botanical-border.top {
    top: 0;
    height: 128px;
  }

  @media (max-width: 768px) {
    .botanical-border.left,
    .botanical-border.right,
    .botanical-border.bottom {
      display: none;
    }

    .botanical-border.top {
      height: 48px;
      opacity: 0.5;
    }

    .botanical-border.top .border-svg {
      filter: drop-shadow(0 1px 2px rgba(var(--border-walnut-rgb), 0.05));
    }
  }

  .botanical-border.bottom {
    bottom: 0;
    height: 128px;
    transform: scaleY(-1);
  }

  .botanical-border.left {
    top: 178px;
    left: 0;
    width: 160px;
    height: calc(100vh - 306px);
    opacity: 0.6;
  }

  .botanical-border.right {
    top: 178px;
    right: 0;
    width: 160px;
    height: calc(100vh - 306px);
    opacity: 0.4;
    transform: scaleX(-1);
  }

  .botanical-border.corner {
    width: 80px;
    height: 80px;
  }

  .botanical-border.corner:nth-of-type(1) {
    top: 12px;
    left: 12px;
  }

  .botanical-border.corner:nth-of-type(2) {
    top: 12px;
    right: 12px;
    transform: scaleX(-1);
  }

  .botanical-border.corner:nth-of-type(3) {
    bottom: 12px;
    left: 12px;
    transform: scaleY(-1);
  }

  .botanical-border.corner:nth-of-type(4) {
    bottom: 12px;
    right: 12px;
    transform: scale(-1);
  }
</style>
