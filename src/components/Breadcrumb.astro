---
export interface Props {
  items?: Array<{ label: string; href?: string }>;
  className?: string;
}

const { items, className = '' } = Astro.props;
---

<nav class={`breadcrumb ${className}`} aria-label="Breadcrumb navigation">
  <ol class="breadcrumb-list">
    <li class="breadcrumb-item">
      <a href="/" class="breadcrumb-link">
        <svg class="breadcrumb-icon" viewBox="0 0 20 20" width="14" height="14" aria-hidden="true">
          <path
            d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
        <span class="breadcrumb-text">Home</span>
      </a>
    </li>
    {
      items && items.length > 0 ? (
        items.map((item) => (
          <li class="breadcrumb-item">
            {item.href ? (
              <a href={item.href} class="breadcrumb-link">
                <span class="breadcrumb-text">{item.label}</span>
              </a>
            ) : (
              <span class="breadcrumb-text" aria-current="page">
                {item.label}
              </span>
            )}
          </li>
        ))
      ) : (
        <slot />
      )
    }
  </ol>
</nav>

<style>
  .breadcrumb {
    display: flex;
    align-items: center;
    padding: var(--space-xs) 0;
    margin-bottom: var(--space-sm);
  }

  .breadcrumb-list {
    display: flex;
    align-items: center;
    list-style: none;
    margin: 0;
    padding: 0;
    gap: 0;
    flex-wrap: wrap;
  }

  .breadcrumb-item {
    display: flex;
    align-items: center;
    gap: var(--space-xxs);
  }

  .breadcrumb-item:not(:last-child)::after {
    content: '/';
    color: var(--color-lichen);
    font-size: var(--text-sm);
    margin: 0 var(--space-xxs);
  }

  .breadcrumb-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xxs);
    color: var(--color-ink-light);
    text-decoration: none;
    font-size: var(--text-sm);
    font-weight: 500;
    transition: all var(--transition-fast);
    padding: var(--space-xxs) var(--space-xs);
    border-radius: 4px;
  }

  .breadcrumb-link:hover {
    color: var(--color-walnut);
    background: color-mix(in srgb, var(--color-sage) 15%, transparent);
  }

  .breadcrumb-link:focus {
    outline: 2px solid var(--color-tansy);
    outline-offset: 2px;
  }

  .breadcrumb-text {
    letter-spacing: 0.01em;
  }

  .breadcrumb-icon {
    flex-shrink: 0;
    opacity: 0.7;
    transition: opacity var(--transition-fast);
  }

  .breadcrumb-link:hover .breadcrumb-icon {
    opacity: 1;
    transform: translateX(-2px);
  }

  /* Mobile: Horizontal scroll for long breadcrumbs */
  @media (max-width: 640px) {
    .breadcrumb {
      overflow-x: auto;
      overflow-y: hidden;
      padding-inline: var(--space-sm);
      margin-inline: calc(var(--space-sm) * -1);
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }

    .breadcrumb::-webkit-scrollbar {
      display: none;
    }

    .breadcrumb-list {
      flex-wrap: nowrap;
    }

    .breadcrumb-item {
      flex-shrink: 0;
    }
  }

  /* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .breadcrumb-icon {
      transition: none;
    }

    .breadcrumb-link:hover .breadcrumb-icon {
      transform: none;
    }
  }
</style>
