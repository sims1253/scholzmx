---
export interface Props {
  className?: string;
}

const { className = '' } = Astro.props;
---

<div class={`font-size-control ${className}`}>
  <button
    id="font-size-trigger"
    class="font-size-trigger"
    aria-expanded="false"
    aria-controls="font-size-dropdown"
    type="button"
  >
    <span class="font-size-icon">Aa</span>
    <svg class="chevron" viewBox="0 0 24 24" width="12" height="12" aria-hidden="true">
      <path
        d="M6 9l6 6 6-6"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
    </svg>
  </button>

  <div
    id="font-size-dropdown"
    class="font-size-dropdown"
    role="radiogroup"
    aria-label="Font size"
    aria-hidden="true"
  >
    <button
      class="font-size-option"
      data-size="xsmall"
      role="radio"
      aria-checked="false"
      type="button"
    >
      <span class="option-label" data-size="xsmall">Aa</span>
      <span class="option-name">Small</span>
    </button>
    <button
      class="font-size-option"
      data-size="medium"
      role="radio"
      aria-checked="true"
      type="button"
    >
      <span class="option-label" data-size="medium">Aa</span>
      <span class="option-name">Default</span>
    </button>
    <button
      class="font-size-option"
      data-size="xlarge"
      role="radio"
      aria-checked="false"
      type="button"
    >
      <span class="option-label" data-size="xlarge">Aa</span>
      <span class="option-name">Large</span>
    </button>
  </div>
</div>

<style>
  .font-size-control {
    position: relative;
    display: flex;
    align-items: center;
  }

  .font-size-trigger {
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 4px 8px;
    background: transparent;
    border: 1px solid var(--color-lichen);
    border-radius: 6px;
    color: var(--color-walnut);
    cursor: pointer;
    transition:
      background-color 0.15s ease-out,
      border-color 0.15s ease-out;
    font-family: var(--font-heading);
    font-size: 13px;
  }

  .font-size-trigger:hover {
    background: color-mix(in srgb, var(--color-sage) 10%, transparent);
    border-color: var(--color-sage);
  }

  .font-size-trigger:focus {
    outline: 2px solid var(--color-tansy);
    outline-offset: 1px;
    border-color: var(--color-sage);
  }

  .font-size-icon {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 14px;
    line-height: 1;
  }

  .chevron {
    flex-shrink: 0;
    transition: transform 0.2s ease-out;
  }

  .font-size-trigger[aria-expanded='true'] .chevron {
    transform: rotate(180deg);
  }

  .font-size-dropdown {
    position: absolute;
    top: calc(100% + 4px);
    right: 0;
    min-width: 120px;
    background: var(--color-surface);
    border: 1px solid var(--color-lichen);
    border-radius: 8px;
    box-shadow:
      0 4px 12px color-mix(in srgb, var(--color-walnut) 8%, transparent),
      0 2px 4px color-mix(in srgb, var(--color-sage) 10%, transparent);
    padding: 4px;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-8px);
    transition:
      opacity 0.2s ease-out,
      visibility 0.2s ease-out,
      transform 0.2s ease-out;
    z-index: 1000;
  }

  .font-size-dropdown[aria-hidden='false'] {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .font-size-option {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    width: 100%;
    padding: 8px 12px;
    background: transparent;
    border: none;
    border-radius: 6px;
    color: var(--color-walnut);
    cursor: pointer;
    transition: background-color 0.15s ease-out;
    text-align: left;
  }

  .font-size-option:hover {
    background: color-mix(in srgb, var(--color-sage) 15%, transparent);
  }

  .font-size-option:focus {
    outline: 2px solid var(--color-tansy);
    outline-offset: 2px;
    background: color-mix(in srgb, var(--color-sage) 15%, transparent);
  }

  .font-size-option.active {
    background: var(--color-moss);
    color: var(--color-parchment-light);
  }

  .option-label {
    font-family: var(--font-heading);
    font-weight: 600;
  }

  .option-label[data-size='xsmall'] {
    font-size: 12px;
  }

  .option-label[data-size='medium'] {
    font-size: 14px;
  }

  .option-label[data-size='xlarge'] {
    font-size: 16px;
  }

  .option-name {
    font-family: var(--font-heading);
    font-size: 12px;
    font-weight: 500;
    opacity: 0.8;
    margin-left: auto;
  }

  /* Remove hover effects on touch devices */
  @media (hover: none) and (pointer: coarse) {
    .font-size-trigger:hover {
      background: transparent;
      border-color: var(--color-lichen);
    }

    .font-size-option:hover {
      background: transparent;
    }

    .font-size-option:active {
      background: color-mix(in srgb, var(--color-sage) 15%, transparent);
    }
  }

  /* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .font-size-dropdown {
      transition: none;
    }

    .chevron {
      transition: none;
    }

    .font-size-trigger[aria-expanded='true'] .chevron {
      transform: none;
    }
  }
</style>

<script>
  const STORAGE_KEY = 'font-size-preference';
  const FONT_SIZES = {
    xsmall: 0.8,
    medium: 1,
    xlarge: 1.3,
  } as const;

  type FontSize = keyof typeof FONT_SIZES;

  function getStoredSize(): FontSize {
    try {
      const stored = localStorage.getItem(STORAGE_KEY);
      if (stored && (stored === 'xsmall' || stored === 'medium' || stored === 'xlarge')) {
        return stored;
      }
    } catch {
      // Ignore storage errors
    }

    // Default to medium
    return 'medium';
  }

  function setStoredSize(size: FontSize): void {
    try {
      localStorage.setItem(STORAGE_KEY, size);
    } catch {
      // Ignore storage errors
    }
  }

  function applyFontSize(size: FontSize): void {
    const root = document.documentElement;
    const scale = FONT_SIZES[size];

    // For medium (default), remove custom property to let CSS clamp() work naturally
    if (size === 'medium') {
      root.style.removeProperty('--font-scale');
      return;
    }

    // Set CSS custom property for font scale instead of fixed pixel value
    // This preserves CSS clamp() responsiveness on viewport resize
    root.style.setProperty('--font-scale', String(scale));
  }

  function handleFontSizeChange(size: FontSize): void {
    setStoredSize(size);
    applyFontSize(size);
    updateActiveState(size);
  }

  function updateActiveState(size: FontSize): void {
    // Update trigger icon size
    const trigger = document.getElementById('font-size-trigger');
    if (trigger) {
      const icon = trigger.querySelector('.font-size-icon') as HTMLElement;
      if (icon) {
        const iconSizes = { xsmall: '12px', medium: '14px', xlarge: '16px' };
        icon.style.fontSize = iconSizes[size];
      }
    }

    // Update dropdown option states
    document.querySelectorAll('.font-size-option').forEach((option) => {
      const optionSize = (option as HTMLElement).dataset.size as FontSize;
      if (optionSize === size) {
        option.classList.add('active');
        option.setAttribute('aria-checked', 'true');
      } else {
        option.classList.remove('active');
        option.setAttribute('aria-checked', 'false');
      }
    });
  }

  function toggleDropdown(): void {
    const trigger = document.getElementById('font-size-trigger') as HTMLButtonElement;
    const dropdown = document.getElementById('font-size-dropdown') as HTMLElement;

    if (!trigger || !dropdown) return;

    const isOpen = trigger.getAttribute('aria-expanded') === 'true';

    if (isOpen) {
      trigger.setAttribute('aria-expanded', 'false');
      dropdown.setAttribute('aria-hidden', 'true');
    } else {
      trigger.setAttribute('aria-expanded', 'true');
      dropdown.setAttribute('aria-hidden', 'false');
    }
  }

  function closeDropdown(): void {
    const trigger = document.getElementById('font-size-trigger');
    const dropdown = document.getElementById('font-size-dropdown');

    if (trigger && dropdown) {
      trigger.setAttribute('aria-expanded', 'false');
      dropdown.setAttribute('aria-hidden', 'true');
    }
  }

  function initFontSizeControl(): void {
    const trigger = document.getElementById('font-size-trigger') as HTMLButtonElement;
    const dropdown = document.getElementById('font-size-dropdown') as HTMLElement;

    if (!trigger || !dropdown) return;

    // Get initial preference
    const initialSize = getStoredSize();

    // Apply initial size
    applyFontSize(initialSize);
    updateActiveState(initialSize);

    // Toggle dropdown on trigger click
    trigger.addEventListener('click', (e) => {
      e.stopPropagation();
      toggleDropdown();
    });

    // Handle option clicks
    dropdown.querySelectorAll('.font-size-option').forEach((option) => {
      option.addEventListener('click', (e) => {
        e.stopPropagation();
        const size = (option as HTMLElement).dataset.size as FontSize;
        if (size && (size === 'xsmall' || size === 'medium' || size === 'xlarge')) {
          handleFontSizeChange(size);
          closeDropdown();
          trigger.focus();
        }
      });

      // Keyboard support
      option.addEventListener('keydown', (e: Event) => {
        const keyboardEvent = e as KeyboardEvent;
        if (keyboardEvent.key === 'Enter' || keyboardEvent.key === ' ') {
          e.preventDefault();
          const size = (option as HTMLElement).dataset.size as FontSize;
          if (size && (size === 'xsmall' || size === 'medium' || size === 'xlarge')) {
            handleFontSizeChange(size);
            closeDropdown();
            trigger.focus();
          }
        }
      });
    });

    // Close dropdown when clicking outside
    document.addEventListener('click', (e) => {
      if (!trigger.contains(e.target as Node) && !dropdown.contains(e.target as Node)) {
        closeDropdown();
      }
    });

    // Close dropdown on escape key
    document.addEventListener('keydown', (e) => {
      if ((e as KeyboardEvent).key === 'Escape') {
        closeDropdown();
        // Return focus to trigger when closing via Escape
        if (
          document.activeElement &&
          (trigger.contains(document.activeElement) || dropdown.contains(document.activeElement))
        ) {
          trigger.focus();
        }
      }
    });

    // Arrow-key navigation between options when menu is open
    dropdown.addEventListener('keydown', (e) => {
      const keyboardEvent = e as KeyboardEvent;
      if (
        keyboardEvent.key !== 'ArrowDown' &&
        keyboardEvent.key !== 'ArrowUp' &&
        keyboardEvent.key !== 'Home' &&
        keyboardEvent.key !== 'End'
      ) {
        return;
      }

      const options = Array.from(dropdown.querySelectorAll<HTMLElement>('.font-size-option'));
      if (options.length === 0) return;

      const currentIndex = options.indexOf(document.activeElement as HTMLElement);

      let nextIndex: number;
      if (keyboardEvent.key === 'Home') {
        nextIndex = 0;
      } else if (keyboardEvent.key === 'End') {
        nextIndex = options.length - 1;
      } else {
        const direction = keyboardEvent.key === 'ArrowDown' ? 1 : -1;
        nextIndex =
          currentIndex === -1 ? 0 : (currentIndex + direction + options.length) % options.length;
      }

      e.preventDefault();
      options[nextIndex].focus();
    });
  }

  // Initialize after DOM is ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initFontSizeControl);
  } else {
    initFontSizeControl();
  }
</script>
