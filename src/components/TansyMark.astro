---
/** A tansy corymb: five button flowers on one stem. The site's mark. */
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<svg class:list={['tansy-mark', className]} viewBox="0 0 32 32" aria-hidden="true">
  <path
    class="tansy-stem"
    d="M16 31V19M16 19 8.5 10.5M16 19l-2.5-11M16 19l3-11.5M16 19l7.5-8M16 19v-6"
  ></path>
  <circle class="tansy-head" cx="8.5" cy="10" r="3.3"></circle>
  <circle class="tansy-head" cx="13.3" cy="6.6" r="3.3"></circle>
  <circle class="tansy-head" cx="19.2" cy="6.4" r="3.3"></circle>
  <circle class="tansy-head" cx="23.6" cy="10.4" r="3.3"></circle>
  <circle class="tansy-head" cx="16" cy="11.6" r="3.3"></circle>
</svg>

<style>
  .tansy-mark {
    width: 1.1em;
    height: 1.1em;
    overflow: visible;
  }

  .tansy-stem {
    fill: none;
    stroke: var(--color-moss);
    stroke-width: 1.4;
    stroke-linecap: round;
  }

  .tansy-head {
    fill: var(--color-tansy);
    stroke: color-mix(in srgb, var(--color-ochre) 70%, var(--color-ink-dark));
    stroke-width: 1;
  }
</style>
