---
/**
 * A niche in the grotto's wall, keeping the thing a part of the site is made at: the
 * writing desk, the pantry shelf, the workbench, the folio. The drawing and its name
 * are one link; whatever the niche currently holds goes in the slot beneath.
 *
 * By day the recess holds the canopy's shade and the thing's shadow leans with the sun
 * (the --sun-* properties set in BaseLayout). After dark the recess goes black and the
 * light that fills it on hover or focus is the torch's. Nothing moves on its own.
 */
interface Props {
  kind: 'desk' | 'pantry' | 'bench' | 'folio' | 'bare';
  href: string;
  name: string;
  /** What the drawing shows, e.g. "the writing desk". */
  caption?: string;
}

const { kind, href, name, caption } = Astro.props;
