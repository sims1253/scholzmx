---
/**
 * A niche in the grotto's wall, keeping the thing a part of the site is made at: the
 * writing desk, the workbench, the pantry shelf, the folio. The drawing and its name
 * are one link to that part of the site; the newest thing kept there goes beneath.
 *
 * By day the recess holds the canopy's shade and the thing's shadow leans with the sun
 * (the --sun-* properties set in BaseLayout). After dark the recess goes black and the
 * light that fills it on hover or focus is the torch's.
 *
 * Each furnished niche is inhabited, and when a reader's pointer or keyboard comes to it
 * (on a touch screen: when it first scrolls into view) a small critter gets up to
 * something, in a scene of a few seconds that ends where it began:
 *   desk    a mouse blows out the candle; when it is lit again, the mouse has been busy
 *   bench   a beetle runs the wheel that hoists the flag, until the flag pulls back
 *   pantry  a hedgehog sneezes under the shelf, and the apple comes down
 *   folio   a bookworm eats through the pages, until the lens finds it
 * Each scene has two endings, picked at random. Only the candle and the honey jar stir
 * on their own, and only while on screen. Only transform and opacity move. Without
 * motion (base.css stops all animation) hover or focus shows the scene's punchline.
 */
interface Kept {
  href: string;
  title: string;
  /** A short name set before the title, e.g. a project's own name: "ry: Static Checker for R". */
  name?: string;
  when?: string;
}

type Kind = 'desk' | 'pantry' | 'bench' | 'folio' | 'bare';

interface Props {
  kind: Kind;
  /** The newest thing kept in the niche. */
  kept?: Kept | undefined;
  /** The bare niche has no room of its own and is told where it leads. */
  href?: string;
  name?: string;
  caption?: string;
}

/** Where each niche leads, what it shows, and how long its scene runs. */
const ROOMS: Record<Kind, { href: string; name: string; caption?: string; sceneMs?: number }> = {
  desk: { href: '/blog', name: 'Blog', caption: 'the writing desk', sceneMs: 3400 },
  bench: { href: '/projects', name: 'Projects', caption: 'the workbench', sceneMs: 4000 },
  pantry: { href: '/recipes', name: 'Recipes', caption: 'the pantry shelf', sceneMs: 3600 },
  folio: { href: '/research', name: 'Research', caption: 'the folio', sceneMs: 3600 },
  bare: { href: '/', name: 'Back home' },
};

const { kind, kept, ...overrides } = Astro.props;
const { href, name, caption, sceneMs } = { ...ROOMS[kind], ...overrides };

// The line under a niche has room for about this many characters in three lines on the
// narrowest wall. A longer title is cut there after a whole word, in its own words, and
// not on a word that only leads to the next one.
const KEPT_LENGTH = 60;
const LEADS_ON = new Set('a an and as at by for from in into of on or the to with'.split(' '));
const shorten = (title: string) => {
  if (title.length <= KEPT_LENGTH) return title;
  const words = title
    .slice(0, KEPT_LENGTH + 1)
    .split(' ')
    .slice(0, -1);
  while (words.length > 1 && LEADS_ON.has((words.at(-1) ?? '').toLowerCase())) words.pop();
  return `${words.join(' ').replace(/[,:;–—-]+$/, '')}…`;
};
const shown = kept && shorten(kept.title);
const whole = kept && (kept.name ? `${kept.name}: ${kept.title}` : kept.title);
const cut = kept !== undefined && shown !== kept.title;
// A thing kept elsewhere (a repository, a paper's PDF) says that it leaves the site.
const leaves = kept !== undefined && /^https?:\/\//.test(kept.href);
