<style>
  .niche {
    --niche-shade: rgb(var(--sun-shade, 58 78 26) / 0.24);
    --niche-light: rgb(255 226 150 / 0.6);
    --cast-shade: rgb(var(--sun-shade, 58 78 26) / 0.42);
    --cast-skew: var(--sun-skew, 0deg);
    --cast-stretch: var(--sun-stretch, 1);

    display: grid;
    justify-items: center;
    align-content: start;
    text-align: center;
  }

  /* Torchlight: the recess is dark, and what lights it is the torch. */
  :global(:root[data-theme='dark']) .niche {
    --niche-shade: rgb(8 6 3 / 0.7);
    --niche-light: rgb(255 158 64 / 0.5);
    --cast-shade: rgb(8 6 3 / 0.55);
    --cast-skew: -14deg;
    --cast-stretch: 1.2;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .niche {
      --niche-shade: rgb(8 6 3 / 0.7);
      --niche-light: rgb(255 158 64 / 0.5);
      --cast-shade: rgb(8 6 3 / 0.55);
      --cast-skew: -14deg;
      --cast-stretch: 1.2;
    }
  }

  .niche-door {
    display: grid;
    justify-items: center;
    width: 100%;
    color: var(--color-text-primary);
    text-decoration: none;
    border-radius: 4px;
  }

  .niche-door:focus-visible {
    outline: 2px solid var(--color-moss);
    outline-offset: 4px;
    background: none;
  }

  svg {
    width: 100%;
    max-width: 11rem;
    height: auto;
    overflow: visible;
  }

  .niche-name {
    margin-top: 0.3rem;
    font-family: var(--font-label);
    font-size: var(--text-lg);
    letter-spacing: 0.04em;
    line-height: 1.1;
  }

  .niche-caption {
    font-family: var(--font-heading);
    font-size: var(--text-sm);
    font-style: italic;
    line-height: 1.3;
    color: var(--color-text-muted);
  }

  .niche-door:hover .niche-name,
  .niche-door:focus-visible .niche-name {
    color: var(--color-link-hover);
  }

  /* Ink and washes: everything drawn takes its colour from the page's ink and botanicals. */
  .ink {
    stroke: var(--color-ink-dark);
  }

  .stone {
    stroke-width: 1.1;
    opacity: 0.8;
  }

  .recess {
    fill: var(--niche-shade);
  }

  .light-stop {
    stop-color: var(--niche-light);
  }

  .light {
    opacity: 0;
    transition: opacity 0.35s ease;
  }

  /* The shadow a thing throws on its sill leans with the sun, or away from the torch. */
  .cast {
    fill: var(--cast-shade);
    transform: translateY(-4px) skewX(var(--cast-skew)) scaleX(var(--cast-stretch));
    transform-box: fill-box;
    transform-origin: 50% 100%;
  }

  .thing {
    transform-box: fill-box;
    transform-origin: 50% 100%;
    transition: transform 0.35s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .niche-door:hover .light,
  .niche-door:focus-visible .light {
    opacity: 1;
  }

  .niche-door:hover .thing,
  .niche-door:focus-visible .thing {
    transform: translateY(-3px);
  }

  .sheet {
    fill: var(--print-sheet);
  }

  .tape {
    fill: var(--tape-strip);
    stroke: var(--color-ink-dark);
    stroke-width: 0.6;
    opacity: 0.95;
  }

  .wash {
    stroke: none;
  }

  .wash--ink {
    fill: var(--color-ink-dark);
  }

  .wash--moss {
    fill: color-mix(in srgb, var(--color-moss) 60%, var(--color-parchment));
  }

  .wash--grape {
    fill: color-mix(in srgb, var(--color-clay) 70%, var(--color-parchment));
  }

  .wash--tansy {
    fill: color-mix(in srgb, var(--color-tansy) 60%, var(--color-parchment));
  }

  .wash--squash {
    fill: color-mix(in srgb, var(--color-ochre) 75%, var(--color-tansy));
  }

  .speckle {
    fill: var(--color-parchment);
  }

  .speckle .eye {
