<script>
  // A niche's scene plays when a pointer comes to it or the keyboard focuses one of its
  // links; on a touch screen, where a tap follows the link, it plays once as the niche
  // first scrolls into view. Niches that arrive together take turns, so the wall stirs in
  // one place at a time. A scene runs to its end and is not cut short or looped.
  // Without motion there is nothing to play: CSS shows the punchline on hover or focus.
  const still = matchMedia('(prefers-reduced-motion: reduce)');
  const touch = matchMedia('(hover: none)');
  const TAKES = 2;

  const awake = new IntersectionObserver((entries) => {
    for (const entry of entries) entry.target.classList.toggle('is-awake', entry.isIntersecting);
  });
  let turn = Promise.resolve();
  const arriving = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        const niche = entry.target;
        if (!entry.isIntersecting || !(niche instanceof HTMLElement)) continue;
        arriving.unobserve(niche);
        turn = turn.then(() => play(niche)).then(() => pause(BETWEEN_MS));
      }
    },
    { threshold: 0.6 }
  );

  const busy = new WeakSet<HTMLElement>();
  const BETWEEN_MS = 900;
  const pause = (ms: number) => new Promise<void>((done) => window.setTimeout(done, ms));

  /** Plays a niche's scene; settles when it is over, or at once if there is none to play. */
  async function play(niche: HTMLElement): Promise<void> {
    if (still.matches || busy.has(niche)) return;
    busy.add(niche);
    // Each scene has more than one ending; which one plays is up to chance.
    niche.dataset.take = String(1 + Math.floor(Math.random() * TAKES));
    niche.classList.remove('is-playing');
    // Flush styles between removing and adding the class, so the scene starts over.
    void niche.getBoundingClientRect();
    niche.classList.add('is-playing');
    await pause(Number(niche.dataset.scene));
    niche.classList.remove('is-playing');
    busy.delete(niche);
  }

  for (const niche of document.querySelectorAll<HTMLElement>('.niche')) {
    awake.observe(niche);
    if (!niche.dataset.scene) continue;
    niche.addEventListener('pointerenter', (event) => {
      if (event.pointerType !== 'touch') void play(niche);
    });
    niche.addEventListener('focusin', () => void play(niche));
    if (touch.matches) arriving.observe(niche);
  }
</script>

<style>
  .niche {
    --niche-shade: rgb(var(--sun-shade, 58 78 26) / 0.24);
    --niche-light: rgb(255 226 150 / 0.6);
    --cast-shade: rgb(var(--sun-shade, 58 78 26) / 0.42);
    --cast-skew: var(--sun-skew, 0deg);
    --cast-stretch: var(--sun-stretch, 1);
    --candle: 0.55;

    display: grid;
    justify-items: center;
    align-content: start;
    text-align: center;
  }

  /* Torchlight: the recess is dark, and what lights it is the torch. */
  :global(:root[data-theme='dark']) .niche {
    --niche-shade: rgb(8 6 3 / 0.7);
    --niche-light: rgb(255 158 64 / 0.5);
    --cast-shade: rgb(8 6 3 / 0.55);
    --cast-skew: -14deg;
    --cast-stretch: 1.2;
    --candle: 1;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .niche {
      --niche-shade: rgb(8 6 3 / 0.7);
      --niche-light: rgb(255 158 64 / 0.5);
      --cast-shade: rgb(8 6 3 / 0.55);
      --cast-skew: -14deg;
      --cast-stretch: 1.2;
      --candle: 1;
    }
  }

  .niche-stage {
    width: min(100%, var(--niche-size, 11rem));
  }

  .niche-door {
    display: grid;
    justify-items: center;
    width: 100%;
    color: var(--color-text-primary);
    text-decoration: none;
    border-radius: 4px;
  }

  .niche-door:focus-visible {
    outline: 2px solid var(--color-moss);
    outline-offset: 4px;
    background: none;
  }

  svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  /* The name is the way in, so it is the one that looks like a link. */
  .niche-name {
    margin-top: 0.3rem;
    font-family: var(--font-label);
    font-variant-caps: small-caps;
    font-size: var(--niche-name-size, var(--text-lg));
    letter-spacing: 0.04em;
    line-height: 1.1;
    color: var(--color-link);
    text-decoration: underline;
    text-decoration-color: var(--color-underline);
    text-decoration-thickness: max(0.06em, 1px);
    text-underline-offset: 0.2em;
  }

  .niche-caption {
    font-family: var(--font-heading);
    font-size: var(--text-sm);
    font-style: italic;
    line-height: 1.3;
    color: var(--color-text-muted);
  }

  .niche-door:hover .niche-name,
  .niche-door:focus-visible .niche-name {
    color: var(--color-link-hover);
    text-decoration-color: var(--color-underline-hover);
  }

  /* What the niche keeps: its newest thing, and when it was made. It is set quieter than
     the name above it. A long title arrives shortened after a whole word and wraps as it
     needs; the whole title is still there to be read out. */
  .kept {
    max-width: min(var(--kept-width, 13rem), 100%);
    margin: 0.45rem 0 0;
    font-size: var(--kept-size, var(--text-sm));
    line-height: 1.4;
    hyphens: manual;
    text-wrap: balance;
  }

  .kept a {
    color: var(--color-text-secondary);
    text-decoration-color: color-mix(in srgb, currentcolor 30%, transparent);
    text-decoration-thickness: 1px;
  }

  .kept a:hover {
    color: var(--color-link-hover);
  }

  /* The arrow the site's prose puts after a link that leaves it (base.css). */
  .kept a[href^='http']::after {
    content: '↗';
    display: inline-block;
    margin-left: 0.3em;
    font-size: 0.75em;
    line-height: 0;
    vertical-align: super;
    opacity: 0.7;
  }

  .kept-when {
    display: block;
    margin-top: 0.15rem;
    font-style: italic;
    color: var(--color-text-muted);
    font-variant-numeric: oldstyle-nums;
  }

  /* ===== Ink and washes: colour from the page's ink and botanicals ===== */

  .ink {
    stroke: var(--color-ink-dark);
  }

  .dot {
    fill: var(--color-ink-dark);
  }

  .stone {
    stroke-width: 1.1;
    opacity: 0.8;
  }

  .recess {
    fill: var(--niche-shade);
  }

  .light-stop {
    stop-color: var(--niche-light);
  }

  .light {
    opacity: 0;
    transition: opacity 0.35s ease;
  }

  .niche-door:hover .light,
  .niche-door:focus-visible .light,
  .is-playing .light {
    opacity: 1;
  }

  /* The shadow a thing throws on its sill leans with the sun, or away from the torch. */
  .cast {
    fill: var(--cast-shade);
    transform: translateY(-4px) skewX(var(--cast-skew)) scaleX(var(--cast-stretch));
    transform-box: fill-box;
    transform-origin: 50% 100%;
  }

  .sheet {
    fill: var(--print-sheet);
  }

  .wash {
    stroke: none;
  }

  .wash--ink {
    fill: var(--color-ink-dark);
  }

  .wash--moss {
    fill: color-mix(in srgb, var(--color-moss) 60%, var(--color-parchment));
  }

  .wash--grape {
    fill: color-mix(in srgb, var(--color-clay) 70%, var(--color-parchment));
  }

  .wash--tansy {
    fill: color-mix(in srgb, var(--color-tansy) 60%, var(--color-parchment));
  }

  .wash--squash {
    fill: color-mix(in srgb, var(--color-ochre) 75%, var(--color-tansy));
  }

  .wash--apple {
    fill: color-mix(in srgb, var(--color-clay) 80%, var(--color-ochre));
  }

  .fur {
    fill: color-mix(in srgb, var(--color-ink-medium) 35%, var(--color-parchment));
  }

  .ear-in {
    fill: color-mix(in srgb, var(--color-clay) 45%, var(--color-parchment));
  }

  .spines {
    fill: color-mix(in srgb, var(--color-ochre) 40%, var(--color-ink-medium));
  }

  .shell {
    fill: color-mix(in srgb, var(--color-moss) 55%, var(--color-ink-dark));
  }

  .hole {
    fill: color-mix(in srgb, var(--color-ink-dark) 85%, transparent);
  }

  /* Every moving part moves about a point given in the drawing's own units. */
  svg * {
    transform-box: view-box;
  }

  /* ===== What stirs on its own, and only while on screen (the script sets .is-awake) ===== */

  .flame,
  .candle-glow,
  .honey {
    animation-play-state: paused;
  }

  .is-awake :is(.flame, .candle-glow, .honey) {
    animation-play-state: running;
  }

  .flame {
    fill: var(--color-tansy);
    stroke: color-mix(in srgb, var(--color-ochre) 70%, var(--color-ink-dark));
    stroke-width: 0.6;
    transform-origin: 62px 145px;
    animation: flicker 2.3s ease-in-out infinite;
  }

  .candle-stop {
    stop-color: var(--color-tansy);
  }

  .candle-glow {
    opacity: calc(var(--candle) * 0.8);
    transform-origin: 62px 138px;
    animation: glow 2.3s ease-in-out infinite;
  }

  @keyframes flicker {
    0%,
    100% {
      transform: rotate(0) scale(1, 1);
    }
    18% {
      transform: rotate(-4deg) scale(0.92, 1.08);
    }
    31% {
      transform: rotate(3deg) scale(1.04, 0.94);
    }
    47% {
      transform: rotate(-2deg) scale(0.96, 1.1);
    }
    63% {
      transform: rotate(5deg) scale(1, 0.9);
    }
    82% {
      transform: rotate(-1deg) scale(0.95, 1.04);
    }
  }

  @keyframes glow {
    0%,
    100% {
      transform: scale(1);
    }
    31% {
      transform: scale(0.9);
    }
    63% {
      transform: scale(1.06);
    }
  }

  .honey-run {
    fill: none;
    stroke: color-mix(in srgb, var(--color-tansy) 70%, var(--color-ochre));
    stroke-width: 1.4;
    stroke-linecap: round;
    opacity: 0.8;
  }

  /* Honey gathers under the jar, lets go, and lands on the floor. */
  .honey {
    transform-origin: 142px 146px;
    animation: honey-drip 9s ease-in infinite;
  }

  @keyframes honey-drip {
    0% {
      transform: translate(0, 0) scale(0.15, 0.15);
      opacity: 1;
    }
    58% {
      transform: translate(0, 0) scale(1, 1);
    }
    64% {
      transform: translate(0, 1px) scale(0.85, 1.3);
    }
    70% {
      transform: translate(0, 68px) scale(0.8, 1.35);
      opacity: 1;
    }
    72% {
      transform: translate(0, 72px) scale(1.8, 0.3);
      opacity: 0.9;
    }
    82%,
    100% {
      transform: translate(0, 72px) scale(1.8, 0.3);
      opacity: 0;
    }
  }

  /* ===== The scenes =====
     Each part's keyframes span the whole scene (--scene, set from the niche's ROOMS entry),
     so the percentages of one scene line up across its parts. A scene ends where it began. */

  /* ----- The writing desk: the mouse behind the letter -----
     It peeks out, puffs out its cheeks and blows the candle out. In the dark its eyes
     slip along the letter. When the candle catches again, either there are inky
     pawprints across the letter, or the inkwell and the quill have gone, and the mouse
     looks out wearing them as a helmet and plume. */

  .mouse {
    transform: translateY(26px);
    transform-origin: 99px 130px;
  }

  .cheek {
    transform: scale(0);
    transform-origin: 90px 125.5px;
  }

  .puff,
  .smoke,
  .prints,
  .hat,
  .dusk,
  .glint {
    opacity: 0;
  }

  .puff {
    stroke-width: 0.8;
  }

  .smoke {
    stroke: var(--color-ink-medium);
    stroke-width: 1;
    stroke-linecap: round;
  }

  .prints {
    fill: var(--color-ink-dark);
  }

  .dusk {
    fill: rgb(12 9 5);
  }

  .glint {
    fill: var(--color-tansy);
  }

  .flame-scene {
    transform-origin: 62px 145px;
  }

  .is-playing .mouse {
    animation: mouse-peek var(--scene) ease-in-out;
  }

  .is-playing .cheek {
    animation: cheek var(--scene) ease-in-out;
  }

  .is-playing .puff {
    animation: puff var(--scene) ease-in-out;
  }

  .is-playing .flame-scene {
    animation: blown-out var(--scene) ease-in-out;
  }

  .is-playing .glow-scene {
    animation: glow-out var(--scene) ease-in-out;
  }

  .is-playing .smoke {
    animation: smoke var(--scene) ease-in-out;
  }

  .is-playing .dusk {
    animation: dusk var(--scene) ease-in-out;
  }

  .is-playing .glint {
    animation: glint var(--scene) ease-in-out;
  }

  [data-take='1'].is-playing .prints {
