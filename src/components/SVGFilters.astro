---
/**
 * SVG Filters Component
 * Renders shared SVG filters once at document level for use by BotanicalBorder and other components.
 * Include this once in BaseLayout to enable filter="url(#filterId)" references throughout.
 */
---

<svg
  class="svg-filters"
  aria-hidden="true"
  style="position: absolute; width: 0; height: 0; overflow: hidden;"
>
  <defs>
    <filter id="bb-gentleTexture" x="-20%" y="-20%" width="140%" height="140%">
      <feTurbulence baseFrequency="0.02" numOctaves="1" result="noise" seed="1"></feTurbulence>
      <feDisplacementMap in="SourceGraphic" in2="noise" scale="0.8"></feDisplacementMap>
    </filter>

    <filter id="bb-organicTexture" x="-20%" y="-20%" width="140%" height="140%">
      <feTurbulence baseFrequency="0.02" numOctaves="2" result="noise" seed="2"></feTurbulence>
      <feDisplacementMap in="SourceGraphic" in2="noise" scale="1.5"></feDisplacementMap>
    </filter>

    <filter id="bb-softShadow" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur in="SourceAlpha" stdDeviation="1"></feGaussianBlur>
      <feOffset dx="0" dy="0.5" result="offset"></feOffset>
      <feFlood flood-color="rgba(139, 90, 60, 0.1)"></feFlood>
      <feComposite in2="offset" operator="in"></feComposite>
      <feMerge>
        <feMergeNode></feMergeNode>
        <feMergeNode in="SourceGraphic"></feMergeNode>
      </feMerge>
    </filter>

    <filter id="bb-roughTexture" x="-20%" y="-20%" width="140%" height="140%">
      <feTurbulence baseFrequency="0.04" numOctaves="3" result="noise" seed="1"></feTurbulence>
      <feDisplacementMap in="SourceGraphic" in2="noise" scale="2"></feDisplacementMap>
    </filter>

    <filter id="bb-bottomShadow" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur in="SourceAlpha" stdDeviation="2"></feGaussianBlur>
      <feOffset dx="1" dy="2" result="offset"></feOffset>
      <feFlood flood-color="rgba(139, 90, 60, 0.2)"></feFlood>
      <feComposite in2="offset" operator="in"></feComposite>
      <feMerge>
        <feMergeNode></feMergeNode>
        <feMergeNode in="SourceGraphic"></feMergeNode>
      </feMerge>
    </filter>

    <filter id="bb-cornerEmboss" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur in="SourceAlpha" stdDeviation="3"></feGaussianBlur>
      <feOffset dx="3" dy="3" result="offset"></feOffset>
      <feFlood flood-color="rgba(139, 90, 60, 0.15)"></feFlood>
      <feComposite in2="offset" operator="in"></feComposite>
      <feMerge>
        <feMergeNode></feMergeNode>
        <feMergeNode in="SourceGraphic"></feMergeNode>
      </feMerge>
    </filter>
  </defs>
</svg>
