---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import DropCap from '../../components/DropCap.astro';
import ImageFrame from '../../components/ImageFrame.astro';
import Series from '../../components/Series.astro';
import RecipeCard from '../../components/RecipeCard.astro';
import { timing } from '../../lib/recipe';

/* Note: Content markdown cannot render Astro components by default.
   To allow components inside markdown, pass them via the 'components' prop on <Content />. */
// import { Image } from 'astro:assets';

export async function getStaticPaths() {
  const recipes = await getCollection('recipes');
  return recipes.map((recipe) => ({
    params: { slug: recipe.id },
    props: { recipe },
  }));
}

const { recipe } = Astro.props;
const { Content } = await render(recipe);

// With a recipe card the card states yield and time, computed from the steps; the header
// only files the recipe. Search engines still get both.
const { steps, prepMinutes } = recipe.data;
const minutes = steps ? timing(steps, prepMinutes).total : 0;
const isoDuration = `PT${Math.floor(minutes / 60)}H${minutes % 60}M`;
const tags = recipe.data.tags ?? [];
const tagLinks = tags.map((text) => ({ text, href: `/recipes?tag=${encodeURIComponent(text)}` }));
---

<BaseLayout
  title={`${recipe.data.title} - Scholz MX`}
  description={recipe.data.description}
  image={recipe.data.heroImage?.src}
  tone="personal"
  layout="prose"
  prose={true}
>
  <article class="recipe-content" itemscope itemtype="https://schema.org/Recipe">
    <header class="recipe-header">
      <h1 class="recipe-title" itemprop="name" data-pagefind-meta="title">
        {recipe.data.title}
      </h1>
      <p class="recipe-description" itemprop="description" data-pagefind-meta="description">
        {recipe.data.description}
      </p>
      {steps ? (
        <p
          class="recipe-meta"
          data-pagefind-meta={tags.length > 0 ? `tags:${tags.join(', ')}` : undefined}
        >
          <meta itemprop="recipeYield" content={recipe.data.servings} />
          <meta itemprop="totalTime" content={isoDuration} />
          {tags.length > 0 && <>Filed under <Series items={tagLinks} />.</>}
        </p>
      ) : (
        <p
          class="recipe-meta"
          data-pagefind-meta={tags.length > 0 ? `tags:${tags.join(', ')}` : undefined}
        >
          Makes <span itemprop="recipeYield">{recipe.data.servings}</span>, takes
          <span itemprop="totalTime">{recipe.data.time}</span
          >{tags.length > 0 && <>. Filed under <Series items={tagLinks} /></>}.
        </p>
      )}
    </header>

    {recipe.data.heroImage && <div class="recipe-hero pasted">
      <ImageFrame
        src={recipe.data.heroImage}
        alt={recipe.data.title}
        style="hero"
        aspectRatio="3/2"
        scale={recipe.data.heroImageScale}
        positionX={recipe.data.heroImagePositionX ? recipe.data.heroImagePositionX * 100 : 0}
        positionY={recipe.data.heroImagePositionY ? recipe.data.heroImagePositionY * 100 : 0}
        loading="eager"
        width={800}
        height={400}
      />
    </div>}

    {recipe.data.steps && (
      <RecipeCard
        ingredients={recipe.data.ingredients ?? []}
        steps={recipe.data.steps}
        meanwhile={recipe.data.meanwhile}
        makes={recipe.data.makes}
        prepMinutes={recipe.data.prepMinutes}
        equipment={recipe.data.equipment}
      />
    )}

    <section
      class="recipe-body prose"
      itemprop="recipeInstructions"
      data-pagefind-body
      data-pagefind-filter="type:recipe"
    >
      <Content components={{ DropCap }} />
    </section>

    <footer class="recipe-footer">
      <p><a href="/recipes">All recipes</a></p>
    </footer>
  </article>
</BaseLayout>

<style>
  .recipe-content {
    position: relative;
  }

  .recipe-header {
    margin: var(--page-top) 0 var(--space-lg);
  }

  .recipe-title {
    margin: 0 0 0.3em;
    font-size: var(--text-display);
    font-weight: 400;
    line-height: 1.05;
    text-wrap: balance;
  }

  .recipe-description {
    margin: 0 0 0.6em;
    font-size: var(--text-lg);
    font-style: italic;
    line-height: 1.45;
    color: var(--color-text-secondary);
  }

  .recipe-meta {
    margin: 0;
    font-size: var(--text-sm);
    font-style: italic;
    color: var(--color-text-muted);
    font-variant-numeric: oldstyle-nums;
  }

  .recipe-meta a {
    color: inherit;
    text-decoration-color: color-mix(in srgb, currentcolor 35%, transparent);
  }

  .recipe-hero {
    margin: 0 0 var(--space-xl);
  }

  .recipe-hero :global(.image-frame) {
    margin: 0;
    padding: 0;
    border-radius: 2px;
    box-shadow:
      0 1px 2px color-mix(in srgb, var(--color-ink-dark) 16%, transparent),
      0 14px 28px -16px color-mix(in srgb, var(--color-ink-dark) 40%, transparent);
  }

  .recipe-body :global(strong) {
    font-weight: 700;
    color: var(--color-text-primary);
  }

  .recipe-body :global(hr) {
    margin: var(--space-xl) 0;
    border: 0;
    border-top: 1px solid var(--rule-ink);
  }

  .recipe-footer {
    margin-top: var(--space-xxl);
    padding-top: var(--space-lg);
    border-top: 1px solid var(--rule-ink);
  }

  .recipe-footer p {
    margin: 0;
  }
</style>
