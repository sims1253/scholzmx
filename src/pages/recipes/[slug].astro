---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import DropCap from '../../components/DropCap.astro';
import ImageFrame from '../../components/ImageFrame.astro';
import FaintLineDivider from '../../components/FaintLineDivider.astro';
import ContentSidebar from '../../components/ContentSidebar.astro';
import ReadingLayout from '../../components/ReadingLayout.astro';
import MarginNotesScripts from '../../components/MarginNotesScripts.astro';

/* Note: Content markdown cannot render Astro components by default.
   To allow components inside markdown, pass them via the 'components' prop on <Content />. */

export async function getStaticPaths() {
  const recipes = await getCollection('recipes');
  return recipes.map((recipe) => ({
    params: { slug: recipe.id },
    props: { recipe },
  }));
}

const { recipe } = Astro.props;
const { Content } = await render(recipe);

const sidebarMetadataItems = [
  {
    label: 'Servings',
    value: recipe.data.servings,
    itemprop: 'recipeYield',
  },
  {
    label: 'Time',
    value: recipe.data.time,
    itemprop: 'totalTime',
  },
];

const sidebarTags = (recipe.data.tags ?? []).map((tag) => ({
  label: tag,
  itemprop: 'recipeCategory',
  href: `/recipes?tag=${encodeURIComponent(tag)}`,
}));
---

<BaseLayout
  title={`${recipe.data.title} - Scholz MX`}
  description={recipe.data.description}
  image={typeof recipe.data.heroImage === 'string'
    ? recipe.data.heroImage
    : recipe.data.heroImage?.src}
  footerVariant="kitchen"
  tone="personal"
  layout="wide"
  leading="relaxed"
>
  <div class="recipe-post">
    <article class="recipe-content" itemscope itemtype="https://schema.org/Recipe">
      <ReadingLayout className="recipe-layout">
        <ContentSidebar
          slot="leftRail"
          breadcrumbs={[
            { label: 'Home', href: '/' },
            { label: 'Kitchen', href: '/recipes' },
            { label: recipe.data.title },
          ]}
          metadataItems={sidebarMetadataItems}
          tags={sidebarTags}
          tocMaxDepth={3}
        />

        <div class="recipe-main">
          <header class="recipe-header">
            <h1 class="recipe-title" itemprop="name" data-pagefind-meta="title">
              {recipe.data.title}
            </h1>

            <p class="recipe-description" itemprop="description" data-pagefind-meta="description">
              {recipe.data.description}
            </p>
          </header>

          {
            recipe.data.heroImage && (
              <ImageFrame
                src={recipe.data.heroImage}
                alt={recipe.data.title}
                style="hero"
                aspectRatio="3/2"
                scale={
                  recipe.data.heroImageScale !== undefined && recipe.data.heroImageScale !== 1
                    ? recipe.data.heroImageScale
                    : undefined
                }
                positionX={
                  recipe.data.heroImagePositionX !== undefined &&
                  recipe.data.heroImagePositionX !== 0
                    ? recipe.data.heroImagePositionX * 100
                    : undefined
                }
                positionY={
                  recipe.data.heroImagePositionY !== undefined &&
                  recipe.data.heroImagePositionY !== 0
                    ? recipe.data.heroImagePositionY * 100
                    : undefined
                }
                loading="eager"
                width={800}
                height={400}
                className="recipe-hero"
              />
            )
          }

          <div class="inline-sidebar-wrap">
            <ContentSidebar
              breadcrumbs={[
                { label: 'Home', href: '/' },
                { label: 'Kitchen', href: '/recipes' },
                { label: recipe.data.title },
              ]}
              metadataItems={sidebarMetadataItems}
              tags={sidebarTags}
              tocMaxDepth={3}
            />
          </div>

          <FaintLineDivider width="wide" class="recipe-divider" />

          <section
            id="recipe-body"
            class="recipe-body prose"
            itemprop="recipeInstructions"
            data-pagefind-body
            data-pagefind-filter="type:recipe"
          >
            <Content components={{ DropCap, Image }} />
          </section>
        </div>

        <div slot="rightRail" class="margin-notes-layer recipe-notes-layer" data-margin-notes-layer>
        </div>
      </ReadingLayout>

      <FaintLineDivider width="medium" />

      <footer class="recipe-footer">
        <nav class="recipe-navigation" aria-label="Recipe navigation">
          <a href="/recipes" class="back-link">← Back to Kitchen</a>
        </nav>
      </footer>
    </article>
  </div>
  <MarginNotesScripts slot="scripts" />
</BaseLayout>

<style>
  .recipe-post {
    max-width: 100%;
    margin-top: calc(-1 * var(--space-xs));
  }

  .recipe-content {
    padding: 0 0 var(--space-xs) 0;
    position: relative;
  }

  /* Main Content Styling */
  .recipe-main {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    min-width: 0;
  }

  .recipe-notes-layer {
    position: relative;
    width: 100%;
  }

  /* Hero follows header — give it breathing room above */
  .recipe-main :global(.recipe-hero) {
    margin-top: var(--space-xs);
  }

  .recipe-header {
    position: relative;
  }

  .recipe-title {
    display: block;
    margin: 0 auto;
    font-size: clamp(var(--text-2xl), 5vw, var(--text-3xl));
    line-height: 1.2;
    color: var(--color-ink-dark);
    font-family: var(--font-heading);
    font-weight: var(--font-weight-semibold);
    text-align: center;
  }

  .recipe-description {
    font-family: var(--font-body-personal); /* Alegreya */
    font-size: var(--text-lg);
    font-style: italic;
    color: var(--color-ink-medium);
    line-height: 1.6;
    margin-bottom: 0;
  }

  .recipe-body :global(strong) {
    color: var(--color-walnut);
    font-weight: 600;
  }

  .recipe-body :global(em) {
    color: var(--color-ink-medium);
  }

  .recipe-body :global(img) {
    width: 100%;
    height: auto;
    border-radius: var(--border-radius);
    box-shadow: 0 4px 12px color-mix(in oklab, var(--color-walnut) 15%, transparent);
    margin: var(--space-lg) 0;
  }

  .recipe-footer {
    margin-top: var(--space-xxl);
    padding-top: var(--space-lg);
    border-top: 1px solid color-mix(in oklab, var(--color-walnut) 10%, transparent);
  }

  .recipe-navigation {
    text-align: center;
  }

  .back-link {
    font-family: var(--font-body-personal); /* Alegreya */
    font-size: var(--text-sm);
    color: var(--color-walnut);
    text-decoration: none;
    font-weight: 500;
    padding: var(--space-xs) var(--space-sm);
    border: 1px solid var(--color-walnut);
    border-radius: var(--border-radius);
    transition: all var(--transition-fast);
  }

  .back-link:hover {
    background-color: var(--color-walnut);
    color: var(--color-parchment-light);
  }

  /* Mobile and Tablet Styling (< 768px) */
  @media (max-width: 767px) {
    .recipe-content {
      padding: var(--space-md);
    }
  }

  /* Tablet Styling (768px - 1199px) - Compact stacked layout */
  @media (min-width: 768px) and (max-width: 1199px) {
    .recipe-content {
      padding: var(--space-md);
    }
  }

  @media (min-width: 1200px) {
    .inline-sidebar-wrap {
      display: none;
    }

    .recipe-main {
      gap: var(--space-xs);
    }
  }

  @media (max-width: 1199px) {
    .recipe-main {
      gap: var(--space-xxs);
    }

    .inline-sidebar-wrap {
      position: sticky;
      top: 0;
      z-index: 10;
      background: var(--color-background);
      padding-block: var(--space-xxs);
    }
  }
</style>
