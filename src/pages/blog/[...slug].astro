---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ImageFrame from '../../components/ImageFrame.astro';
import Series from '../../components/Series.astro';
import NoteCardStack from '../../components/NoteCardStack.astro';

export async function getStaticPaths() {
  const posts = (await getCollection('blog')).filter((post) => !post.data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

// Helper function to get related posts based on tags
const getRelatedPosts = async (currentPost: CollectionEntry<'blog'>) => {
  const allPosts = await getCollection('blog');
  const currentTags = currentPost.data.tags || [];

  if (currentTags.length === 0) return [];

  return allPosts
    .filter((post) => post.id !== currentPost.id && !post.data.draft)
    .map((post) => {
      const commonTags = (post.data.tags || []).filter((tag) => currentTags.includes(tag));
      return { post, score: commonTags.length };
    })
    .filter((item) => item.score > 0)
    .sort((a, b) => b.score - a.score)
    .slice(0, 3)
    .map((item) => item.post);
};

// Helper function to get previous and next posts
const getAdjacentPosts = async (currentPost: CollectionEntry<'blog'>) => {
  const allPosts = await getCollection('blog');
  const publishedPosts = allPosts
    .filter((post) => !post.data.draft)
    .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

  const currentIndex = publishedPosts.findIndex((post) => post.id === currentPost.id);

  return {
    prev: currentIndex > 0 ? publishedPosts[currentIndex - 1] : null,
    next: currentIndex < publishedPosts.length - 1 ? publishedPosts[currentIndex + 1] : null,
  };
};

const { post } = Astro.props;
const { Content } = await render(post);

// Get related and adjacent posts
const relatedPosts = await getRelatedPosts(post);
const { prev, next } = await getAdjacentPosts(post);

const isoDay = (date: Date) => date.toISOString().slice(0, 10);
const heroOf = (entry: CollectionEntry<'blog'>) => {
  const { heroImage, heroImageScale, heroImagePositionX, heroImagePositionY } = entry.data;
  const framing = {
    scale: heroImageScale ?? 1,
    posX: heroImagePositionX ?? 0,
    posY: heroImagePositionY ?? 0,
  };
  // The collection schema validates the string/asset union before this point.
  // oxlint-disable-next-line anti-slop/no-runtime-typeof
  if (typeof heroImage === 'string') return { kind: 'url' as const, src: heroImage, ...framing };
  if (heroImage) return { kind: 'asset' as const, src: heroImage, ...framing };
  return undefined;
};

const formatDate = (date: Date) =>
  date.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });

// Calculate reading time from content
const getReadingTime = (content: string): string => {
  const wordsPerMinute = 200;
  const words = content.split(/\s+/).filter((word) => word.length > 0).length;
  const minutes = Math.ceil(words / wordsPerMinute);
  return minutes === 1 ? 'a minute' : `${minutes} minutes`;
};

const readingTime = getReadingTime(post.body || '');
---

<BaseLayout
  title={`${post.data.title}`}
  description={post.data.description}
  image={typeof post.data.heroImage === 'string' ? post.data.heroImage : post.data.heroImage?.src}
  tone="serious"
  layout="prose"
  prose={true}
>
  <article class="post-content" itemscope itemtype="https://schema.org/Article">
    <header class="post-header">
      <h1 class="post-title" itemprop="headline">{post.data.title}</h1>
      <p class="post-meta">
        Written on
        <time datetime={post.data.date.toISOString()} itemprop="datePublished"
          >{formatDate(post.data.date)}</time
        >{post.data.lastUpdated && (
          <>, last tended on
            <time datetime={post.data.lastUpdated.toISOString()} itemprop="dateModified"
              >{formatDate(post.data.lastUpdated)}</time
            ></>
        )}.
        About {readingTime} to
        read{post.data.tags && post.data.tags.length > 0 && (
          <>, filed under
            <Series
              items={post.data.tags.map((text) => ({
                text,
                href: `/blog?tag=${encodeURIComponent(text)}`,
              }))}
            /></>
        )}.
      </p>
    </header>

    {post.data.heroImage && <div class="post-hero pasted">
      <ImageFrame
        src={post.data.heroImage}
        alt=""
        style="hero"
        aspectRatio="8/3"
        scale={post.data.heroImageScale}
        positionX={post.data.heroImagePositionX ? post.data.heroImagePositionX * 100 : 0}
        positionY={post.data.heroImagePositionY ? post.data.heroImagePositionY * 100 : 0}
        loading="eager"
        width={800}
        height={400}
      />
    </div>}

    <section
      class="post-body prose"
      itemprop="articleBody"
      data-pagefind-body
      data-pagefind-filter="type:blog"
    >
      <Content />
    </section>

    <aside class="footnotes-area" aria-label="Footnotes"></aside>

    <footer class="post-footer">
      {(prev || next) && <nav class="post-navigation" aria-label="Neighbouring posts">
        {next && <p>Older: <a href={`/blog/${next.id}`}>{next.data.title}</a></p>}
        {prev && <p>Newer: <a href={`/blog/${prev.id}`}>{prev.data.title}</a></p>}
      </nav>}

      {relatedPosts.length > 0 && <section class="related-posts" aria-labelledby="related-title">
        <h2 class="related-title" id="related-title">Related posts</h2>
        <NoteCardStack
          columns="auto"
          itemMinWidth="16rem"
          aspectRatio="8/3"
          headingLevel={3}
          items={relatedPosts.map((related) => ({
            id: related.id,
            title: related.data.title,
            subtitle: related.data.description,
            href: `/blog/${related.id}`,
            writtenDate: isoDay(related.data.date),
            tags: related.data.tags ?? [],
            hero: heroOf(related),
          }))}
        />
      </section>}

      <p class="back-link"><a href="/blog">All posts</a></p>
    </footer>
  </article>
</BaseLayout>

<script>
  // Convert Quarto-style "> margin:" blockquotes into inline anchors with data-note
  document.addEventListener('DOMContentLoaded', function () {
    const blockquotes = document.querySelectorAll('.post-body blockquote');
    blockquotes.forEach((blockquote) => {
      const firstP = blockquote.querySelector('p:first-child');
      if (!firstP || !firstP.textContent) return;
      const raw = firstP.textContent.trim();
      if (!/^margin:/i.test(raw)) return;
      const noteText = raw.replace(/^margin:\s*/i, '').trim();
      // Replace the blockquote with a span anchor placed before it, then remove the blockquote
      const anchor = document.createElement('span');
      anchor.className = 'note-anchor';
      anchor.textContent = '';
      anchor.setAttribute('data-note', noteText);
      blockquote.parentElement?.insertBefore(anchor, blockquote);
      blockquote.remove();
    });
  });
</script>

<style>
  .post-content {
    position: relative;
  }

  .post-header {
    margin: clamp(1.5rem, 5vw, 3.5rem) 0 var(--space-xl);
  }

  .post-title {
    margin: 0 0 0.45em;
    font-size: clamp(var(--text-2xl), 1.3rem + 2vw, var(--text-3xl));
    font-weight: 400;
    line-height: 1.1;
    text-wrap: balance;
  }

  .post-meta {
    margin: 0;
    max-width: 34rem;
    font-family: var(--font-body-personal);
    font-size: var(--text-md);
    font-style: italic;
    line-height: 1.5;
    color: var(--color-text-muted);
    font-variant-numeric: oldstyle-nums;
  }

  .post-meta a {
    color: inherit;
    text-decoration-color: color-mix(in srgb, currentcolor 35%, transparent);
  }

  .post-meta a:hover {
    color: var(--color-link-hover);
    text-decoration-color: var(--color-tansy);
  }

  .post-hero {
    margin: 0 0 var(--space-xl);
  }

  .post-hero :global(.image-frame) {
    margin: 0;
    padding: 0;
    border-radius: 2px;
  }

  .post-body :global(figure) {
    margin: var(--space-xl) auto;
  }

  .post-body :global(figcaption) {
    margin-top: var(--space-xs);
    font-family: var(--font-body-personal);
    font-size: var(--text-sm);
    font-style: italic;
    color: var(--color-text-muted);
    text-align: center;
  }

  .post-body :global(section.footnotes),
  .footnotes-area :global(section.footnotes) {
    margin-top: var(--space-xl);
    padding-top: var(--space-md);
    border-top: 1px solid var(--rule-ink);
    font-size: var(--text-sm);
  }

  .post-body :global(section.footnotes ol) {
    padding-left: var(--space-lg);
  }

  .post-body :global(section.footnotes li) {
    margin-bottom: var(--space-sm);
  }

  .post-body :global(a.footnote-backref) {
    text-decoration: none;
  }

  .post-footer {
    margin-top: var(--space-xxl);
    padding-top: var(--space-lg);
    border-top: 1px solid var(--rule-ink);
  }

  .post-navigation p {
    margin: 0 0 0.4em;
    font-style: italic;
    color: var(--color-text-muted);
  }

  .post-navigation a {
    font-family: var(--font-heading);
    font-style: normal;
  }

  .related-posts {
    margin-top: var(--space-xl);
  }

  .related-title {
    margin: 0 0 var(--space-md);
    font-size: var(--text-xl);
  }

  .back-link {
    margin: var(--space-xl) 0 0;
  }

  /* Margin notes are positioned by margin-notes.ts; only their look lives here. */
  .post-body.prose :global(.margin-note::before) {
    display: none !important;
  }
</style>
