---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FaintLineDivider from '../../components/FaintLineDivider.astro';
import ImageFrame from '../../components/ImageFrame.astro';
import ListingCardStack from '../../components/ListingCardStack.astro';
import ContentSidebar from '../../components/ContentSidebar.astro';
import ReadingLayout from '../../components/ReadingLayout.astro';
import BlogPostScripts from '../../components/BlogPostScripts.astro';
import { fromBlogEntry } from '../../lib/cards/adapters';

export async function getStaticPaths() {
  const posts = (await getCollection('blog')).filter((post) => !post.data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

// Helper function to get related posts based on tags
const getRelatedPosts = async (currentPost: CollectionEntry<'blog'>) => {
  const allPosts = await getCollection('blog');
  const currentTags = currentPost.data.tags || [];

  if (currentTags.length === 0) return [];

  return allPosts
    .filter((post) => post.id !== currentPost.id && !post.data.draft)
    .map((post) => {
      const commonTags = (post.data.tags || []).filter((tag) => currentTags.includes(tag));
      return { post, score: commonTags.length };
    })
    .filter((item) => item.score > 0)
    .sort((a, b) => b.score - a.score)
    .slice(0, 3)
    .map((item) => item.post);
};

// Helper function to get previous and next posts
const getAdjacentPosts = async (currentPost: CollectionEntry<'blog'>) => {
  const allPosts = await getCollection('blog');
  const publishedPosts = allPosts
    .filter((post) => !post.data.draft)
    .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

  const currentIndex = publishedPosts.findIndex((post) => post.id === currentPost.id);

  return {
    prev: currentIndex > 0 ? publishedPosts[currentIndex - 1] : null,
    next: currentIndex < publishedPosts.length - 1 ? publishedPosts[currentIndex + 1] : null,
  };
};

const { post } = Astro.props;
const { Content } = await render(post);

// Get related and adjacent posts
const relatedPosts = await getRelatedPosts(post);
const { prev, next } = await getAdjacentPosts(post);

const formatDate = (date: Date) => {
  return date.toISOString().split('T')[0];
};

const getReadingTime = (content: string): string => {
  const WORDS_PER_MINUTE = 200;
  const LINES_PER_MINUTE_CODE = 30;

  const codeBlockRegex = /```[\s\S]*?```/g;
  const codeBlocks = content.match(codeBlockRegex) || [];
  const codeLines = codeBlocks.reduce((acc, block) => acc + block.split('\n').length - 2, 0);
  const contentWithoutCode = content.replace(codeBlockRegex, '');
  const proseWords = contentWithoutCode.split(/\s+/).filter((word) => word.length > 0).length;
  const proseMinutes = proseWords / WORDS_PER_MINUTE;
  const codeMinutes = codeLines / LINES_PER_MINUTE_CODE;
  const totalMinutes = Math.ceil(proseMinutes + codeMinutes);
  return `${totalMinutes} min read`;
};

const readingTime = getReadingTime(post.body || '');

const sidebarMetadataItems = [
  {
    label: 'Written',
    value: formatDate(post.data.date),
    datetime: post.data.date.toISOString(),
    itemprop: 'datePublished',
  },
  ...(post.data.lastUpdated
    ? [
        {
          label: 'Updated',
          value: formatDate(post.data.lastUpdated),
          datetime: post.data.lastUpdated.toISOString(),
          itemprop: 'dateModified',
        },
      ]
    : []),
  {
    label: 'Length',
    value: readingTime,
  },
];

const sidebarTags = (post.data.tags ?? []).map((tag) => ({
  label: tag,
  itemprop: 'keywords',
  href: `/blog?tag=${encodeURIComponent(tag)}`,
}));
---

<BaseLayout
  title={`${post.data.title}`}
  description={post.data.description}
  image={typeof post.data.heroImage === 'string' ? post.data.heroImage : post.data.heroImage?.src}
  footerVariant="writing"
  tone="serious"
  layout="wide"
>
  <div class="blog-post">
    <article class="post-content" itemscope itemtype="https://schema.org/Article">
      <ReadingLayout className="post-layout">
        <ContentSidebar
          slot="leftRail"
          breadcrumbs={[
            { label: 'Home', href: '/' },
            { label: 'Blog', href: '/blog' },
            { label: post.data.title },
          ]}
          metadataItems={sidebarMetadataItems}
          tags={sidebarTags}
          tocMaxDepth={3}
        />

        <div class="post-main">
          <h1 class="post-title" itemprop="headline">
            {post.data.title}
          </h1>

          {
            post.data.description && (
              <p class="post-description" itemprop="description">
                {post.data.description}
              </p>
            )
          }

          {
            post.data.heroImage && (
              <ImageFrame
                src={post.data.heroImage}
                alt={post.data.title}
                style="hero"
                aspectRatio="3/1"
                fillMode="contain"
                scale={
                  post.data.heroImageScale !== undefined && post.data.heroImageScale !== 1
                    ? post.data.heroImageScale
                    : undefined
                }
                positionX={
                  post.data.heroImagePositionX !== undefined && post.data.heroImagePositionX !== 0
                    ? post.data.heroImagePositionX * 100
                    : undefined
                }
                positionY={
                  post.data.heroImagePositionY !== undefined && post.data.heroImagePositionY !== 0
                    ? post.data.heroImagePositionY * 100
                    : undefined
                }
                loading="eager"
                width={800}
                height={267}
              />
            )
          }

          {
            /* Inline sidebar: visible on mobile/tablet (<1200px), hidden on desktop.
               Desktop uses the ContentSidebar in slot="leftRail" above.
               Both use display:none at the inactive breakpoint, so only one
               is ever in the a11y tree at a time. */
          }
          <div class="inline-sidebar-wrap">
            <ContentSidebar
              breadcrumbs={[
                { label: 'Home', href: '/' },
                { label: 'Blog', href: '/blog' },
                { label: post.data.title },
              ]}
              metadataItems={sidebarMetadataItems}
              tags={sidebarTags}
              tocMaxDepth={3}
            />
          </div>

          <FaintLineDivider width="wide" />

          <section
            id="post-body"
            class="post-body prose"
            itemprop="articleBody"
            data-pagefind-body
            data-pagefind-filter="type:blog"
          >
            <Content components={{ Image }} />
          </section>
        </div>

        <div slot="rightRail" class="margin-notes-layer post-notes-layer" data-margin-notes-layer>
        </div>
      </ReadingLayout>

      <aside class="footnotes-area" aria-label="Footnotes"></aside>

      <FaintLineDivider width="medium" />

      <footer class="post-footer">
        <nav class="post-navigation" aria-label="Post navigation">
          <div class="nav-links">
            {
              prev && (
                <a href={`/blog/${prev.id}`} class="nav-link prev-link" rel="prev">
                  <span class="nav-direction">← Previous</span>
                  <span class="nav-title">{prev.data.title}</span>
                </a>
              )
            }
            {
              next && (
                <a href={`/blog/${next.id}`} class="nav-link next-link" rel="next">
                  <span class="nav-direction">Next →</span>
                  <span class="nav-title">{next.data.title}</span>
                </a>
              )
            }
          </div>
          <a href="/blog" class="back-link">← Back to Writing</a>
        </nav>

        {
          relatedPosts.length > 0 && (
            <section class="related-posts" aria-label="Related posts">
              <h2 class="related-title">Related Posts</h2>
              <ListingCardStack
                profile="related"
                columns="auto"
                itemMinWidth="280px"
                aspectRatio="3/1"
                items={relatedPosts.map((relatedPost) =>
                  fromBlogEntry(relatedPost, {
                    idPrefix: 'stack',
                    tagHref: (tag) => `/blog?tag=${encodeURIComponent(tag)}`,
                  })
                )}
              />
            </section>
          )
        }
      </footer>
    </article>
  </div>
  <BlogPostScripts slot="scripts" />
  <script>
    function alignSidebarToDescription() {
      const desc = document.querySelector('.post-description');
      const rail = document.querySelector('[data-left-rail]');
      const sidebar = rail?.querySelector('.content-sidebar');
      if (!desc || !rail || !sidebar) return;
      const offset = desc.getBoundingClientRect().top - rail.getBoundingClientRect().top;
      if (offset > 0) {
        (sidebar as HTMLElement).style.marginTop = `${offset}px`;
      }
    }
    alignSidebarToDescription();
    document.addEventListener('astro:page-load', alignSidebarToDescription);
  </script>
</BaseLayout>

<style>
  .blog-post {
    max-width: 100%;
    margin-top: calc(-1 * var(--space-xs));
  }

  .post-content {
    padding: 0 0 var(--space-xs) 0;
    position: relative;
  }

  /* Main Content Styling */
  .post-main {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    min-width: 0;
  }

  .post-notes-layer {
    position: relative;
    width: 100%;
  }

  .post-description {
    font-style: italic;
    font-size: var(--text-lg);
    color: var(--color-ink-medium);
    line-height: 1.55;
    text-align: center;
    margin: 0;
  }

  /* Hero follows title/description — give it breathing room above.
     Blog heroes are atmospheric/vibes; keep them compact. */
  .post-main :global(.image-frame-hero) {
    margin-top: var(--space-xs);
    max-height: 280px;
  }

  .post-title {
    display: flex;
    align-items: baseline;
    gap: 0.15em;
    flex-wrap: wrap;
    margin: 0;
    font-size: clamp(var(--text-2xl), 5vw, var(--text-3xl));
    line-height: 1.2;
    color: var(--color-ink-dark);
    font-family: var(--font-heading);
    font-weight: var(--font-weight-semibold);
  }

  .post-title .title-initial {
    display: inline-flex;
    line-height: 1;
  }

  .post-title .title-rest {
    display: inline;
  }

  .post-body :global(figure) {
    margin: var(--space-xl) auto;
  }

  .post-body :global(figcaption) {
    font-size: var(--text-xs);
    color: var(--color-ink-light);
    text-align: center;
    margin-top: var(--space-xs);
    font-style: italic;
  }

  .post-body :global(section.footnotes),
  .footnotes-area :global(section.footnotes) {
    border-top: 1px solid color-mix(in oklab, var(--color-walnut) 15%, transparent);
    margin-top: var(--space-xl);
    padding-top: var(--space-md);
  }

  .post-body :global(section.footnotes ol) {
    padding-left: var(--space-lg);
  }

  .post-body :global(section.footnotes li) {
    margin-bottom: var(--space-sm);
  }

  .post-body :global(a.footnote-backref) {
    text-decoration: none;
    color: var(--color-walnut);
    border-bottom: 1px dotted var(--color-walnut);
  }

  /* Footer Styling */
  .post-footer {
    margin-top: var(--space-xxl);
    padding-top: var(--space-lg);
    border-top: 1px solid color-mix(in oklab, var(--color-walnut) 10%, transparent);
  }

  .post-navigation {
    text-align: center;
  }

  .back-link {
    font-size: var(--text-sm);
    color: var(--color-walnut);
    text-decoration: none;
    font-weight: 500;
    padding: var(--space-xs) var(--space-sm);
    border: 1px solid var(--color-walnut);
    border-radius: var(--border-radius);
    transition: all var(--transition-fast);
  }

  .back-link:hover {
    background-color: var(--color-walnut);
    color: var(--color-parchment-light);
  }

  /* Navigation Links */
  .nav-links {
    display: flex;
    align-items: stretch;
    justify-content: center;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-bottom: var(--space-md);
  }

  .nav-link {
    display: inline-flex;
    flex-direction: column;
    padding: var(--space-sm) var(--space-sm);
    border: 1px solid var(--color-lichen);
    border-radius: var(--border-radius);
    text-decoration: none;
    transition: all var(--transition-fast);
    background: var(--color-surface);
    min-width: min(16rem, 100%);
    max-width: 19rem;
  }

  .prev-link {
    text-align: left;
  }

  .next-link {
    text-align: right;
  }

  .nav-direction {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: var(--space-xxs);
  }

  .nav-title {
    font-size: var(--text-sm);
    color: var(--color-walnut);
    font-weight: 600;
    line-height: 1.3;
  }

  .nav-link:hover {
    border-color: var(--color-sage);
    background: color-mix(in oklab, var(--color-sage) 5%, transparent);
  }

  /* Related Posts */
  .related-posts {
    margin-top: var(--space-xl);
    padding-top: var(--space-lg);
    border-top: 1px solid color-mix(in oklab, var(--color-walnut) 10%, transparent);
  }

  .related-title {
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    color: var(--color-walnut);
    margin-bottom: var(--space-md);
    text-align: center;
  }

  @media (min-width: 1200px) {
    .post-title {
      text-align: center;
    }

    .inline-sidebar-wrap {
      display: none;
    }

    .post-main {
      gap: var(--space-xs);
    }
  }

  /* Mobile and Tablet Styling (< 768px) */
  @media (max-width: 767px) {
    .post-content {
      padding: var(--space-md);
    }

    .post-title {
      text-align: center;
    }

    .nav-links {
      flex-direction: column;
      align-items: stretch;
      gap: var(--space-md);
    }

    .nav-link {
      min-width: 0;
      max-width: none;
      width: 100%;
    }
  }

  /* Tablet Styling (768px - 1199px) - Compact stacked layout */
  @media (min-width: 768px) and (max-width: 1199px) {
    .post-content {
      padding: var(--space-md);
    }
  }

  @media (max-width: 1199px) {
    .post-title {
      text-align: center;
    }

    .post-main {
      gap: var(--space-xxs);
    }

    .inline-sidebar-wrap {
      position: sticky;
      top: 0;
      z-index: 10;
      background: var(--color-background);
      padding-block: var(--space-xxs);
    }
  }
</style>
