---
import BaseLayout from '../layouts/BaseLayout.astro';
import Series from '../components/Series.astro';
import StackedCard from '../components/StackedCard.astro';
import { publications } from '../data/publications';

const publicationsByYear = publications.reduce<Record<number, (typeof publications)[number][]>>(
  (acc, pub) => {
    (acc[pub.year] ||= []).push(pub);
    return acc;
  },
  {}
);
const years = Object.keys(publicationsByYear).sort((a, b) => Number(b) - Number(a));

const SELF = 'Maximilian Scholz';
const describe = (type: string, venue: string) =>
  type === 'Thesis' ? venue : `${type === 'Journal' ? 'Journal article' : type}, ${venue}`;
const linkLabel = (kind: string) => (kind === 'pdf' || kind === 'doi' ? kind.toUpperCase() : kind);
---

<BaseLayout
  title="Research"
  description="Research by Maximilian Scholz"
  tone="serious"
  layout="listing"
>
  <div class="index-page" style="--index-content: var(--card-max-width)">
    <header class="page-header">
      <h1 class="page-title">Research</h1>
      <p class="page-lede">
        I come from more of a software engineering background, but have taken a detour through the
        world of bayesian statistics recently. Let's hope I won't continue adding new fields...
      </p>
      <p class="profiles">
        My work is also listed on
        <a href="https://scholar.google.com/citations?user=JhwHgX4AAAAJ">Google Scholar</a> and
        <a href="https://orcid.org/0000-0002-4486-1393">ORCID</a>.
      </p>
    </header>

    {years.map((year) => <section
      class="index-group"
      data-index-group
      aria-labelledby={`year-${year}`}
    >
      <h2 class="index-label" id={`year-${year}`}>{year}</h2>
      <div class="pub-cards">
        {publicationsByYear[Number(year)]!.map((pub, index) => <StackedCard
          seed={`pub/${year}/${index}/${pub.title}`}
          title={pub.title}
          subtitle={describe(pub.type, pub.venue)}
          href={pub.links.pdf ?? pub.links.doi ?? pub.links.code}
          layers={1}
          ornament={false}
          headingLevel={3}
        >
          <p class="authors">
            <Series items={pub.authors.map((text) => ({ text, strong: text === SELF }))} />
          </p>
          <div class="sc-tags">
            {Object.entries(pub.links).map(([kind, url]) => <a class="sc-chip" href={url}>
              {linkLabel(kind)}
            </a>)}
          </div>
        </StackedCard>)}
      </div>
    </section>)}
  </div>
</BaseLayout>

<style>
  .profiles {
    margin: 0.75em 0 0;
    font-size: var(--text-md);
    color: var(--color-text-secondary);
  }

  .pub-cards {
    display: grid;
    gap: var(--space-xl);
    max-width: var(--card-max-width);
  }

  .authors {
    margin: var(--space-xs) 0 0;
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
  }

  .authors :global(strong) {
    font-weight: 600;
    color: var(--color-text-primary);
  }
</style>
