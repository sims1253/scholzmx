---
import BaseLayout from '../layouts/BaseLayout.astro';
import Series from '../components/Series.astro';
import StackedCard from '../components/StackedCard.astro';
import { publications } from '../data/publications';

const SELF = 'Maximilian Scholz';
const kindOf = (type: string) => (type === 'Journal' ? 'Journal article' : type);
const linkLabel = (kind: string) => (kind === 'pdf' || kind === 'doi' ? kind.toUpperCase() : kind);
---

<BaseLayout
  title="Research"
  description="Research by Maximilian Scholz"
  tone="serious"
  layout="cards"
>
  <div class="research-page">
    <header class="page-header">
      <h1 class="page-title">Research</h1>
      <p class="page-lede">
        I come from more of a software engineering background, but have taken a detour through the
        world of bayesian statistics recently. Let's hope I won't continue adding new fields...
      </p>
      <p class="profiles">
        My work is also listed on
        <a href="https://scholar.google.com/citations?user=JhwHgX4AAAAJ">Google Scholar</a> and
        <a href="https://orcid.org/0000-0002-4486-1393">ORCID</a>.
      </p>
    </header>

    {/* A drawer of catalogue cards, newest first. The year heads each card like a call
        number, so the cards need no year headings between them. */}
    <div class="pub-cards sc-desk">
      {publications.map((pub, index) => <StackedCard
        seed={`pub/${pub.year}/${index}/${pub.title}`}
        title={pub.title}
        href={pub.links.pdf ?? pub.links.doi ?? pub.links.code}
        material="index"
        headingLevel={2}
      >
        <p class="pub-call" slot="media">
          <span class="pub-year">{pub.year}</span>
          <span>{kindOf(pub.type)}</span>
        </p>
        <p class="pub-authors">
          <Series items={pub.authors.map((text) => ({ text, strong: text === SELF }))} />
        </p>
        <p class="pub-venue">{pub.venue}</p>
        <div class="sc-meta">
          <div class="sc-tags">
            {Object.entries(pub.links).map(([kind, url]) => <a class="sc-chip" href={url}>
              {linkLabel(kind)}
            </a>)}
          </div>
        </div>
      </StackedCard>)}
    </div>
  </div>
</BaseLayout>

<style>
  .profiles {
    margin: 0.75em 0 0;
    font-size: var(--text-md);
    color: var(--color-text-secondary);
  }

  /* No years hang in the margin, so the drawer takes the full column. */
  .research-page {
    width: 100%;
    max-width: 60rem;
    margin-inline: auto;
  }

  .pub-cards {
    --desk-min: 17rem;
  }

  /* The heading line of a catalogue card: the year as call number, the kind of work
     at the right, and the card's printed clay rule beneath. */
  .pub-call {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-sm);
    margin: 0 0 var(--space-xs);
    padding-bottom: 0.2rem;
    border-bottom: 1px solid color-mix(in srgb, var(--color-clay) 45%, transparent);
    font-family: var(--font-body-personal);
    font-size: var(--text-sm);
    font-style: italic;
    color: var(--color-text-muted);
  }

  .pub-year {
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    font-style: normal;
    font-variant-numeric: oldstyle-nums;
    color: var(--sc-moss);
  }

  .pub-authors {
    margin: 0.2rem 0 0;
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
  }

  .pub-authors :global(strong) {
    font-weight: 600;
    color: var(--color-text-primary);
  }

  .pub-venue {
    margin: 0;
    font-size: var(--text-sm);
    font-style: italic;
    color: var(--color-text-muted);
  }

  /* On a lined card the heading line is one pitch tall and its printed clay rule lies on
     the card's own rule; the kind of work, the authors and the venue are writing smaller
     than the title, so they are set down to the title's baseline (--sc-nudge, from
     stacked-card.css). The kind is in the personal voice whatever the page's. */
  :global(.sc-card[data-lined]) .pub-call {
    --sc-slope: var(--baseline-personal);

    position: relative;
    align-items: flex-start;
    padding-bottom: 0;
    border-bottom: 0;
  }

  :global(.sc-card[data-lined]) .pub-call::after {
    content: '';
    position: absolute;
    inset: var(--sc-rule-at) 0 auto;
    height: 1px;
    background: var(--color-clay);
    opacity: 0.45;
  }

  :global(.sc-card[data-lined]) .pub-call > span:not(.pub-year),
  :global(.sc-card[data-lined]) :is(.pub-authors, .pub-venue) {
    position: relative;
    top: var(--sc-nudge);
  }

  /* Each block starts on the next rule, with nothing between. */
  :global(.sc-card[data-lined]) :is(.pub-call, .pub-authors, .pub-venue) {
    margin-block: 0;
  }
</style>
