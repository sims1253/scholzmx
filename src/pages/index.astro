---
import BaseLayout from '../layouts/BaseLayout.astro';
import DropCap from '../components/DropCap.astro';
import ImageFrame from '../components/ImageFrame.astro';
import { getCollection } from 'astro:content';
import '../styles/homepage.css';

/* Optimized local images */
import selfImage from '../assets/images/homepage/self.jpg';
import portraitImage from '../assets/images/homepage/portrait.jpg';

/* Get newest post (blog or recipe) */
const allBlogPosts = await getCollection('blog', ({ data }) => !data.draft);
const allRecipes = await getCollection('recipes', ({ data }) => !data.draft);

type PostLike = { id: string; data: { date?: Date; title: string } };

const sortByDateDesc = (a: PostLike, b: PostLike) =>
  (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0);

const latestBlog = allBlogPosts.filter((p) => p.data.date).sort(sortByDateDesc)[0];
const latestRecipe = allRecipes.filter((p) => p.data.date).sort(sortByDateDesc)[0];

const newestPost = (() => {
  if (!latestBlog && !latestRecipe) return null;
  if (!latestBlog) return { type: 'recipe' as const, post: latestRecipe };
  if (!latestRecipe) return { type: 'blog' as const, post: latestBlog };
  return latestBlog.data.date! >= latestRecipe.data.date!
    ? { type: 'blog' as const, post: latestBlog }
    : { type: 'recipe' as const, post: latestRecipe };
})();

const formatDate = (date: Date) => date.toISOString().split('T')[0];

const newestPostData = newestPost
  ? {
      type: newestPost.type,
      id: newestPost.post.id,
      title: newestPost.post.data.title,
      date: newestPost.post.data.date!,
    }
  : null;

/* Curated picks: recent items across content types */
type Pick = {
  type: 'blog' | 'recipe';
  id: string;
  title: string;
  description?: string;
  date: Date;
  href: string;
  typeLabel: string;
};

const blogPicks: Pick[] = allBlogPosts
  .filter((p) => p.data.date)
  .sort(sortByDateDesc)
  .slice(0, 2)
  .map((p) => ({
    type: 'blog' as const,
    id: p.id,
    title: p.data.title,
    description: p.data.description,
    date: p.data.date!,
    href: `/blog/${p.id}`,
    typeLabel: 'Essay',
  }));

const recipePicks: Pick[] = allRecipes
  .filter((p) => p.data.date)
  .sort(sortByDateDesc)
  .slice(0, 1)
  .map((p) => ({
    type: 'recipe' as const,
    id: p.id,
    title: p.data.title,
    description: p.data.description,
    date: p.data.date!,
    href: `/recipes/${p.id}`,
    typeLabel: 'Recipe',
  }));

const recentPicks = [...blogPicks, ...recipePicks].sort(
  (a, b) => b.date.getTime() - a.date.getTime()
);
---

<BaseLayout
  title="Grotto - Personal Website of Maximilian Scholz"
  description="A place where I cultivate the feeling of watching shadows dance through vines, while insects hum and tansy makes everything smell like summer."
  footerVariant="default"
  includeQuoteSection={true}
  addBorders={true}
  tone="personal"
  layout="wide"
>
  <div class="homepage-grid">
    <!-- Left Sidebar -->
    <aside class="homepage-sidebar">
      {
        newestPostData && (
          <a
            href={
              newestPostData.type === 'blog'
                ? `/blog/${newestPostData.id}`
                : `/recipes/${newestPostData.id}`
            }
            class="latest-scribble"
          >
            <span class="scribble-label">Newest post</span>
            <span class="scribble-title">
              {newestPostData.title}
            </span>
            <time class="scribble-date" datetime={newestPostData.date.toISOString()}>
              {formatDate(newestPostData.date)}
            </time>
          </a>
        )
      }
    </aside>

    <!-- Main Content Column -->
    <main class="homepage-main">
      <!-- Illuminated Header -->
      <header class="welcome-header">
        <div class="manuscript-text">
          <h1 class="site-title">Welcome to my Grotto</h1>
          <p class="site-description constrained-text">
            a place where I try to cultivate the feeling of watching the shadows dance through
            vines, while insects are humming and tansy is making everything smell like summer.
          </p>
        </div>
        <div class="portrait-container">
          <ImageFrame
            src={portraitImage}
            alt="Professional portrait of me"
            alternateSrc={selfImage}
            alternateAlt="More cool portrait of me"
            style="watercolor"
            size="custom"
            width="180px"
            height="210px"
            loading="eager"
            positionX={0}
            positionY={2}
            scale={1.4}
            alternatePositionX={-5}
            alternatePositionY={15}
            alternateScale={1.5}
          />
        </div>
      </header>

      <!-- Bio Content -->
      <div class="about-preview">
        <div class="prose content">
          <p class="bio-intro">
            <DropCap letter="I" variant="personal" />'m Maximilian. My best friend once painted me a
            t-shirt that read <em>verspielt und liebenswürdig</em> (playful and endearing) and I've yet
            to find a better description. The best feedback I've ever gotten described me as a <em
              >herder of cat herders</em
            > and my music taste has been characterized as being <em
              >an atmospheric futurist with a nostalgic heart</em>.
          </p>
          <p>
            I tend to make things. Software infrastructure that hopefully helps others, harsh vocals
            and guitar covers, a concept Call of Cthulhu campaign for a deathcore album (much to my
            players' confusion), and kitchen experiments where I try something new each month. I'm
            easy to nerdsnipe, if you couldn't tell. When I'm not building something, you'll find me
            on the mats failing triangle escapes, or somewhere between a barbell and a book.
          </p>
          <p>
            Somewhere along the way I collected a B.Sc. in <em>Computer Science in Engineering</em>,
            a M.Sc. in <em>Software Engineering and Technology</em>, and, if the gods of bureaucracy
            ever look kindly upon me, a PhD in <em>Bayesian statistics</em> will follow.
          </p>
        </div>
      </div>

      {newestPostData && (
        <div class="mobile-latest">
          <a
            href={
              newestPostData.type === 'blog'
                ? `/blog/${newestPostData.id}`
                : `/recipes/${newestPostData.id}`
            }
            class="latest-scribble"
          >
            <span class="scribble-label">Newest post</span>
            <span class="scribble-title">{newestPostData.title}</span>
            <time class="scribble-date" datetime={newestPostData.date.toISOString()}>
              {formatDate(newestPostData.date)}
            </time>
          </a>
        </div>
      )}
    </main>
  </div>
</BaseLayout>

<script>
  // Scroll-based animation for bio divider
  const bioDivider = document.querySelector('.bio-divider');
  if (bioDivider && window.matchMedia('(prefers-reduced-motion: no-preference)').matches) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            bioDivider.classList.add('in-view');
          }
        });
      },
      { threshold: 0.3 }
    );
    observer.observe(bioDivider);
  }
</script>
