<script>
  // Gentle depth: the planes of the wall shift a few pixels with the pointer and with scrolling.
  // Everything is a transform set through two custom properties; nothing runs on its own.
  const wall = document.querySelector<HTMLElement>('.wall');
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const fine = matchMedia('(hover: hover) and (pointer: fine)').matches;

  if (wall && !reduced) {
    let inView = false;
    let queued = false;
    let px = 0;
    let py = 0;
    let sy = 0;

    const paint = () => {
      queued = false;
      wall.style.setProperty('--px', px.toFixed(3));
      wall.style.setProperty('--py', py.toFixed(3));
      wall.style.setProperty('--sy', sy.toFixed(3));
    };
    const queue = () => {
      if (!queued) {
        queued = true;
        requestAnimationFrame(paint);
      }
    };

    const onScroll = () => {
      if (!inView || document.hidden) return;
      const box = wall.getBoundingClientRect();
      // -1 when the wall has scrolled to the top of the window, 0 when it sits mid-screen
      sy = Math.max(-1, Math.min(1, (box.top + box.height / 2 - innerHeight / 2) / innerHeight));
      queue();
    };

    const rest = () => {
      wall.classList.toggle('is-resting', !inView || document.hidden);
    };

    new IntersectionObserver(
      ([entry]) => {
        inView = entry?.isIntersecting ?? false;
        rest();
        if (inView) onScroll();
      },
      { rootMargin: '10% 0px' }
    ).observe(wall);
    document.addEventListener('visibilitychange', rest);
    addEventListener('scroll', onScroll, { passive: true });

    if (fine) {
      wall.addEventListener('pointermove', (event) => {
        if (!inView) return;
        const box = wall.getBoundingClientRect();
        px = (event.clientX - box.left) / box.width - 0.5;
        py = (event.clientY - box.top) / box.height - 0.5;
        queue();
      });
      wall.addEventListener('pointerleave', () => {
        px = 0;
        py = 0;
        queue();
      });
    }
  }
</script>

