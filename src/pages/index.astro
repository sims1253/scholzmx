---
import BaseLayout from '../layouts/BaseLayout.astro';
import DropCap from '../components/DropCap.astro';
import ImageFrame from '../components/ImageFrame.astro';
import { getCollection } from 'astro:content';

/* Optimized local images */
import selfImage from '../assets/images/homepage/self.jpg';
import portraitImage from '../assets/images/homepage/portrait.jpg';

/* Get newest post (blog or recipe) */
const allBlogPosts = await getCollection('blog');
const allRecipes = await getCollection('recipes');

const latestBlog = allBlogPosts
  .filter((p) => !p.data.draft)
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())[0];

// Both use 'date' for consistency
const latestRecipe = allRecipes.sort(
  (a, b) => new Date(b.data.date ?? 0).getTime() - new Date(a.data.date ?? 0).getTime()
)[0];

// Compare dates and pick the newest
const blogDate = latestBlog?.data.date ? new Date(latestBlog.data.date) : null;
const recipeDate = latestRecipe?.data.date ? new Date(latestRecipe.data.date) : null;

const newestPost =
  blogDate && recipeDate
    ? blogDate > recipeDate
      ? { type: 'blog' as const, post: latestBlog, date: blogDate }
      : { type: 'recipe' as const, post: latestRecipe, date: recipeDate }
    : blogDate
      ? { type: 'blog' as const, post: latestBlog, date: blogDate }
      : recipeDate
        ? { type: 'recipe' as const, post: latestRecipe, date: recipeDate }
        : null;

const formatDate = (date: Date) =>
  date.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---

<BaseLayout
  title="Grotto - Personal Website of Maximilian Scholz"
  description="Welcome to my Grotto, a place where I try to cultivate the feeling of watching the shadows dance through vines, while insects are humming and tansy is making everything smell like summer."
  includeQuoteSection={true}
  tone="personal"
  layout="wide"
>
  <div class="home">
    <h1 class="welcome">
      <span class="welcome-greeting">Welcome to my Grotto,</span>
      <span class="welcome-line">
        a place where I try to cultivate the feeling of watching the shadows dance through vines,
        while insects are humming and tansy is making everything smell like summer.
      </span>
    </h1>

    <div class="portrait pasted">
      <ImageFrame
        src={portraitImage}
        alt="Professional portrait of me"
        alternateSrc={selfImage}
        alternateAlt="More cool portrait of me"
        style="watercolor"
        fillMode="contain"
        size="large"
        loading="eager"
        positionX={0}
        positionY={2}
        scale={1.4}
        alternatePositionX={-5}
        alternatePositionY={15}
        alternateScale={1.5}
      />
    </div>

    <div class="about prose">
      <p>
        <DropCap letter="I" variant="personal" color="moss" />'m Maximilian. My best friend once
        painted me a t-shirt that read <em>verspielt und liebenswürdig</em> (playful and endearing)
        and I've yet to find a better description. The best feedback I've ever gotten described me
        as a <em>herder of cat herders</em> and my music taste has been characterized as being
        <em>an atmospheric futurist with a nostalgic heart</em>.
      </p>
      <p>
        I tend to make things. Software infrastructure that hopefully helps others, harsh vocals and
        guitar covers, a concept Call of Cthulhu campaign for a deathcore album (much to my players'
        confusion), and kitchen experiments where I try something new each month. I'm easy to
        nerdsnipe, if you couldn't tell. When I'm not building something, you'll find me on the mats
        failing triangle escapes, or somewhere between a barbell and a book.
      </p>
      <p>
        Somewhere along the way I collected a B.Sc. in <em>Computer Science in Engineering</em>, a
        M.Sc. in <em>Software Engineering and Technology</em>, and, if the gods of bureaucracy ever
        look kindly upon me, a PhD in <em>Bayesian statistics</em> will follow.
      </p>
      <p>
        I've hidden a growing number of easter eggs around the site. Let me know when you find them
        :)
      </p>
    </div>

    {newestPost && <aside class="latest" aria-label="Newest post">
      <p>
        The newest post, from
        <time datetime={newestPost.date.toISOString()}>{formatDate(newestPost.date)}</time>, is
        <a
          href={
            newestPost.type === 'blog'
              ? `/blog/${newestPost.post.id}`
              : `/recipes/${newestPost.post.id}`
          }
          >{newestPost.post.data.title}</a
        >{/[.!?]$/.test(newestPost.post.data.title) ? '' : '.'}
      </p>
    </aside>}
  </div>
</BaseLayout>

<style>
  /*
   * Desktop:  [portrait] [about, the reading column] [newest post]
   * The greeting starts on the reading column's left edge, so one axis runs down the page.
   */
  .home {
    --portrait-col: 200px;
    --aside-col: 12rem;
    --gap: clamp(1.5rem, 3vw, 3rem);

    display: grid;
    grid-template-columns:
      [portrait] var(--portrait-col)
      [text] minmax(0, var(--measure-prose))
      [aside] var(--aside-col);
    column-gap: var(--gap);
    justify-content: center;
    align-items: start;
  }

  /* The welcome is a lede, not a poster: the bio starts in the first screen. */
  .welcome {
    grid-column: text / -1;
    max-width: 32em;
    margin: var(--page-top) 0 clamp(1.25rem, 3vw, 2.25rem);
    font-family: var(--font-heading);
    font-size: var(--text-2xl);
    font-weight: 400;
    line-height: 1.15;
    text-wrap: balance;
    hyphens: manual;
  }

  .welcome-greeting {
    display: block;
    margin-bottom: 0.15em;
  }

  .welcome-line {
    display: block;
    margin-top: 0.2em;
    font-style: italic;
    font-size: 0.6em;
    line-height: 1.35;
    color: var(--color-text-secondary);
  }

  .portrait {
    grid-column: portrait;
    width: fit-content;
    margin-top: 0.4rem;
    justify-self: end;
  }

  /* A photograph pasted in, not a cut-out blob. The frame's geometry stays untouched. */
  .portrait :global(.image-frame-watercolor) {
    border-radius: 2px;
    background: var(--paper-sheet);
    box-shadow:
      0 1px 2px color-mix(in srgb, var(--color-ink-dark) 18%, transparent),
      0 10px 22px -12px color-mix(in srgb, var(--color-ink-dark) 35%, transparent);
  }

  .portrait :global(.image-frame-watercolor img) {
    border-radius: 0;
  }

  .about {
    grid-column: text;
  }

  .about p {
    margin-bottom: 1em;
  }

  .latest {
    grid-column: aside;
    margin-top: 0.4rem;
    padding-top: 0.6rem;
    border-top: 2px solid var(--color-tansy);
    font-size: var(--text-sm);
    font-style: italic;
    line-height: 1.45;
    color: var(--color-text-muted);
  }

  .latest p {
    margin: 0;
  }

  .latest a {
    font-style: normal;
    color: var(--color-link);
  }

  .latest time {
    font-variant-numeric: oldstyle-nums;
  }

  /* Medium screens: the newest post moves under the text. */
  @media (max-width: 72rem) {
    .home {
      grid-template-columns: [portrait] var(--portrait-col) [text aside] minmax(
          0,
          var(--measure-prose)
        );
    }

    .latest {
      grid-column: aside;
      max-width: 22rem;
      margin-top: var(--space-md);
    }
  }

  /* Narrow screens: one column, portrait between greeting and text. */
  @media (max-width: 48rem) {
    .home {
      grid-template-columns: minmax(0, 1fr);
    }

    .welcome,
    .portrait,
    .about,
    .latest {
      grid-column: 1;
    }

    .portrait {
      justify-self: center;
      margin: 0 0 var(--space-lg);
    }
  }
</style>
