---
import BaseLayout from '../layouts/BaseLayout.astro';
import ImageFrame from '../components/ImageFrame.astro';
import Niche from '../components/Niche.astro';
import QuoteOfTheDay from '../components/QuoteOfTheDay.astro';
import { getCollection } from 'astro:content';
import { projects, projectName } from '../data/projects';
import { publications } from '../data/publications';

/* Optimized local images */
import selfImage from '../assets/images/homepage/self.jpg';
import portraitImage from '../assets/images/homepage/portrait.jpg';

/* The newest thing kept in each niche */
const newestPost = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
)[0];
const newestRecipe = (await getCollection('recipes', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
)[0];
const newestProject = projects[0];
const newestPaper = publications[0];

const yearOf = (date: Date) => String(date.getFullYear());

/* In the order of the navigation. Each niche knows where it leads; it is told what it keeps. */
const niches = [
  {
    kind: 'desk' as const,
    kept: newestPost && {
      href: `/blog/${newestPost.id}`,
      title: newestPost.data.title,
      when: yearOf(newestPost.data.date),
    },
  },
  {
    kind: 'bench' as const,
    kept: newestProject && {
      href: newestProject.links[0]!.url,
      name: projectName(newestProject.title).name,
      title: projectName(newestProject.title).common,
      when: String(newestProject.year),
    },
  },
  {
    kind: 'pantry' as const,
    kept: newestRecipe && {
      href: `/recipes/${newestRecipe.id}`,
      title: newestRecipe.data.title,
      when: yearOf(newestRecipe.data.date),
    },
  },
  {
    kind: 'folio' as const,
    kept: newestPaper && {
      href: newestPaper.links.pdf ?? newestPaper.links.doi ?? '/research',
      title: newestPaper.title,
      when: String(newestPaper.year),
    },
  },
];
---

<BaseLayout
  title="Grotto - Personal Website of Maximilian Scholz"
  description="Welcome to my Grotto, a place where I try to cultivate the feeling of watching the shadows dance through vines, while insects are humming and tansy is making everything smell like summer."
  tone="personal"
  layout="wide"
>
  <div class="home">
    {/* The first screen: who this is, and the wall. The niches are the way into the site
        and lead the page; everything else waits below them. */}
    <div class="first-screen">
      <header class="intro">
        <div class="who">
          <h1 class="name">Maximilian Scholz</h1>
          <p class="who-line">
            I make software, cook, and hold a PhD in Bayesian statistics. You can find me on
            <a href="https://github.com/sims1253" rel="noopener me" class="no-external-indicator"
              >GitHub</a
            >
            and
            <a
              href="https://bsky.app/profile/scholzmx.bsky.social"
              rel="noopener me"
              class="no-external-indicator"
              >Bluesky</a
            >.
          </p>
        </div>
        <p class="welcome">
          Welcome to my Grotto, a place where I try to cultivate the feeling of watching the shadows
          dance through vines, while insects are humming and tansy is making everything smell like
          summer.
        </p>
      </header>

      {/* The grotto as a place: four niches in the wall, each keeping what a part of the
          site is made at, and under it the newest thing made there. Something lives in each. */}
      <section class="niches" aria-labelledby="niches-title">
        <h2 class="sr-only" id="niches-title">The four niches in the wall</h2>
        <ul class="niche-row">
          {niches.map((niche) => <li><Niche {...niche} /></li>)}
        </ul>
        <p class="wall-note">Under each niche is the newest thing I made there.</p>
      </section>
    </div>

    <section class="about" aria-labelledby="about-title">
      <h2 class="sr-only" id="about-title">About me</h2>
      <div class="portrait pasted">
        <ImageFrame
          src={portraitImage}
          alt="Maximilian in a dark suit and tie, with shoulder-length dark hair, glasses and a beard, laughing at something to his left."
          alternateSrc={selfImage}
          alternateAlt="Maximilian in the same kind of suit and round sunglasses, the wind in his hair, with other guests behind him in the sun."
          style="watercolor"
          size="large"
          positionX={0}
          positionY={2}
          scale={1.4}
          alternatePositionX={-6.5}
          alternatePositionY={15}
          alternateScale={1.5}
        />
      </div>

      <div class="bio prose">
        <p>
          My best friend once painted me a t-shirt that read
          <em lang="de">verspielt und liebenswürdig</em> (playful and endearing) and I've yet to
          find a better description. The best feedback I've ever gotten described me as a
          <em>herder of cat herders</em> and my music taste has been characterized as being
          <em>an atmospheric futurist with a nostalgic heart</em>.
        </p>
        <p>
          I tend to make things. Software infrastructure that hopefully helps others, harsh vocals
          and guitar covers, a concept Call of Cthulhu campaign for a deathcore album (much to my
          players' confusion), and kitchen experiments where I try something new each month. I'm
          easy to nerdsnipe, if you couldn't tell. When I'm not building something, you'll find me
          on the mats failing triangle escapes, or somewhere between a barbell and a book.
        </p>
        <p>
          On the way to the PhD I collected a B.Sc. in <em>Computer Science in Engineering</em> and
          a M.Sc. in <em>Software Engineering and Technology</em>.
        </p>
      </div>

      <div class="quote">
        <QuoteOfTheDay />
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  /*
   * The first screen is the wall: the name and a welcome above it, then the four niches in
   * one course, as large as the window allows, and a line under them that says what they
   * keep. The first screen ends with the window: nothing of the rest shows half. The
   * portrait, the bio and the quote of the day come after it.
   *
   * All of it keeps the page header's two edges: the name starts under the wordmark and
   * the last niche ends under the light switch, however wide the window is.
   *
   * One rule sizes the niches from the window's width and height (--niche-size); the type
   * around them follows from it. Nothing else is fitted to the screen.
   */
  .home {
    --gap: clamp(1.5rem, 3vw, 3rem);
    /* The page header, and the room main-content leaves above its first child */
    --above: 6.25rem;
    /* The header's width inside its padding (.page-nav in layout.css) */
    --wall-width: min(100%, var(--site-width) - 2 * var(--space-md));
    /* A niche is as large as the window allows, up to a quarter of the wall */
    --niche-size: clamp(6.5rem, min(16.5vw, (100svh - 22rem) * 0.5), 13rem);
    /* The name's column and the welcome's */
    --columns: minmax(0, 4fr) minmax(0, 5fr);
    /* The portrait's width, and the bio's measure: about 65 characters */
    --portrait-width: 14rem;
    --bio-measure: 26rem;

    display: grid;
    justify-items: center;
  }

  .first-screen {
    display: grid;
    align-content: center;
    gap: clamp(1.25rem, 4svh, 3rem);
    width: var(--wall-width);
    min-height: calc(100svh - var(--above));
    padding-bottom: clamp(1rem, 3svh, 2rem);
  }

  /* ===== Who, and the welcome ===== */

  .intro {
    display: grid;
    grid-template-columns: var(--columns);
    gap: var(--gap);
    align-items: end;
  }

  .name {
    margin: 0 0 0.25em;
    font-family: var(--font-heading);
    /* At its largest the name still fits its column on one line. */
    font-size: clamp(2rem, var(--niche-size) * 0.3, 3.1rem);
    font-weight: 400;
    line-height: 1.05;
    text-wrap: balance;
  }

  .who-line {
    max-width: 30rem;
    margin: 0;
    line-height: 1.5;
    text-wrap: pretty;
  }

  /* The welcome is the place speaking: italic, at the size of the text, and quieter
     than the name, which leads. */
  .welcome {
    max-width: 32rem;
    margin: 0;
    font-style: italic;
    line-height: 1.5;
    color: var(--color-text-secondary);
    text-wrap: pretty;
    hyphens: manual;
  }

  /* ===== The niches ===== */

  .niche-row {
    --niche-name-size: clamp(var(--text-lg), var(--niche-size) * 0.13, 1.667rem);
    --kept-size: clamp(var(--text-sm), var(--niche-size) * 0.085, var(--text-md));
    --kept-width: 100%;

    /* Each column is as wide as its niche, and the room left over goes between them, so
       the outer niches stand on the wall's two edges. What a niche keeps is set to the
       column's width. Where a short window makes the niches small, the column stays wide
       enough for a title to read in two or three lines, and the niche stands in its
       middle. */
    display: grid;
    grid-template-columns: repeat(4, minmax(0, max(var(--niche-size), 10rem)));
    justify-content: space-between;
    gap: var(--space-lg) clamp(0.75rem, 2vw, 2rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .niche-row li {
    margin: 0;
  }

  /* The wall's caption: what the line under each niche is. */
  .wall-note {
    margin: clamp(0.9rem, 2.5svh, 1.6rem) 0 0;
    font-size: var(--text-sm);
    font-style: italic;
    color: var(--color-text-muted);
    text-align: center;
  }

  /* ===== Below the wall: the portrait, the bio, and the quote ===== */

  /* Three across the wall's width: the portrait under the name, the bio right beside it
     so the two read as one, and the quote of the day as an aside under the last niche. */
  .about {
    display: grid;
    grid-template-columns: var(--portrait-width) minmax(0, var(--bio-measure)) minmax(0, 1fr);
    column-gap: var(--gap);
    align-items: start;
    width: var(--wall-width);
    margin-top: var(--space-lg);
  }

  .portrait {
    grid-column: 1;
    grid-row: 1;
    width: var(--portrait-width);
    margin-top: 0.5rem;
  }

  /* The frame is told its width here; it keeps its own shape, and its mat grows with
     it, so the photograph is framed the same at every size. */
  .home .portrait :global(.image-frame-watercolor) {
    width: 100%;
    padding: 4%;
  }

  /* A photograph pasted in, not a cut-out blob. The frame's geometry stays untouched, and
     its shadow stays a shadow in both lights: by torchlight the ink is pale, so the shade
     is its own. Picked up, it lifts a little. */
  .home {
    --photo-shade: var(--color-ink-dark);
  }

  :global(:root[data-theme='dark']) .home {
    --photo-shade: rgb(4 3 2);
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .home {
      --photo-shade: rgb(4 3 2);
    }
  }

  .home .portrait :global(.image-frame-watercolor) {
    border-radius: 2px;
    background: var(--paper-sheet);
    box-shadow:
      0 1px 2px color-mix(in srgb, var(--photo-shade) 18%, transparent),
      0 10px 22px -12px color-mix(in srgb, var(--photo-shade) 35%, transparent);
  }

  .home .portrait :global(.image-frame-watercolor.clickable:hover) {
    box-shadow:
      0 1px 2px color-mix(in srgb, var(--photo-shade) 22%, transparent),
      0 14px 26px -12px color-mix(in srgb, var(--photo-shade) 45%, transparent);
  }

  .portrait :global(.image-frame-watercolor img) {
    border-radius: 0;
  }

  /* By torchlight a daylit photograph glares; it takes the torch's warmth instead. */
  :global(:root[data-theme='dark']) .portrait :global(img) {
    filter: brightness(0.78) saturate(0.85) sepia(0.12);
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .portrait :global(img) {
      filter: brightness(0.78) saturate(0.85) sepia(0.12);
    }
  }

  .bio {
    grid-column: 2;
    grid-row: 1 / span 2;
    max-width: var(--bio-measure);
  }

  .bio p:last-child {
    margin-bottom: 0;
  }

  .quote {
    grid-column: 3;
    grid-row: 1;
    justify-self: end;
    width: 100%;
    max-width: 26rem;
    margin-top: 0.5rem;
  }

  /* Too narrow for three across: the quote goes under the portrait, which takes what
     the bio's measure leaves it. */
  @media (max-width: 77.999rem) {
    .home {
      --portrait-width: 100%;
    }

    .about {
      grid-template-columns: minmax(12rem, 17rem) minmax(0, var(--bio-measure));
    }

    .quote {
      grid-column: 1;
      grid-row: 2;
      margin-top: var(--space-xl);
    }
  }

  /* Narrower than name and welcome side by side: they stack, and the wall follows at
     once. The window's height no longer decides anything. */
  @media (max-width: 60rem) {
    .home {
      --niche-size: clamp(8rem, 20vw, 11rem);
      --wall-width: min(100%, 46rem);
      --columns: minmax(0, 1fr);
      --portrait-width: 200px;
    }

    .first-screen {
      min-height: 0;
      gap: var(--space-lg);
      padding-top: var(--page-top);
    }

    /* Here the niches share the wall's width evenly. */
    .niche-row {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .intro {
      gap: var(--space-sm);
    }

    .about {
      grid-template-columns: auto minmax(0, 1fr);
      margin-top: var(--space-md);
    }

    .bio {
      grid-row: 1;
    }

    .quote {
      grid-column: 2;
      justify-self: start;
    }
  }

  /* Phones: the name leads straight to the niches, which stand two by two; the welcome
     follows the wall. The portrait goes above the bio. */
  @media (max-width: 40rem) {
    /* Small enough that the second pair's links show on the first screen */
    .home {
      --niche-size: min(9.5rem, 30vw);
    }

    .first-screen {
      gap: var(--space-md);
    }

    .intro {
      display: contents;
    }

    .niches {
      order: 1;
    }

    /* A rule keeps the welcome apart from the wall's caption: both are italic. */
    .welcome {
      order: 2;
      padding-top: var(--space-md);
      border-top: 1px solid var(--rule-ink);
    }

    .niche-row {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .about {
      grid-template-columns: minmax(0, 1fr);
    }

    .portrait,
    .bio,
    .quote {
      grid-column: 1;
      grid-row: auto;
    }

    .portrait {
      justify-self: center;
      margin: 0 0 var(--space-lg);
    }

    .quote {
      justify-self: center;
    }
  }
</style>
