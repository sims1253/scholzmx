---
import BaseLayout from '../layouts/BaseLayout.astro';
import DropCap from '../components/DropCap.astro';
import ImageFrame from '../components/ImageFrame.astro';
import Niche from '../components/Niche.astro';
import { getCollection } from 'astro:content';
import { projects, projectName } from '../data/projects';
import { publications } from '../data/publications';

/* Optimized local images */
import selfImage from '../assets/images/homepage/self.jpg';
import portraitImage from '../assets/images/homepage/portrait.jpg';

/* The newest thing kept in each niche */
const newestPost = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
)[0];
const newestRecipe = (await getCollection('recipes', ({ data }) => !data.draft)).sort(
  (a, b) => (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0)
)[0];
const newestProject = projects[0];
const newestPaper = publications[0];

const yearOf = (date: Date) => String(date.getFullYear());

const niches = [
  {
    kind: 'desk' as const,
    href: '/blog',
    name: 'Blog',
    caption: 'the writing desk',
    kept: newestPost && {
      href: `/blog/${newestPost.id}`,
      title: newestPost.data.title,
      when: yearOf(newestPost.data.date),
    },
  },
  {
    kind: 'pantry' as const,
    href: '/recipes',
    name: 'Recipes',
    caption: 'the pantry shelf',
    kept: newestRecipe && {
      href: `/recipes/${newestRecipe.id}`,
      title: newestRecipe.data.title,
      when: newestRecipe.data.date ? yearOf(newestRecipe.data.date) : undefined,
    },
  },
  {
    kind: 'bench' as const,
    href: '/projects',
    name: 'Projects',
    caption: 'the workbench',
    kept: newestProject && {
      href: newestProject.links[0]!.url,
      // A short lowercase name alone ("ry") reads as the tail of a cut-off word.
      name: projectName(newestProject.title).name,
      title: projectName(newestProject.title).common,
      when: String(newestProject.year),
    },
  },
  {
    kind: 'folio' as const,
    href: '/research',
    name: 'Research',
    caption: 'the folio',
    kept: newestPaper && {
      href: newestPaper.links.pdf ?? newestPaper.links.doi ?? '/research',
      title: newestPaper.title,
      when: String(newestPaper.year),
    },
  },
];
---

<BaseLayout
  title="Grotto - Personal Website of Maximilian Scholz"
  description="Welcome to my Grotto, a place where I try to cultivate the feeling of watching the shadows dance through vines, while insects are humming and tansy is making everything smell like summer."
  includeQuoteSection={true}
  tone="personal"
  layout="wide"
>
  <div class="home">
    <h1 class="welcome">
      <span class="welcome-greeting">Welcome to my Grotto,</span>
      <span class="welcome-line">
        a place where I try to cultivate the feeling of watching the shadows dance through vines,
        while insects are humming and tansy is making everything smell like summer.
      </span>
    </h1>

    <div class="portrait pasted">
      <ImageFrame
        src={portraitImage}
        alt="Professional portrait of me"
        alternateSrc={selfImage}
        alternateAlt="More cool portrait of me"
        style="watercolor"
        fillMode="contain"
        size="large"
        loading="eager"
        positionX={0}
        positionY={2}
        scale={1.4}
        alternatePositionX={-5}
        alternatePositionY={15}
        alternateScale={1.5}
      />
    </div>

    <div class="about prose">
      <p>
        <DropCap letter="I" variant="personal" color="moss" />'m Maximilian. My best friend once
        painted me a t-shirt that read <em>verspielt und liebenswürdig</em> (playful and endearing)
        and I've yet to find a better description. The best feedback I've ever gotten described me
        as a <em>herder of cat herders</em> and my music taste has been characterized as being
        <em>an atmospheric futurist with a nostalgic heart</em>.
      </p>
      <p>
        I tend to make things. Software infrastructure that hopefully helps others, harsh vocals and
        guitar covers, a concept Call of Cthulhu campaign for a deathcore album (much to my players'
        confusion), and kitchen experiments where I try something new each month. I'm easy to
        nerdsnipe, if you couldn't tell. When I'm not building something, you'll find me on the mats
        failing triangle escapes, or somewhere between a barbell and a book.
      </p>
      <p>
        Somewhere along the way I collected a B.Sc. in <em>Computer Science in Engineering</em>, a
        M.Sc. in <em>Software Engineering and Technology</em>, and, if the gods of bureaucracy ever
        look kindly upon me, a PhD in <em>Bayesian statistics</em> will follow.
      </p>
      <p>
        I've hidden a growing number of easter eggs around the site. Let me know when you find them
        :)
      </p>
    </div>

    {/* The grotto as a place: four niches in the wall, each keeping what a part of the
        site is made at, and under it the newest thing made there. */}
    <section class="niches" aria-labelledby="niches-title">
      <h2 class="niches-title" id="niches-title">
        There are four niches in the wall. Each keeps the newest thing I made there.
      </h2>
      <ul class="niche-row">
        {niches.map(({ kept, ...niche }) => <li>
          <Niche {...niche}>
            {kept && <p class="kept">
              <a href={kept.href}> {'name' in kept && <><em>{kept.name}</em>, </>}{kept.title} </a>
              {kept.when && <span class="kept-when">{kept.when}</span>}
            </p>}
          </Niche>
        </li>)}
      </ul>
    </section>
  </div>
</BaseLayout>

<style>
  /*
   * Desktop:  [portrait] [about, the reading column] [an equal empty margin]
   *           [ four niches across the whole width ]
   * The greeting starts on the reading column's left edge, so one axis runs down the page.
   */
  /* The two side columns are equally wide, so the reading column is centred. */
  .home {
    --side-col: 12rem;
    --gap: clamp(1.5rem, 3vw, 3rem);

    display: grid;
    grid-template-columns:
      [portrait] var(--side-col)
      [text] minmax(0, var(--measure-prose))
      [aside] var(--side-col);
    column-gap: var(--gap);
    justify-content: center;
    align-items: start;
  }

  /* The welcome is a lede, not a poster: the bio starts in the first screen. */
  .welcome {
    grid-column: text / -1;
    max-width: 32em;
    margin: var(--page-top) 0 clamp(1.25rem, 3vw, 2.25rem);
    font-family: var(--font-heading);
    font-size: var(--text-2xl);
    font-weight: 400;
    line-height: 1.15;
    text-wrap: balance;
    hyphens: manual;
  }

  .welcome-greeting {
    display: block;
    margin-bottom: 0.15em;
  }

  .welcome-line {
    display: block;
    margin-top: 0.2em;
    font-style: italic;
    font-size: 0.6em;
    line-height: 1.35;
    color: var(--color-text-secondary);
  }

  .portrait {
    grid-column: portrait;
    width: fit-content;
    margin-top: 0.4rem;
    justify-self: end;
  }

  /* A photograph pasted in, not a cut-out blob. The frame's geometry stays untouched. */
  .portrait :global(.image-frame-watercolor) {
    border-radius: 2px;
    background: var(--paper-sheet);
    box-shadow:
      0 1px 2px color-mix(in srgb, var(--color-ink-dark) 18%, transparent),
      0 10px 22px -12px color-mix(in srgb, var(--color-ink-dark) 35%, transparent);
  }

  .portrait :global(.image-frame-watercolor img) {
    border-radius: 0;
  }

  .about {
    grid-column: text;
  }

  .about p {
    margin-bottom: 1em;
  }

  /* ===== The niches ===== */

  .niches {
    grid-column: 1 / -1;
    width: min(100%, 58rem);
    margin: clamp(2.5rem, 6vw, 4.5rem) auto 0;
  }

  /* A sentence, not a banner: it only says what the drawings are. */
  .niches-title {
    max-width: 30rem;
    margin: 0 auto clamp(1.25rem, 3vw, 2rem);
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    font-style: italic;
    font-weight: 400;
    line-height: 1.4;
    text-align: center;
    color: var(--color-text-secondary);
  }

  .niche-row {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-lg) clamp(0.75rem, 2.5vw, 2rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .niche-row li {
    margin: 0;
  }

  .kept {
    max-width: 13rem;
    margin: 0.6rem 0 0;
    font-size: var(--text-sm);
    line-height: 1.4;
    hyphens: manual;
  }

  /* A long paper title stays three lines; the link leads to the rest. */
  .kept a {
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    line-clamp: 3;
  }

  .kept-when {
    display: block;
    margin-top: 0.15rem;
    font-style: italic;
    color: var(--color-text-muted);
    font-variant-numeric: oldstyle-nums;
  }

  /* Below the width where the portrait fits beside the text: one centred reading
     column, the portrait between greeting and text, the niches after it. */
  @media (max-width: 72rem) {
    .home {
      grid-template-columns: minmax(0, var(--measure-prose));
    }

    .welcome,
    .portrait,
    .about {
      grid-column: 1;
    }

    .portrait {
      justify-self: center;
      margin: 0 0 var(--space-lg);
    }
  }

  /* Phones: the niches sit two by two. */
  @media (max-width: 40rem) {
    .niche-row {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
