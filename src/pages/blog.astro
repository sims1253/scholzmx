---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import IndexFinder from '../components/IndexFinder.astro';
import NoteCardStack from '../components/NoteCardStack.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);

const years = [...new Set(posts.map((post) => post.data.date.getFullYear()))];
const postsByYear = years.map(
  (year) => [year, posts.filter((post) => post.data.date.getFullYear() === year)] as const
);
const tags = [...new Set(posts.flatMap((post) => post.data.tags ?? []))].sort((a, b) =>
  a.localeCompare(b)
);

const isoDay = (date: Date) => date.toISOString().slice(0, 10);

type Post = (typeof posts)[number];
const heroOf = (post: Post) => {
  const { heroImage, heroImageScale, heroImagePositionX, heroImagePositionY } = post.data;
  const framing = {
    scale: heroImageScale || 1,
    posX: heroImagePositionX || 0,
    posY: heroImagePositionY || 0,
  };
  // The collection schema validates the string/asset union before this point.
  // oxlint-disable-next-line anti-slop/no-runtime-typeof
  if (typeof heroImage === 'string') return { kind: 'url' as const, src: heroImage, ...framing };
  if (heroImage) return { kind: 'asset' as const, src: heroImage, ...framing };
  return undefined;
};
---

<BaseLayout title="Blog" description="My long-form writing." tone="serious" layout="listing">
  <div class="index-page">
    <header class="page-header">
      <h1 class="page-title">Blog</h1>
      <p class="page-lede">
        I like writing both to teach myself and others, as well as just as a way to have fun.
      </p>
    </header>

    <IndexFinder
      type="blog"
      noun="posts"
      tags={tags}
      jumps={years.map((year) => ({ href: `#year-${year}`, label: String(year) }))}
    />

    {postsByYear.map(([year, entries]) => <section
      class="index-group"
      data-index-group
      aria-labelledby={`year-${year}`}
    >
      <h2 class="index-label" id={`year-${year}`}>{year}</h2>
      <NoteCardStack
        columns={1}
        headingLevel={3}
        items={entries.map((post) => ({
          id: post.id,
          title: post.data.title,
          subtitle: post.data.description,
          href: `/blog/${post.id}`,
          writtenDate: isoDay(post.data.date),
          updatedDate: post.data.lastUpdated ? isoDay(post.data.lastUpdated) : undefined,
          tags: post.data.tags ?? [],
          year,
          hero: heroOf(post),
        }))}
      />
    </section>)}
  </div>
</BaseLayout>
