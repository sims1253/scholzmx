---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import IndexFinder from '../components/IndexFinder.astro';
import Series from '../components/Series.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);

const years = [...new Set(posts.map((post) => post.data.date.getFullYear()))];
const postsByYear = years.map(
  (year) => [year, posts.filter((post) => post.data.date.getFullYear() === year)] as const
);
const tags = [...new Set(posts.flatMap((post) => post.data.tags ?? []))].sort((a, b) =>
  a.localeCompare(b)
);

const dayAndMonth = (date: Date) =>
  date.toLocaleDateString('en-GB', { day: 'numeric', month: 'long' });
const fullDate = (date: Date) =>
  date.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---

<BaseLayout title="Blog" description="My long-form writing." tone="serious" layout="listing">
  <div class="index-page">
    <header class="page-header">
      <h1 class="page-title">Blog</h1>
      <p class="page-lede">
        I like writing both to teach myself and others, as well as just as a way to have fun.
      </p>
    </header>

    <IndexFinder
      type="blog"
      noun="posts"
      tags={tags}
      jumps={years.map((year) => ({ href: `#year-${year}`, label: String(year) }))}
    />

    {postsByYear.map(([year, entries]) => <section
      class="index-group"
      data-index-group
      aria-labelledby={`year-${year}`}
    >
      <h2 class="index-label" id={`year-${year}`}>{year}</h2>
      <ol class="index-entries" reversed>
        {entries.map((post) => {
          const postTags = post.data.tags ?? [];
          return <li class="index-entry nc-item" data-year={year} data-tags={postTags.join(',')}>
            <h3 class="entry-title"><a href={`/blog/${post.id}`}>{post.data.title}</a></h3>
            <p class="entry-summary">{post.data.description}</p>
            <p class="entry-meta">
              <time datetime={post.data.date.toISOString()}>{dayAndMonth(post.data.date)}</time
              >{post.data.lastUpdated && (
                <>, updated
                  <time datetime={post.data.lastUpdated.toISOString()}
                    >{fullDate(post.data.lastUpdated)}</time
                  ></>
              )}{postTags.length > 0 && (
                <>. Filed under
                  <Series
                    items={postTags.map((text) => ({
                      text,
                      href: `/blog?tag=${encodeURIComponent(text)}`,
                    }))}
                  /></>
              )}.
            </p>
          </li>;
        })}
      </ol>
    </section>)}
  </div>
</BaseLayout>
