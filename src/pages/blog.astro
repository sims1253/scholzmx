---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ListingCardStack from '../components/ListingCardStack.astro';
import Search from 'astro-pagefind/components/Search';
import { fromBlogEntry } from '../lib/cards/adapters';

// Get URL parameters for filtering
const params = Astro.url.searchParams;
const filterYear = params.get('year');
const filterTag = params.get('tag');

let allPosts = await getCollection('blog', ({ data }) => !data.draft).catch((err) => {
  console.error('Failed to load blog collection:', err);
  return [];
});

const posts = [...allPosts].sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);

const years = Array.from(new Set(allPosts.map((p) => new Date(p.data.date).getFullYear()))).sort(
  (a, b) => b - a
);
const tags = Array.from(new Set(allPosts.flatMap((p) => p.data.tags ?? []))).sort();

const yearAllUrl = new URL('/blog', Astro.url);
if (filterTag) yearAllUrl.searchParams.set('tag', filterTag);
const yearAllHref = `${yearAllUrl.pathname}${yearAllUrl.search}`;

const tagAllUrl = new URL('/blog', Astro.url);
if (filterYear) tagAllUrl.searchParams.set('year', filterYear);
const tagAllHref = `${tagAllUrl.pathname}${tagAllUrl.search}`;
---

<BaseLayout
  title="Blog"
  description="My long-form writing."
  footerVariant="writing"
  tone="serious"
  layout="listing"
>
  <div class="blog-page">
    <header class="blog-header page-shell-header">
      <h1 class="page-title page-shell-title" id="blog-title">Blog</h1>
      <p class="page-description page-shell-description">
        I like writing both to teach myself and others, as well as just as a way to have fun.
      </p>
    </header>

    <div class="blog-container">
      <aside class="blog-sidebar blog-filters">
        <div class="listing-sidebar blog-sidebar-inner">
          <section class="sidebar-section" role="search" aria-labelledby="search-heading">
            <h3 id="search-heading">Search posts</h3>
            <Search
              id="blog-search"
              className="pagefind-ui"
              uiOptions={{
                showImages: false,
                debounceTimeoutMs: 100,
                pageSize: 5,
                excerptLength: 80,
                showResultsCount: true,
                showEmptyFilters: false,
                filters: { type: 'blog' },
                translations: {
                  placeholder: 'Search posts...',
                  clear_search: 'Clear search',
                  load_more: 'Load more results',
                  search_label: 'Search posts',
                  filters_label: 'Filters',
                  zero_results: 'No posts found matching your search.',
                  many_results: '# posts found',
                  one_result: '1 post found',
                  alt_search: 'Search for [SEARCH_TERM]',
                  search_suggestion: 'Try searching for a topic, tag, or keyword',
                },
              }}
            />
          </section>
          <section class="sidebar-section" aria-labelledby="year-filter-heading">
            <h3 id="year-filter-heading">Filter by year</h3>
            <ul class="filter-list">
              <li>
                <a href={yearAllHref} class={`filter-btn${!filterYear ? ' active' : ''}`}> All </a>
              </li>
              {
                years.map((y) => {
                  const url = new URL('/blog', Astro.url);
                  if (filterTag) url.searchParams.set('tag', filterTag);
                  url.searchParams.set('year', y.toString());
                  const href = `${url.pathname}${url.search}`;
                  const isActive = filterYear === y.toString();
                  return (
                    <li>
                      <a href={href} class={`filter-btn${isActive ? ' active' : ''}`}>
                        {y}
                      </a>
                    </li>
                  );
                })
              }
            </ul>
          </section>
          <section class="sidebar-section" aria-labelledby="tag-filter-heading">
            <h3 id="tag-filter-heading">Filter by tag</h3>
            <ul class="filter-list">
              <li>
                <a href={tagAllHref} class={`filter-btn${!filterTag ? ' active' : ''}`}> All </a>
              </li>
              {
                tags.map((t) => {
                  const url = new URL('/blog', Astro.url);
                  if (filterYear) url.searchParams.set('year', filterYear);
                  url.searchParams.set('tag', t);
                  const href = `${url.pathname}${url.search}`;
                  const isActive = filterTag === t;
                  return (
                    <li>
                      <a href={href} class={`filter-btn${isActive ? ' active' : ''}`}>
                        #{t}
                      </a>
                    </li>
                  );
                })
              }
            </ul>
          </section>
        </div>
      </aside>

      <main class="blog-content">
        <section aria-labelledby="posts-heading">
          <h2 id="posts-heading" class="visually-hidden">All Posts</h2>
          <ListingCardStack
            profile="blog"
            columns={1}
            maxWidth="var(--listing-card-max-width)"
            items={posts.map((post) =>
              fromBlogEntry(post, {
                idPrefix: 'stack',
                tagHref: (tag) => `/blog?tag=${encodeURIComponent(tag)}`,
              })
            )}
          />
          <p class="blog-empty-state" aria-live="polite" hidden>
            No posts match these filters. <a href="/blog">Clear filters</a>
          </p>
        </section>
      </main>
    </div>
  </div>

  <style>
    .blog-page {
      max-width: 100%;
      --article-column-width: var(--measure-prose);
      --listing-card-max-width: calc(var(--article-column-width) + (2 * var(--space-md)));
    }

    @media (min-width: 1200px) and (max-width: 1499px) {
      .blog-page {
        --article-column-width: calc(1200px - 280px - var(--space-lg));
      }
    }

    .blog-container {
      position: relative;
      max-width: var(--listing-card-max-width);
      margin: 0 auto;
    }

    .blog-content {
      /* content is the main flow */
    }

    .blog-empty-state {
      font-style: italic;
      color: var(--color-text-muted);
      text-align: center;
      padding: var(--space-xl) var(--space-md);
      font-size: var(--text-md);
    }

    .blog-empty-state a {
      color: var(--color-walnut);
    }

    .blog-sidebar {
      display: none; /* hidden on mobile */
    }

    @media (min-width: 1200px) {
      .blog-sidebar {
        display: block;
        position: absolute;
        right: calc(100% + var(--space-lg));
        top: 0;
        bottom: 0;
        width: var(--sidebar-width);
      }

      .blog-sidebar-inner {
        position: sticky;
        top: clamp(6.5rem, 38.2vh, 14rem);
        max-height: calc(100dvh - clamp(6.5rem, 38.2vh, 14rem) - var(--space-md));
        overflow-y: auto;
      }
    }
  </style>

  <script is:inline>
    (() => {
      const applyBlogFilters = () => {
        const params = new URLSearchParams(window.location.search);
        const activeYear = params.get('year');
        const activeTag = params.get('tag');

        let visibleCount = 0;
        document.querySelectorAll('.blog-content .nc-item').forEach((card) => {
          const year = card.getAttribute('data-year');
          const tags = (card.getAttribute('data-tags') || '').split(',').filter(Boolean);
          const yearMatch = !activeYear || year === activeYear;
          const tagMatch = !activeTag || tags.includes(activeTag);
          const visible = yearMatch && tagMatch;

          card.style.display = visible ? '' : 'none';
          card.setAttribute('aria-hidden', visible ? 'false' : 'true');
          if (visible) visibleCount++;
        });

        const emptyState = document.querySelector('.blog-empty-state');
        if (emptyState) {
          emptyState.hidden = visibleCount > 0;
        }

        const markActive = (sectionSelector, key) => {
          const value = params.get(key);
          document.querySelectorAll(`${sectionSelector} .filter-btn`).forEach((btn) => {
            const btnParams = new URL(btn.href, window.location.origin).searchParams;
            const btnValue = btnParams.get(key);
            const isActive = value ? btnValue === value : !btnValue;
            btn.classList.toggle('active', isActive);
            if (isActive) {
              btn.setAttribute('aria-current', 'page');
            } else {
              btn.removeAttribute('aria-current');
            }
          });
        };

        markActive('[aria-labelledby="year-filter-heading"]', 'year');
        markActive('[aria-labelledby="tag-filter-heading"]', 'tag');
      };

      const onFilterClick = (event) => {
        const target = event.target;
        if (!(target instanceof HTMLElement)) return;
        const link = target.closest('.blog-sidebar .filter-btn');
        if (!(link instanceof HTMLAnchorElement)) return;

        event.preventDefault();

        const current = new URL(window.location.href);
        const next = new URL(link.href, window.location.origin);

        if (link.closest('[aria-labelledby="year-filter-heading"]')) {
          const year = next.searchParams.get('year');
          if (year) current.searchParams.set('year', year);
          else current.searchParams.delete('year');
        }

        if (link.closest('[aria-labelledby="tag-filter-heading"]')) {
          const tag = next.searchParams.get('tag');
          if (tag) current.searchParams.set('tag', tag);
          else current.searchParams.delete('tag');
        }

        window.history.pushState({}, '', current);
        applyBlogFilters();
      };

      const initBlogFilters = () => {
        applyBlogFilters();

        const sidebar = document.querySelector('.blog-sidebar');
        if (sidebar && !sidebar.dataset.filtersBound) {
          sidebar.addEventListener('click', onFilterClick);
          sidebar.dataset.filtersBound = 'true';
        }

        if (!window.__blogFilterPopstateBound) {
          window.addEventListener('popstate', applyBlogFilters);
          window.__blogFilterPopstateBound = true;
        }
      };

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initBlogFilters, { once: true });
      } else {
        initBlogFilters();
      }

      document.addEventListener('astro:page-load', initBlogFilters);
    })();
  </script>
</BaseLayout>
