---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Series from '../../components/Series.astro';
import StackedCard from '../../components/StackedCard.astro';

const notes = (await getCollection('notes', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.created.getTime() - a.data.created.getTime()
);
const titles = new Map(notes.map((note) => [note.id, note.data.title]));

const years = [...new Set(notes.map((note) => note.data.created.getFullYear()))];
const notesByYear = years.map(
  (year) => [year, notes.filter((note) => note.data.created.getFullYear() === year)] as const
);

const dayAndMonth = (date: Date) =>
  date.toLocaleDateString('en-GB', { day: 'numeric', month: 'long' });
const article = (type: string) => (/^[aeiou]/.test(type) ? 'An' : 'A');
---

<BaseLayout
  title="Notes - Digital Garden"
  description="A digital garden of notes in every stage of growth."
  tone="personal"
  layout="listing"
>
  <div class="index-page">
    <header class="page-header">
      <h1 class="page-title">Notes & Seedlings</h1>
      <p class="page-lede">
        A digital garden where thoughts grow from seeds to saplings. Some ideas are polished, others
        are works in progress. All are part of the ongoing journey of learning and understanding.
      </p>
    </header>

    {notesByYear.map(([year, entries]) => <section
      class="index-group"
      data-index-group
      aria-labelledby={`year-${year}`}
    >
      <h2 class="index-label" id={`year-${year}`}>{year}</h2>
      <div class="note-cards">
        {entries.map((note) => {
          const connections = (note.data.connections ?? []).flatMap((id) => {
            const text = titles.get(id);
            return text ? [{ text, href: `/notes/${id}` }] : [];
          });
          return <StackedCard
            seed={`note/${note.id}`}
            title={note.data.title}
            subtitle={note.data.description}
            href={`/notes/${note.id}`}
            headingLevel={3}
          >
            <p class="note-meta">
              {article(note.data.type)}
              {note.data.type}, planted on
              <time datetime={note.data.created.toISOString()}
                >{dayAndMonth(note.data.created)}</time
              >{connections.length > 0 && (
                <>. Grows toward <Series items={connections} last="and" /></>
              )}.
            </p>
          </StackedCard>;
        })}
      </div>
    </section>)}
  </div>
</BaseLayout>

<style>
  .note-cards {
    display: grid;
    gap: var(--space-xl);
    max-width: var(--card-max-width);
  }

  .note-meta {
    margin: var(--space-xs) 0 0;
    font-size: var(--text-sm);
    font-style: italic;
    color: var(--color-text-muted);
  }
</style>
