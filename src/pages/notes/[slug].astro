---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Series from '../../components/Series.astro';

export async function getStaticPaths() {
  const notes = await getCollection('notes');
  return notes.map((note) => ({
    params: { slug: note.id },
    props: { note },
  }));
}

const { note } = Astro.props;

// Get all notes for backlinks functionality
const allNotes = await getCollection('notes');
const titles = new Map(allNotes.map((n) => [n.id, n.data.title]));

// Find notes that reference this note (backlinks)
const backlinks = allNotes.filter(
  (n) =>
    n.data.connections?.includes(note.id) ||
    n.body?.includes(`[[${note.data.title}]]`) ||
    n.body?.includes(`[[${note.id}]]`)
);

// Find notes that this note connects to (forward links)
const forwardLinks = allNotes.filter((n) => note.data.connections?.includes(n.id));

// Wiki links like [[slow-web-principles]] become links to the note they name.
const body = (note.rendered?.html ?? '').replace(
  /\[\[([a-z0-9-]+)\]\]/g,
  (match: string, id: string) => {
    const title = titles.get(id);
    return title ? `<a href="/notes/${id}">${title}</a>` : match;
  }
);

const formatDate = (date: Date) =>
  date.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
const article = (type: string) => (/^[aeiou]/.test(type) ? 'An' : 'A');
const toItems = (notes: typeof allNotes) =>
  notes.map((n) => ({ text: n.data.title, href: `/notes/${n.id}` }));
---

<BaseLayout
  title={`${note.data.title} - Notes`}
  description={note.data.description || `A ${note.data.type} from the digital garden`}
  tone="personal"
  layout="prose"
  prose={true}
>
  <article class="note">
    <header class="note-header">
      <h1 class="note-title">{note.data.title}</h1>
      {note.data.description && <p class="note-description">{note.data.description}</p>}
      <p class="note-meta">
        {article(note.data.type)}
        {note.data.type}, planted on
        <time datetime={note.data.created.toISOString()}>{formatDate(note.data.created)}</time
        >{note.data.updated && (
          <>, last tended on
            <time datetime={note.data.updated.toISOString()}>{formatDate(note.data.updated)}</time></>
        )}{note.data.tags && note.data.tags.length > 0 && (
          <>. Filed under <Series items={note.data.tags.map((text) => ({ text }))} /></>
        )}.
      </p>
    </header>

    <div class="note-body prose" set:html={body} />

    <footer class="note-footer">
      {forwardLinks.length > 0 && <p>
        Grows toward <Series items={toItems(forwardLinks)} last="and" />.
      </p>}
      {backlinks.length > 0 && <p>
        Referenced by <Series items={toItems(backlinks)} last="and" />.
      </p>}
      <p><a href="/notes">All notes</a></p>
    </footer>
  </article>
</BaseLayout>

<style>
  .note-header {
    margin: clamp(1.5rem, 5vw, 3.5rem) 0 var(--space-xl);
  }

  .note-title {
    margin: 0 0 0.3em;
    font-size: var(--text-display);
    font-weight: 400;
    line-height: 1.05;
    text-wrap: balance;
  }

  .note-description {
    margin: 0 0 0.6em;
    font-size: var(--text-lg);
    font-style: italic;
    line-height: 1.45;
    color: var(--color-text-secondary);
  }

  .note-meta {
    margin: 0;
    font-size: var(--text-sm);
    font-style: italic;
    color: var(--color-text-muted);
    font-variant-numeric: oldstyle-nums;
  }

  .note-footer {
    margin-top: var(--space-xxl);
    padding-top: var(--space-lg);
    border-top: 1px solid var(--rule-ink);
    font-style: italic;
    color: var(--color-text-muted);
  }

  .note-footer p {
    margin: 0 0 0.4em;
  }

  .note-footer a {
    font-style: normal;
  }
</style>
