---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ListingCardStack from '../components/ListingCardStack.astro';
import Search from 'astro-pagefind/components/Search';
import { fromRecipeEntry } from '../lib/cards/adapters';

// Get URL parameters for filtering
const params = Astro.url.searchParams;
const filterTag = params.get('tag');

const allRecipes = await getCollection('recipes', ({ data }) => !data.draft);

const recipes = [...allRecipes].sort((a, b) => a.data.title.localeCompare(b.data.title));
const tags = Array.from(new Set(allRecipes.flatMap((r) => r.data.tags ?? []))).sort();
---

<BaseLayout
  title="Recipes"
  description="Personal kitchen notes and recipes."
  footerVariant="kitchen"
  tone="personal"
  layout="listing"
>
  <div class="recipes-page">
    <header class="recipes-header page-shell-header">
      <h1 class="page-title page-shell-title">Recipes</h1>
      <p class="page-description page-shell-description">
        I am an avid hobby-cook and try out new things constantly. Figured I should start keeping a
        better log.
      </p>
    </header>

    <div class="recipes-container">
      <aside class="recipes-sidebar">
        <div class="listing-sidebar recipes-sidebar-inner">
          <section class="sidebar-section" role="search" aria-labelledby="search-heading">
            <h3 id="search-heading">Search recipes</h3>
            <Search
              id="recipes-search"
              className="pagefind-ui"
              uiOptions={{
                showImages: false,
                debounceTimeoutMs: 100,
                pageSize: 5,
                excerptLength: 80,
                showResultsCount: true,
                showEmptyFilters: false,
                filters: { type: 'recipe' },
                translations: {
                  placeholder: 'Search recipes...',
                  clear_search: 'Clear search',
                  load_more: 'Load more results',
                  search_label: 'Search recipes',
                  filters_label: 'Filters',
                  zero_results: 'No recipes found matching your search.',
                  many_results: '# recipes found',
                  one_result: '1 recipe found',
                  alt_search: 'Search for [SEARCH_TERM]',
                  search_suggestion:
                    'Try searching for a recipe name, ingredient, or cooking method',
                },
              }}
            />
          </section>
          <section class="sidebar-section" role="group" aria-labelledby="filter-heading">
            <h3 id="filter-heading">Filter by tag</h3>
            <ul class="filter-list">
              <li>
                <a
                  href="/recipes"
                  class={`filter-btn${!filterTag ? ' active' : ''}`}
                  aria-label="Show all recipes"
                >
                  All
                </a>
              </li>
              {
                tags.map((t) => {
                  const url = new URL('/recipes', Astro.url);
                  url.searchParams.set('tag', t);
                  const isActive = filterTag === t;
                  return (
                    <li>
                      <a
                        href={url.toString()}
                        class={`filter-btn${isActive ? ' active' : ''}`}
                        aria-label={`Filter by tag: ${t}`}
                      >
                        #{t}
                      </a>
                    </li>
                  );
                })
              }
            </ul>
          </section>
        </div>
      </aside>

      <main class="recipes-content">
        <section aria-label="Recipes">
          <ListingCardStack
            profile="recipes"
            columns={1}
            aspectRatio="3/2"
            maxWidth="var(--listing-card-max-width)"
            items={recipes.map((recipe) =>
              fromRecipeEntry(recipe, {
                idPrefix: 'stack',
                tagHref: (tag) => `/recipes?tag=${encodeURIComponent(tag)}`,
              })
            )}
          />
          <p class="recipes-empty-state" aria-live="polite" hidden>
            No recipes match these filters. <a href="/recipes">Clear filters</a>
          </p>
        </section>
      </main>
    </div>
  </div>

  <script is:inline>
    (() => {
      const applyRecipeFilters = () => {
        const params = new URLSearchParams(window.location.search);
        const activeTag = params.get('tag');

        let visibleCount = 0;
        document.querySelectorAll('.recipes-content .nc-item').forEach((card) => {
          const tags = (card.getAttribute('data-tags') || '').split(',').filter(Boolean);
          const visible = !activeTag || tags.includes(activeTag);

          card.style.display = visible ? '' : 'none';
          card.setAttribute('aria-hidden', visible ? 'false' : 'true');
          if (visible) visibleCount++;
        });

        const emptyState = document.querySelector('.recipes-empty-state');
        if (emptyState) {
          emptyState.hidden = visibleCount > 0;
        }

        document
          .querySelectorAll('[aria-labelledby="filter-heading"] .filter-btn')
          .forEach((btn) => {
            if (!(btn instanceof HTMLAnchorElement)) return;
            const btnParams = new URL(btn.href, window.location.origin).searchParams;
            const btnTag = btnParams.get('tag');
            const isActive = activeTag ? btnTag === activeTag : !btnTag;

            btn.classList.toggle('active', isActive);
            if (isActive) {
              btn.setAttribute('aria-current', 'page');
            } else {
              btn.removeAttribute('aria-current');
            }
          });
      };

      const onFilterClick = (event) => {
        const target = event.target;
        if (!(target instanceof HTMLElement)) return;
        const link = target.closest('.recipes-sidebar .filter-btn');
        if (!(link instanceof HTMLAnchorElement)) return;

        event.preventDefault();
        window.history.pushState({}, '', link.href);
        applyRecipeFilters();
      };

      const initRecipeFilters = () => {
        applyRecipeFilters();

        const sidebar = document.querySelector('.recipes-sidebar');
        if (sidebar && !sidebar.dataset.filtersBound) {
          sidebar.addEventListener('click', onFilterClick);
          sidebar.dataset.filtersBound = 'true';
        }

        if (!window.__recipeFilterPopstateBound) {
          window.addEventListener('popstate', applyRecipeFilters);
          window.__recipeFilterPopstateBound = true;
        }
      };

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initRecipeFilters, { once: true });
      } else {
        initRecipeFilters();
      }

      document.addEventListener('astro:page-load', initRecipeFilters);
    })();
  </script>
</BaseLayout>

<style>
  .recipes-page {
    max-width: 100%;
    --article-column-width: var(--measure-prose);
    --listing-card-max-width: calc(var(--article-column-width) + (2 * var(--space-md)));
  }

  @media (min-width: 1200px) and (max-width: 1499px) {
    .recipes-page {
      --article-column-width: calc(1200px - 280px - var(--space-lg));
    }
  }

  .recipes-container {
    position: relative;
    max-width: var(--listing-card-max-width);
    margin: 0 auto;
  }

  .recipes-content {
    /* content is the main flow */
  }

  .recipes-sidebar {
    display: none; /* hidden on mobile */
  }

  .recipes-empty-state {
    font-style: italic;
    color: var(--color-text-muted);
    text-align: center;
    padding: var(--space-xl) var(--space-md);
    font-size: var(--text-md);
  }

  .recipes-empty-state a {
    color: var(--color-walnut);
  }

  @media (min-width: 1200px) {
    .recipes-sidebar {
      display: block;
      position: absolute;
      right: calc(100% + var(--space-lg));
      top: 0;
      bottom: 0;
      width: var(--sidebar-width);
    }

    .recipes-sidebar-inner {
      position: sticky;
      top: clamp(6.5rem, 38.2vh, 14rem);
      max-height: calc(100dvh - clamp(6.5rem, 38.2vh, 14rem) - var(--space-md));
      overflow-y: auto;
    }
  }

  /* Pagefind search styling - page-specific overrides */
  :global(.pagefind-ui__search-input) {
    background: var(--color-surface);
    border: 1px solid var(--color-lichen);
    border-radius: var(--border-radius);
    padding: 0.5rem 0.75rem;
    font-size: var(--text-sm);
    font-family: inherit;
    color: var(--color-text-primary);
    transition: border-color var(--transition-fast);
  }

  :global(.pagefind-ui__search-input:focus) {
    outline: none;
    border-color: var(--color-link);
    box-shadow: 0 0 0 2px color-mix(in oklab, var(--color-walnut) 10%, transparent);
  }

  :global(.pagefind-ui__search-clear) {
    background: var(--color-surface);
    border: 1px solid var(--color-lichen);
    color: var(--color-text-secondary);
    border-radius: var(--border-radius);
    transition: all var(--transition-fast);
    width: 2rem;
    height: 2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    text-indent: -9999px;
    overflow: hidden;
    position: relative;
  }

  :global(.pagefind-ui__search-clear::before) {
    content: '×';
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    text-indent: 0;
    font-size: var(--text-lg);
    line-height: 1;
  }

  :global(.pagefind-ui__search-clear:hover) {
    color: var(--color-link-hover);
    background: var(--wash-sage);
    border-color: var(--color-sage);
  }

  :global(.pagefind-ui__result) {
    background: var(--color-surface);
    border: 1px solid var(--color-lichen);
    border-radius: var(--border-radius);
    padding: var(--space-sm);
    margin-bottom: var(--space-xs);
    transition: all var(--transition-fast);
  }

  :global(.pagefind-ui__result:hover) {
    border-color: var(--color-sage);
    background: var(--wash-sage);
  }

  :global(.pagefind-ui__result-title) {
    font-size: var(--text-sm);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-primary);
    margin-bottom: 0.25rem;
  }

  :global(.pagefind-ui__result-excerpt) {
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
    line-height: 1.4;
  }

  :global(.pagefind-ui__message) {
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
    text-align: center;
    padding: var(--space-sm);
    background: var(--wash-sage);
    border-radius: var(--border-radius);
    margin-top: var(--space-xs);
  }
</style>
