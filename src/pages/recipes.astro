---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import IndexFinder from '../components/IndexFinder.astro';
import NoteCardStack from '../components/NoteCardStack.astro';

const recipes = (await getCollection('recipes', ({ data }) => !data.draft)).sort((a, b) =>
  a.data.title.localeCompare(b.data.title)
);

// A cookbook index: recipes grouped under their initial letter.
const initials = [...new Set(recipes.map((recipe) => recipe.data.title[0]!.toUpperCase()))];
const recipesByInitial = initials.map(
  (initial) =>
    [initial, recipes.filter((recipe) => recipe.data.title[0]!.toUpperCase() === initial)] as const
);
const tags = [...new Set(recipes.flatMap((recipe) => recipe.data.tags ?? []))].sort((a, b) =>
  a.localeCompare(b)
);
---

<BaseLayout
  title="Recipes"
  description="Personal kitchen notes and recipes."
  tone="personal"
  layout="cards"
>
  <div class="index-page" style="--index-content: var(--card-max-width)">
    <header class="page-header">
      <h1 class="page-title">Recipes</h1>
      <p class="page-lede">
        I am an avid hobby-cook and try out new things constantly. Figured I should start keeping a
        better log.
      </p>
    </header>

    <IndexFinder type="recipe" noun="recipes" tags={tags} />

    {recipesByInitial.map(([initial, entries]) => <section
      class="index-group"
      data-index-group
      aria-label={`Recipes starting with ${initial}`}
    >
      <p class="index-label" aria-hidden="true">{initial}</p>
      <NoteCardStack
        columns={1}
        media="thumb"
        headingLevel={2}
        tagBase="/recipes"
        items={entries.map((recipe) => ({
          id: recipe.id,
          title: recipe.data.title,
          subtitle: recipe.data.description,
          href: `/recipes/${recipe.id}`,
          tags: recipe.data.tags ?? [],
          hero: recipe.data.heroImage
            ? {
                kind: 'asset' as const,
                src: recipe.data.heroImage,
                scale: recipe.data.heroImageScale ?? 1,
                posX: recipe.data.heroImagePositionX ?? 0,
                posY: recipe.data.heroImagePositionY ?? 0,
              }
            : undefined,
        }))}
      />
    </section>)}
  </div>
</BaseLayout>
