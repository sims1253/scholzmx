---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import IndexFinder from '../components/IndexFinder.astro';
import ImageFrame from '../components/ImageFrame.astro';
import Series from '../components/Series.astro';

const recipes = (await getCollection('recipes', ({ data }) => !data.draft)).sort((a, b) =>
  a.data.title.localeCompare(b.data.title)
);

// A cookbook index: recipes grouped under their initial letter.
const initials = [...new Set(recipes.map((recipe) => recipe.data.title[0]!.toUpperCase()))];
const recipesByInitial = initials.map(
  (initial) =>
    [initial, recipes.filter((recipe) => recipe.data.title[0]!.toUpperCase() === initial)] as const
);
const tags = [...new Set(recipes.flatMap((recipe) => recipe.data.tags ?? []))].sort((a, b) =>
  a.localeCompare(b)
);
---

<BaseLayout
  title="Recipes"
  description="Personal kitchen notes and recipes."
  tone="personal"
  layout="listing"
>
  <div class="index-page">
    <header class="page-header">
      <h1 class="page-title">Recipes</h1>
      <p class="page-lede">
        I am an avid hobby-cook and try out new things constantly. Figured I should start keeping a
        better log.
      </p>
    </header>

    <IndexFinder type="recipe" noun="recipes" tags={tags} />

    {recipesByInitial.map(([initial, entries]) => <section
      class="index-group"
      data-index-group
      aria-label={`Recipes starting with ${initial}`}
    >
      <p class="index-label" aria-hidden="true">{initial}</p>
      <ul class="index-entries">
        {entries.map((recipe) => {
          const recipeTags = recipe.data.tags ?? [];
          return <li class="index-entry recipe-entry nc-item" data-tags={recipeTags.join(',')}>
            {recipe.data.heroImage && <a
              href={`/recipes/${recipe.id}`}
              class="recipe-photo pasted"
              tabindex="-1"
              aria-hidden="true"
            >
              <ImageFrame
                src={recipe.data.heroImage}
                alt=""
                aspectRatio="3/2"
                style="simple"
                fillMode="cover"
                positionX={(recipe.data.heroImagePositionX ?? 0) * 100}
                positionY={(recipe.data.heroImagePositionY ?? 0) * 100}
                scale={recipe.data.heroImageScale ?? 1}
                width={900}
                height={600}
              />
            </a>}
            <h2 class="entry-title"><a href={`/recipes/${recipe.id}`}>{recipe.data.title}</a></h2>
            <p class="entry-summary">{recipe.data.description}</p>
            <p class="entry-meta">
              Makes {recipe.data.servings}, takes
              {recipe.data.time}{recipeTags.length > 0 && (
                <>. Filed under
                  <Series
                    items={recipeTags.map((text) => ({
                      text,
                      href: `/recipes?tag=${encodeURIComponent(text)}`,
                    }))}
                  /></>
              )}.
            </p>
          </li>;
        })}
      </ul>
    </section>)}
  </div>
</BaseLayout>

<style>
  .recipe-entry {
    margin-bottom: var(--space-xl);
  }

  .recipe-photo {
    max-width: 30rem;
    margin: var(--space-sm) 0 var(--space-md);
    text-decoration: none;
  }

  .recipe-photo :global(.image-frame) {
    border-radius: 2px;
    box-shadow:
      0 1px 2px color-mix(in srgb, var(--color-ink-dark) 16%, transparent),
      0 12px 24px -14px color-mix(in srgb, var(--color-ink-dark) 40%, transparent);
  }
</style>
