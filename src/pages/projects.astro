---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import StackedCard from '../components/StackedCard.astro';
import { projects, projectName } from '../data/projects';
---

<BaseLayout title="Projects" description="Selected projects" tone="serious" layout="cards">
  <div class="projects-page">
    <header class="page-header">
      <h1 class="page-title">Projects & Software</h1>
      <p class="page-lede">
        I tend to build stuff to procrastinate. This is where I feel good about it.
      </p>
    </header>

    {/* Workshop tags on a board: each tool hangs by its string, its badge on it. */}
    <div class="project-cards sc-desk">
      {projects.map((project, index) => {
        const { name, common } = projectName(project.title);
        return <StackedCard
          seed={`project/${project.title}`}
          title={name}
          subtitle={common}
          href={project.links[0]!.url}
          material="tag"
          layout="side"
          class="project-card"
        >
          <div
            slot="media"
            class:list={['project-badge', { 'project-badge--round': project.round === true }]}
            style={`--badge-scale: ${project.scale ?? 1}`}
          >
            <span class="project-badge-face">
              <Image
                class="project-badge-art"
                src={project.banner}
                alt=""
                width={160}
                densities={[1, 2]}
                loading={index < 4 ? 'eager' : 'lazy'}
                decoding="async"
              />
            </span>
          </div>
          <p class="project-description">{project.description}</p>
          <div class="sc-meta">
            <p class="project-meta">{project.tech.join(', ')}, {project.year}.</p>
            <div class="sc-tags">
              {project.links.map((link) => <a class="sc-chip" href={link.url}>{link.type}</a>)}
            </div>
          </div>
        </StackedCard>;
      })}
    </div>
  </div>
</BaseLayout>

<script>
  // A badge turns toward the pointer and catches its light.
  import '../scripts/project-badges';
</script>

<style>
  /* The header and the board share one centred column, two tags to a row. */
  .projects-page {
    width: 100%;
    max-width: 60rem;
    margin-inline: auto;
  }

  /* A tag's string runs off its left end, so tags keep more air between them than sheets
     on a desk: the string must not reach the tag beside it. */
  .project-cards {
    --desk-min: 20rem;
    --desk-col-gap: 3.5rem;
  }

  /* The name is set like a binomial, its plain-English description beneath. */
  :global(.project-card .sc-title) {
    font-size: var(--text-xl);
    font-style: italic;
    font-weight: 400;
    line-height: 1.1;
  }

  :global(.project-card .sc-subtitle) {
    margin-bottom: var(--space-xs);
    font-family: var(--font-heading);
    font-size: var(--text-md);
    color: var(--sc-moss);
  }

  /* The badge sits at the tag's left, beside the eyelet; the words take the rest. */
  :global(.project-card .sc-row) {
    grid-template-columns: 7.5rem minmax(0, 1fr);
    gap: var(--space-md);
  }

  :global(.project-card .sc-col.media) {
    order: -1;
  }

  /* A project's mark is a badge on its tag: die-cut to one shape, a regular hexagon with its
     point up, and under a thick gloss, with no paper behind it. As the pointer crosses the
     tag the badge turns a few degrees toward it and the light runs across its face
     (src/scripts/project-badges.ts). Where the pointer cannot hover, and under reduced
     motion, the badge keeps its resting light and its set. */
  .project-badge {
    --badge-rim: 0.16rem;
    /* What the gloss reflects: daylight, or by torchlight the lantern's own gold. */
    --badge-glint: var(--by-day, #ffffff) var(--by-torch, #f3d27a);
    --badge-base: color-mix(in srgb, var(--color-tansy) 24%, var(--sc-sheet));
    --badge-light: color-mix(in srgb, var(--badge-glint) 62%, var(--badge-base));
    --badge-shade: color-mix(in srgb, var(--color-ink-dark) 42%, var(--badge-base));
    --badge-turn: calc(var(--rot-b, 1deg) * 1.5);

    position: relative;
    display: block;
    width: min(6.5rem, 100%);
    aspect-ratio: 0.866; /* as wide as the root of three over two of its height */
    margin-block: 0.5rem auto;
    margin-inline: auto;
    clip-path: polygon(50% 0, 100% 25%, 100% 75%, 50% 100%, 0 75%, 0 25%);
    background: radial-gradient(
      circle at var(--light-x, 28%) var(--light-y, 20%),
      var(--badge-light),
      var(--badge-base) 55%,
      var(--badge-shade)
    );
    transform: perspective(30rem) rotateX(var(--badge-tip, 0deg))
      rotateY(var(--badge-turn-to, 0deg)) rotate(var(--badge-turn));
    transition: transform 0.2s ease-out;
    filter: drop-shadow(0 1px 1px color-mix(in srgb, var(--sc-shade) 30%, transparent))
      drop-shadow(0 5px 7px -3px color-mix(in srgb, var(--sc-shade) 50%, transparent));
    isolation: isolate;
  }

  /* The face sits in a hollow inside the rim: shaded along its foot, lit along its head */
  .project-badge-face {
    position: absolute;
    inset: var(--badge-rim);
    display: block;
    overflow: hidden;
    clip-path: polygon(50% 0, 100% 25%, 100% 75%, 50% 100%, 0 75%, 0 25%);
    background: var(--badge-base);
  }

  .project-badge-face::after {
    content: '';
    position: absolute;
    inset: 0;
    box-shadow:
      inset 0 2px 3px color-mix(in srgb, var(--sc-shade) 34%, transparent),
      inset 0 -1px 1px color-mix(in srgb, var(--badge-glint) 38%, transparent);
  }

  /* A hexagonal banner fills the face, from its point to its point, and runs a little
     under its rim (src/data/projects.ts) */
  .project-badge-art {
    position: absolute;
    top: 50%;
    left: 50%;
    display: block;
    width: auto;
    max-width: none; /* it runs wider than the face on purpose */
    height: 100%;
    transform: translate(-50%, -50%) scale(var(--badge-scale, 1));
  }

  /* A round one is the medallion of the badge: as wide as the face, so that it touches
     its sides */
  .project-badge--round .project-badge-art {
    width: 100%;
    height: auto;
  }

  /* The gloss. The face is domed and lacquered: it darkens away from the light, carries a
     soft reflection on the light's side, and has a pool of light with a bright core where
     the light strikes. All of it follows the one light. */
  .project-badge::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      radial-gradient(
        circle at var(--light-x, 28%) var(--light-y, 20%),
        color-mix(in srgb, var(--badge-glint) 78%, transparent),
        color-mix(in srgb, var(--badge-glint) 30%, transparent) 7%,
        transparent 17%
      ),
      radial-gradient(
        circle at var(--light-x, 28%) var(--light-y, 20%),
        color-mix(in srgb, var(--badge-glint) 52%, transparent),
        color-mix(in srgb, var(--badge-glint) 12%, transparent) 30%,
        transparent 58%
      ),
      radial-gradient(
        circle at var(--light-x, 28%) var(--light-y, 20%),
        transparent 40%,
        color-mix(in srgb, var(--sc-shade) 8%, transparent) 72%,
        color-mix(in srgb, var(--sc-shade) 19%, transparent)
      ),
      linear-gradient(
        118deg,
        color-mix(in srgb, var(--badge-glint) 26%, transparent),
        color-mix(in srgb, var(--badge-glint) 7%, transparent) 34%,
        transparent 52%
      );
    pointer-events: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .project-badge {
      transform: rotate(var(--badge-turn));
    }
  }

  .project-description {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
  }

  .project-meta {
    margin: 0;
    font-family: var(--font-body-personal);
    font-size: var(--text-xs);
    font-style: italic;
    color: var(--color-text-secondary); /* muted ink fades on manila by torchlight */
  }

  @media (max-width: 640px) {
    :global(.project-card .sc-row) {
      grid-template-columns: 5.5rem minmax(0, 1fr);
    }
  }
</style>
