---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import StackedCard from '../components/StackedCard.astro';
import { projects, projectName } from '../data/projects';
---

<BaseLayout title="Projects" description="Selected projects" tone="serious" layout="cards">
  <div class="projects-page">
    <header class="page-header">
      <h1 class="page-title">Projects & Software</h1>
      <p class="page-lede">
        I tend to build stuff to procrastinate. This is where I feel good about it.
      </p>
    </header>

    {/* Workshop tags on a board: each tool hangs by its string, its print pasted on. */}
    <div class="project-cards sc-desk">
      {projects.map((project, index) => {
        const { name, common } = projectName(project.title);
        return <StackedCard
          seed={`project/${project.title}`}
          title={name}
          subtitle={common}
          href={project.links[0]!.url}
          material="tag"
          layout="side"
          class="project-card"
        >
          <div slot="media" class="project-logo pasted">
            <Image
              src={project.banner}
              alt=""
              width={112}
              densities={[1, 2]}
              loading={index < 4 ? 'eager' : 'lazy'}
              decoding="async"
            />
          </div>
          <p class="project-description">{project.description}</p>
          <div class="sc-meta">
            <p class="project-meta">{project.tech.join(', ')}, {project.year}.</p>
            <div class="sc-tags">
              {project.links.map((link) => <a class="sc-chip" href={link.url}>{link.type}</a>)}
            </div>
          </div>
        </StackedCard>;
      })}
    </div>
  </div>
</BaseLayout>

<style>
  /* The header and the board share one centred column, two tags to a row. */
  .projects-page {
    width: 100%;
    max-width: 60rem;
    margin-inline: auto;
  }

  /* Tags hang from strings, so they keep more air between them than sheets on a desk */
  .project-cards {
    --desk-min: 20rem;
    --desk-col-gap: var(--space-xl);
  }

  /* The name is set like a binomial, its plain-English description beneath. */
  :global(.project-card .sc-title) {
    font-size: var(--text-xl);
    font-style: italic;
    font-weight: 400;
    line-height: 1.1;
  }

  :global(.project-card .sc-subtitle) {
    margin-bottom: var(--space-xs);
    font-family: var(--font-heading);
    font-size: var(--text-md);
    color: var(--sc-moss);
  }

  /* The print sits at the tag's left, beside the eyelet; the words take the rest. */
  :global(.project-card .sc-row) {
    grid-template-columns: 5.5rem minmax(0, 1fr);
    gap: var(--space-md);
  }

  :global(.project-card .sc-col.media) {
    order: -1;
  }

  .project-logo {
    margin-top: 0.5rem;
    background: var(--print-sheet);
    box-shadow:
      0 1px 2px color-mix(in srgb, var(--color-ink-dark) 14%, transparent),
      0 8px 14px -10px color-mix(in srgb, var(--color-ink-dark) 38%, transparent);
    transform: rotate(calc(var(--rot-b, 1deg) * 1.5));
  }

  /* One short strip holds the small print */
  .project-logo::before {
    left: 50%;
    width: 2.2rem;
    height: 0.85rem;
    top: -0.45rem;
    transform: translateX(-50%) rotate(calc(var(--rot-a, -1deg) * 2));
  }

  .project-logo::after {
    display: none;
  }

  .project-logo img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: contain;
    padding: 0.2rem;
    border-radius: 0;
  }

  .project-description {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
  }

  .project-meta {
    margin: 0;
    font-family: var(--font-body-personal);
    font-size: var(--text-xs);
    font-style: italic;
    color: var(--color-text-secondary); /* muted ink fades on manila by torchlight */
  }

  .project-meta + :global(.sc-tags) {
    margin-top: 0.15rem;
  }

  @media (max-width: 640px) {
    :global(.project-card .sc-row) {
      grid-template-columns: 4.5rem minmax(0, 1fr);
    }
  }
</style>
