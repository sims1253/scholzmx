---
import BaseLayout from '../layouts/BaseLayout.astro';
import StackedCard from '../components/StackedCard.astro';
import GlossPrint from '../components/GlossPrint.astro';
import { projects, projectName } from '../data/projects';
---

<BaseLayout title="Projects" description="Selected projects" tone="serious" layout="cards">
  <div class="projects-page">
    <header class="page-header">
      <h1 class="page-title">Projects & Software</h1>
      <p class="page-lede">
        I tend to build stuff to procrastinate. This is where I feel good about it.
      </p>
    </header>

    {/* Workshop tags on a board: each tool hangs by its string, its sticker stuck on. */}
    <div class="project-cards sc-desk">
      {projects.map((project, index) => {
        const { name, common } = projectName(project.title);
        return <StackedCard
          seed={`project/${project.title}`}
          title={name}
          subtitle={common}
          href={project.links[0]!.url}
          material="tag"
          layout="side"
          class="project-card"
        >
          <GlossPrint
            slot="media"
            image={project.banner}
            relief={project.relief}
            turn="calc(var(--rot-b, 1deg) * 1.5)"
            loading={index < 4 ? 'eager' : 'lazy'}
          />
          <p class="project-description sc-line">{project.description}</p>
          <div class="sc-meta">
            <p class="project-meta">{project.tech.join(', ')}, {project.year}.</p>
            <div class="sc-tags">
              {project.links.map((link) => <a class="sc-chip" href={link.url}>{link.type}</a>)}
            </div>
          </div>
        </StackedCard>;
      })}
    </div>
  </div>
</BaseLayout>

<style>
  /* The header and the board share one centred column, two tags to a row. */
  .projects-page {
    width: 100%;
    max-width: 60rem;
    margin-inline: auto;
  }

  /* A tag's string runs off its left end, so tags keep more air between them than sheets
     on a desk: the string must not reach the tag beside it. */
  .project-cards {
    --desk-min: 20rem;
    --desk-col-gap: 3.5rem;
  }

  /* The name is set like a binomial, its plain-English description beneath. */
  :global(.project-card .sc-title) {
    font-size: var(--text-xl);
    font-style: italic;
    font-weight: 400;
    line-height: 1.1;
  }

  :global(.project-card .sc-subtitle) {
    margin-bottom: var(--space-xs);
    font-family: var(--font-heading);
    font-size: var(--text-md);
    color: var(--sc-moss);
  }

  /* The sticker sits at the tag's left, beside the eyelet; the words take the rest. */
  :global(.project-card .sc-row) {
    grid-template-columns: 7.5rem minmax(0, 1fr);
    gap: var(--space-md);
  }

  :global(.project-card .gloss-print) {
    margin-top: 0.25rem;
  }

  :global(.project-card .sc-col.media) {
    order: -1;
  }

  .project-description {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
  }

  /* A tag is not ruled, so its footer line keeps close to the words above it instead
     of skipping one of the sheet's lines. */
  :global(.project-card .sc-meta) {
    min-height: 0;
    padding-top: var(--space-xs);
  }

  .project-meta {
    font-family: var(--font-body-personal);
    font-size: var(--text-xs);
    font-style: italic;
    color: var(--color-text-secondary); /* muted ink fades on manila by torchlight */
  }

  @media (max-width: 640px) {
    :global(.project-card .sc-row) {
      grid-template-columns: 5.5rem minmax(0, 1fr);
    }
  }
</style>
