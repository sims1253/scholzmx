---
import BaseLayout from '../layouts/BaseLayout.astro';
import ListingCardStack from '../components/ListingCardStack.astro';
import { fromProjectRecord } from '../lib/cards/adapters';

const projects = [
  {
    title: 'huerd — Herding Hues',
    description: 'Perceptually distinct color palettes optimized for accessibility in OKLAB (R).',
    year: 2024,
    status: 'Active',
    banner: {
      src: 'https://sims1253.github.io/huerd/reference/figures/logo.png',
      width: 560,
      height: 160,
    },
    tech: ['R', 'OKLAB', 'nloptr'],
    links: [
      { type: 'GitHub', url: 'https://github.com/sims1253/huerd' },
      { type: 'Docs', url: 'https://github.com/sims1253/huerd#readme' },
    ],
  },
  {
    title: 'hrvester — Heart Rate Variability Toolkit',
    description: 'Analyze HRV data with robust preprocessing and recovery scoring.',
    year: 2024,
    status: 'Active',
    banner: {
      src: 'https://sims1253.github.io/hrvester/reference/figures/logo.png',
      width: 560,
      height: 160,
    },
    tech: ['R', 'Signal Processing'],
    links: [
      { type: 'GitHub', url: 'https://github.com/sims1253/hrvester' },
      { type: 'Docs', url: 'https://github.com/sims1253/hrvester#readme' },
    ],
  },
];

// Sort projects by year (most recent first)
const sortedProjects = projects.sort((a, b) => b.year - a.year);
---

<BaseLayout
  title="Projects"
  description="Selected projects"
  footerVariant="projects"
  tone="serious"
  layout="wide"
>
  <div class="projects-page">
    <header class="projects-header page-shell-header">
      <h1 class="page-title page-shell-title">Projects & Software</h1>
      <p class="page-description page-shell-description">
        I tend to build stuff to procrastinate. This is where I feel good about it.
      </p>
    </header>

    <div class="projects-container">
      <main class="projects-content">
        <div class="projects-inner container-wide">
          <section aria-label="Projects">
            <ListingCardStack
              profile="projects"
              columns={1}
              maxWidth="40rem"
              itemClass="project-item"
              items={sortedProjects.map((project) =>
                fromProjectRecord({
                  id: `project/${project.title}`,
                  title: project.title,
                  description: project.description,
                  year: project.year,
                  status: project.status,
                  banner: project.banner,
                  links: project.links,
                })
              )}
            />
          </section>
        </div>
      </main>
    </div>
  </div>
</BaseLayout>

<style>
  .projects-page {
    max-width: 100%;
  }

  /* Centering handled by BaseLayout container (contentWidth) */

  /* Width/centering handled via .container-wide */
  .project-item {
    width: 40rem;
    max-width: 100%;
    margin-left: auto;
    margin-right: auto;
  }
  .project-logo .image-frame {
    width: 180px;
    max-width: 100%;
  }
  .project-item {
    margin-bottom: var(--space-lg);
  }
  /* Remove any default frames/shadows around logo images */
  .project-logo .image-frame {
    box-shadow: none;
    border: 0;
    background: transparent;
    border-radius: 0;
  }
  .project-logo .frame-image {
    box-shadow: none;
    background: transparent;
  }
  .project-logo img {
    box-shadow: none !important;
    border-radius: 0 !important;
  }

  /* Keep side layout, but make content column flex so links can sit at bottom */
  .projects-page .sc-row {
    align-items: stretch;
  }
  .projects-page .sc-col.content {
    display: flex;
    flex-direction: column;
  }
  .projects-page .sc-col.content .sc-meta {
    margin-top: auto;
    padding-top: var(--space-xs);
  }
</style>
