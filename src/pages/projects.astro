---
import { Image } from 'astro:assets';
import ryLogo from '../assets/images/projects/ry-logo.webp';
import starlingLogo from '../assets/images/projects/starling-logo.webp';
import janusLogo from '../assets/images/projects/janus-logo.webp';
import huerdLogo from '../assets/images/projects/huerd-logo.png';
import hrvesterLogo from '../assets/images/projects/hrvester-logo.png';
import BaseLayout from '../layouts/BaseLayout.astro';
import StackedCard from '../components/StackedCard.astro';

const projects = [
  {
    title: 'ry — Static Checker for R',
    description:
      'Catch type errors, missing data frame columns, and scope issues before running R code.',
    year: 2026,
    status: 'Active',
    banner: ryLogo,
    tech: ['Rust', 'R'],
    links: [
      { type: 'GitHub', url: 'https://github.com/sims1253/ry' },
      { type: 'Docs', url: 'https://github.com/sims1253/ry#readme' },
    ],
  },
  {
    title: 'Starling — Local Speech Recognition',
    description:
      'Transcribe speech locally with a native inference engine and apps for desktop and phone.',
    year: 2026,
    status: 'Active',
    banner: starlingLogo,
    tech: ['C++', 'ggml', 'TypeScript'],
    links: [
      { type: 'GitHub', url: 'https://github.com/sims1253/starling' },
      { type: 'Docs', url: 'https://github.com/sims1253/starling#readme' },
    ],
  },
  {
    title: 'Janus — Structured PDF Extraction',
    description:
      'Extract data from PDF text and layout locally, inspect source locations, and compare with reference data.',
    year: 2026,
    status: 'Active',
    banner: janusLogo,
    tech: ['Python', 'PDF'],
    links: [
      { type: 'GitHub', url: 'https://github.com/sims1253/nebu/tree/main/janus' },
      { type: 'Docs', url: 'https://github.com/sims1253/nebu/tree/main/janus#readme' },
    ],
  },
  {
    title: 'huerd — Herding Hues',
    description: 'Perceptually distinct color palettes optimized for accessibility in OKLAB (R).',
    year: 2024,
    status: 'Active',
    banner: huerdLogo,
    tech: ['R', 'OKLAB', 'nloptr'],
    links: [
      { type: 'GitHub', url: 'https://github.com/sims1253/huerd' },
      { type: 'Docs', url: 'https://github.com/sims1253/huerd#readme' },
    ],
  },
  {
    title: 'hrvester — Heart Rate Variability Toolkit',
    description: 'Analyze HRV data with robust preprocessing and recovery scoring.',
    year: 2024,
    status: 'Active',
    banner: hrvesterLogo,
    tech: ['R', 'Signal Processing'],
    links: [
      { type: 'GitHub', url: 'https://github.com/sims1253/hrvester' },
      { type: 'Docs', url: 'https://github.com/sims1253/hrvester#readme' },
    ],
  },
];

// Sort projects by year (most recent first)
const sortedProjects = projects.sort((a, b) => b.year - a.year);

// "ry — Static Checker for R" becomes a plate name and its common name.
const plateName = (title: string) => {
  const [name = title, common] = title.split(' — ');
  return { name, common };
};
---

<BaseLayout title="Projects" description="Selected projects" tone="serious" layout="listing">
  <div class="projects-page">
    <header class="page-header">
      <h1 class="page-title">Projects & Software</h1>
      <p class="page-lede">
        I tend to build stuff to procrastinate. This is where I feel good about it.
      </p>
    </header>

    <div class="project-cards">
      {sortedProjects.map((project, index) => {
        const { name, common } = plateName(project.title);
        return <StackedCard
          seed={`project/${project.title}`}
          title={name}
          subtitle={common}
          href={project.links[0]!.url}
          layers={3}
          layout="side"
          class="project-card"
        >
          <div slot="media" class="project-logo pasted">
            <Image
              src={project.banner}
              alt=""
              width={176}
              densities={[1, 2]}
              loading={index < 2 ? 'eager' : 'lazy'}
              decoding="async"
            />
          </div>
          <p class="project-description">{project.description}</p>
          <p class="project-meta">{project.tech.join(', ')}, {project.year}.</p>
          <div class="sc-tags">
            {project.links.map((link) => <a class="sc-chip" href={link.url}>{link.type}</a>)}
          </div>
        </StackedCard>;
      })}
    </div>
  </div>
</BaseLayout>

<style>
  /* The header and cards share one centred 44rem column. */
  .projects-page {
    max-width: 44rem;
    margin-inline: auto;
  }

  .project-cards {
    display: grid;
    gap: var(--space-xxl);
  }

  /* The name is set like a binomial, its plain-English description beneath. */
  :global(.project-card .sc-title) {
    font-size: var(--text-2xl);
    font-style: italic;
    font-weight: 400;
    line-height: 1.1;
  }

  :global(.project-card .sc-subtitle) {
    margin-bottom: var(--space-sm);
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    color: var(--color-moss);
  }

  :global(.project-card .sc-row) {
    grid-template-columns: minmax(0, 1fr) 11rem;
  }

  .project-logo {
    margin-top: 0.4rem;
    background: var(--paper-sheet);
    box-shadow:
      0 1px 2px color-mix(in srgb, var(--color-ink-dark) 14%, transparent),
      0 12px 22px -14px color-mix(in srgb, var(--color-ink-dark) 38%, transparent);
  }

  .project-logo img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: contain;
    border-radius: 0;
  }

  .project-description {
    margin: 0 0 0.4em;
    color: var(--color-text-secondary);
  }

  .project-meta {
    margin: 0;
    font-family: var(--font-body-personal);
    font-size: var(--text-sm);
    font-style: italic;
    color: var(--color-text-muted);
  }

  @media (max-width: 640px) {
    :global(.project-card .sc-row) {
      grid-template-columns: 1fr;
    }

    :global(.project-card .sc-col.media) {
      order: -1;
    }

    .project-logo {
      width: 9rem;
    }
  }
</style>
