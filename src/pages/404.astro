---
import BaseLayout from '../layouts/BaseLayout.astro';
import Niche from '../components/Niche.astro';
---

<BaseLayout
  title="Page not found · scholzmx"
  description="The page you were looking for doesn't exist."
  tone="personal"
  layout="prose"
>
  <section class="lost">
    <h1 class="page-title">It is getting late...</h1>
    <p class="page-lede">
      This page has wandered off the path. It may have been moved, renamed, or never existed.
    </p>
    <p class="way-back">
      The way back leads <a href="/">home</a>, or to the <a href="/blog">blog</a>.
    </p>
    {/* An empty niche: whatever was kept here is gone, and the candle is out. */}
    <div class="empty-niche">
      <Niche kind="bare" href="/" name="Back home" caption="this niche is empty" />
    </div>
  </section>
</BaseLayout>

<style>
  .lost {
    min-height: 50vh;
    margin: clamp(2rem, 8vw, 6rem) 0 0;
  }

  .way-back {
    margin-top: var(--space-lg);
  }

  .empty-niche {
    width: 11rem;
    margin-top: var(--space-xl);
  }
</style>
