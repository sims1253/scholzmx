---
import BotanicalBorder from '../components/BotanicalBorder.astro';
import IllustratedFooter from '../components/IllustratedFooter.astro';
import BackToTop from '../components/BackToTop.astro';
import ReadingProgress from '../components/ReadingProgress.astro';
import FontSizeControl from '../components/FontSizeControl.astro';
import SVGFilters from '../components/SVGFilters.astro';

// Import CSS files
import '../styles/layers.css';
import '../styles/tokens.colors.css';
import '../styles/tokens.typography.css';
import '../styles/tokens.spacing.css';
import '../styles/tokens.layout.css';
import '../styles/tokens.motion.css';
import '../styles/fonts.css';
import '../styles/layout.css';
import '../styles/base.css';
import '../styles/modern.css';
import '../styles/prose.css';
import '../styles/page-shell.css';
import '../styles/typography-utils.css';
import '../styles/dropcap.css';
import '../styles/tailwind.css'; // Utilities only - preserves existing design
import '../styles/margin-notes.css';
import '../styles/stacked-card.css';
import '../styles/shiki-theming.css';
import '../styles/listing-sidebar.css';

export interface Props {
  title: string;
  description?: string;
  image?: string;
  addBorders?: boolean;
  footerVariant?: 'garden' | 'kitchen' | 'craft' | 'writing' | 'projects' | 'research' | 'default';
  includeQuoteSection?: boolean;
  tone?: 'personal' | 'serious';
  layout?: 'prose' | 'listing' | 'wide' | 'full';
  leading?: 'default' | 'relaxed' | 'tight';
  lang?: string;
}

const {
  title,
  description = 'A digital garden and personal website - thoughtful, slow web principles with a warm, botanical aesthetic.',
  image = '/img/portrait-DY3LVcsu_ZVN2ds.webp',
  addBorders = true,
  footerVariant = 'default',
  includeQuoteSection = false,
  tone = 'personal',
  layout = 'prose',
  leading = 'default',
  lang = 'en',
} = Astro.props;

const currentPath = Astro.url.pathname;

const absoluteImageUrl = image.startsWith('http') ? image : `https://www.scholzmx.com${image}`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="mask-icon" href="/favicon.svg" color="#8b5a3c" />
    <meta name="generator" content={Astro.generator} />

    <!-- Canonical URL -->
    <link rel="canonical" href={`https://www.scholzmx.com${Astro.url.pathname}`} />

    <!-- RSS Feed autodiscovery -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Grotto RSS Feed"
      href={new URL('rss.xml', Astro.site)}
    />

    <!-- Critical resource hints for performance -->

    <slot name="head" />

    <!-- Critical font preloading: heading + body font only (max 2) -->
    <link
      rel="preload"
      href="/fonts/cormorant-garamond-600.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    {
      tone === 'personal' ? (
        <link
          rel="preload"
          href="/fonts/Alegreya/alegreya-v38-latin-regular.woff2"
          as="font"
          type="font/woff2"
          crossorigin
        />
      ) : (
        <link
          rel="preload"
          href="/fonts/et-book-roman-old-style-figures.woff2"
          as="font"
          type="font/woff2"
          crossorigin
        />
      )
    }

    <!-- Code and math fonts: prefetch for likely code content (not preload to reduce contention) -->
    {
      currentPath.includes('/blog/') && (
        <>
          <link rel="prefetch" href="/fonts/FiraCode-Regular.woff2" as="font" />
          <link rel="prefetch" href="/katex/fonts/KaTeX_Main-Regular.woff2" as="font" />
        </>
      )
    }

    <!-- KaTeX CSS: non-blocking load -->
    {
      (currentPath.includes('/blog/') ||
        currentPath.includes('/research')) && (
        <link
          rel="preload"
          href="/katex/katex.min.css"
          as="style"
          onload="this.onload=null;this.rel='stylesheet'"
        />
      )
    }
    <noscript><link rel="stylesheet" href="/katex/katex.min.css" /></noscript>

    <!-- Performance hints - will be updated by theme toggle -->
    <meta name="theme-color" content="#f9f6f2" />
    <meta name="color-scheme" content="light dark" />
    <script is:inline>
      (() => {
        const key = 'theme-preference';
        let theme = null;
        try {
          theme = localStorage.getItem(key);
        } catch {}

        const resolved =
          theme === 'dark' || theme === 'light'
            ? theme
            : window.matchMedia('(prefers-color-scheme: dark)').matches
              ? 'dark'
              : 'light';

        document.documentElement.setAttribute('data-theme', resolved);
        const meta = document.querySelector('meta[name="theme-color"]');
        if (meta) {
          meta.setAttribute('content', resolved === 'dark' ? '#0f100e' : '#f9f6f2');
        }
      })();
    </script>

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={absoluteImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={Astro.url.href} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={absoluteImageUrl} />

    <!-- Creative Commons License -->
    <link rel="license" href="https://creativecommons.org/licenses/by-sa/4.0/" />

    <!-- JSON-LD Structured Data -->
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@graph': [
          {
            '@type': 'WebSite',
            '@id': 'https://www.scholzmx.com/#website',
            url: 'https://www.scholzmx.com/',
            name: 'Grotto',
            description: 'Personal website of Maximilian Scholz',
            potentialAction: {
              '@type': 'SearchAction',
              target: 'https://www.scholzmx.com/blog?q={search_term_string}',
              'query-input': 'required name=search_term_string',
            },
          },
          {
            '@type': 'Person',
            '@id': 'https://www.scholzmx.com/#person',
            name: 'Maximilian Scholz',
            url: 'https://www.scholzmx.com/',
            image: absoluteImageUrl,
            sameAs: [
              'https://github.com/sims1253',
              'https://bsky.app/profile/scholzmx.bsky.social',
            ],
            jobTitle: 'PhD Candidate in Bayesian Statistics',
            alumniOf: [{ '@type': 'EducationalOrganization', name: 'RWTH Aachen University' }],
          },
        ],
      })}
    />

    <title>{title}</title>
  </head>

  <body class={tone === 'personal' ? 'personal-content' : 'serious-content'}>
    <SVGFilters />
    <a href="#main-content" class="skip-link">Skip to content</a>
    <a href="#main-navigation" class="skip-link">Skip to navigation</a>

    <div class="page-wrapper">
      <!-- Reading Progress Indicator -->
      <ReadingProgress color="moss" height={3} />

      <!-- Organic botanical borders -->
      {
        addBorders && (
          <div>
            <BotanicalBorder position="top" variant="vine" intensity="light" />
            <BotanicalBorder position="left" variant="vine" intensity="light" />
            <BotanicalBorder position="right" variant="vine" intensity="light" />
          </div>
        )
      }

      <!-- Navigation and Content in scrollable area -->
      <div class="nav-and-content-area">
        <nav
          class="page-nav tw-w-full"
          role="navigation"
          aria-label="Main navigation"
          id="main-navigation"
        >
          <div class="nav-content nav-wide tw-mx-auto">
            <div class="nav-brand">
              <a href="/" class="site-logo">
                <span class="logo-text">Grotto</span>
              </a>
            </div>

            <div class="nav-links">
              <a
                href="/blog"
                class={currentPath.startsWith('/blog') ? 'nav-link active' : 'nav-link'}
                aria-current={currentPath.startsWith('/blog') ? 'page' : undefined}>Blog</a
              >
              <span class="nav-separator" aria-hidden="true">·</span>
              <a
                href="/projects"
                class={currentPath.startsWith('/projects') ? 'nav-link active' : 'nav-link'}
                aria-current={currentPath.startsWith('/projects') ? 'page' : undefined}>Projects</a
              >
              <span class="nav-separator" aria-hidden="true">·</span>
              <a
                href="/recipes"
                class={currentPath.startsWith('/recipes') ? 'nav-link active' : 'nav-link'}
                aria-current={currentPath.startsWith('/recipes') ? 'page' : undefined}>Recipes</a
              >
              <span class="nav-separator" aria-hidden="true">·</span>
              <a
                href="/research"
                class={currentPath.startsWith('/research') ? 'nav-link active' : 'nav-link'}
                aria-current={currentPath.startsWith('/research') ? 'page' : undefined}>Research</a
              >
              <button
                id="nav-theme-toggle"
                class="torch-toggle"
                aria-label="Toggle theme"
                aria-pressed="false"
                title="Toggle day/night"
                type="button"
              >
                <svg
                  class="torch-icon"
                  viewBox="0 0 64 64"
                  width="22"
                  height="22"
                  aria-hidden="true"
                >
                  <defs>
                    <linearGradient id="flame" x1="0" y1="0" x2="0" y2="1">
                      <stop offset="0%" stop-color="var(--color-ochre)"></stop>
                      <stop offset="60%" stop-color="var(--color-walnut)"></stop>
                      <stop offset="100%" stop-color="var(--color-tansy)"></stop>
                    </linearGradient>
                  </defs>
                  <path
                    d="M32 8c6 7 4 13-1 18 5-1 8-5 8-10 5 5 7 13 2 19-4 5-12 6-18 3-7-4-7-12-2-17 0 6 6 9 10 7-3-2-5-6-5-9 0-2 1-5 6-11z"
                    fill="url(#flame)"
                    stroke="var(--color-ink-medium)"
                    stroke-width="1"></path>
                  <rect x="28" y="44" width="8" height="10" rx="2" fill="var(--color-ink-medium)"
                  ></rect>
                </svg>
              </button>

              <FontSizeControl />
            </div>
          </div>
        </nav>

        <!-- Main content area -->
        <main class="main-content" id="main-content">
          <div class={`layout-${layout} ${leading !== 'default' ? `leading-${leading}` : ''}`}>
            <slot />
          </div>
          <div class="notes-container" id="notesContainer"></div>
        </main>

        <!-- Illustrated Footer -->
        <div class="footer-area">
          <IllustratedFooter variant={footerVariant} includeQuoteSection={includeQuoteSection} />
        </div>
      </div>

      <!-- Back to Top Button -->
      <BackToTop />

      <script>
        import '../scripts/theme-toggle';
        import '../scripts/copy-button';
        import '../scripts/table-overflow';
      </script>
      <slot name="scripts" />
    </div>
  </body>
</html>
