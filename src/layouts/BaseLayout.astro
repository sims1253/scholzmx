---
import { getImage } from 'astro:assets';
import portrait from '../assets/images/homepage/portrait.jpg';
import Canopy from '../components/Canopy.astro';
import Dapple from '../components/Dapple.astro';
import SiteFooter from '../components/SiteFooter.astro';
import BackToTop from '../components/BackToTop.astro';

// Import CSS files
import '../styles/layers.css';
import '../styles/tokens.colors.css';
import '../styles/tokens.typography.css';
import '../styles/tokens.spacing.css';
import '../styles/tokens.layout.css';
import '../styles/tokens.motion.css';
import '../styles/fonts-critical.css';
import '../styles/fonts.css';
import '../styles/layout.css';
import '../styles/base.css';
import '../styles/modern.css';
import '../styles/prose.css';
import '../styles/typography-utils.css';
import '../styles/dropcap.css';
import '../styles/tailwind.css'; // Utilities only - preserves existing design
import '../styles/tailwind-utilities.css'; // Force utility generation
import '../styles/margin-notes.css';
import '../styles/index-list.css';
import '../styles/tactile.css';

export interface Props {
  title: string;
  description?: string;
  image?: string;
  includeQuoteSection?: boolean;
  tone?: 'personal' | 'serious';
  layout?: 'prose' | 'listing' | 'cards' | 'wide' | 'full';
  prose?: boolean;
}

const {
  title,
  description = 'A digital garden and personal website - thoughtful, slow web principles with a warm, botanical aesthetic.',
  image,
  includeQuoteSection = false,
  tone = 'personal',
  layout = 'prose',
  prose = false,
} = Astro.props;

const currentPath = Astro.url.pathname;
const socialImage = image ?? (await getImage({ src: portrait, width: 1200, format: 'webp' })).src;
const socialImageURL = new URL(socialImage, Astro.site).href;

const sections = [
  { href: '/blog', label: 'Blog' },
  { href: '/projects', label: 'Projects' },
  { href: '/recipes', label: 'Recipes' },
  { href: '/research', label: 'Research' },
];

const isHome = currentPath === '/';
const hasCode = currentPath.startsWith('/blog/') || currentPath.startsWith('/notes/');
const hasInitial = isHome || /^\/(blog|recipes|notes)\/.+/.test(currentPath);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <!-- Fix the layer order before any stylesheet: Astro links shared component CSS first,
         and the first stylesheet to name a layer would otherwise set the order. -->
    <style is:inline>
      @layer base, components, enhancements, utilities;
    </style>
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- The light follows the visitor's clock, set before first paint so it never flashes.
         By day the canopy's shadows lean away from the sun, long and cool in the morning,
         short and sharp at noon, long and gold towards evening. At night the torch lights
         itself; the torch button overrides that until the next dawn or dusk.
         src/scripts/theme-toggle.ts calls window.grottoSky again as the day moves on. -->
    <script is:inline>
      (() => {
        const mix = (from, to, t) =>
          from.map((value, index) => Math.round(value + (to[index] - value) * t));
        const COOL = [52, 72, 80];
        const GREEN = [58, 78, 26];
        const GOLD = [100, 72, 16];

        const torch = () => {
          try {
            const saved = JSON.parse(localStorage.getItem('torch') ?? 'null');
            if (
              saved &&
              saved.until > Date.now() &&
              (saved.theme === 'dark' || saved.theme === 'light')
            ) {
              return saved.theme;
            }
          } catch {
            // Storage can be unavailable in private modes; the clock decides.
          }
          return null;
        };

        window.grottoSky = () => {
          const now = new Date();
          const hour = now.getHours() + now.getMinutes() / 60;
          const night = hour < 6 || hour >= 21;
          // -1 at sunrise, 0 at noon, 1 at sunset, from the sun's side of the sky
          const sun = Math.max(-1, Math.min(1, (hour - 13.5) / 7));
          const low = Math.abs(sun);
          const shade = sun < 0 ? mix(GREEN, COOL, -sun) : mix(GREEN, GOLD, sun);
          const glow =
            sun > 0.35
              ? `radial-gradient(ellipse 80% 70% at 100% 0%, rgb(255 186 80 / ${(0.32 * (sun - 0.35)) / 0.65}), transparent 70%)`
              : sun < -0.35
                ? `radial-gradient(ellipse 80% 70% at 0% 0%, rgb(214 232 255 / ${(0.28 * (-sun - 0.35)) / 0.65}), transparent 70%)`
                : 'none';
          const root = document.documentElement;
          root.style.setProperty('--sun-skew', `${(-sun * 8).toFixed(2)}deg`);
          root.style.setProperty('--sun-stretch', (1 + 0.3 * low ** 1.5).toFixed(3));
          root.style.setProperty('--sun-crisp', (1 - 0.45 * low).toFixed(3));
          root.style.setProperty('--sun-shade', shade.join(' '));
          root.style.setProperty('--sun-glow', glow);

          const theme = torch() ?? (night ? 'dark' : null);
          if (theme) root.dataset.theme = theme;
          else delete root.dataset.theme;
        };

        window.grottoSky();
      })();
    </script>
    <link rel="canonical" href={`https://www.scholzmx.com${Astro.url.pathname}`} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Grotto RSS Feed"
      href={new URL('rss.xml', Astro.site)}
    />

    <slot name="head" />

    <!-- Alegreya sets headings and Alegreya SC the wordmark and navigation on every page. -->
    <link
      rel="preload"
      href="/fonts/Alegreya/alegreya-v38-latin-regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/Alegreya/alegreya-sc-v28-latin-regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    {isHome && (
      <link
        rel="preload"
        href="/fonts/Alegreya/alegreya-v38-latin-italic.woff2"
        as="font"
        type="font/woff2"
        crossorigin
      />
    )}
    {tone === 'serious' && (
      <link
        rel="preload"
        href="/fonts/et-book-roman-old-style-figures.woff2"
        as="font"
        type="font/woff2"
        crossorigin
      />
    )}

    {hasCode && (
      <>
        <link
          rel="preload"
          href="/fonts/FiraCode-Regular.woff2"
          as="font"
          type="font/woff2"
          crossorigin
        />
        <link
          rel="preload"
          href="/katex/fonts/KaTeX_Main-Regular.woff2"
          as="font"
          type="font/woff2"
          crossorigin
        />
        <link
          rel="preload"
          href="/katex/katex.min.css"
          as="style"
          onload={"this.onload=null;this.rel='stylesheet'"}
        />
        <noscript>
          <link rel="stylesheet" href="/katex/katex.min.css" />
        </noscript>
      </>
    )}

    {/* Load the decorative initial before it can change the first paragraph's wrapping. */}
    {hasInitial && (
      <>
        <link
          rel="preload"
          href="/fonts/EBGaramond-InitialsF1.woff2"
          as="font"
          type="font/woff2"
          crossorigin
        />
        <link
          rel="preload"
          href="/fonts/EBGaramond-InitialsF2.woff2"
          as="font"
          type="font/woff2"
          crossorigin
        />
      </>
    )}

    <meta name="theme-color" content="#f2f1e8" />
    <meta name="color-scheme" content="light dark" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImageURL} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={Astro.url.href} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={socialImageURL} />

    <!-- Creative Commons License -->
    <link rel="license" href="https://creativecommons.org/licenses/by-sa/4.0/" />

    <title>{title}</title>
  </head>

  <body class={tone === 'personal' ? 'personal-content' : 'serious-content'}>
    <a href="#main-content" class="skip-link">Skip to content</a>

    <div class="page-wrapper">
      <Canopy />

      <header class="site-header">
        <nav class="page-nav" aria-label="Main navigation" id="main-navigation">
          <a href="/" class="site-logo carved" aria-current={isHome ? 'page' : undefined}>
            <span class="logo-text">Grotto</span>
          </a>

          <ul class="nav-links">
            {sections.map(({ href, label }) => {
              const active = currentPath.startsWith(href);
              return <li>
                <a
                  href={href}
                  class:list={['nav-link', 'carved', { active }]}
                  aria-current={active ? 'page' : undefined}
                >
                  {label}
                </a>
              </li>;
            })}
            <li class="nav-torch">
              <button
                id="nav-theme-toggle"
                class="torch-toggle"
                aria-label="Torchlight"
                aria-pressed="false"
                title="Light the torch"
                type="button"
              >
                <svg class="torch-icon" viewBox="14 6 36 50" aria-hidden="true">
                  <defs>
                    <linearGradient id="torch-flame-gradient" x1="0" y1="0" x2="0" y2="1">
                      <stop class="torch-flame-tip" offset="0%"></stop>
                      <stop class="torch-flame-base" offset="100%"></stop>
                    </linearGradient>
                  </defs>
                  <path
                    class="torch-flame"
                    fill="url(#torch-flame-gradient)"
                    d="M32 8c6 7 4 13-1 18 5-1 8-5 8-10 5 5 7 13 2 19-4 5-12 6-18 3-7-4-7-12-2-17 0 6 6 9 10 7-3-2-5-6-5-9 0-2 1-5 6-11z"
                  ></path>
                  <rect class="torch-holder" x="28" y="44" width="8" height="10" rx="2"></rect>
                </svg>
              </button>
            </li>
          </ul>
        </nav>
      </header>

      <main class="main-content" id="main-content">
        <div class:list={[`layout-${layout}`, { prose }]}>
          <slot />
        </div>
        <div class="notes-container" id="notesContainer"></div>
      </main>

      <SiteFooter includeQuoteSection={includeQuoteSection} />
    </div>

    <BackToTop />
    <Dapple
      clear={layout === 'prose' ? 'var(--measure-prose)' : layout === 'wide' ? '40rem' : '0px'}
    />

    <style is:global>
      /* Shiki dual theme switching - use only dark variables that Astro generates */

      /* Dark theme styles - when explicitly set */
      [data-theme='dark'] .astro-code,
      [data-theme='dark'] .astro-code span {
        color: var(--shiki-dark) !important;
        background-color: var(--shiki-dark-bg) !important;
      }

      /* Dark theme styles - when system prefers dark and no explicit theme */
      @media (prefers-color-scheme: dark) {
        :not([data-theme]) .astro-code,
        :not([data-theme]) .astro-code span {
          color: var(--shiki-dark) !important;
          background-color: var(--shiki-dark-bg) !important;
        }
      }
    </style>

    <script>
      import '../scripts/theme-toggle';
      import '../scripts/copy-button';
      import '../scripts/margin-notes';
    </script>
  </body>
</html>
