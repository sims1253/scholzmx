---
import { getImage } from 'astro:assets';
import { getEntry } from 'astro:content';
import portrait from '../assets/images/homepage/portrait.jpg';
import Canopy from '../components/Canopy.astro';
import SiteFooter from '../components/SiteFooter.astro';
import BackToTop from '../components/BackToTop.astro';

// Import CSS files
import '../styles/layers.css';
import '../styles/tokens.colors.css';
import '../styles/tokens.typography.css';
import '../styles/tokens.spacing.css';
import '../styles/tokens.layout.css';
import '../styles/tokens.motion.css';
import '../styles/fonts-critical.css';
import '../styles/fonts.css';
import '../styles/layout.css';
import '../styles/base.css';
import '../styles/modern.css';
import '../styles/prose.css';
import '../styles/typography-utils.css';
import '../styles/dropcap.css';
import '../styles/margin-notes.css';
import '../styles/index-list.css';
import '../styles/paper.css';

export interface Props {
  title: string;
  description?: string;
  image?: string;
  includeQuoteSection?: boolean;
  tone?: 'personal' | 'serious';
  layout?: 'prose' | 'listing' | 'cards' | 'wide' | 'full';
  prose?: boolean;
  /** The page may contain KaTeX maths, so it loads KaTeX's stylesheet and font. */
  math?: boolean;
}

const {
  title,
  description = 'A digital garden and personal website - thoughtful, slow web principles with a warm, botanical aesthetic.',
  image,
  includeQuoteSection = false,
  tone = 'personal',
  layout = 'prose',
  math = false,
  prose = false,
} = Astro.props;

const currentPath = Astro.url.pathname;
// Every absolute address comes from `site` in astro.config.mjs, the host the site is served from.
const absolute = (path: string) => new URL(path, Astro.site).href;
const canonicalURL = absolute(currentPath);
// The 404 page answers at whatever address was missing, so it claims none.
const isNotFound = /^\/404\/?$/.test(currentPath);
// Some link-preview scrapers still refuse WebP, so the portrait fallback is a JPEG.
const socialImage = absolute(
  image ?? (await getImage({ src: portrait, width: 1200, format: 'jpg' })).src
);

const AUTHOR = 'Maximilian Scholz';
const author = { '@type': 'Person', name: AUTHOR, url: absolute('/') };
const pageTitle = isNotFound || title.includes(AUTHOR) ? title : `${title} · ${AUTHOR}`;
// A post page is the only one whose path names a blog entry; drafts never get a page.
const postId = /^\/blog\/(.+?)\/?$/.exec(currentPath)?.[1];
const post = postId ? await getEntry('blog', postId) : undefined;
const structuredData = post
  ? {
      '@context': 'https://schema.org',
      '@type': 'BlogPosting',
      headline: post.data.title,
      description,
      url: canonicalURL,
      mainEntityOfPage: canonicalURL,
      image: socialImage,
      datePublished: post.data.date.toISOString(),
      dateModified: (post.data.lastUpdated ?? post.data.date).toISOString(),
      author,
      keywords: post.data.tags,
    }
  : currentPath === '/'
    ? {
        '@context': 'https://schema.org',
        ...author,
        image: socialImage,
        sameAs: ['https://github.com/sims1253', 'https://bsky.app/profile/scholzmx.bsky.social'],
      }
    : undefined;

const sections = [
  { href: '/blog', label: 'Blog' },
  { href: '/projects', label: 'Projects' },
  { href: '/recipes', label: 'Recipes' },
  { href: '/research', label: 'Research' },
];

const isHome = currentPath === '/';

const FONT = {
  alegreya: '/fonts/Alegreya/alegreya-latin-wght-normal.woff2',
  alegreyaItalic: '/fonts/Alegreya/alegreya-latin-wght-italic.woff2',
  etBook: '/fonts/et-book-roman-old-style-figures.woff2',
  etBookItalic: '/fonts/et-book-display-italic-old-style-figures.woff2',
  initials: '/fonts/EBGaramond-InitialsF2.woff2',
};
const criticalFonts = tone === 'serious' ? [FONT.alegreya, FONT.etBook] : [FONT.alegreya];
// The other tone's body face, the italics and the drop-cap letters (which only show when
// they are already at hand). The script skips the files this page has already loaded.
const warmFonts = [
  ...(tone === 'serious' ? [FONT.etBookItalic] : [FONT.etBook]),
  FONT.alegreyaItalic,
  FONT.initials,
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <!-- Fix the layer order before any stylesheet: Astro links shared component CSS first,
         and the first stylesheet to name a layer would otherwise set the order. -->
    <style is:inline>
      @layer base, components, enhancements, utilities;
    </style>
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- The light follows the visitor's clock, set before first paint so it never flashes.
         By day the canopy's shadows lean away from the sun, long and cool in the morning,
         short and sharp at noon, long and gold towards evening. At night the torch lights
         itself; the torch button overrides that until the next dawn or dusk.
         src/scripts/theme-toggle.ts calls window.grottoSky again as the day moves on. -->
    <script is:inline>
      (() => {
        const mix = (from, to, t) =>
          from.map((value, index) => Math.round(value + (to[index] - value) * t));
        const COOL = [52, 72, 80];
        const GREEN = [58, 78, 26];
        const GOLD = [100, 72, 16];

        const torch = () => {
          try {
            // The button keeps its choice in memory too, for when storage is blocked.
            const saved = window.grottoTorch ?? JSON.parse(localStorage.getItem('torch') ?? 'null');
            if (
              saved &&
              saved.until > Date.now() &&
              (saved.theme === 'dark' || saved.theme === 'light')
            ) {
              return saved.theme;
            }
          } catch {
            // Storage can be unavailable in private modes; the clock decides.
          }
          return null;
        };

        window.grottoSky = () => {
          const now = new Date();
          const hour = now.getHours() + now.getMinutes() / 60;
          const night = hour < 6 || hour >= 21;
          // -1 at sunrise, 0 at noon, 1 at sunset, from the sun's side of the sky
          const sun = Math.max(-1, Math.min(1, (hour - 13.5) / 7));
          const low = Math.abs(sun);
          const shade = sun < 0 ? mix(GREEN, COOL, -sun) : mix(GREEN, GOLD, sun);
          const glow =
            sun > 0.35
              ? `radial-gradient(ellipse 80% 70% at 100% 0%, rgb(255 186 80 / ${(0.32 * (sun - 0.35)) / 0.65}), transparent 70%)`
              : sun < -0.35
                ? `radial-gradient(ellipse 80% 70% at 0% 0%, rgb(214 232 255 / ${(0.28 * (-sun - 0.35)) / 0.65}), transparent 70%)`
                : 'none';
          const root = document.documentElement;
          root.style.setProperty('--sun-skew', `${(-sun * 8).toFixed(2)}deg`);
          root.style.setProperty('--sun-stretch', (1 + 0.3 * low ** 1.5).toFixed(3));
          root.style.setProperty('--sun-crisp', (1 - 0.45 * low).toFixed(3));
          root.style.setProperty('--sun-shade', shade.join(' '));
          root.style.setProperty('--sun-glow', glow);

          const theme = torch() ?? (night ? 'dark' : null);
          if (theme) root.dataset.theme = theme;
          else delete root.dataset.theme;
        };

        window.grottoSky();
      })();
    </script>
    {!isNotFound && <link rel="canonical" href={canonicalURL} />}
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${AUTHOR}'s blog`}
      href={absolute('/rss.xml')}
    />

    <slot name="head" />

    {/* The first paint needs one face on personal pages and two on serious ones; everything
        else (italics, bold, code, initials, maths) loads when the page sets text in it. */}
    {criticalFonts.map((href) => (
      <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />
    ))}
    {/* Once the page has loaded and the browser is idle, fetch at low priority the faces
        the next page is likely to need, so it paints in them straight away. Not on
        Save-Data or a slow connection. */}
    <script is:inline define:vars={{ warmFonts }}>
      addEventListener('load', () => {
        const net = navigator.connection;
        if (net && (net.saveData || /2g|3g/.test(net.effectiveType))) return;
        (window.requestIdleCallback ?? setTimeout)(() => {
          const have = performance.getEntriesByType('resource').map((entry) => entry.name);
          for (const href of warmFonts) {
            if (have.some((name) => name.endsWith(href))) continue;
            const link = Object.assign(document.createElement('link'), { rel: 'prefetch', href });
            link.crossOrigin = '';
            document.head.append(link);
          }
        });
      });
    </script>

    {math && (
      <>
        <link
          rel="preload"
          href="/katex/katex.min.css"
          as="style"
          onload={"this.onload=null;this.rel='stylesheet'"}
        />
        <noscript>
          <link rel="stylesheet" href="/katex/katex.min.css" />
        </noscript>
      </>
    )}

    {/* The canopy's far leaves are the largest thing painted on every page. CSS masks
        are fetched in CORS mode, so the preload is too, or it would download twice. */}
    <link
      rel="preload"
      href="/grotto/canopy-high.svg"
      as="image"
      fetchpriority="high"
      crossorigin
    />

    <meta name="theme-color" content="#f2f1e8" />
    <meta name="color-scheme" content="light dark" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={post ? 'article' : 'website'} />
    <meta property="og:site_name" content={`Grotto · ${AUTHOR}`} />
    {!isNotFound && <meta property="og:url" content={canonicalURL} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImage} />
    {post && (
      <>
        <meta property="article:published_time" content={post.data.date.toISOString()} />
        {post.data.lastUpdated && (
          <meta property="article:modified_time" content={post.data.lastUpdated.toISOString()} />
        )}
        <meta property="article:author" content={AUTHOR} />
        {post.data.tags?.map((tag) => (
          <meta property="article:tag" content={tag} />
        ))}
      </>
    )}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />

    {structuredData && (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
    )}

    <!-- Creative Commons License -->
    <link rel="license" href="https://creativecommons.org/licenses/by-sa/4.0/" />

    <title>{pageTitle}</title>
  </head>

  <body class={tone === 'personal' ? 'personal-content' : 'serious-content'}>
    <a href="#main-content" class="skip-link">Skip to content</a>

    <div class="page-wrapper">
      <Canopy />

      <header class="site-header">
        <nav class="page-nav" aria-label="Main navigation" id="main-navigation">
          <a href="/" class="site-logo" aria-current={isHome ? 'page' : undefined}>
            <span class="logo-text">Grotto</span>
          </a>

          <ul class="nav-links">
            {sections.map(({ href, label }) => {
              const active = currentPath.startsWith(href);
              return <li>
                <a
                  href={href}
                  class:list={['nav-link', { active }]}
                  aria-current={active ? 'page' : undefined}
                >
                  {label}
                </a>
              </li>;
            })}
            <li class="nav-torch">
              <button
                id="nav-theme-toggle"
                class="torch-toggle"
                aria-label="Torchlight"
                aria-pressed="false"
                title="Light the torch"
                type="button"
              >
                <svg class="torch-icon" viewBox="14 6 36 50" aria-hidden="true">
                  <defs>
                    <linearGradient id="torch-flame-gradient" x1="0" y1="0" x2="0" y2="1">
                      <stop class="torch-flame-tip" offset="0%"></stop>
                      <stop class="torch-flame-base" offset="100%"></stop>
                    </linearGradient>
                  </defs>
                  <path
                    class="torch-flame"
                    fill="url(#torch-flame-gradient)"
                    d="M32 8c6 7 4 13-1 18 5-1 8-5 8-10 5 5 7 13 2 19-4 5-12 6-18 3-7-4-7-12-2-17 0 6 6 9 10 7-3-2-5-6-5-9 0-2 1-5 6-11z"
                  ></path>
                  <rect class="torch-holder" x="28" y="44" width="8" height="10" rx="2"></rect>
                </svg>
              </button>
            </li>
          </ul>
        </nav>
      </header>

      <main class="main-content" id="main-content">
        <div class:list={[`layout-${layout}`, { prose }]}>
          <slot />
        </div>
        <div class="notes-container" id="notesContainer"></div>
      </main>

      <SiteFooter includeQuoteSection={includeQuoteSection} />
    </div>

    <BackToTop />

    <style is:global>
      /* Shiki dual theme switching - use only dark variables that Astro generates */

      /* Dark theme styles - when explicitly set */
      [data-theme='dark'] .astro-code,
      [data-theme='dark'] .astro-code span {
        color: var(--shiki-dark) !important;
        background-color: var(--shiki-dark-bg) !important;
      }

      /* Dark theme styles - when system prefers dark and no explicit theme */
      @media (prefers-color-scheme: dark) {
        :not([data-theme]) .astro-code,
        :not([data-theme]) .astro-code span {
          color: var(--shiki-dark) !important;
          background-color: var(--shiki-dark-bg) !important;
        }
      }
    </style>

    <script>
      import '../scripts/theme-toggle';
      import '../scripts/copy-button';
      import '../scripts/margin-notes';
    </script>
  </body>
</html>
